#!/usr/bin/env python3
# bin/ratchet-preview - Ratchet Wave 6 preview server (loopback-only, read-only glass)
import argparse
import hashlib
import hmac
import html
import http.server
import importlib.machinery
import importlib.util
import json
import os
import pathlib
import secrets
import socketserver
import sys
import threading
import time
import urllib.parse
import webbrowser

HERE = os.path.dirname(os.path.abspath(__file__))

def _kernel():
    spec = importlib.util.spec_from_loader(
        "ratchet_kernel",
        importlib.machinery.SourceFileLoader("ratchet_kernel", os.path.join(HERE, "ratchet")),
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod

K = _kernel()

# ---------- helpers ----------

def _ensure_dirs(session_dir):
    pathlib.Path(session_dir, "content").mkdir(parents=True, exist_ok=True)
    pathlib.Path(session_dir, "state").mkdir(parents=True, exist_ok=True)

def _events_path(session_dir):
    return os.path.join(session_dir, "state", "events.jsonl")

def _append_event(session_dir, ev):
    p = _events_path(session_dir)
    line = json.dumps(ev, sort_keys=False) + "\n"
    with open(p, "a", encoding="utf-8") as f:
        f.write(line)

def _read_events(session_dir):
    p = _events_path(session_dir)
    if not os.path.exists(p):
        return []
    out = []
    with open(p, "r", encoding="utf-8") as f:
        for ln in f:
            ln = ln.strip()
            if not ln:
                continue
            try:
                out.append(json.loads(ln))
            except Exception:
                pass
    return out

def _next_seq(session_dir):
    evs = _read_events(session_dir)
    if not evs:
        return 1
    mx = 0
    for e in evs:
        try:
            s = int(e.get("seq", 0))
            if s > mx:
                mx = s
        except Exception:
            pass
    return mx + 1

def _mint_token():
    return secrets.token_hex(16)

def _check_token(provided, expected):
    if not provided or not expected:
        return False
    return hmac.compare_digest(provided, expected)

# ---------- HTML shell ----------

HTML_SHELL = r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Ratchet preview</title>
<style>
  body{margin:0;font-family:system-ui,sans-serif;background:#111;color:#eee}
  header{padding:8px 12px;background:#222;border-bottom:1px solid #333;display:flex;align-items:center;gap:12px}
  header h1{font-size:14px;margin:0;font-weight:600}
  .bar{margin-left:auto;display:flex;gap:6px;align-items:center}
  iframe{border:0;width:100vw;height:calc(100vh - 48px);background:#fff}
  button{background:#234;color:#eee;border:1px solid #456;padding:4px 10px;cursor:pointer;border-radius:3px}
  button.a{background:#173;color:#cfc;border-color:#2a5}
  button.r{background:#612;color:#fdd;border-color:#a33}
  input{background:#000;color:#eee;border:1px solid #333;padding:4px}
  .msg{font-size:11px;color:#888}
</style>
</head>
<body>
<header>
  <h1 id="t">Ratchet preview__CARD__</h1>
  <span class="msg" id="seqmsg">seq -</span>
  <span class="bar">
    <input id="note" placeholder="note (optional)" size="24">
    <button class="a" id="bA">Approve</button>
    <button class="r" id="bR">Reject</button>
  </span>
</header>
<iframe id="frm" sandbox="allow-scripts"></iframe>
<script>
(function(){
  var KEY = "__KEY__";
  function withK(u){ return u + (u.indexOf("?")>=0?"&":"?") + "key=" + encodeURIComponent(KEY); }
  function setFrame(seq){
    if(seq<1) return;
    var p = "/content/" + seq + ".html";
    document.getElementById("frm").src = withK(p);
    document.getElementById("seqmsg").textContent = "seq " + seq;
  }
  function poll(){
    var since = window.__since || 0;
    fetch(withK("/events?since=" + since)).then(function(r){
      return r.json();
    }).then(function(j){
      if(j && j.events && j.events.length){
        for(var i=0;i<j.events.length;i++){
          var ev = j.events[i];
          if(ev.seq > since){ since = ev.seq; }
        }
        window.__since = since;
        setFrame(since);
      }
    }).catch(function(){}).finally(function(){
      setTimeout(poll, 1000);
    });
  }
  function post(verdict){
    var note = document.getElementById("note").value || "";
    var body = "verdict=" + encodeURIComponent(verdict) + "&note=" + encodeURIComponent(note);
    fetch(withK("/verdict"), {method:"POST", headers:{"Content-Type":"application/x-www-form-urlencoded"}, body:body})
      .then(function(r){
        document.getElementById("seqmsg").textContent = r.ok ? ("verdict: " + verdict) : ("verdict failed " + r.status);
      }).catch(function(){
        document.getElementById("seqmsg").textContent = "verdict error";
      });
  }
  document.getElementById("bA").onclick = function(){ post("approved"); };
  document.getElementById("bR").onclick = function(){ post("rejected"); };
  window.__since = 0;
  poll();
})();
</script>
</body>
</html>
"""

def _render_shell(key, card_id):
    cid = html.escape(card_id) if card_id else "(none)"
    out = HTML_SHELL.replace("__KEY__", key)
    out = out.replace("__CARD__", " - card " + cid)
    return out.encode("utf-8")

# A previewed fragment is UNTRUSTED — often the very artifact under review, so its scripts must not
# be able to act as the human reviewer. This CSP (served on every /content/ response) sandboxes it:
# connect-src 'none' blocks fetch/XHR/beacon, so a fragment cannot POST /verdict (forge the
# Approve/Reject decision) or exfiltrate the session token; form-action 'none' blocks form submits;
# frame-ancestors keeps it embeddable only by our own shell. (Audit: verdict-forge.)
_CONTENT_CSP = ("default-src 'none'; img-src 'self' data: blob:; media-src 'self' data: blob:; "
                "style-src 'self' 'unsafe-inline'; script-src 'unsafe-inline'; font-src 'self' data:; "
                "connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'self'")

# ---------- HTTP server ----------

class _Handler(http.server.BaseHTTPRequestHandler):
    server_version = "ratchet-preview/1.0"

    def log_message(self, fmt, *args):
        pass  # quiet

    def _send(self, status, body=b"", ctype="text/plain; charset=utf-8", extra=None):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        if extra:
            for k, v in extra.items():
                self.send_header(k, v)
        self.end_headers()
        if body:
            try:
                self.wfile.write(body)
            except Exception:
                pass

    def _check_key(self):
        token = self.server.preview_token  # type: ignore[attr-defined]
        qs = urllib.parse.urlparse(self.path).query
        params = urllib.parse.parse_qs(qs)
        provided = ""
        if "key" in params and params["key"]:
            provided = params["key"][0]
        else:
            cookie = self.headers.get("Cookie", "")
            for part in cookie.split(";"):
                part = part.strip()
                if part.startswith("rk="):
                    provided = part[3:]
                    break
        if not _check_token(provided, token):
            self._send(403, b"")
            return False
        return True

    def _serve_file(self, full, ctype="text/html; charset=utf-8"):
        # O_NOFOLLOW closes the symlink TOCTOU: if the final path component was
        # swapped for a symlink after the realpath check, os.open refuses it.
        try:
            fd = os.open(full, os.O_RDONLY | os.O_NOFOLLOW)
            with os.fdopen(fd, "rb") as f:
                data = f.read()
            self._send(200, data, ctype=ctype, extra={"Content-Security-Policy": _CONTENT_CSP})
        except (FileNotFoundError, OSError):
            self._send(404, b"")

    def _safe_content_path(self, rel):
        if rel is None:
            return None
        if "\x00" in rel:
            return None
        # URL-decode to catch %2f style encodings
        try:
            rel_decoded = urllib.parse.unquote(rel)
        except Exception:
            return None
        if "\x00" in rel_decoded:
            return None
        # Reject any leading slash (absolute path)
        if rel_decoded.startswith("/") or rel_decoded.startswith("\\"):
            return None
        # Split into parts and reject traversal/empty segments
        parts = rel_decoded.replace("\\", "/").split("/")
        for p in parts:
            if p in ("", ".") or p == "..":
                return None
            if os.path.isabs(p):
                return None
        content_dir = self.server.content_dir  # type: ignore[attr-defined]
        candidate = os.path.realpath(os.path.join(content_dir, rel_decoded))
        base = os.path.realpath(content_dir)
        if candidate != base and not candidate.startswith(base + os.sep):
            return None
        return candidate

    def do_GET(self):
        if not self._check_key():
            return
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)
        if path == "/" or path == "":
            cid = self.server.card_id  # type: ignore[attr-defined]
            self._send(200, _render_shell(self.server.preview_token, cid),  # type: ignore[attr-defined]
                       ctype="text/html; charset=utf-8")
            return
        if path.startswith("/content/"):
            rel = path[len("/content/"):]
            safe = self._safe_content_path(rel)
            if not safe:
                self._send(404, b"")
                return
            self._serve_file(safe, ctype="text/html; charset=utf-8")
            return
        if path == "/events":
            try:
                since = int((params.get("since") or ["0"])[0])
            except Exception:
                since = 0
            evs = _read_events(self.server.session_dir)  # type: ignore[attr-defined]
            newer = []
            for e in evs:
                try:
                    s = int(e.get("seq", 0))
                except Exception:
                    continue
                if s > since:
                    newer.append({"seq": s, "ts": e.get("ts"), "path": e.get("path")})
            body = json.dumps({"events": newer}).encode("utf-8")
            self._send(200, body, ctype="application/json")
            return
        self._send(404, b"")

    def do_POST(self):
        if not self._check_key():
            return
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/verdict":
            self._send(404, b"")
            return
        length = 0
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except Exception:
            length = 0
        raw = self.rfile.read(length) if length > 0 else b""
        try:
            data = urllib.parse.parse_qs(raw.decode("utf-8", errors="replace"))
        except Exception:
            data = {}
        verdict = (data.get("verdict") or [""])[0]
        note = (data.get("note") or [""])[0]
        if verdict not in ("approved", "rejected"):
            self._send(400, b"")
            return
        ev = {"ts": int(time.time()), "verdict": verdict, "note": note}
        try:
            _append_event(self.server.session_dir, ev)  # type: ignore[attr-defined]
            vp = os.path.join(self.server.session_dir, "state", "verdict.json")  # type: ignore[attr-defined]
            with open(vp, "w", encoding="utf-8") as f:
                json.dump(ev, f)
        except Exception:
            self._send(500, b"")
            return
        self._send(200, json.dumps(ev).encode("utf-8"), ctype="application/json")

class _ThreadingHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

# ---------- subcommands ----------

def cmd_serve(args):
    session_dir = os.path.abspath(args.dir)
    _ensure_dirs(session_dir)
    token = _mint_token()
    # bind a random high port on loopback
    import socket as _socket
    s = _socket.socket(_socket.AF_INET, _socket.SOCK_STREAM)
    s.setsockopt(_socket.SOL_SOCKET, _socket.SO_REUSEADDR, 1)
    s.bind(("127.0.0.1", getattr(args, "port", None) or 0))  # honor --port when given; else random (audit: flag was dead)
    port = s.getsockname()[1]
    s.close()

    server = _ThreadingHTTPServer(("127.0.0.1", port), _Handler)
    server.preview_token = token
    server.session_dir = session_dir
    server.content_dir = os.path.realpath(os.path.join(session_dir, "content"))
    server.card_id = args.card or ""

    url = "http://127.0.0.1:%d/?key=%s" % (port, token)
    try:
        with open(os.path.join(session_dir, "state", "url"), "w", encoding="utf-8") as f:
            f.write(url + "\n")
        with open(os.path.join(session_dir, "state", "port"), "w", encoding="utf-8") as f:
            f.write(str(port) + "\n")
        with open(os.path.join(session_dir, "state", "token"), "w", encoding="utf-8") as f:
            f.write(token + "\n")
        # the URL and token files carry the session secret — owner-only
        for _n in ("url", "token", "port"):
            try:
                os.chmod(os.path.join(session_dir, "state", _n), 0o600)
            except OSError:
                pass
    except Exception as e:
        print("ratchet-preview: failed to write state: %s" % e, file=sys.stderr)
        return 2

    print(url)

    if not args.no_open:
        try:
            webbrowser.open(url)
        except Exception:
            pass

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            server.server_close()
        except Exception:
            pass
    return 0

def cmd_emit(args):
    session_dir = os.path.abspath(args.dir)
    _ensure_dirs(session_dir)
    src = args.fragment
    # Reject ONLY if not a readable regular file. Do not validate basename.
    try:
        if not src or not os.path.isfile(src) or not os.access(src, os.R_OK):
            print("ratchet-preview: source is not a readable regular file", file=sys.stderr)
            return 2
        with open(src, "rb") as f:
            data = f.read()
    except Exception as e:
        print("ratchet-preview: source unreadable: %s" % e, file=sys.stderr)
        return 2
    # Destination is SERVER-GENERATED; traversal-proof by construction.
    seq = _next_seq(session_dir)
    out_name = "%d.html" % seq
    out_path = os.path.join(session_dir, "content", out_name)
    try:
        with open(out_path, "wb") as f:
            f.write(data)
    except Exception as e:
        print("ratchet-preview: write failed: %s" % e, file=sys.stderr)
        return 2
    ev = {"ts": int(time.time()), "seq": seq, "path": out_name}
    _append_event(session_dir, ev)
    print(out_name)
    return 0

def cmd_review(args):
    if args.approve and args.reject:
        print("ratchet-preview: --approve and --reject are mutually exclusive", file=sys.stderr)
        return 2
    if not args.approve and not args.reject:
        print("ratchet-preview: specify --approve or --reject", file=sys.stderr)
        return 2
    verdict = "approved" if args.approve else "rejected"
    card_id = args.card
    if not card_id:
        print("ratchet-preview: --card is required", file=sys.stderr)
        return 2
    # record to kernel: glass + card timeline
    try:
        K.telemetry_log({"event": "preview_review", "work_id": card_id,
                          "verdict": verdict, "note": K.redact(args.note or "")})
        K.record(card_id, {"event": "preview_review", "verdict": verdict,
                            "note": K.redact(args.note or "")})
    except Exception as e:
        print("ratchet-preview: kernel write failed: %s" % e, file=sys.stderr)
        return 2
    print("preview_review card=%s verdict=%s" % (card_id, verdict))
    return 0

# ---------- selftest ----------


def _selftest():
    # TRUSTED, INDEPENDENT, BLACK-BOX proof. Drives ONLY the public CLI + HTTP
    # surface of THIS file, so it cannot be gamed by the implementation. Every
    # check reproduces a real failure mode and proves it is caught.
    import socket, subprocess, tempfile, shutil, urllib.request, urllib.error
    RP = os.path.abspath(__file__)
    results = []
    def check(label, ok, detail=""):
        results.append((label, bool(ok), str(detail)[:200]))
    def free_port():
        s = socket.socket(); s.bind(("127.0.0.1", 0)); p = s.getsockname()[1]; s.close(); return p
    def GET(port, path, timeout=4):
        try:
            r = urllib.request.urlopen(f"http://127.0.0.1:{port}{path}", timeout=timeout)
            return r.getcode(), r.read()
        except urllib.error.HTTPError as e:
            return e.code, e.read()
        except Exception as e:
            return None, str(e).encode()
    def POST(port, path, data, timeout=4):
        try:
            req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", data=data.encode(),
                                         headers={"Content-Type": "application/x-www-form-urlencoded"})
            return urllib.request.urlopen(req, timeout=timeout).getcode(), b""
        except urllib.error.HTTPError as e:
            return e.code, e.read()
        except Exception as e:
            return None, str(e).encode()
    def run(argv, env=None, timeout=30):
        e = dict(os.environ); e.update(env or {})
        return subprocess.run([sys.executable, RP] + argv, capture_output=True, text=True, env=e, timeout=timeout)

    sess = tempfile.mkdtemp(prefix="rp-st-sess-")
    home = tempfile.mkdtemp(prefix="rp-st-home-")
    os.makedirs(os.path.join(home, "state"), exist_ok=True)
    port = free_port(); token = None; srv = None
    try:
        srv = subprocess.Popen([sys.executable, RP, "serve", "--dir", sess, "--card", "CARD-ST",
                                "--port", str(port), "--no-open"],
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        urlfile = os.path.join(sess, "state", "url")
        deadline = time.time() + 8
        while time.time() < deadline:
            if os.path.exists(urlfile):
                u = open(urlfile).read().strip()
                if "key=" in u:
                    token = u.split("key=", 1)[1].split("&")[0].strip()
                    try:
                        port = int(u.split("//", 1)[1].split("/", 1)[0].rsplit(":", 1)[1])
                    except Exception:
                        pass
                    break
            if srv.poll() is not None:
                break
            time.sleep(0.15)
        check("serve writes state/url with a ?key= session token", bool(token),
              f"urlfile={os.path.exists(urlfile)}")
        if not token:
            raise RuntimeError("server did not come up")
        for _ in range(40):
            if GET(port, f"/?key={token}")[0] is not None:
                break
            time.sleep(0.1)

        check("token gate: no key -> 403, correct key -> 200",
              GET(port, "/")[0] == 403 and GET(port, f"/?key={token}")[0] == 200)
        check("wrong key -> 403 (no crash)",
              GET(port, "/?key=deadbeefdeadbeefdeadbeefdeadbeef")[0] == 403)
        u = open(urlfile).read().strip()
        check("served URL is loopback (127.0.0.1/localhost)",
              ("127.0.0.1" in u or "localhost" in u) and "0.0.0.0" not in u, u[:80])

        frag = os.path.join(sess, "frag.html"); open(frag, "w").write("<h1>PREVIEW-ONE</h1>")
        r1 = run(["emit", "--dir", sess, frag])
        frag2 = os.path.join(sess, "frag2.html"); open(frag2, "w").write("<h1>PREVIEW-TWO</h1>")
        r2 = run(["emit", "--dir", sess, frag2])
        cdir = os.path.join(sess, "content"); evf = os.path.join(sess, "state", "events.jsonl")
        html_files = sorted(os.listdir(cdir)) if os.path.isdir(cdir) else []
        ev_lines = [l for l in open(evf).read().splitlines() if l.strip()] if os.path.exists(evf) else []
        seqs = []
        for l in ev_lines:
            try: seqs.append(json.loads(l).get("seq"))
            except Exception: pass
        check("emit: two emits create content/*.html + 2 monotonic events",
              len(html_files) >= 2 and len(ev_lines) == 2 and seqs == sorted(seqs) and len(set(seqs)) == 2,
              f"files={html_files} seqs={seqs} rc=({r1.returncode},{r2.returncode})")

        first = html_files[0] if html_files else "1.html"
        good_code, good_body = GET(port, f"/content/{first}?key={token}")
        trav = []
        for p in ("/content/../../etc/passwd", "/content/..%2f..%2fetc%2fpasswd",
                  "/content//etc/passwd", "/content/../frag.html"):
            code, _ = GET(port, f"{p}?key={token}")
            trav.append(code in (403, 404))
        check("path sandbox: traversal 403/404, legit fragment 200",
              good_code == 200 and b"PREVIEW" in good_body and all(trav),
              f"good={good_code} trav_ok={trav}")

        # verdict-forge defense (audit): an untrusted fragment must not be able to POST /verdict.
        # The /content/ response carries a CSP whose connect-src 'none' blocks any fetch/XHR, and
        # the shell embeds it in a sandboxed (opaque-origin) iframe it can't reach out of.
        try:
            _r = urllib.request.urlopen(f"http://127.0.0.1:{port}/content/{first}?key={token}", timeout=4)
            csp = _r.headers.get("Content-Security-Policy", "")
        except Exception as _e:
            csp = ""
        check("content CSP blocks fragment callbacks (connect-src/form-action 'none' → no verdict forge)",
              "connect-src 'none'" in csp and "form-action 'none'" in csp, csp[:90])
        shell_html = GET(port, f"/?key={token}")[1].decode("utf-8", "replace")
        check("preview iframe is sandboxed (allow-scripts, no same-origin)",
              'id="frm" sandbox="allow-scripts"' in shell_html, "")

        before = len(os.listdir(cdir)) if os.path.isdir(cdir) else 0
        bad = run(["emit", "--dir", sess, "/no/such/fragment-xyz123.html"])
        after = len(os.listdir(cdir)) if os.path.isdir(cdir) else 0
        check("emit rejects a nonexistent source (nonzero exit, no partial write)",
              bad.returncode != 0 and after == before, f"rc={bad.returncode} {before}->{after}")

        code, body = GET(port, f"/events?since=1&key={token}")
        try:
            evs = json.loads(body); evs = evs.get("events", evs) if isinstance(evs, dict) else evs
            got = [e.get("seq") for e in evs] if isinstance(evs, list) else []
        except Exception:
            got = "unparseable"
        check("events poll: ?since=1 returns only seq>1", got == [2], f"got={got}")

        vcode = POST(port, f"/verdict?key={token}", "verdict=approved&note=lgtm")[0]
        vjson = os.path.join(sess, "state", "verdict.json"); vok = False
        if os.path.exists(vjson):
            try: vok = json.load(open(vjson)).get("verdict") == "approved"
            except Exception: vok = False
        check("verdict POST writes state/verdict.json with the verdict", vcode == 200 and vok,
              f"code={vcode} file={os.path.exists(vjson)}")

        renv = {"RATCHET_HOME": home, "WL_HOME": home, "WL_INSTANCE": "rp-st"}
        ra = run(["review", "--dir", sess, "--card", "CARD-ST", "--approve", "--note", "ok"], env=renv)
        telem = os.path.join(home, "state", "telemetry.jsonl")
        t1 = open(telem).read() if os.path.exists(telem) else ""
        check("review --approve writes preview_review(approved) to the glass",
              ra.returncode == 0 and "preview_review" in t1 and "approved" in t1,
              f"rc={ra.returncode} err={ra.stderr[-80:]}")
        rr = run(["review", "--dir", sess, "--card", "CARD-ST", "--reject", "--note", "no"], env=renv)
        t2 = open(telem).read() if os.path.exists(telem) else ""
        check("review --reject writes preview_review(rejected) to the glass",
              rr.returncode == 0 and "rejected" in t2, f"rc={rr.returncode}")
        pre = len(t2.splitlines())
        both = run(["review", "--dir", sess, "--card", "CARD-ST", "--approve", "--reject"], env=renv)
        neither = run(["review", "--dir", sess, "--card", "CARD-ST"], env=renv)
        post = len(open(telem).read().splitlines()) if os.path.exists(telem) else 0
        check("review both/neither -> nonzero exit, no extra glass writes",
              both.returncode != 0 and neither.returncode != 0 and post == pre,
              f"both={both.returncode} neither={neither.returncode} {pre}->{post}")
    finally:
        if srv and srv.poll() is None:
            srv.terminate()
            try: srv.wait(timeout=5)
            except Exception: srv.kill()
        shutil.rmtree(sess, ignore_errors=True); shutil.rmtree(home, ignore_errors=True)

    passed = sum(1 for _, ok, _ in results if ok)
    for label, ok, detail in results:
        print(f"  {'OK  ' if ok else 'FAIL'}  {label}" + ("" if ok else f"  -- {detail}"))
    print(f"\n  ratchet-preview selftest: {passed}/{len(results)}")
    return 0 if passed == len(results) else 2


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        argv = ["--help"]

    parser = argparse.ArgumentParser(prog="ratchet-preview", add_help=True)
    sub = parser.add_subparsers(dest="cmd", required=False)

    p_serve = sub.add_parser("serve")
    p_serve.add_argument("--dir", required=True)
    p_serve.add_argument("--card", default=None)
    p_serve.add_argument("--port", type=int, default=None)
    p_serve.add_argument("--no-open", action="store_true")

    p_emit = sub.add_parser("emit")
    p_emit.add_argument("--dir", required=True)
    p_emit.add_argument("fragment")

    p_review = sub.add_parser("review")
    p_review.add_argument("--dir", required=True)
    p_review.add_argument("--card", required=True)
    p_review.add_argument("--approve", action="store_true")
    p_review.add_argument("--reject", action="store_true")
    p_review.add_argument("--note", default="")

    p_self = sub.add_parser("selftest")

    args = parser.parse_args(argv)

    if args.cmd == "serve":
        return cmd_serve(args)
    if args.cmd == "emit":
        return cmd_emit(args)
    if args.cmd == "review":
        return cmd_review(args)
    if args.cmd == "selftest":
        return _selftest()
    parser.print_help()
    return 2

if __name__ == "__main__":
    sys.exit(main())
