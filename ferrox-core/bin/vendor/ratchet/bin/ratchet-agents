#!/usr/bin/env python3
"""ratchet-agents — the AGENTS.md generator. Makes every adopted repo Ratchet-native.

It writes a MANAGED BLOCK into the repo's AGENTS.md — detected stack + the Ratchet operating
contract — using a marker-block merge (IJFW's proven pattern): the region between the RATCHET
markers is regenerated; everything a human wrote outside it is preserved byte-for-byte. Self-
contained (its own light stack census from git ls-files); no model calls, no protected-state
mutation. Regeneration is idempotent — no timestamps in the block, so re-running produces a clean
(often empty) diff.

Verbs:
  gen <repo> [--write] [--path AGENTS.md]   render the managed block merged into AGENTS.md; prints
                                            to stdout unless --write commits it to the repo file
  selftest                                  hermetic proofs: generate, merge-preserve, idempotence
"""
import importlib.machinery, importlib.util
import os, sys
from collections import Counter

HERE = os.path.dirname(os.path.abspath(__file__))

def _kernel():
    spec = importlib.util.spec_from_loader(
        "ratchet_kernel", importlib.machinery.SourceFileLoader("ratchet_kernel", os.path.join(HERE, "ratchet")))
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod); return mod

K = _kernel()

BEGIN = "<!-- RATCHET:BEGIN (managed block — regenerated by `ratchet-agents`; do not edit inside) -->"
END = "<!-- RATCHET:END -->"

LANGS = {".py": "python", ".js": "javascript", ".jsx": "javascript", ".mjs": "javascript",
         ".ts": "typescript", ".tsx": "typescript", ".go": "go", ".rs": "rust", ".rb": "ruby",
         ".java": "java", ".c": "c", ".h": "c", ".cc": "cpp", ".cpp": "cpp", ".swift": "swift",
         ".kt": "kotlin", ".sh": "shell", ".md": "markdown"}
ENTRY_STEMS = {"main", "index", "app", "cli", "server", "__main__", "mod", "lib"}
TEST_MARKERS = ("test", "spec", "__tests__")

def _shebang_lang(first):
    if not first.startswith("#!"):
        return None
    if "python" in first: return "python"
    if "node" in first: return "javascript"
    if "ruby" in first: return "ruby"
    if any(s in first for s in ("bash", "/sh", "zsh")): return "shell"
    return None

def _lang_of(root, path):
    lang = LANGS.get(os.path.splitext(path)[1].lower())
    if lang is None and os.path.splitext(path)[1] == "":
        try:
            first = open(os.path.join(root, path), encoding="utf-8", errors="replace").readline()
            lang = _shebang_lang(first)
        except OSError:
            lang = None
    return lang

def _is_test(f):
    """Test file by PATH COMPONENT (a dir literally named test/tests/spec/…) or by filename
    convention (test_*/spec_*, *.test.*, *.spec.*) — never a substring, so `src/contest/` and
    `special.ts` are not mislabeled as tests."""
    comps = f.split("/")
    if any(c.lower() in ("test", "tests", "spec", "specs", "__tests__") for c in comps[:-1]):
        return True
    base = comps[-1].lower()
    stem = os.path.splitext(base)[0]
    return stem.startswith(("test_", "spec_")) or any(
        base.endswith(s) for s in (".test.ts", ".test.tsx", ".test.js", ".spec.ts", ".spec.js", ".spec.py"))

def census(root):
    """Language counts, entry-point candidates, and test dirs — from tracked files only. -z so a
    path with a newline/quote can't corrupt the census."""
    # -s so we can read the mode and keep ONLY regular blobs (100644/100755): a tracked SYMLINK
    # (120000) or gitlink (160000) would otherwise let _lang_of's open() follow the link and read a
    # file OUTSIDE the repo (audit; the ratchet-index census already guards this way). -z: NUL-safe.
    rc, out, _ = K.git(root, "ls-files", "-s", "-z")
    files = []
    if rc == 0:
        for rec in out.split("\0"):
            if not rec or "\t" not in rec:
                continue
            meta, path = rec.split("\t", 1)
            if path and meta.split(" ", 1)[0] in ("100644", "100755"):
                files.append(path)
    langs = Counter()
    entries, testdirs = [], set()
    for f in files:
        lang = _lang_of(root, f)
        if lang and lang != "markdown":
            langs[lang] += 1
        if _is_test(f):
            d = os.path.dirname(f)
            testdirs.add(d + "/" if d else "(root)")  # the actual dir holding the test, not src/
            continue
        stem = os.path.splitext(os.path.basename(f))[0].lower()
        depth = f.count("/")
        if lang and (stem in ENTRY_STEMS or (f.startswith("bin/") and depth == 1)):
            entries.append((depth, f))
    entries = [f for _, f in sorted(entries)][:6]
    return langs, entries, sorted(testdirs)[:8], len(files)

def build_block(repo, root):
    m = K.load_manifest()
    r = m["repos"].get(repo, {})
    langs, entries, testdirs, n = census(root)
    lang_str = ", ".join(f"{l} ({c})" for l, c in langs.most_common()) or "none detected"
    suite = r.get("suite_cmd") or "none declared"
    mainline = r.get("mainline", "?")
    lines = [
        f"# {repo} — agent operating notes  ·  managed by Ratchet",
        "",
        "_Ratchet governs work in this repo. Edit ONLY outside the RATCHET markers — the block "
        "between them is regenerated by `ratchet-agents gen` and your edits inside it are overwritten._",
        "",
        "## Stack (detected)",
        f"- Files tracked: {n}",
        f"- Languages: {lang_str}",
        f"- Entry points: {', '.join(f'`{e}`' for e in entries) if entries else 'none obvious'}",
        f"- Tests: {', '.join(f'`{t}`' for t in testdirs) if testdirs else 'none detected'}",
        "",
        "## Working here (Ratchet-gated)",
        f"- Cards are the only doorway: `ratchet take <slug> --repo {repo}`. Work ONLY inside your "
        "card's worktree / granted lane.",
        "- Never push, never merge, never touch other branches. You cannot land — the gate runs "
        "`ratchet land` after review, and an agent never self-lands.",
        f"- Suite that must stay green: `{suite}`.  Mainline: `{mainline}`.",
        "- When done, write a one-paragraph `DELIVERY.md` at the worktree root; the gate takes it "
        "from there (rebase → suite → corpus → review → PR).",
    ]
    return "\n".join(lines)

def merge(existing, block):
    """Marker-preserving merge. Markers count ONLY when they are a line's sole content (modulo
    whitespace) — so a human quoting the marker inline, or documenting it in a code fence, does not
    trip the boundary detector. Returns merged text, or None if the markers are MALFORMED (caller
    aborts rather than risk clobbering human content):
      - no marker lines            ⇒ append the block (never clobber a hand-written AGENTS.md)
      - exactly one BEGIN line with an END line after it ⇒ replace that region, keep all else
      - anything else (0/2+ BEGIN lines, or a BEGIN with no following END line) ⇒ None = malformed"""
    lines = existing.split("\n")
    begins = [i for i, l in enumerate(lines) if l.strip() == BEGIN]
    ends = [i for i, l in enumerate(lines) if l.strip() == END]
    if not begins and not ends:
        managed = f"{BEGIN}\n{block}\n{END}\n"
        if not existing.strip():
            return managed
        sep = "" if existing.endswith("\n\n") else ("\n" if existing.endswith("\n") else "\n\n")
        return f"{existing}{sep}{managed}"
    if len(begins) != 1:
        return None
    after = [e for e in ends if e > begins[0]]
    if not after:
        return None
    b, e = begins[0], after[0]
    merged = lines[:b] + [BEGIN] + block.split("\n") + [END] + lines[e + 1:]
    return "\n".join(merged)

def _safe_target(root, path):
    """Resolve --path inside the repo. Rejects absolute paths, `..` traversal, and a symlinked
    target — a `--write` must never escape the repo (a card-interpolated --path in CI is untrusted)."""
    if os.path.isabs(path) or ".." in path.replace("\\", "/").split("/"):
        return None, "path must be relative and contain no '..'"
    target = os.path.join(root, path)
    rr, rt = os.path.realpath(root), os.path.realpath(target)
    if rt != rr and not rt.startswith(rr + os.sep):
        return None, "path escapes the repo root"
    if os.path.islink(target):
        return None, "target is a symlink — refusing to follow it"
    return target, None

def gen_cmd(args):
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet-agents gen <repo> [--write] [--path AGENTS.md]"); return 1
    repo = pos[0]
    m = K.load_manifest()
    if repo not in m["repos"]:
        print(f"agents: unknown repo '{repo}' — adopt it first"); return 2
    root = K.expand(m["repos"][repo]["path"])
    path = "AGENTS.md"
    if "--path" in args:
        i = args.index("--path")
        if i + 1 >= len(args):
            print("agents: --path needs a value"); return 1
        path = args[i + 1]
    target, err = _safe_target(root, path)
    if err:
        print(f"agents: REFUSE --path '{path}' — {err}"); return 2
    existing = open(target, encoding="utf-8", errors="replace").read() if os.path.exists(target) else ""
    merged = merge(existing, build_block(repo, root))
    if merged is None:
        print(f"agents: {target} has malformed RATCHET markers (BEGIN×{existing.count(BEGIN)}, "
              f"END×{existing.count(END)}) — fix or remove them; refusing to touch it"); return 2
    if "--write" in args:
        tmp = f"{target}.tmp.{os.getpid()}"  # atomic: a crash mid-write can't truncate human content
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(merged)
        os.replace(tmp, target)
        changed = merged != existing
        print(f"agents: {'updated' if changed and existing else ('wrote' if changed else 'no change to')} {target}")
    else:
        print(merged)
    return 0

def selftest(args):
    """Hermetic proofs: block generation from a real census, human-content preservation across a
    regenerate, and idempotence (second gen is a no-op)."""
    import tempfile, subprocess, json
    results = []
    with tempfile.TemporaryDirectory(prefix="ragents-st-") as tmp:
        root = os.path.join(tmp, "repo"); os.makedirs(os.path.join(root, "src")); os.makedirs(os.path.join(root, "tests"))
        subprocess.run(["git", "init", "-q", "-b", "main", root])
        subprocess.run(["git", "-C", root, "config", "user.email", "t@t"])
        subprocess.run(["git", "-C", root, "config", "user.name", "t"])
        open(os.path.join(root, "src", "app.ts"), "w").write("export const x = 1\n")
        open(os.path.join(root, "src", "util.ts"), "w").write("export const y = 2\n")
        open(os.path.join(root, "cli.py"), "w").write("def main():\n    pass\n")
        open(os.path.join(root, "tests", "app.test.ts"), "w").write("test('x', ()=>{})\n")
        subprocess.run(["git", "-C", root, "add", "."]); subprocess.run(["git", "-C", root, "commit", "-qm", "c0"])
        home = os.path.join(tmp, "home"); os.makedirs(os.path.join(home, "state"))
        mpath = os.path.join(tmp, "m.json")
        json.dump({"schema_version": 1, "min_wl_plane": "0", "repos": {"sb": {
            "path": root, "mainline": "main", "suite_cmd": "npm test", "fetch_remote": "origin",
            "push_remote": "origin", "gh_login": "t", "forbidden_push": [], "remotes": {},
            "worktree_root": os.path.join(tmp, "wts")}}, "noise_paths": [], "archive_dir": os.path.join(tmp, "arc"),
            "fetch_ttl_seconds": 300, "sync_warn_behind": 1, "sync_red_behind": 50}, open(mpath, "w"))
        os.environ["WL_HOME"] = home; os.environ["WL_MANIFEST"] = mpath; os.environ["WL_INSTANCE"] = "ragents-st"
        global K
        K = _kernel()

        block = build_block("sb", root)
        results.append(("BLOCK reflects the detected stack (langs + suite + mainline)",
                        "typescript (3)" in block and "python (1)" in block and "npm test" in block and "main" in block,
                        block[block.find('Languages'):block.find('Languages')+60]))
        results.append(("BLOCK lists entry points + test dirs",
                        "`cli.py`" in block and "tests/" in block, block[block.find('Entry'):block.find('Entry')+80]))
        # merge into a file with human content ABOVE and BELOW → both preserved, block inserted once
        target = os.path.join(root, "AGENTS.md")
        open(target, "w").write("# My Repo\n\nHuman notes that must survive.\n")
        gen_cmd(["sb", "--write"])
        after = open(target).read()
        results.append(("MERGE preserves human content + inserts the managed block",
                        "Human notes that must survive." in after and BEGIN in after and END in after,
                        after[:60]))
        # idempotence: a second write changes nothing (no timestamp churn)
        before2 = open(target).read()
        gen_cmd(["sb", "--write"])
        results.append(("IDEMPOTENT: regenerating produces an identical file",
                        open(target).read() == before2, "second gen differed" if open(target).read() != before2 else ""))
        # a subsequent human edit BELOW the block survives regeneration
        with open(target, "a") as f:
            f.write("\n## My extra section\nkeep me\n")
        gen_cmd(["sb", "--write"])
        final = open(target).read()
        results.append(("MERGE preserves human edits made AFTER the block on re-gen",
                        "keep me" in final and "Human notes that must survive." in final and final.count(BEGIN) == 1,
                        f"begins={final.count(BEGIN)}"))
        # cross-audit: --write must never escape the repo
        rc_trav = gen_cmd(["sb", "--write", "--path", "../escape.md"])
        results.append(("WRITE refuses --path traversal outside the repo",
                        rc_trav == 2 and not os.path.exists(os.path.join(tmp, "escape.md")), str(rc_trav)))
        # cross-audit: malformed markers (BEGIN, no END) ⇒ abort, file left untouched (no clobber)
        mal = os.path.join(root, "MAL.md"); open(mal, "w").write("human work\n" + BEGIN + "\nstuff\n")
        rc_mal = gen_cmd(["sb", "--write", "--path", "MAL.md"])
        results.append(("WRITE aborts on malformed markers, leaves the file untouched",
                        rc_mal == 2 and open(mal).read() == "human work\n" + BEGIN + "\nstuff\n", str(rc_mal)))
        # cross-audit: a stray END in prose BEFORE the block must not truncate head/tail on regen
        prose = os.path.join(root, "PROSE.md")
        open(prose, "w").write(f"intro {END} as prose\n\n{BEGIN}\nOLD\n{END}\n\ntail keep\n")
        gen_cmd(["sb", "--write", "--path", "PROSE.md"])
        pf = open(prose).read()
        results.append(("MERGE with a prose END before the block preserves head + tail",
                        f"intro {END} as prose" in pf and "tail keep" in pf and pf.count(BEGIN) == 1, pf[:30]))

    passed = sum(1 for _, okv, _ in results if okv)
    for label, okv, detail in results:
        print(f"  {'OK  ' if okv else 'FAIL'}  {label}" + ("" if okv else f" — {detail}"))
    print(f"\n  ratchet-agents selftest: {passed}/{len(results)}")
    return 0 if passed == len(results) else 2

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    verb = {"gen": gen_cmd, "selftest": selftest}.get(args[0])
    if not verb:
        print(f"ratchet-agents: unknown verb '{args[0]}'", file=sys.stderr); return 1
    return verb(args[1:])

if __name__ == "__main__":
    sys.exit(main())
