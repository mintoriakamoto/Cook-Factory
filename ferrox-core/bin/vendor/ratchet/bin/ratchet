#!/usr/bin/env python3
"""ratchet — progress that can't slip back.

The enforcement layer for AI-built software: drift detection, work-card discipline,
secret-proof hooks, synchronous merge gates, cross-repo integration trains, a compounding
regression corpus, and branch-protection-as-code — for ANY agent or human touching the repos.

Verbs:
  doctor  [--fresh] [--offline] [--json] [--explain]   drift detection across the manifest
  sync    [repo] [--dry-run]                            ff-only sync of canonical trees
  status                                                one-screen god-view (TTL-cached)
  selftest                                              sandbox-proves every check fires on its target
  init    [--install [--yes]]                            first-run setup wizard: detect tools, suggest/install, confirm dispatch lane
  config  [--json]                                      effective policy values + source (E0; write path lands in E2)
  watch   [--serve [--port N]]                          the glass: needs-you + lanes; --serve = read-only localhost page
  log     <card>                                        postmortem: full flight recording + artifacts
  replay  <card>                                        re-derive recorded council verdicts from their recorded inputs
  chain                                                 verify the hash-chained telemetry ledger (tamper detection)
  inbox   [--all]                                       what needs YOU, worst first · snooze <id> --until · delegate <id> --to
  approve <plan.json> [--hash <sha12>]                  sign off a council plan → cards (hash-bound, fails closed on change)
  answer  <q> --text '<decision>'                       lock a council question into a recorded decision
  kill|pause|resume <card>                              fleet control: signal the recorded exec lane (pid-reuse-safe)
  closeout <candidate>                                  ship-audit artifact for a promoted release (spend + ledger summary)
  overwatch <register|flag|await|sweep|respond>         the never-idle team wait-loop as a verb (baselines the waker at flag time)

Design (WL-CONTROL-PLANE-SPEC.md v1.3):
- Fetch-first SYNC with TTL; fetch FAILURE = loud UNKNOWN, never a silent number off stale refs.
- Effective auth identity per repo (global gh mismatch = WARN + remediation, absence = RED).
- Read-only by default. sync is the only mutator here and is ff-only + refuses dirty.
- The plane doesn't trust itself: manifest schema pin + `selftest` reproduces each failure mode.
"""
import json, os, re, shutil, subprocess, sys, tempfile, time, urllib.error, urllib.parse, urllib.request

VERSION = "0.12.0"
WL_HOME = os.environ.get("RATCHET_HOME") or os.environ.get("WL_HOME") or os.path.expanduser("~/.ratchet")
MANIFEST_PATH = os.environ.get("RATCHET_MANIFEST") or os.environ.get("WL_MANIFEST") or os.path.join(WL_HOME, "state", "workspace.json")
CACHE_DIR = os.path.join(WL_HOME, "state", ".cache")
# Remote land-gate harness families (manifest gate.kind). Each maps to a harness honoring the
# shared `<slot> <local_worktree> <args...>` interface; an unlisted kind is a config ERROR, never
# a silent local fallback (see _gate_exec_plan).
GATE_KINDS = ("cargo", "vitest")

OK, WARN, RED, UNKNOWN, SKIP = "OK", "WARN", "RED", "UNKNOWN", "SKIP"
COLORS = {OK: "\033[32m", WARN: "\033[33m", RED: "\033[31m", UNKNOWN: "\033[35m", SKIP: "\033[2m"}
USE_COLOR = sys.stdout.isatty() and not os.environ.get("NO_COLOR")

def paint(status):
    return f"{COLORS[status]}{status:7}\033[0m" if USE_COLOR else f"{status:7}"

def expand(p):
    return os.path.expanduser(p)

def run(args, cwd=None, timeout=45):
    """Run a command; return (rc, stdout, stderr). Never raises on failure."""
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        # rstrip ONLY — a leading space is significant in porcelain output (' M file')
        return r.returncode, r.stdout.rstrip("\n"), r.stderr.strip()
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"
    except FileNotFoundError as e:
        return 127, "", str(e)

def git(repo_path, *args, timeout=45):
    return run(["git", "-C", repo_path, *args], timeout=timeout)

# ---------- manifest ----------

def load_manifest():
    try:
        m = json.load(open(MANIFEST_PATH))
    except FileNotFoundError:
        sys.exit(f"ratchet: no manifest at {MANIFEST_PATH} — the control plane has no topology to enforce")
    except json.JSONDecodeError as e:
        sys.exit(f"ratchet: manifest is not valid JSON ({e}) — refusing to run on a poisoned manifest")
    if m.get("schema_version") != 1:
        sys.exit(f"ratchet: manifest schema_version={m.get('schema_version')} unsupported (need 1)")
    minv = m.get("min_ratchet", m.get("min_wl_plane", "0"))
    if vtuple(VERSION) < vtuple(minv):
        sys.exit(f"ratchet: binary {VERSION} < manifest min_ratchet {minv} — update ratchet before acting")
    for key in ("repos",):
        if key not in m:
            sys.exit(f"ratchet: manifest missing required key '{key}'")
    for name, r in m["repos"].items():
        for req in ("path", "mainline", "fetch_remote", "push_remote", "gh_login", "remotes", "worktree_root"):
            if req not in r:
                sys.exit(f"ratchet: manifest repo '{name}' missing '{req}'")
        # field validation — kills the injection/typo class at the source (council code-audit)
        if not re.fullmatch(r"[\w./-]+", r["mainline"]):
            sys.exit(f"ratchet: repo '{name}' mainline '{r['mainline']}' has unsafe characters")
        for rn, url in r["remotes"].items():
            if not re.fullmatch(r"[A-Za-z0-9_-]+", rn):
                sys.exit(f"ratchet: repo '{name}' remote name '{rn}' has unsafe characters")
            if not re.fullmatch(r"(https://github\.com/[\w.-]+/[\w.-]+(\.git)?|/[^\s'\"]+)", url):
                sys.exit(f"ratchet: repo '{name}' remote '{rn}' URL not github-https or absolute path: {url}")
        pin = r.get("pin")
        if pin and not re.fullmatch(r"[\w.-]+/[\w.-]+", pin.get("upstream_repo", "")):
            sys.exit(f"ratchet: repo '{name}' pin upstream_repo malformed")
    return m

def vtuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", str(v))[:4]) or (0,)

# ---------- cache (TTL) ----------

def cache_get(key, ttl):
    p = os.path.join(CACHE_DIR, key + ".json")
    try:
        if time.time() - os.path.getmtime(p) <= ttl:
            return json.load(open(p))
    except (OSError, json.JSONDecodeError):
        pass
    return None

def cache_get_stale(key):
    """Any cached value regardless of age, plus its age in seconds (for degraded reporting)."""
    p = os.path.join(CACHE_DIR, key + ".json")
    try:
        return json.load(open(p)), int(time.time() - os.path.getmtime(p))
    except (OSError, json.JSONDecodeError):
        return None, None

def cache_put(key, value):
    os.makedirs(CACHE_DIR, exist_ok=True)
    p = os.path.join(CACHE_DIR, key + ".json")
    tmp = f"{p}.{os.getpid()}.tmp"  # per-process tmp: two lanes writing the same key must not interleave
    with open(tmp, "w") as fh:      # guaranteed flush+close BEFORE the atomic replace
        json.dump(value, fh)
    os.replace(tmp, p)  # atomic — parallel lanes must not read torn writes

# ---------- checks (each returns (status, message, evidence)) ----------

def check_standalone(path):
    dotgit = os.path.join(path, ".git")
    if not os.path.exists(dotgit):
        return RED, "no .git — not a repository", dotgit
    if os.path.isdir(dotgit):
        return OK, "standalone clone", dotgit
    head = open(dotgit).read(200).strip()
    return RED, "'.git' is a POINTER (worktree of another repo — the engine-tangle)", head

def check_mainline(path, mainline):
    rc, out, err = git(path, "branch", "--show-current")
    if rc != 0:
        return UNKNOWN, f"cannot read branch: {err}", err
    if out == mainline:
        return OK, f"on {mainline}", out
    return RED, f"on '{out}', manifest says '{mainline}'", out

def check_remotes(path, expected):
    rc, out, err = git(path, "remote", "-v")
    if rc != 0:
        return UNKNOWN, f"cannot read remotes: {err}", err
    have = {}
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1] == "(fetch)":
            have[parts[0]] = parts[1]
    problems = []
    for name, url in expected.items():
        if name not in have:
            problems.append(f"missing remote '{name}'")
        elif have[name].rstrip("/").removesuffix(".git") != url.rstrip("/").removesuffix(".git"):
            problems.append(f"'{name}' -> {have[name]} (manifest: {url})")
    if problems:
        return RED, "; ".join(problems), out
    return OK, f"{len(expected)} remote(s) match manifest", out

def fetch_with_ttl(path, remote, branch, ttl, fresh=False, offline=False):
    """Fetch remote/branch unless a fetch newer than ttl exists.
    Returns (fetched_ok, age_seconds, error). fetch FAILURE is a first-class outcome."""
    rc, gitdir, _ = git(path, "rev-parse", "--git-dir")
    stamp = os.path.join(path, gitdir, "ratchet-fetch-stamp") if rc == 0 else None
    age = None
    if stamp and os.path.exists(stamp):
        age = int(time.time() - os.path.getmtime(stamp))
    if offline:
        return False, age, "offline mode"
    if not fresh and age is not None and age <= ttl:
        return True, age, None
    rc, _, err = git(path, "fetch", remote, branch, timeout=120)
    if rc != 0:
        return False, age, err or f"fetch exit {rc}"
    if stamp:
        open(stamp, "w").write(str(int(time.time())))
    return True, 0, None

def check_sync(path, remote, branch, warn_at, red_at, fetched_ok, age, fetch_err):
    if not fetched_ok:
        # v1.3: NEVER report a drift number off refs we couldn't refresh.
        stale = f" (refs last fetched {fmt_age(age)} ago)" if age is not None else " (refs never stamped by wl)"
        return UNKNOWN, f"fetch failed: {fetch_err}{stale} — drift UNMEASURABLE, not zero", fetch_err
    # measure the MAINLINE REF, not HEAD — HEAD on a feature branch would misreport mainline drift
    local = branch if git(path, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")[0] == 0 else "HEAD"
    # LINEAGE first: a behind-count is meaningless without a common ancestor. Discovered
    # live 2026-07-06 — canonical desktop main was a DIFFERENT history than ferrox/main
    # (migration re-root), and "752 behind" was really "wrong lineage entirely".
    rc_mb, mb, _ = git(path, "merge-base", local, f"{remote}/{branch}")
    if rc_mb != 0 or not mb:
        return RED, f"NO COMMON ANCESTOR with {remote}/{branch} — tree is on the WRONG LINEAGE, not merely behind", "merge-base: none"
    rc, behind, err = git(path, "rev-list", "--count", f"{local}..{remote}/{branch}")
    if rc != 0:
        return UNKNOWN, f"rev-list failed: {err}", err
    rc2, ahead, err2 = git(path, "rev-list", "--count", f"{remote}/{branch}..{local}")
    if rc2 != 0:
        return UNKNOWN, f"ahead-count failed: {err2} — sync state unmeasurable", err2
    behind, ahead = int(behind), int(ahead)
    freshness = f"refs {fmt_age(age)} old" if age else "refs fresh"
    if behind >= red_at:
        return RED, f"{behind} commits BEHIND {remote}/{branch} ({freshness}) — the 752-class rot", str(behind)
    if behind >= warn_at:
        return WARN, f"{behind} behind {remote}/{branch} ({freshness})", str(behind)
    if ahead > 0:
        return WARN, f"in sync but {ahead} UNPUSHED local commit(s) on canonical mainline", str(ahead)
    return OK, f"in sync with {remote}/{branch} ({freshness})", "0"

def check_worktrees(path, worktree_root):
    rc, out, err = git(path, "worktree", "list", "--porcelain")
    if rc != 0:
        return UNKNOWN, f"cannot list worktrees: {err}", err
    root = os.path.realpath(expand(worktree_root)) if os.path.exists(expand(worktree_root)) else expand(worktree_root)
    canonical = os.path.realpath(expand(path))
    stray = []
    n = 0
    for line in out.splitlines():
        if line.startswith("worktree "):
            wt = os.path.realpath(line.split(" ", 1)[1])
            if wt == canonical:
                continue
            n += 1
            if not wt.startswith(root + os.sep) and wt != root:
                stray.append(wt)
    if stray:
        return WARN, f"{len(stray)} worktree(s) OUTSIDE {worktree_root}: {', '.join(stray[:3])}", "\n".join(stray)
    return OK, f"{n} worktree(s), all under {worktree_root}" if n else "no extra worktrees", str(n)

def check_clean(path, noise):
    rc, out, err = git(path, "status", "--porcelain")
    if rc != 0:
        return UNKNOWN, f"cannot read status: {err}", err
    real = []
    for line in out.splitlines():
        f = line[3:].split(" -> ")[-1].strip('"')
        if any(f == n or f.startswith(n) or os.path.basename(f) == n.rstrip("/") for n in noise):
            continue
        real.append(f)
    if real:
        return WARN, f"{len(real)} non-noise dirty file(s): {', '.join(real[:4])}{'…' if len(real) > 4 else ''}", "\n".join(real)
    return OK, "clean (noise-only dirt ignored)", ""

def effective_gh_login():
    """The identity gh will ACT as right now (env token beats active login)."""
    rc, out, _ = run(["gh", "api", "user", "--jq", ".login"], timeout=20)
    if rc != 0 or not re.fullmatch(r"[A-Za-z0-9-]+", out or ""):
        return None
    return out

def check_auth(gh_login, effective):
    if effective is None:
        return RED, "gh not authenticated / unreachable — no identity to act as", ""
    if effective == gh_login:
        return OK, f"effective identity = {effective}", effective
    return WARN, (f"effective identity is '{effective}', repo needs '{gh_login}' — "
                  f"switch (gh auth switch --user {gh_login}) or wire a per-lane GH_TOKEN before WRITES"), effective

def check_pin(m, repo, fetched_ok):
    pin = repo.get("pin")
    if not pin:
        return None
    path = expand(repo["path"])
    ref = f"{repo['fetch_remote']}/{repo['mainline']}"
    # Read the pin from REMOTE mainline (the truth), not the possibly-behind local tree.
    rc, content, err = git(path, "show", f"{ref}:{pin['file']}")
    src = ref
    if rc != 0:
        rc2 = 0
        try:
            content = open(os.path.join(path, pin["file"])).read()
            src = "worktree (remote ref unreadable)"
        except OSError as e:
            return UNKNOWN, f"pin file unreadable from {ref} and worktree: {e}", str(e)
    mt = re.search(pin["regex"], content)
    if not mt:
        return RED, f"pin regex matched NOTHING in {pin['file']} ({src}) — pin format drifted, check is blind", pin["regex"]
    pinned = mt.group(1)
    if not fetched_ok:
        # stale refs can hide a pin bump on remote mainline — never a confident OK (council catch)
        return UNKNOWN, f"pin reads {pinned} but refs are STALE (fetch failed) — remote pin state unverified", pinned
    # latest release (TTL-cached; offline -> degrade loudly, never guess)
    ck = "release-" + pin["upstream_repo"].replace("/", "_")
    latest = cache_get(ck, m.get("fetch_ttl_seconds", 300))
    if latest is None:
        rc, out, _ = run(["gh", "release", "list", "-R", pin["upstream_repo"], "-L", "1",
                          "--json", "tagName", "--jq", ".[0].tagName"], timeout=30)
        if rc == 0 and out:
            latest = out
            cache_put(ck, latest)
        else:
            stale, age = cache_get_stale(ck)
            if stale:
                latest = stale
                if vtuple(pinned) < vtuple(latest):
                    return WARN, f"pin {pinned} < latest {latest} (STALE data, {fmt_age(age)} old)", pinned
                return UNKNOWN, f"pin={pinned}; release feed unreachable, cache {fmt_age(age)} old says {stale}", pinned
            return UNKNOWN, f"pin={pinned}; cannot reach {pin['upstream_repo']} releases and no cache", pinned
    if vtuple(pinned) < vtuple(latest):
        return WARN, f"pin {pinned} but {pin['upstream_repo']} shipped {latest} — bump due (the stale-v0.9.4 class)", pinned
    return OK, f"pin {pinned} == latest release {latest} (from {src})", pinned

# hosts a contract callback may send a bearer token to; extend via config's contract_hosts
CONTRACT_HOST_ALLOW = ("api.fluxrouter.ai", "fluxrouter.ai")
# host credentials that must NEVER be shipped as a contract token (a contract uses a scoped key)
CONTRACT_KEY_DENY = ("GH_TOKEN", "GITHUB_TOKEN", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
                     "ANTHROPIC_API_KEY", "OPENAI_API_KEY")

def check_contract(m, repo):
    c = repo.get("contract")
    if not c:
        return None
    # the endpoint + key_env are manifest-supplied → validate host/scheme and refuse host
    # credentials BEFORE any secret is attached (security-council CRITICAL: a poisoned manifest
    # could point endpoint at attacker.com and key_env at GH_TOKEN, exfiltrating it via doctor).
    allow = set(CONTRACT_HOST_ALLOW) | set(config_load()[0].get("contract_hosts") or [])
    try:
        u = urllib.parse.urlparse(c["endpoint"])
    except (ValueError, KeyError, TypeError):
        return RED, "contract endpoint is missing or malformed", ""
    if u.scheme != "https" or u.hostname not in allow:
        return RED, (f"contract endpoint host '{u.hostname}' not in allowlist {sorted(allow)} or not https — "
                     f"refusing to send a key to it"), ""
    bad_key = [k for k in c.get("key_env", []) if k in CONTRACT_KEY_DENY]
    if bad_key:
        return RED, (f"contract key_env names host credential(s) {bad_key} — a catalog contract must "
                     f"use a purpose-scoped key (e.g. FLUX_*), never a host token"), ""
    key = next((os.environ[k] for k in c["key_env"] if os.environ.get(k)), None)
    ck = "contract-" + repo["gh_login"]
    ttl = m.get("fetch_ttl_seconds", 300)
    ids = cache_get(ck, ttl)
    stale_note = None
    if ids is None:
        if not key:
            stale, age = cache_get_stale(ck)
            if stale:
                ids, stale_note = stale, f"STALE cache {fmt_age(age)} old (no key to refresh)"
            else:
                return SKIP, f"no key in {'/'.join(c['key_env'])} and no cache — contract unverified", ""
        else:
            try:
                req = urllib.request.Request(c["endpoint"], headers={"Authorization": f"Bearer {key}"})
                data = json.load(urllib.request.urlopen(req, timeout=20))
                ids = [x.get("id") for x in data.get("data", [])]
                cache_put(ck, ids)
            except Exception as e:
                stale, age = cache_get_stale(ck)
                if stale:
                    ids, stale_note = stale, f"STALE cache {fmt_age(age)} old (catalog unreachable)"
                else:
                    return UNKNOWN, f"catalog unreachable ({type(e).__name__}) and no cache", str(e)
    missing = [a for a in c["required_aliases"] if a not in ids]
    if missing:
        return WARN, f"{len(missing)} required alias(es) MISSING from flux catalog: {', '.join(missing[:3])}", "\n".join(missing)
    if stale_note:
        # stale data can only ever DOWNGRADE confidence, never mint a confident OK (council catch)
        return WARN, f"aliases present per {stale_note} — refresh to confirm", ""
    return OK, f"all {len(c['required_aliases'])} required aliases present in flux catalog", ""

def fmt_age(s):
    if s is None:
        return "?"
    if s < 90: return f"{s}s"
    if s < 5400: return f"{s // 60}m"
    return f"{s // 3600}h"

# ---------- doctor ----------

def doctor(m, args):
    fresh = "--fresh" in args
    offline = "--offline" in args
    as_json = "--json" in args
    explain = "--explain" in args
    ttl = 0 if fresh else m.get("fetch_ttl_seconds", 300)
    targets = [a for a in args if not a.startswith("-")]
    effective = None if offline else effective_gh_login()
    results = []  # (repo, check, status, message, evidence)

    for name, r in m["repos"].items():
        if targets and name not in targets:
            continue
        path = expand(r["path"])
        if not os.path.isdir(path):
            results.append((name, "PATH", RED, f"repo path missing: {path}", path))
            continue
        st = check_standalone(path);           results.append((name, "STANDALONE", *st))
        st = check_mainline(path, r["mainline"]); results.append((name, "MAINLINE", *st))
        st = check_remotes(path, r["remotes"]);   results.append((name, "REMOTES", *st))
        fetched_ok, age, ferr = fetch_with_ttl(path, r["fetch_remote"], r["mainline"], ttl, fresh, offline)
        st = check_sync(path, r["fetch_remote"], r["mainline"],
                        m.get("sync_warn_behind", 1), m.get("sync_red_behind", 50),
                        fetched_ok, age, ferr)
        results.append((name, "SYNC", *st))
        st = check_worktrees(path, r["worktree_root"]); results.append((name, "WORKTREES", *st))
        st = check_clean(path, m.get("noise_paths", [])); results.append((name, "CLEAN", *st))
        st = check_auth(r["gh_login"], effective)
        if offline:
            st = (SKIP, "offline — identity unchecked", "")
        results.append((name, "AUTH", *st))
        pr = check_pin(m, r, fetched_ok)
        if pr: results.append((name, "PIN", *pr))
        cr = check_contract(m, r)
        if cr: results.append((name, "CONTRACT", *cr))
        if r.get("protection") and not offline:
            pst, pmsg = protect_verify_one(m, name, r)
            results.append((name, "PROTECT", pst, pmsg, ""))

    # persist the report for the glass (v4 prereq): the Repos page renders THIS file, never a
    # live doctor run. Merged per-repo so a targeted `doctor <repo>` refreshes its target
    # without erasing the others' last-known truth; each check carries the ts that produced it.
    ts = now_iso()
    per = {}
    for repo, check, status, msg, _ev in results:
        per.setdefault(repo, {})[check] = {"status": status, "msg": msg, "ts": ts}
    def _persist(cur):
        repos = cur.setdefault("repos", {})
        repos.update(per)
        for name in list(repos):
            if name not in m["repos"]:
                del repos[name]  # a repo dropped from the manifest must not haunt the glass
        cur["ts"] = ts
        # summary over the MERGED map (not just this run) — it must describe what the file says
        cur["summary"] = {s: sum(1 for r in repos.values() for c in r.values() if c["status"] == s)
                          for s in (RED, UNKNOWN, WARN, OK, SKIP)}
    state_mutate("doctor-report.json", {}, _persist)

    if as_json:
        print(json.dumps([{"repo": a, "check": b, "status": c, "msg": d} for a, b, c, d, _ in results], indent=1))
    else:
        cur = None
        for repo, check, status, msg, ev in results:
            if repo != cur:
                print(f"\n── {repo} ({m['repos'][repo]['path'] if repo in m['repos'] else ''})")
                cur = repo
            print(f"  {paint(status)} {check:11} {msg}")
            if explain and ev:
                for line in str(ev).splitlines()[:6]:
                    print(f"          │ {line}")
        counts = {s: sum(1 for x in results if x[2] == s) for s in (RED, UNKNOWN, WARN, OK, SKIP)}
        print(f"\n  doctor: {counts[RED]} RED · {counts[UNKNOWN]} UNKNOWN · {counts[WARN]} WARN · {counts[OK]} OK · {counts[SKIP]} SKIP")
        if counts[RED]: print("  ⛔ RED present — do NOT start work on this topology; fix or run ratchet sync first.")
        elif counts[UNKNOWN]: print("  ⚠️  UNKNOWN present — drift is unmeasured, not absent. Restore network or use cached truth consciously.")
    reds = sum(1 for x in results if x[2] == RED)
    unknowns = sum(1 for x in results if x[2] == UNKNOWN)
    return 2 if reds else (3 if unknowns else 0)

# ---------- sync (the one Phase-1 mutator: ff-only, refuses anything odd) ----------

def repo_lock(name):
    """Advisory per-repo lock — two lanes must not race fetch→merge on the same canonical tree."""
    import fcntl
    os.makedirs(CACHE_DIR, exist_ok=True)
    f = open(os.path.join(CACHE_DIR, f"{name}.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except OSError:
        f.close()
        return None

def sync(m, args):
    targets = [a for a in args if not a.startswith("-")]
    dry = "--dry-run" in args
    rc_all = 0
    for name, r in m["repos"].items():
        if targets and name not in targets:
            continue
        path = expand(r["path"])
        remote, branch = r["fetch_remote"], r["mainline"]
        lock = repo_lock(name)
        if lock is None:
            print(f"[{name}] REFUSE: another ratchet operation holds the {name} lock — try again"); rc_all = 1; continue
        rc, cur, _ = git(path, "branch", "--show-current")
        if cur != branch:
            print(f"[{name}] REFUSE: on '{cur}', not '{branch}' — sync only ffs the mainline"); rc_all = 1; continue
        # Refuse only on MODIFIED TRACKED files (real work at risk). Untracked-only dirt is
        # safe: git's ff-merge itself aborts rather than overwrite an untracked collision.
        rc, porc, _ = git(path, "status", "--porcelain")
        tracked_mods = [l[3:] for l in porc.splitlines() if not l.startswith("??")]
        noise = m.get("noise_paths", [])
        real_mods = [f for f in tracked_mods
                     if not any(f == n or f.startswith(n) or os.path.basename(f) == n.rstrip("/") for n in noise)]
        if real_mods:
            print(f"[{name}] REFUSE: {len(real_mods)} modified tracked file(s) ({', '.join(real_mods[:4])}) — commit/stash real work before sync"); rc_all = 1; continue
        rc, _, err = git(path, "fetch", remote, branch, timeout=90)
        if rc != 0:
            print(f"[{name}] REFUSE: fetch failed ({err}) — will not sync against unrefreshed refs"); rc_all = 1; continue
        rc, _, err = git(path, "rev-parse", "--verify", "--quiet", f"{remote}/{branch}")
        if rc != 0:
            print(f"[{name}] REFUSE: '{remote}/{branch}' does not exist after fetch — CHECK THE MANIFEST (mainline typo?)"); rc_all = 1; continue
        rc, mb, _ = git(path, "merge-base", "HEAD", f"{remote}/{branch}")
        if rc != 0 or not mb:
            print(f"[{name}] REFUSE: NO COMMON ANCESTOR with {remote}/{branch} — WRONG LINEAGE, a behind-count would be a lie; this needs a human re-root decision"); rc_all = 1; continue
        rc, behind, _ = git(path, "rev-list", "--count", f"HEAD..{remote}/{branch}")
        if behind == "0":
            print(f"[{name}] already in sync with {remote}/{branch}"); continue
        if dry:
            print(f"[{name}] would fast-forward {behind} commit(s) to {remote}/{branch}"); continue
        rc, out, err = git(path, "merge", "--ff-only", f"{remote}/{branch}")
        if rc != 0:
            print(f"[{name}] REFUSE: ff-only merge failed ({err}) — local mainline has diverged; resolve by hand"); rc_all = 1; continue
        # stamp the fetch so doctor's TTL sees this as fresh
        rc2, gitdir, _ = git(path, "rev-parse", "--git-dir")
        if rc2 == 0:
            open(os.path.join(path, gitdir, "ratchet-fetch-stamp"), "w").write(str(int(time.time())))
        print(f"[{name}] fast-forwarded {behind} commit(s) → {remote}/{branch}")
    return rc_all

# ---------- status (god-view, TTL-cached reads) ----------

def _repo_rows(m, readonly=False):
    """Per-repo drift/dirt/worktree state — one source of truth for status and the glass.

    readonly=True is the glass path (§9: a page view must NEVER mutate): no fetch, no
    stamp/cache writes, no gh calls — drift is computed against the refs from the LAST
    explicit fetch and labelled as such. status/doctor keep the fetching path."""
    rows = []
    for name, r in m["repos"].items():
        path = expand(r["path"])
        rc, br, _ = git(path, "branch", "--show-current")
        ref = f"{r['fetch_remote']}/{r['mainline']}"
        if readonly:
            rc_ref, _, _ = git(path, "rev-parse", "--verify", "--quiet", ref)
            fetched_ok, ferr = rc_ref == 0, "no cached remote refs"
        else:
            fetched_ok, age, ferr = fetch_with_ttl(path, r["fetch_remote"], r["mainline"], m.get("fetch_ttl_seconds", 300))
        kind = "unk"
        if fetched_ok:
            rc_mb, mb, _ = git(path, "merge-base", "HEAD", ref)
            if rc_mb != 0 or not mb:
                drift, kind = "⛔ WRONG LINEAGE", "red"
            else:
                _, behind, _ = git(path, "rev-list", "--count", f"HEAD..{ref}")
                _, ahead, _ = git(path, "rev-list", "--count", f"{ref}..HEAD")
                if behind == "0" and ahead == "0":
                    drift, kind = "✓ synced", "ok"
                else:
                    drift = f"↓{behind} ↑{ahead}"
                    kind = "red" if int(behind or 0) >= m.get("sync_red_behind", 50) else "warn"
                if readonly:
                    drift += " (last-fetched refs)"
        else:
            drift = f"？unmeasured — {ferr if readonly else plain_fetch_err(ferr)}"
        _, dirty, _ = git(path, "status", "--porcelain")
        ndirty = len(dirty.splitlines()) if dirty else 0
        _, wt, _ = git(path, "worktree", "list", "--porcelain")
        nwt = max(0, sum(1 for l in (wt or "").splitlines() if l.startswith("worktree ")) - 1)
        pin = ""
        if not readonly:
            pr = check_pin(m, r, fetched_ok)
            if pr:
                pin = pr[1].split(" — ")[0]
        rows.append({"name": name, "branch": br or "?", "drift": drift, "kind": kind,
                     "dirty": ndirty, "worktrees": nwt, "pin": pin})
    return rows

def status(m, args):
    print(f"ratchet workspace · manifest schema {m['schema_version']} · ratchet {VERSION}")
    for row in _repo_rows(m):
        pin = f" · pin: {row['pin']}" if row["pin"] else ""
        print(f"  {row['name']:8} {row['branch']:8} {row['drift']:22} dirty:{row['dirty']:<3} worktrees:{row['worktrees']}{pin}")
    return 0

# ---------- Phase 2: hooks (fast local hard-blocks; CI/branch-protection is the real functional enforcer) ----------

# The git-history secret gate. ONE bash-ERE alternation, mirroring REDACT_RES so the hooks that
# guard pushed history are never WEAKER than the redaction layer (audit: gho_/ghs_/glpat-/npm_/
# xox*/JWT slipped through). Templated into all three hooks via install_hooks (__SECRET_RE__).
_SECRET_ERE = (
    r"sk-[A-Za-z0-9_-]{16,}"
    r"|ghp_[A-Za-z0-9]{20,}"
    r"|github_pat_[A-Za-z0-9_]{20,}"
    r"|gh[ousr]_[A-Za-z0-9]{20,}"
    r"|glpat-[A-Za-z0-9_-]{16,}"
    r"|npm_[A-Za-z0-9]{30,}"
    r"|xox[abprs]-[0-9A-Za-z-]{10,}"
    r"|AKIA[0-9A-Z]{16}"
    r"|eyJ[A-Za-z0-9_-]{8,}[.][A-Za-z0-9_-]{8,}[.][A-Za-z0-9_-]{8,}"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY"
)

PRE_COMMIT = r"""#!/usr/bin/env bash
# ratchet pre-commit — FAST hard-blocks only (secrets + AI signatures). Full suite runs at `ratchet land`.
set -euo pipefail
staged="$(git diff --cached)"
# secret patterns (v1.3: preventative LOCAL block — CI catching it is already a leak).
# Builtin grep ALWAYS runs (selftest proved gitleaks-only silently passed a staged secret);
# gitleaks adds depth when present but is never the sole line.
if printf '%s' "$staged" | grep -nE '^\+.*(__SECRET_RE__)' >/dev/null; then
  echo "ratchet: SECRET-LIKE pattern in staged diff — BLOCKED (use env vars / keychain, never commit keys)" >&2; exit 1
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner 2>/dev/null || { echo "ratchet: gitleaks found secrets in staged diff — BLOCKED" >&2; exit 1; }
fi
# AI attribution (repo rule: no AI signatures anywhere)
if printf '%s' "$staged" | grep -nE '^\+.*(Co-Authored-By: *Claude|Generated with \[?Claude|noreply@anthropic\.com)' >/dev/null; then
  echo "ratchet: AI attribution in staged content — BLOCKED (repo forbids AI signatures)" >&2; exit 1
fi
exit 0
"""

COMMIT_MSG = r"""#!/usr/bin/env bash
# ratchet commit-msg — subject length + AI attribution + junk bodies.
set -euo pipefail
f="$1"
subject="$(head -1 "$f")"
if [ "${#subject}" -gt 72 ]; then
  echo "ratchet: subject is ${#subject} chars (max 72): '$subject'" >&2; exit 1
fi
if grep -qE '(Co-Authored-By: *Claude|Generated with \[?Claude|noreply@anthropic\.com)' "$f"; then
  echo "ratchet: AI attribution in commit message — BLOCKED" >&2; exit 1
fi
# secrets in the MESSAGE body (live-fire found this gap: diff scan can't see the message)
if grep -qE '(__SECRET_RE__)' "$f"; then
  echo "ratchet: SECRET-LIKE pattern in commit MESSAGE — BLOCKED" >&2; exit 1
fi
if grep -qiE '^(update file|fix bug|wip|changes)$' <<<"$subject"; then
  echo "ratchet: junk subject '$subject' — describe WHAT and WHY" >&2; exit 1
fi
exit 0
"""

PRE_PUSH = r"""#!/usr/bin/env bash
# ratchet pre-push — remote/org guard + mainline direct-push block + PER-COMMIT secret scan.
# args: $1=remote-name $2=remote-url ; stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>
set -euo pipefail
remote_name="${1:-}"; remote_url="${2:-}"
WL_PUSH_LINES="$(cat)"   # stdin read ONCE; every guard below iterates this
# normalize URL variants (trailing slash / .git) so a rewritten remote can't dodge the guard
norm(){ local u="${1%/}"; printf '%s' "${u%.git}"; }
remote_url_n="$(norm "$remote_url")"
__FORBIDDEN__
# direct pushes to the mainline are for the land gate / release flows only
# (probe-proven 2026-07-07: admin direct pushes bypass GitHub required checks)
if [ "${RATCHET_BREAK_GLASS:-${WL_BREAK_GLASS:-}}" != "1" ]; then
  while read -r lref lsha rref rsha; do
    [ -z "$lref" ] && continue
    if [ "$rref" = "refs/heads/__MAINLINE__" ] && [ "$lsha" != "0000000000000000000000000000000000000000" ]; then
      echo "ratchet: DIRECT push to __MAINLINE__ — BLOCKED (merge via ratchet land / PR; emergency: RATCHET_BREAK_GLASS=1)" >&2; exit 1
    fi
  done < <(printf '%s\n' "$WL_PUSH_LINES")
fi
SECRET_RE='^\+.*(__SECRET_RE__)'
while read -r lref lsha rref rsha; do
  [ -z "$lref" ] && continue
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue  # deletion push
  if [ "$rsha" != "0000000000000000000000000000000000000000" ] && git cat-file -e "$rsha" 2>/dev/null; then
    revs="$rsha..$lsha"
  else
    revs="$lsha --not --remotes"  # new branch: only commits no remote has yet
  fi
  # PER-COMMIT scan (a global head-cap silently skipped later commits — council catch)
  for sha in $(git rev-list $revs 2>/dev/null); do
    # scan diff (+ prefixed) AND the raw message (--format= would hide message-body secrets)
    if git show --no-color "$sha" 2>/dev/null | grep -qE "$SECRET_RE"; then
      echo "ratchet: SECRET-LIKE pattern in commit $sha — push BLOCKED. Rewrite history before pushing." >&2; exit 1
    fi
    if git log -1 --format=%B "$sha" 2>/dev/null | grep -qE '(__SECRET_RE__)'; then
      echo "ratchet: SECRET-LIKE pattern in MESSAGE of $sha — push BLOCKED." >&2; exit 1
    fi
  done
  # gitleaks adds depth on the pushed range when present (never the sole line — builtin above is
  # the guaranteed floor). Scoped to the commits being pushed, non-fatal on tool error.
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks detect --no-banner --log-opts="$revs" >/dev/null 2>&1 || {
      echo "ratchet: gitleaks found secrets in the pushed range — push BLOCKED." >&2; exit 1; }
  fi
done < <(printf '%s\n' "$WL_PUSH_LINES")
exit 0
"""

def repo_for_dir(m, d):
    """Which manifest repo owns directory d (canonical tree or a worktree under its root)?"""
    d = os.path.realpath(d)
    for name, r in m["repos"].items():
        for base in (expand(r["path"]), expand(r["worktree_root"])):
            b = os.path.realpath(base) if os.path.exists(base) else expand(base)
            if d == b or d.startswith(b + os.sep):
                return name, r
    return None, None

def install_hooks(m, name, r, target_path):
    """Install the wl hook pack into the repo's SHARED hooks dir (fires for canonical + all worktrees)."""
    rc, common, err = git(target_path, "rev-parse", "--git-common-dir")
    if rc != 0:
        return False, f"not a git dir: {err}"
    hooks = os.path.join(target_path, common, "hooks") if not os.path.isabs(common) else os.path.join(common, "hooks")
    os.makedirs(hooks, exist_ok=True)
    forb = ""
    for fr in r.get("forbidden_push", []):
        url = r["remotes"].get(fr, "").rstrip("/").removesuffix(".git")
        forb += (f'if [ "$remote_name" = "{fr}" ] || [ "$remote_url_n" = "{url}" ]; then\n'
                 f'  echo "ratchet: push to {fr} ({url}) is FORBIDDEN for {name} — push to {r["push_remote"]}" >&2; exit 1\nfi\n')
    prepush = PRE_PUSH.replace("__FORBIDDEN__", forb).replace("__MAINLINE__", r["mainline"])
    for fname, body in (("pre-commit", PRE_COMMIT), ("commit-msg", COMMIT_MSG),
                        ("pre-push", prepush)):
        body = body.replace("__SECRET_RE__", _SECRET_ERE)  # one shared token set across all hooks
        p = os.path.join(hooks, fname)
        if os.path.exists(p) and not any(s in open(p).read(200) for s in ("ratchet", "wl ")):
            return False, f"{fname} exists and is NOT a wl hook — refusing to overwrite someone else's hook"
        tmp = f"{p}.{os.getpid()}.tmp"  # atomic install: a mid-write hook must never execute half-written
        open(tmp, "w").write(body)
        os.chmod(tmp, 0o755)
        os.replace(tmp, p)
    return True, hooks

def hooks_cmd(m, args):
    targets = [a for a in args if not a.startswith("-")] or list(m["repos"].keys())
    rc_all = 0
    for name in targets:
        r = m["repos"].get(name)
        if not r:
            print(f"[{name}] unknown repo"); rc_all = 1; continue
        okv, detail = install_hooks(m, name, r, expand(r["path"]))
        print(f"[{name}] {'hooks installed → ' + detail if okv else 'FAILED: ' + detail}")
        rc_all = rc_all or (0 if okv else 1)
    return rc_all

# ---------- Phase 2: work / land / gc ----------

def branch_for(slug):
    """The branch name a slug maps to. `fix-`/`chore-` slugs get a `fix/`/`chore/` prefix; everything
    else `feat/`. ONE definition so `work` (create) and `take`'s rollback (delete) can never disagree
    — the audit found the rollback hard-coded feat/{slug}, leaking the real fix/ branch and making the
    slug permanently un-retryable."""
    return f"feat/{slug}" if not slug.startswith(("fix-", "chore-")) else slug.replace("-", "/", 1)

def work(m, args):
    pos = [a for a in args if not a.startswith("-")]
    if len(pos) != 2:
        print("usage: ratchet work <repo> <slug>"); return 1
    name, slug = pos
    r = m["repos"].get(name)
    if not r:
        print(f"unknown repo '{name}' (have: {', '.join(m['repos'])})"); return 1
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", slug):
        print("slug must be kebab-case [a-z0-9-]"); return 1
    path = expand(r["path"])
    root = expand(r["worktree_root"])
    wt = os.path.join(root, f"wt-{slug}")
    branch = branch_for(slug)
    # gate: topology must be sane before new work starts
    for label, st in (("STANDALONE", check_standalone(path)), ("REMOTES", check_remotes(path, r["remotes"]))):
        if st[0] == RED:
            print(f"[{name}] {label} RED: {st[1]} — run ratchet doctor, fix topology first"); return 2
    fetched, age, ferr = fetch_with_ttl(path, r["fetch_remote"], r["mainline"], 0, fresh=True)
    if not fetched:
        print(f"[{name}] REFUSE: cannot fetch {r['fetch_remote']}/{r['mainline']} ({ferr}) — will not branch off stale refs"); return 2
    rc, _, err = git(path, "rev-parse", "--verify", "--quiet", f"{r['fetch_remote']}/{r['mainline']}")
    if rc != 0:
        print(f"[{name}] REFUSE: '{r['fetch_remote']}/{r['mainline']}' does not exist after fetch — CHECK THE MANIFEST (mainline typo?)"); return 2
    os.makedirs(root, exist_ok=True)
    rc, out, err = git(path, "worktree", "add", wt, "-b", branch, f"{r['fetch_remote']}/{r['mainline']}")
    if rc != 0:
        print(f"[{name}] worktree add failed: {err}"); return 1  # git's atomicity IS the slug lock
    okv, detail = install_hooks(m, name, r, wt)
    if not okv:
        print(f"[{name}] WARNING: hooks not installed: {detail}")
    print(f"[{name}] worktree ready: {wt}")
    print(f"  branch {branch} off FRESH {r['fetch_remote']}/{r['mainline']} · hooks {'installed' if okv else 'MISSING'}")
    print(f"  identity: gh_login must be {r['gh_login']} for writes · push to {r['push_remote']} only")
    print(f"  when done: ratchet land {wt}")
    return 0

def detect_repo_check(wt):
    """A repo with no manifest suite_cmd may still ship its own check. Find the canonical one so the
    land gate runs SOMETHING rather than silently passing (FRICTION #3: a silent SKIP once let a lint
    failure land on ijfw). Returns (cmd, source_label), or ("", "") if nothing is detectable — the
    caller then REFUSES the land unless --no-suite is on the record. Order = most-specific-first: a
    repo's own aggregate check beats a generic language test runner."""
    def has(*parts): return os.path.exists(os.path.join(wt, *parts))
    # 1. the repo's own aggregate check script (ratchet/ijfw convention)
    for rel in ("check-all.sh", "scripts/check-all.sh", "preflight.sh", "scripts/preflight.sh"):
        if has(*rel.split("/")):
            return f"bash {rel}", rel
    # 2. language-native runners — same precedence `adopt` uses at manifest-write time
    # (Cargo → package.json → python), so a dual-language repo land-checks the way it was adopted.
    if has("Cargo.toml"):
        return "cargo test --workspace --quiet", "Cargo.toml"
    if has("package.json"):
        try:
            scripts = json.load(open(os.path.join(wt, "package.json"))).get("scripts", {})
        except (OSError, json.JSONDecodeError):
            scripts = {}
        if "test" in scripts:
            return ("bun run test" if has("bun.lock") else "npm test"), "package.json test script"
    if has("pyproject.toml") or has("requirements.txt"):
        return "python3 -m pytest -q", "python project"
    # 3. a Makefile check/test target
    if has("Makefile"):
        try:
            mk = open(os.path.join(wt, "Makefile")).read()
        except OSError:
            mk = ""
        for tgt in ("check", "test"):
            if re.search(rf"^{tgt}:", mk, re.M):
                return f"make {tgt}", f"Makefile {tgt} target"
    return "", ""

def land(m, args):
    pos = [a for a in args if not a.startswith("-")]
    wt = os.path.realpath(expand(pos[0])) if pos else os.getcwd()
    no_fuse = "--no-fuse" in args
    do_merge = "--merge" in args
    name, r = repo_for_dir(m, wt)
    if not name:
        print(f"'{wt}' is not inside any manifest repo/worktree root"); return 1
    rc, branch, _ = git(wt, "branch", "--show-current")
    if not branch or branch == r["mainline"]:
        print(f"land runs from a FEATURE worktree, not {r['mainline']}"); return 1
    # card-gate: in-flight work must be ON THE BOOKS (ratchet take) — orphan lands are how
    # multi-agent state rots. RATCHET_BREAK_GLASS=1 escapes, loudly.
    card = card_for_worktree(wt, ("open", "landing"))
    if card is None and os.environ.get("RATCHET_BREAK_GLASS", os.environ.get("WL_BREAK_GLASS")) != "1":
        print(f"[land] REFUSE: no open work card for this worktree — start work with ratchet take "
              f"(or RATCHET_BREAK_GLASS=1 for a logged exception)"); return 2
    if card:
        # claim the card atomically INSIDE the lock: open→landing, pid-stamped. Two concurrent
        # lands both passed the read-only card check before (audit race catch); now the second
        # sees a LIVE claimant and refuses. A DEAD claimant's card is re-claimable (crash re-run).
        def claim(cur):
            for c in cur["cards"]:
                if c["status"] in ("open", "landing") and os.path.realpath(expand(c["worktree"])) == wt:
                    if c["status"] == "landing" and c.get("land_pid") and c["land_pid"] != os.getpid():
                        if pid_is_claimant(c["land_pid"], c.get("land_pid_start", "")):
                            return f"another land (pid {c['land_pid']}) is in progress for this worktree"
                        # claimant is dead (pid-reuse-safe check) — re-claim and resume
                    c["status"] = "landing"; c["land_pid"] = os.getpid()
                    c["land_pid_start"] = pid_start(os.getpid()); c["land_ts"] = now_iso()
                    return None
            return "card vanished mid-land — run ratchet reconcile"
        claim_err = state_mutate(CARDS, {"cards": []}, claim)
        if claim_err:
            print(f"[land] REFUSE: {claim_err}"); return 2
        print(f"[land] card {card['work_id']} ({card['risk']}) · agent {card['agent']}")
    else:
        telemetry_log({"event": "land_no_card", "worktree": wt})
        print("[land] ⚠ BREAK-GLASS land without a card — logged")
    print(f"[land] {name} · {branch} · gate sequence begins (SYNCHRONOUS — await every step)")
    # E0 sentinel journal opens at GATE START, not just the push window: the glass renders the
    # gate as a live stepper (rebase → suite → review → push), so each step leaves its breadcrumb
    # as it completes and every clean abort names the station it died at. Exception honesty
    # (audit catch) keeps: a Python exception records itself — only a hard kill/reboot may leave
    # done=False, so INTERRUPTED always means what it says.
    jid = journal_begin("land", wt)
    try:
        return _land_gate(m, args, wt, name, r, branch, card, no_fuse, do_merge, jid)
    except BaseException:
        journal_done(jid, "exception")
        raise

def _gate_exec_plan(r, wt, suite, local_gate):
    """Decide HOW the land suite runs (not WHAT — same command, same pass/fail). Returns
    (cmd_list, label, err). Default + any repo without a manifest `gate` block + --local-gate → run
    the suite LOCALLY (byte-identical to before, nothing regresses). A `gate.runner=="hetzner"` block
    routes the SAME suite to the Hetzner box via a harness so the Mac never compiles. err set (with
    cmd None) = a config problem the caller must ABORT on — never silently degrade to local.
    Manifest gate block (operator-owned = trusted root; a PR can't alter where/what the gate runs):
      "gate": {"runner":"hetzner","kind":"cargo","harness":"~/.../remote-build.sh","slot":"wcore-gate",
               "command":"nextest run --workspace --no-fail-fast","ssh":"root@HOST","port":"16666"}
    `kind` names the HARNESS FAMILY, not a different contract: every harness takes the same
    `<slot> <local_worktree> <args...>` interface, rsyncs the worktree to its slot on the box, runs
    the args there, streams output and propagates the real exit code. cargo → remote-build.sh (Rust,
    disk-backed warm target); vitest → harness/remote-vitest.sh (TS/bun, warm node_modules + tmpfs
    vite cache). Adding a kind is a one-word change here plus a harness that honors the interface."""
    import shlex
    g = r.get("gate")
    if local_gate or not g or g.get("runner", "local") == "local":
        return ["bash", "-lc", suite], "local", None
    runner = g.get("runner")
    if runner != "hetzner":
        return None, runner, f"unknown gate runner '{runner}' (expected 'local' or 'hetzner')"
    kind, harness, slot, command = g.get("kind"), g.get("harness"), g.get("slot"), g.get("command")
    if kind not in GATE_KINDS:
        return None, runner, (f"gate kind '{kind}' not supported (expected one of "
                              f"{', '.join(sorted(GATE_KINDS))}); use --local-gate")
    for k, v in (("harness", harness), ("slot", slot), ("command", command), ("ssh", g.get("ssh"))):
        if not v:
            return None, runner, f"gate block missing required '{k}'"
    # `slot` is interpolated into remote shell strings that run as ROOT on the box. The manifest is
    # operator-owned (not PR-writable), so this is defense-in-depth rather than a live vector — but a
    # fail-closed component must not hand an unvalidated string to a root shell. Reject, don't sanitize:
    # a silently-rewritten slot name would point the gate at a DIFFERENT slot than the operator wrote.
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", slot):
        return None, runner, f"gate 'slot' {slot!r} must match [A-Za-z0-9_.-]+"
    hp = expand(harness)
    if not os.path.exists(hp):
        return None, runner, f"gate harness not found at {hp}"
    # <slot> <local_worktree> <args...> — the harness rsyncs wt→box slot and runs the args there.
    # NOTE: `ssh`/`port` in the block are used for OUR reachability preflight; the harness has its own
    # box coords, so they must name the SAME box the harness targets (documented in the schema).
    suite_args = shlex.split(command)
    # the harness rejoins args with ${args[*]} and the remote shell re-splits — a token with an
    # embedded space would be silently re-tokenized. Reject it here rather than run the wrong command.
    if any(re.search(r"\s", a) for a in suite_args):
        return None, runner, "gate 'command' has a whitespace-containing token (harness re-splits remotely) — use simple flags only"
    cmd = ["bash", hp, slot, wt] + suite_args
    return cmd, f"hetzner:{kind} via {os.path.basename(hp)} slot={slot}", None

def _gate_slot_lock(slot):
    """Advisory lock on a remote gate SLOT. The slot is a single shared directory on the box that the
    harness rsyncs --delete into then builds in — two concurrent lands sharing a slot would clobber
    each other's source mid-build and could false-green a Frankenstein tree (the local gate had
    per-worktree isolation; routing off-box reintroduces the shared-state race repo_lock() exists for).
    Non-blocking: a busy slot means another land holds it → the caller REFUSES (retry), never proceeds."""
    import fcntl
    os.makedirs(CACHE_DIR, exist_ok=True)
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", slot)  # slot is manifest-controlled, but keep the path clean
    f = open(os.path.join(CACHE_DIR, f"gate-slot-{safe}.lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return f
    except OSError:
        f.close()
        return None

def _land_gate(m, args, wt, name, r, branch, card, no_fuse, do_merge, jid):
    # 1. fresh rebase
    fetched, _, ferr = fetch_with_ttl(wt, r["fetch_remote"], r["mainline"], 0, fresh=True)
    if not fetched:
        journal_done(jid, "aborted:fetch")
        print(f"[land] ABORT: fetch failed ({ferr})"); return 2
    rc, out, err = git(wt, "rebase", f"{r['fetch_remote']}/{r['mainline']}", timeout=300)
    if rc != 0:
        git(wt, "rebase", "--abort")
        journal_done(jid, "aborted:rebase")
        print(f"[land] ABORT: rebase onto {r['fetch_remote']}/{r['mainline']} conflicts:\n{err or out}\nResolve by hand, then re-run."); return 2
    journal_step(jid, "rebase")
    print(f"[land] 1/4 rebased onto fresh {r['fetch_remote']}/{r['mainline']}")
    # clean-tree gate: the suite + corpus below run in the worktree, but ONLY committed work gets
    # pushed. An uncommitted or UNTRACKED file the suite reads (yet that never lands) would make the
    # gate green on a commit that fails a fresh CI checkout — a false-green merge (audit MED-HIGH).
    # Rebase blocks dirty TRACKED files but untracked ones are invisible to it, so require a fully
    # clean tree here: the gate must test exactly what gets pushed.
    rc_ct, porc, _ = git(wt, "status", "--porcelain")
    if porc.strip():
        journal_done(jid, "aborted:unclean")
        print(f"[land] ABORT: worktree is not clean — commit or remove uncommitted/untracked files so "
              f"the gate tests exactly what gets pushed:\n{porc}"); return 2
    # 2. FULL suite against the POST-REBASE tree (v1.3: the 0.11.15 lesson).
    # No manifest suite_cmd is NOT a free pass (FRICTION #3 — a silent SKIP once let a lint
    # failure land on ijfw): fall back to the repo's OWN check, and if none exists REFUSE unless
    # --no-suite is on the record (mirrors the --no-fuse logged-skip contract). A detected check
    # runs through the exact same stream+tail path below, so a failure aborts and records too.
    no_suite = "--no-suite" in args
    suite = r.get("suite_cmd")
    suite_src = "manifest suite_cmd"
    if not suite:
        suite, suite_src = detect_repo_check(wt)
    if suite:
        # gate ROUTING: same suite, possibly run on the Hetzner box (per-repo manifest gate block) so
        # the Mac never compiles. Default = local, unchanged. A config error ABORTS (never silent-local).
        exec_cmd, gate_label, gate_err = _gate_exec_plan(r, wt, suite, "--local-gate" in args)
        if gate_err:
            journal_done(jid, "aborted:gate-config")
            print(f"[land] ABORT: gate misconfigured — {gate_err}\n"
                  f"  fix the manifest gate block, or `ratchet land --local-gate` to run locally this once."); return 2
        slot_lock = None
        gate_env = None
        if gate_label != "local":
            # FAIL CLOSED: the box MUST be reachable, else ERROR — never fall back to a local run that
            # re-melts the Mac. This preflight also cleanly separates 'infra down' from 'tests failed'.
            g = r["gate"]
            rc_pf, _, pf_err = run(["ssh", "-p", str(g.get("port", "22")), "-o", "ConnectTimeout=20",
                                    "-o", "BatchMode=yes", g["ssh"], "true"], timeout=30)
            if rc_pf != 0:
                journal_done(jid, "aborted:gate-unreachable")
                print(f"[land] ABORT: remote gate runner UNREACHABLE ({gate_label}): {pf_err or 'ssh failed'}\n"
                      f"  the gate did NOT run — the box may be down. Retry when it's up, or\n"
                      f"  `ratchet land --local-gate` to run the suite locally this once (logged)."); return 2
            # ONE source of truth for the box: the harness must target the SAME host we just preflighted.
            # Left to its own default it could point somewhere else entirely (or be redirected by a stray
            # RATCHET_GATE_* in a shell profile) while our preflight greened a different machine. Pin the
            # coords from the manifest, and STRIP every other RATCHET_GATE_* the harness reads (WARM,
            # SLOTS, RAM, VITEST_WORKERS, RUSTFLAGS, ...) so an inherited env var can't redirect where the
            # gate seeds/runs behind the preflight's back. A repo that needs a non-default is set it in the
            # manifest, not via ambient env.
            gate_env = {k: v for k, v in os.environ.items() if not k.startswith("RATCHET_GATE_")}
            gate_env["RATCHET_GATE_SSH"] = g["ssh"]
            gate_env["RATCHET_GATE_PORT"] = str(g.get("port", "22"))
            # serialize on the shared remote slot: a concurrent land on the same slot would sync over this
            # build mid-flight → a mixed tree that could false-green. Refuse rather than race. NOTE this is
            # only a fast LOCAL pre-check (it can't see lands from another machine or another RATCHET_HOME);
            # the authoritative lock is the flock the harness takes ON THE BOX, on the slot itself.
            slot_lock = _gate_slot_lock(g["slot"])
            if slot_lock is None:
                journal_done(jid, "aborted:gate-slot-busy")
                print(f"[land] ABORT: remote gate slot '{g['slot']}' is BUSY — another land is using it.\n"
                      f"  concurrent lands can't share a slot safely. Retry when it frees, give this repo its\n"
                      f"  own slot in the manifest, or `ratchet land --local-gate` this once."); return 2
            # Print what we ACTUALLY execute, not suite_cmd. On the remote path the command comes from the
            # gate block and may legitimately differ from suite_cmd (wcore: `cargo test` locally vs `nextest
            # run` on the box). Printing suite_cmd while running something else would make the gate's own
            # output lie about what it verified — the one thing a gate may never do.
            print(f"[land] 2/4 full suite (remote {gate_label}): {r['gate']['command']}")
        else:
            print(f"[land] 2/4 full suite ({suite_src}): {suite}")
        # stream the suite live AND keep a rolling ~2KB tail: on failure the tail lands in the
        # card's recording dir (redacted, like every recorder write), so the glass can show the
        # failing step's output without ever re-running anything. Cost: the suite sees a pipe,
        # not a tty — plain output, no capture loss.
        sys.stdout.flush()
        proc = subprocess.Popen(exec_cmd, cwd=wt, env=gate_env,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        tail = b""
        for chunk in iter(proc.stdout.readline, b""):
            sys.stdout.buffer.write(chunk)
            sys.stdout.buffer.flush()
            tail = (tail + chunk)[-2048:]
        rc = proc.wait()
        if slot_lock is not None:
            slot_lock.close()  # release the shared remote slot for the next land (pass OR fail)
        if rc != 0:
            telemetry_log({"event": "land_suite_fail", "repo": name, "branch": branch,
                           "work_id": card["work_id"] if card else None})
            if card:
                d = os.path.join(WL_HOME, "state", "recordings", card["work_id"])
                os.makedirs(d, exist_ok=True)
                open(os.path.join(d, "suite-tail.txt"), "w").write(redact(tail.decode(errors="replace")))
                record(card["work_id"], {"event": "land_suite_fail", "exit": rc, "tail": "suite-tail.txt"})
            journal_done(jid, "aborted:suite")
            print(f"[land] ABORT: suite FAILED (exit {rc}) — fix the cause, not the gate"); return 2
        print("[land] 2/4 suite green")
        journal_step(jid, "suite")
    elif no_suite:
        telemetry_log({"event": "land_suite_skipped", "repo": name, "branch": branch,
                       "work_id": card["work_id"] if card else None})
        print("[land] 2/4 suite SKIPPED by --no-suite (logged — no check ran; record why in the PR)")
        journal_step(jid, "suite:skipped")  # the stepper never claims a station that didn't run
    else:
        journal_done(jid, "aborted:no-suite")
        print("[land] ABORT: no suite_cmd in the manifest and no repo check auto-detected\n"
              "  (looked for check-all.sh, preflight, npm/bun test, cargo test, pytest, make check/test).\n"
              "  A silent skip must never read as a pass. Fix by ONE of:\n"
              "    · set suite_cmd in the manifest for this repo, or\n"
              "    · add one of those checks to the repo, or\n"
              "    · re-run with --no-suite to skip ON THE RECORD (logged; note why in the PR).")
        return 2
    # 2.5 regression corpus — every card is a bug that escaped ONCE; it never escapes twice
    crc = corpus_run(name, wt)
    if crc != 0:
        telemetry_log({"event": "land_corpus_fail", "repo": name, "branch": branch,
                       "work_id": card["work_id"] if card else None})
        journal_done(jid, "aborted:corpus")
        print("[land] ABORT: regression corpus FAILED — a previously-escaped bug is BACK"); return 2
    # 3. adversarial review — a gate that merely PRINTS is a false-green (council catch).
    # Pass exactly one of: --no-fuse (logged skip) or --fuse-done (logged claim, diff-hashed).
    fuse_done = "--fuse-done" in args
    rc, diffstat, _ = git(wt, "diff", f"{r['fetch_remote']}/{r['mainline']}...HEAD", "--stat")
    import hashlib
    rc, fulldiff, _ = git(wt, "diff", f"{r['fetch_remote']}/{r['mainline']}...HEAD")
    diff_hash = hashlib.sha1(fulldiff.encode()).hexdigest()[:12]
    if no_fuse:
        telemetry_log({"event": "land_fuse_skipped", "repo": name, "branch": branch, "diff": diff_hash})
        print(f"[land] 3/4 fuse review SKIPPED by flag (diff {diff_hash} — logged; record why in the PR)")
        journal_step(jid, "review:skipped")  # honest stepper: a skip is a skip, never "review"
    elif fuse_done:
        telemetry_log({"event": "land_fuse_claimed", "repo": name, "branch": branch, "diff": diff_hash})
        print(f"[land] 3/4 fuse review claimed done for diff {diff_hash} (logged)")
        journal_step(jid, "review")
    else:
        journal_done(jid, "aborted:review")
        print(f"[land] ABORT: adversarial review is REQUIRED and not confirmed.\n{diffstat}\n"
              f"  review this diff (ratchet fuse), then re-run with --fuse-done — or --no-fuse to skip on the record.")
        return 2
    # 4. push + PR (merge stays behind branch protection — the REAL enforcer)
    return _land_window(m, args, wt, name, r, branch, card, no_fuse, do_merge, diff_hash, jid)

def _land_window(m, args, wt, name, r, branch, card, no_fuse, do_merge, diff_hash, jid):
    if card:
        record(card["work_id"], {"event": "land_gate", "repo": name, "branch": branch,
                                 "diff": diff_hash, "fuse": "skipped" if no_fuse else "done"})
        # diff facts — files touched, +/- counts, commit subjects — captured NOW, with git run
        # in the worktree AT LAND TIME. Worktrees get GC'd after merge; the glass renders these
        # from the recording and never runs git on page view.
        rc_ns, numstat, ns_err = git(wt, "diff", "--numstat", f"{r['fetch_remote']}/{r['mainline']}...HEAD")
        rc_sj, subj, sj_err = git(wt, "log", "--format=%s", f"{r['fetch_remote']}/{r['mainline']}..HEAD")
        if rc_ns == 0 and rc_sj == 0:
            files, plus, minus = [], 0, 0
            for ln in numstat.splitlines():
                parts = ln.split("\t")
                if len(parts) == 3:
                    plus += int(parts[0]) if parts[0].isdigit() else 0   # binary files numstat as '-'
                    minus += int(parts[1]) if parts[1].isdigit() else 0
                    files.append(parts[2])
            record(card["work_id"], {"event": "diff_facts", "files": files[:200], "n_files": len(files),
                                     "plus": plus, "minus": minus, "subjects": subj.splitlines()[:50]})
        else:
            # a failed git read must not fossilize as plus=0/minus=0 "facts" — mark it broken
            record(card["work_id"], {"event": "diff_facts",
                                     "error": (ns_err or sj_err or "git diff/log failed")[:200]})
    # --force-with-lease: a crash after a prior push leaves a stale remote branch; the re-run
    # rebases anew and must replace OUR OWN remote ref safely (audit: blind re-run wedged non-FF)
    rc, _, err = git(wt, "push", "-u", "--force-with-lease", r["push_remote"], branch, timeout=180)
    if rc != 0:
        journal_done(jid, "aborted:push")
        print(f"[land] ABORT: push to {r['push_remote']} failed: {err}"); return 2
    journal_step(jid, "pushed")
    print(f"[land] 4/4 pushed {branch} → {r['push_remote']}")
    rc, out, err = run(["gh", "pr", "create", "-R", pr_repo(r), "--fill", "--head", branch], cwd=wt, timeout=60)
    if rc != 0 and "already exists" not in (out + err):
        # a failed PR create must NOT close the card or claim gate-pass (council false-green catch)
        telemetry_log({"event": "land_pr_fail", "repo": name, "branch": branch})
        journal_done(jid, "aborted:pr-create")
        print(f"[land] ABORT: PR creation failed — {(err or out)[:200]}\n  branch is pushed; fix gh/auth and re-run.")
        return 2
    journal_step(jid, "pr")
    print(out or err)
    if do_merge:
        rc, out, err = run(["gh", "pr", "merge", "-R", pr_repo(r), "--squash", "--auto", branch], cwd=wt, timeout=60)
        if rc != 0:
            print(f"[land] WARN: auto-merge arming failed ({(err or out)[:120]}) — PR exists; arm it manually")
        else:
            print(out or "auto-merge armed (merges when required checks pass)")
    if card:
        card_close(wt, "landed", statuses=("open", "landing"))  # close THIS worktree's card only — not every repo sharing the work_id
        record(card["work_id"], {"event": "land_pass", "repo": name, "branch": branch})
    journal_done(jid)
    telemetry_log({"event": "land_gate_pass", "repo": name, "branch": branch,
                   "work_id": card["work_id"] if card else None, "risk": card["risk"] if card else None})
    print("[land] gate complete — merge authority is branch protection + required checks.")
    return 0

def gc(m, args):
    apply = "--apply" in args
    archive = expand(m.get("archive_dir", "~/dev/.wl-archive"))
    rc_all = 0
    for name, r in m["repos"].items():
        path = expand(r["path"])
        rc, out, _ = git(path, "worktree", "list", "--porcelain")
        if rc != 0:
            continue
        wts, cur = [], {}
        for line in out.splitlines():
            if line.startswith("worktree "):
                cur = {"path": line.split(" ", 1)[1]}
                wts.append(cur)
            elif line.startswith("branch "):
                # strip ONLY refs/heads/ — split('/')[-1] turned feat/foo into foo (wrong PR checked,
                # wrong branch deleted — council catch)
                cur["branch"] = line.split(" ", 1)[1].removeprefix("refs/heads/")
        canonical = os.path.realpath(path)
        for w in wts:
            if os.path.realpath(w["path"]) == canonical or "branch" not in w:
                continue
            br = w["branch"]
            # GitHub-truth: EXPLICIT per-branch merged check (v1.1 — never heuristics)
            rc, oid, _ = run(["gh", "pr", "list", "-R", pr_repo(r), "--head", br, "--state", "merged",
                              "--json", "headRefOid", "--jq", ".[0].headRefOid // empty"], cwd=path, timeout=30)
            merged = rc == 0 and bool(oid.strip())
            if not merged:
                print(f"[{name}] KEEP  {w['path']} ({br}) — no confirmed-merged PR on GitHub")
                continue
            # TOCTOU (audit catch): commits added AFTER the merged PR's head are NOT covered by
            # the merge — deleting the branch would destroy them.
            rc2, local_head, _ = git(path, "rev-parse", br)
            if rc2 == 0 and local_head.strip() != oid.strip():
                print(f"[{name}] KEEP  {w['path']} ({br}) — local commits past the merged PR head; not covered by the merge")
                continue
            if not apply:
                print(f"[{name}] WOULD REMOVE {w['path']} ({br}) — PR confirmed merged  (run with --apply)")
                continue
            os.makedirs(archive, exist_ok=True)
            bundle = os.path.join(archive, f"{name}-{br.replace('/', '_')}-{int(time.time())}.bundle")
            rc_b, _, berr = git(path, "bundle", "create", bundle, br, timeout=120)  # archive-before-delete, always
            if rc_b != 0:
                print(f"[{name}] SKIP  {w['path']}: archive bundle FAILED ({berr[:80]}) — nothing deleted"); rc_all = 1; continue
            rc, _, err = git(path, "worktree", "remove", w["path"])
            if rc != 0:
                print(f"[{name}] worktree remove failed ({err}) — dirty? resolve by hand"); rc_all = 1; continue
            git(path, "branch", "-D", br)
            print(f"[{name}] removed {w['path']} + branch {br} (bundle: {bundle})")
    return rc_all

def pr_repo(r):
    url = r["remotes"][r["push_remote"]]
    return re.sub(r"\.git$", "", url.split("github.com/")[-1])

# ---------- state files (flock'd, atomic) ----------

# Set by glass_serve for the life of the serving process: a PAGE VIEW must never mutate state
# (§9) — not even quarantining a corrupt file — and must never sys.exit (under the threaded
# server a handler thread's SystemExit dies SILENTLY: every request gets an empty reply and
# zero diagnostics). In glass mode loaders RAISE; the handler renders the message as a 500.
GLASS_RO = False

def state_path(name):
    return os.path.join(WL_HOME, "state", name)

KNOWN_STATE_VER = 1  # bump ONLY with a migration step below; readers stay .get-tolerant

# STATE_MIGRATIONS[n] upgrades a state dict from schema n-1 to n. Bumping KNOWN_STATE_VER
# without adding the step is a selftest failure — stamping without migrating was the audit's
# data-loss finding, so the chain is enforced structurally.
STATE_MIGRATIONS = {}

def state_migrate(cur):
    v = cur.get("schema_version") or 1
    while v < KNOWN_STATE_VER:
        v += 1
        fn = STATE_MIGRATIONS.get(v)
        if fn is None:
            sys.exit(f"ratchet: no migration step to schema v{v} — KNOWN_STATE_VER was bumped "
                     f"without its migration; refusing to stamp blindly")
        fn(cur)
        cur["schema_version"] = v
    cur["schema_version"] = v  # an unversioned file at effective v1 still gets its stamp
    return cur

def state_load(name, default):
    p = state_path(name)
    try:
        data = json.load(open(p))
        if isinstance(data, dict):
            v = data.get("schema_version")
            if isinstance(v, int) and v > KNOWN_STATE_VER:
                sys.exit(f"ratchet: state file {name} is schema v{v} — NEWER than this kernel understands "
                         f"(v{KNOWN_STATE_VER}). Upgrade ratchet; never downgrade state.")
        return data
    except FileNotFoundError:
        return default
    except (OSError, json.JSONDecodeError) as e:
        # CORRUPT ≠ MISSING: silently defaulting would let the next write DESTROY all prior
        # state (council data-loss catch). Back up the sick file and stop loud.
        if GLASS_RO:  # even the quarantine rename is a WRITE — a page view gets neither
            raise RuntimeError(f"state file {name} is CORRUPT ({e}) — run any ratchet verb "
                               f"in a terminal to quarantine it") from None
        backup = f"{p}.corrupt-{int(time.time())}"
        try:
            os.replace(p, backup)
        except OSError:
            pass
        sys.exit(f"ratchet: state file {name} is CORRUPT ({e}) — moved to {backup}; "
                 f"repair or delete it consciously, never silently")

def state_save(name, value):
    """flock'd read-modify-write is the caller's job via state_mutate; this is the atomic write."""
    p = state_path(name)
    os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = f"{p}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        json.dump(value, fh, indent=1)
        fh.flush()
        os.fsync(fh.fileno())  # power loss inside the rename window must not lose acked state (audit catch)
    os.replace(tmp, p)
    # os.replace is not crash-durable until the PARENT DIR entry is fsync'd — without this the
    # 'no lost acked state' claim above overstates (a power loss just after replace can revert the
    # directory entry to the prior inode). Best-effort; some platforms reject a dir fsync.
    try:
        dfd = os.open(os.path.dirname(p) or ".", os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)
    except OSError:
        pass

def state_mutate(name, default, fn):
    """Exclusive-locked read→mutate→write so parallel lanes can't clobber each other."""
    import fcntl
    os.makedirs(os.path.join(WL_HOME, "state"), exist_ok=True)
    lockf = open(state_path(name) + ".lock", "w")
    fcntl.flock(lockf, fcntl.LOCK_EX)
    try:
        cur = state_load(name, default)
        # MIGRATE FIRST, then mutate: fn is written against the CURRENT schema, so the loaded dict
        # must be brought to the current schema BEFORE the caller touches it. Running the migration
        # AFTER fn lets the migration overwrite fn's output → silent data-loss on the first real
        # schema bump (audit catch). Stepwise chain, never a blind stamp; first migration ledgered.
        if isinstance(cur, dict) and cur.get("schema_version") != KNOWN_STATE_VER:
            was = cur.get("schema_version")
            state_migrate(cur)
            if was is None and name != "config-witness.json":
                telemetry_log({"event": "state_migrated", "file": name, "to": KNOWN_STATE_VER})
        out = fn(cur)
        state_save(name, cur)
        return out
    finally:
        lockf.close()

def now_iso():
    return time.strftime("%Y-%m-%dT%H:%M:%S")

# TRUST MODEL (security-council ruling, documented so it can't erode by accident):
#  · the MANIFEST is the trusted root — it defines what exists and what gets enforced; whoever
#    can rewrite it owns the control plane (same standing as ~/.gitconfig). suite_cmd/repro_cmd/
#    scenario cmd are the owner's OWN shell commands and run via bash by design.
#  · the COMPANIONS (ratchet-exec / ratchet-think) are first-party code in this trust domain.
#  · the SPAWNED AGENT is the untrusted party: separate process, allowlisted env (no secrets),
#    writable only in its worktree, and it can never land — only deliver through the gate.
# Every ref that reaches the filesystem passes safe_ref() so an operator typo or a poisoned
# card id can't traverse out of the state tree.

REF_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")

def safe_ref(x):
    """A work_id / candidate / recording ref that is safe to join into a path. Rejects empties,
    traversal ('..'), slashes, and leading dots. Returns the ref or None."""
    x = str(x)
    if x == ".." or "/" in x or "\\" in x or "\x00" in x or ".." in x:
        return None
    return x if REF_RE.fullmatch(x) else None

# env the spawned agent / automated corpus+train commands are allowed to SEE. Everything else —
# especially GH_TOKEN, *_API_KEY, AWS_*, FLUX_* — is stripped, so an untrusted or prompt-injected
# agent has no secret to exfiltrate (security-council CRITICAL: blocklist missed most tokens).
ENV_ALLOW = ("PATH", "HOME", "USER", "LANG", "LC_ALL", "LC_CTYPE", "TZ", "TERM", "TMPDIR",
             "SHELL", "PWD", "PYTHONPATH", "NODE_PATH")

def clean_env(extra=None):
    base = {k: os.environ[k] for k in ENV_ALLOW if k in os.environ}
    # deliberately DO NOT inherit RATCHET_HOME / RATCHET_MANIFEST / WL_* — a spawned agent has no
    # business knowing where kernel state lives (security-council: don't hand it a signpost to the
    # cards/ledger it could scribble on; it can't LAND anyway, and land re-validates everything).
    # The identity vars it DOES need (RATCHET_CARD/WORKTREE/AGENT) come explicitly via `extra`.
    base.update(extra or {})
    return base

# ---------- E0: config — kernel-owned, loaded ONCE into memory, read-only ----------
# Enforcement model (§8.4): hash-witnessing is tamper-EVIDENCE; the actual enforcement is that
# the kernel reads config exactly once per process and companions' runtime overrides are ignored
# by construction. Unknown keys REFUSE — a typo'd budget key that silently no-ops is how caps die.

CONFIG_FILE = "config.json"
CONFIG_SCHEMA_VER = 1

def config_defaults():
    """Krug defaults: zero required config; the safe path is the easy path (premium off)."""
    return {
        "schema_version": CONFIG_SCHEMA_VER,
        "premium_policy": "never",  # never | judge-only | allowed — the frontier-spend kill-switch
        "budgets": {"per_day_usd": 5.0, "per_card_reserve_usd": 0.50, "per_lane_ceiling_usd": 2.0},
        "rosters": {"default": ["glm", "deepseek", "kimi", "minimax", "qwen"], "judge": ["codex"]},
        "models": {  # roster name → provider model alias (flux:* = FluxRouter; cli:* = local CLI)
            "glm": "flux:flux-pinned-glm-5-2", "deepseek": "flux:flux-pinned-deepseek-v4-pro",
            "kimi": "flux:flux-pinned-kimi-k2-7-code-highspeed", "minimax": "flux:flux-pinned-minimax-m3",
            "qwen": "flux:flux-pinned-qwen3-coder-plus", "codex": "cli:codex", "gemini": "cli:gemini"},
        "deny_list": [],
        "council": {"max_latency_s": 120, "brief_max_tokens": 8000, "max_tokens": 12000},
        "inbox": {"stale_hours": 24},  # SLA: items older than this render STALE and sort first
        "contract_hosts": [],  # extra hosts a contract callback may send a token to (private catalogs)
    }

_CONFIG = None

def _refuse(msg):
    """Loud stop. On a glass page view (GLASS_RO) sys.exit would raise SystemExit inside a
    handler thread and die SILENTLY — every request gets an empty reply. There the loader
    raises instead and the handler renders an honest 500 (§9: views mutate nothing, hide nothing)."""
    if GLASS_RO:
        raise RuntimeError(msg)
    sys.exit(msg)

def config_load():
    """Effective config: defaults overlaid by config.json. Returns (read-only cfg, source-map,
    file-hash). Loud refusal on unknown keys, invalid JSON, or a newer schema."""
    global _CONFIG
    if _CONFIG is not None:
        return (json.loads(_CONFIG[0]), _CONFIG[1], _CONFIG[2])
    import hashlib
    cfg = config_defaults()
    src = {k: "default" for k in cfg}
    digest = None
    p = state_path(CONFIG_FILE)
    try:
        raw = open(p, "rb").read()
    except FileNotFoundError:
        raw = None
    if raw is not None:
        try:
            user = json.loads(raw)
        except json.JSONDecodeError as e:
            _refuse(f"ratchet: {CONFIG_FILE} is INVALID JSON ({e}) — fix it; the kernel never guesses at policy")
        if not isinstance(user, dict):
            _refuse(f"ratchet: {CONFIG_FILE} must be a JSON object")
        v = user.get("schema_version", 1)
        if isinstance(v, int) and v > CONFIG_SCHEMA_VER:
            _refuse(f"ratchet: config schema_version {v} is NEWER than this kernel ({CONFIG_SCHEMA_VER}) — "
                     f"upgrade ratchet; never downgrade config")
        unknown = sorted(set(user) - set(cfg))
        if unknown:
            _refuse(f"ratchet: config has UNKNOWN key(s) {unknown} — refusing to load "
                     f"(a typo'd key silently ignored is how a budget cap stops applying)")
        for k, val in user.items():
            if k != "schema_version":
                cfg[k] = val
                src[k] = "file"
        digest = hashlib.sha256(raw).hexdigest()  # full sha256: truncation invited collisions (audit)
        def witness(cur):
            if cur.get("hash") != digest:  # config changes are EVENTS, on the record
                telemetry_log({"event": "config_changed", "hash": digest[:16], "prev": (cur.get("hash") or "")[:16]})
                cur["hash"] = digest
                cur["ts"] = now_iso()
        if not GLASS_RO:  # witnessing writes state + appends to the ledger — never from a page view (§9)
            state_mutate("config-witness.json", {"schema_version": 1}, witness)
    # DEEP freeze (audit catch: MappingProxyType only froze the outer dict — nested budgets
    # stayed mutable shared state). Canonical JSON is the cache; every caller gets a fresh
    # copy, so no caller can mutate another's view. Also removes any thread-race concern.
    _CONFIG = (json.dumps(cfg), src, digest)
    return (json.loads(_CONFIG[0]), _CONFIG[1], _CONFIG[2])

def config_cmd(m, args):
    """ratchet config — effective values + where each came from. Read path only; the write
    path (config set → gated diff) is an E2 verb per COCKPIT-SPEC v2.1."""
    cfg, src, digest = config_load()
    if "--json" in args:
        print(json.dumps(dict(cfg), indent=1))
        return 0
    where = f"sha1 {digest}" if digest else "absent — pure defaults"
    print(f"config: {state_path(CONFIG_FILE)} ({where})")
    for k in sorted(cfg):
        if k == "schema_version":
            continue
        print(f"  {k:16} [{src[k]:7}] {json.dumps(cfg[k])}")
    print("  write path: edit the file for now — ratchet config set (gated) lands in E2")
    return 0

# ---------- E0: flight recorder — redaction BEFORE capture, always ----------

REDACT_RES = [
    (re.compile(r"sk-[A-Za-z0-9_-]{16,}"), "[REDACTED:key]"),          # covers sk-ant-/sk-proj- too
    (re.compile(r"ghp_[A-Za-z0-9]{20,}"), "[REDACTED:gh-token]"),
    (re.compile(r"github_pat_[A-Za-z0-9_]{20,}"), "[REDACTED:gh-pat]"),
    (re.compile(r"gh[ousr]_[A-Za-z0-9]{20,}"), "[REDACTED:gh-token]"),
    (re.compile(r"glpat-[A-Za-z0-9_-]{16,}"), "[REDACTED:gitlab]"),
    (re.compile(r"npm_[A-Za-z0-9]{30,}"), "[REDACTED:npm]"),
    (re.compile(r"xox[abprs]-[A-Za-z0-9-]{10,}"), "[REDACTED:slack]"),
    (re.compile(r"AKIA[0-9A-Z]{16}"), "[REDACTED:aws]"),
    (re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\b"), "[REDACTED:jwt]"),
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----"), "[REDACTED:pem]"),
    (re.compile(r"(?i)\b(api[_-]?key|access[_-]?token|auth[_-]?token|client[_-]?secret|secret|password|passwd|credential)s?\b(\s*[:=]+\s*['\"]?)[^\s'\"]{6,}"), r"\1\2[REDACTED]"),
    (re.compile(r"(?i)\b(authorization)\b(\s*[:=]\s*)(bearer\s+|basic\s+)?\S{8,}"), r"\1\2[REDACTED]"),
    (re.compile(r"(?i)([?&](token|key|secret|password|sig)=)[^&\s]{6,}"), r"\1[REDACTED]"),
]

def redact(x):
    """Recursively scrub secrets from any JSON-shaped value — INCLUDING dict keys and non-list
    containers (audit NO-GO catch: a secret used as a KEY sailed through). Runs on EVERY
    recorder write; raw streams never touch disk unscanned (E0 invariant). Known residual:
    secrets deliberately split across elements defeat regex scanning — gitleaks (if installed)
    runs as the deeper second pass at the hooks layer; this layer is the always-on floor."""
    if isinstance(x, str):
        for rx, rep in REDACT_RES:
            x = rx.sub(rep, x)
        return x
    if isinstance(x, dict):
        return {redact(k) if isinstance(k, str) else k: redact(v) for k, v in x.items()}
    if isinstance(x, (list, tuple, set)):
        return [redact(v) for v in x]
    return x

def record(card_id, event):
    """Per-card append-only flight recording (state/recordings/<work_id>/events.jsonl)."""
    import fcntl
    d = os.path.join(WL_HOME, "state", "recordings", str(card_id))
    os.makedirs(d, exist_ok=True)
    ev = {"ts": now_iso(),
          "agent": os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE", "unattributed"),
          **redact(event)}
    line = json.dumps(ev, default=str) + "\n"  # serialize BEFORE taking the lock (audit catch)
    with open(os.path.join(d, "events.jsonl"), "a") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.write(line)

# ---------- E0: sentinel crash journals — multi-step verbs leave resume breadcrumbs ----------
# The journal wraps the EXTERNALLY-MUTATING window of a verb (push→PR→close for land; the
# scenario→ledger window for train; bundle→record for cut). A run that ends without done=True
# and whose pid is dead = a crash mid-window; reconcile surfaces it. Clean aborts mark done
# with an outcome so they never masquerade as crashes.

JOURNAL = "journals.json"

def pid_start(pid):
    """Process start time via ps — the anti-PID-REUSE binding (audit catch: os.kill(pid,0)
    alone says 'a process exists', not 'THE process exists'). Empty string = unknowable."""
    rc, out, _ = run(["ps", "-o", "lstart=", "-p", str(pid)], timeout=10)
    return out.strip() if rc == 0 else ""

def pid_is_claimant(pid, recorded_start):
    """True only if pid is alive AND is the SAME process that made the claim. Tolerant of a
    poisoned pid (journals.json is agent-writable): a non-int or out-of-range pid is not a
    live claimant, it is garbage — return False, never raise into watch/inbox/glass."""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    try:
        os.kill(pid, 0)
    except (OSError, OverflowError):
        return False
    if not recorded_start:
        return True  # no binding recorded — conservative: treat alive as alive
    return pid_start(pid) == recorded_start

def journal_begin(verb, ref):
    import hashlib
    run_id = hashlib.sha1(f"{verb}:{ref}:{os.getpid()}:{time.time()}".encode()).hexdigest()[:10]
    def fn(cur):
        cur.setdefault("runs", []).append({"run_id": run_id, "verb": verb, "ref": str(ref),
                                           "pid": os.getpid(), "pid_start": pid_start(os.getpid()),
                                           "started": now_iso(), "steps": [], "done": False})
    state_mutate(JOURNAL, {"schema_version": 1, "runs": []}, fn)
    return run_id

def journal_step(run_id, label):
    def fn(cur):
        for r in cur.get("runs", []):
            if r["run_id"] == run_id:
                r["steps"].append({"label": label, "ts": now_iso()})
    state_mutate(JOURNAL, {"schema_version": 1, "runs": []}, fn)

def canonicalize_verdict(obj):
    """E2 §8.5: DETERMINISTIC canonical form for council outputs, kernel-side. Structural
    disagreement is computed on THIS — never on text distance (models 'disagree' verbosely
    while agreeing substantively, and vice versa). Returns a stable, comparable dict."""
    if not isinstance(obj, dict):
        return {"verdict": "INVALID", "claims": []}
    v = str(obj.get("verdict", "")).upper().replace("_", "-").strip()
    if v not in ("GO", "FIX-FIRST", "NO-GO"):
        v = "INVALID"
    claims = []
    for f in obj.get("findings", obj.get("blocking", [])) or []:
        if not isinstance(f, dict):
            continue
        sev = str(f.get("severity", "")).upper()
        if sev not in ("BLOCKER", "MAJOR", "MINOR"):
            sev = "MINOR"
        ref = str(f.get("file", f.get("ref", ""))).strip().lower()
        claim = re.sub(r"\s+", " ", str(f.get("claim", f.get("summary", ""))).strip().lower())[:160]
        claims.append({"severity": sev, "ref": ref, "claim": claim})
    claims.sort(key=lambda c: ({"BLOCKER": 0, "MAJOR": 1, "MINOR": 2}[c["severity"]], c["ref"], c["claim"]))
    return {"verdict": v, "claims": claims}

def verdicts_disagree(a, b):
    """Structural disagreement between two CANONICALIZED verdicts: different verdict enum, or
    non-overlapping blocker refs (they see different showstoppers)."""
    if a["verdict"] != b["verdict"]:
        return True
    ba = {c["ref"] for c in a["claims"] if c["severity"] == "BLOCKER"}
    bb = {c["ref"] for c in b["claims"] if c["severity"] == "BLOCKER"}
    return bool(ba or bb) and not (ba & bb) and ba != bb

def journal_done(run_id, outcome="ok"):
    def fn(cur):
        runs = cur.get("runs", [])
        for r in runs:
            if r["run_id"] == run_id:
                r["done"] = True
                r["outcome"] = outcome
                r["ended"] = now_iso()
        done = [r for r in runs if r.get("done")]
        if len(done) > 200:  # bounded ledger: completed runs age out, open ones never do
            drop = {r["run_id"] for r in done[:-200]}
            cur["runs"] = [r for r in runs if r["run_id"] not in drop]
    state_mutate(JOURNAL, {"schema_version": 1, "runs": []}, fn)

def telemetry_log(event):
    """Append-only, HASH-CHAINED telemetry (E3): each entry carries h = sha256(prev_h + body).
    An audit trail an agent can edit is theater — the log is a ratchet too. Chain head lives
    in a sidecar updated under the SAME flock as the append, so entries can't interleave."""
    import fcntl, hashlib
    p = state_path("telemetry.jsonl")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    event = {"ts": now_iso(), "agent": os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE") or os.environ.get("WL_AGENT", "unattributed"), **event}
    with open(p, "a") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        head = ""
        try:
            head = open(p + ".head").read().strip()
        except OSError:
            pass
        body = json.dumps(event, default=str)
        h = hashlib.sha256((head + body).encode()).hexdigest()[:32]
        fh.write(json.dumps({**event, "h": h}, default=str) + "\n")
        fh.flush()
        os.fsync(fh.fileno())  # the ENTRY must be durable BEFORE the head advances — a crash between
        # the two leaves the head lagging, which chain_status treats as an incomplete write, not tamper
        with open(p + ".head.tmp", "w") as hf:
            hf.write(h)
            hf.flush()
            os.fsync(hf.fileno())
        os.replace(p + ".head.tmp", p + ".head")

def chain_status(path=None):
    """Verify a hash-chained telemetry ledger. Returns (verdict, detail, n, unchained) where
    verdict is 'empty' | 'ok' | 'tampered' | 'truncated'. THE shared implementation — chain_verify
    (kernel CLI) and ratchet-budget's money gate both consume this, so the anchor check can't drift.

    Anchor semantics (audit): the sidecar `.head` catches deletion of the NEWEST entries (a plain
    prefix still chains, so hashes alone can't). But it must NOT cry tamper on an INCOMPLETE last
    write — a crash between appending an entry and advancing the sidecar leaves the head lagging.
    So we accept the on-disk chain being a valid EXTENSION of the recorded head (anchor is one of
    the heads we computed while walking); only an anchor UNREACHABLE from the chain (newest entries
    removed, or a mid-chain edit) fails."""
    import hashlib
    p = path or state_path("telemetry.jsonl")
    try:
        lines = open(p).read().splitlines()
    except OSError:
        return ("empty", "no telemetry yet", 0, 0)
    head, unchained = "", 0
    heads_seen = {""}
    for i, ln in enumerate(lines, 1):
        try:
            e = json.loads(ln)
        except json.JSONDecodeError:
            return ("tampered", f"line {i} UNPARSEABLE — chain broken", len(lines), unchained)
        h = e.pop("h", None)
        if h is None:
            unchained += 1  # pre-E3 entries predate the chain — counted, not failed
            continue
        want = hashlib.sha256((head + json.dumps(e, default=str)).encode()).hexdigest()[:32]
        if h != want:
            return ("tampered",
                    f"line {i} BREAKS the chain (event '{e.get('event')}' @ {e.get('ts')}) — edited, removed-before, or reordered",
                    len(lines), unchained)
        head = h
        heads_seen.add(head)
    anchor = ""
    try:
        anchor = open(p + ".head").read().strip()
    except OSError:
        pass
    if anchor and anchor not in heads_seen:
        return ("truncated",
                f"recorded head {anchor[:12]} is unreachable from the chain (computed head {head[:12] or '(none)'}) — the newest entries were removed",
                len(lines), unchained)
    return ("ok", f"{len(lines)} entries ({unchained} pre-chain), head {head[:12] or 'empty'}", len(lines), unchained)

def chain_verify():
    """CLI: walk the telemetry chain and report. Tolerant of an incomplete last write; fails on a
    tampered entry or truncation of the newest entries. Persists its verdict to
    state/.cache/chain-verdict.json — the glass renders the LAST RUN's verdict with its age;
    it never walks the whole ledger on page view."""
    verdict, detail, n, _ = chain_status()
    cache_put("chain-verdict", {"ok": verdict in ("ok", "empty"), "verdict": verdict,
                                "detail": detail, "ts": now_iso(), "lines": n})
    if verdict == "empty":
        print("chain: no telemetry yet"); return 0
    if verdict == "ok":
        print(f"chain: intact — {detail}"); return 0
    if verdict == "truncated":
        print(f"chain: TRUNCATED — {detail}"); return 2
    print(f"chain: {detail} — the ledger has been TAMPERED with"); return 2

def spend_today():
    """Metered spend recorded today — WITHOUT re-reading a growing telemetry.jsonl from byte 0
    on every render (multi-MB and compounding daily). A byte-offset cursor
    (state/.cache/spend-cursor.json: {offset, day, day_sum}) scans only the bytes appended since
    the last call. Day rollover resets the sum but keeps the offset — every byte before it was
    written on a prior day. A cursor past EOF means the file was truncated or rotated: the cursor
    is a lie, full rescan. A torn tail line (writer mid-append) is left for the NEXT call — the
    offset only ever advances over complete lines, so no event is half-counted or skipped."""
    p = state_path("telemetry.jsonl")
    today = now_iso()[:10]
    cur = {"offset": 0, "day": today, "day_sum": 0.0}
    saved, _ = cache_get_stale("spend-cursor")
    if isinstance(saved, dict) and isinstance(saved.get("offset"), int) and saved["offset"] >= 0:
        cur["offset"] = saved["offset"]
        if saved.get("day") == today:
            try:
                cur["day_sum"] = float(saved.get("day_sum") or 0.0)
            except (TypeError, ValueError):
                pass
    try:
        size = os.path.getsize(p)
    except OSError:
        return 0.0  # no telemetry yet — nothing spent, no cursor to keep
    if cur["offset"] > size:
        cur = {"offset": 0, "day": today, "day_sum": 0.0}
    with open(p, "rb") as fh:
        fh.seek(cur["offset"])
        for ln in fh:
            if not ln.endswith(b"\n"):
                break  # incomplete last write — picked up whole next time
            cur["offset"] += len(ln)
            try:
                e = json.loads(ln)
                if str(e.get("ts", "")).startswith(today):
                    cur["day_sum"] += float(e.get("cost_usd") or 0)
            except (json.JSONDecodeError, TypeError, ValueError):
                continue
    cache_put("spend-cursor", cur)
    return cur["day_sum"]

# ---------- Wave A: work cards — the board of record for IN-FLIGHT work ----------

CARDS = "workcards.json"

def card_for_worktree(wt, statuses=("open",)):
    wt = os.path.realpath(wt)
    for c in state_load(CARDS, {"cards": []})["cards"]:
        if c["status"] in statuses and os.path.realpath(expand(c["worktree"])) == wt:
            return c
    return None

def take_bulk(m, args):
    """ratchet take --bulk <plan.json> — import a ratchet-think plan artifact as cards.
    Schema-invalid plans are refused WHOLE, never partially imported (§ boundary: a planner
    that hallucinates cards is not a planner — this validator is what makes that falsifiable)."""
    pos = [a for a in args if not a.startswith("-")]
    path = expand(pos[0]) if pos else ""
    if not path or not os.path.exists(path):
        print("usage: ratchet take --bulk <plan.json> (a ratchet-think plan artifact)"); return 1
    try:
        plan = json.load(open(path))
    except (OSError, json.JSONDecodeError) as e:
        print(f"take: plan artifact unreadable ({e})"); return 1
    cards = plan.get("cards")
    if not isinstance(cards, list) or not cards:
        print("take: plan has no cards[] — refusing"); return 1
    for i, c in enumerate(cards):
        missing = [k for k in ("slug", "repo", "title") if not (isinstance(c, dict) and c.get(k))]
        if missing:
            print(f"take: plan card {i} missing {missing} — refused whole, nothing imported"); return 1
        if c["repo"] not in m["repos"]:
            print(f"take: plan card {i} names unknown repo '{c['repo']}' — refused whole"); return 1
    made = []
    for c in cards:
        rc = take(m, [c["slug"], "--repo", c["repo"], "--title", c["title"]])
        if rc != 0:
            print(f"take --bulk: STOPPED at '{c['slug']}' (rc {rc}) — already open: {', '.join(made) or 'none'}")
            return rc
        made.append(c["slug"])
    telemetry_log({"event": "take_bulk", "plan": os.path.basename(path), "cards": made})
    print(f"take --bulk: {len(made)} card(s) opened from {os.path.basename(path)}")
    return 0

def take(m, args):
    """ratchet take <slug> --repo <r1[,r2]> [--issue <#/url>] [--title "..."] — the ONLY sanctioned
    way to start agent work. Card + reserved worktree(s) + work_id that ratchet land requires."""
    if "--bulk" in args:
        return take_bulk(m, [a for a in args if a != "--bulk"])
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet take <slug> --repo <repo[,repo]> [--issue <ref>] [--title <t>]"); return 1
    slug = pos[0]
    repos = []
    if "--repo" in args:
        repos = args[args.index("--repo") + 1].split(",")
    issue = args[args.index("--issue") + 1] if "--issue" in args else ""
    title = args[args.index("--title") + 1] if "--title" in args else slug
    if not repos:
        # don't-make-me-think: one governed repo means there's no ambiguity to resolve
        if len(m["repos"]) == 1:
            repos = list(m["repos"])
            print(f"take: --repo not given; the only governed repo is '{repos[0]}' — using it")
        else:
            print(f"take: which repo? --repo <{ '|'.join(m['repos']) }>"); return 1
    for rn in repos:
        if rn not in m["repos"]:
            print(f"take: unknown repo '{rn}'"); return 1
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{1,40}", slug):
        print("take: slug must be kebab-case"); return 1
    import hashlib
    work_id = hashlib.sha1(f"{slug}:{','.join(sorted(repos))}".encode()).hexdigest()[:10]
    # risk tier: touching pinned/contracted repos or >1 repo = high (drives fuse depth later)
    risk = "high" if len(repos) > 1 or any(m["repos"][rn].get("pin") or m["repos"][rn].get("contract") for rn in repos) else "normal"

    # SINGLE locked transaction reserves PENDING cards (dup-check + insert together) — a split
    # check/commit let two lanes both pass the dup check (council race catch).
    agent = os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE") or os.environ.get("WL_AGENT", "unattributed")
    def reserve(cur):
        for c in cur["cards"]:
            if c["status"] in ("open", "pending") and c["work_id"] == work_id:
                hint = " — crashed take? ratchet reconcile --reap recovers" if c["status"] == "pending" else ""
                return f"take: work_id {work_id} already {c['status']} ({c['worktree']}){hint}"
        for rn in repos:
            r = m["repos"][rn]
            cur["cards"].append({
                "work_id": work_id, "slug": slug, "title": title, "repo": rn, "issue": issue,
                "risk": risk, "status": "pending", "created": now_iso(), "agent": agent,
                "worktree": os.path.join(r["worktree_root"], f"wt-{slug}")})
        return None
    dup = state_mutate(CARDS, {"cards": []}, reserve)
    if dup:
        print(dup); return 1

    made = []
    for rn in repos:
        rc = work(m, [rn, slug])
        if rc != 0:
            print(f"take: worktree reservation failed for {rn} — rolling back"); break
        made.append(rn)
    if len(made) != len(repos):
        for rn in made:  # roll back partial reservations
            r = m["repos"][rn]
            wt = os.path.join(expand(r["worktree_root"]), f"wt-{slug}")
            git(expand(r["path"]), "worktree", "remove", "--force", wt)
            git(expand(r["path"]), "branch", "-D", branch_for(slug))
        def unreserve(cur):
            cur["cards"] = [c for c in cur["cards"] if not (c["work_id"] == work_id and c["status"] == "pending")]
        state_mutate(CARDS, {"cards": []}, unreserve)
        return 1

    def finalize(cur):
        for c in cur["cards"]:
            if c["work_id"] == work_id and c["status"] == "pending":
                c["status"] = "open"
    state_mutate(CARDS, {"cards": []}, finalize)
    telemetry_log({"event": "take", "work_id": work_id, "repos": repos, "risk": risk})
    print(f"take: work_id {work_id} ({risk}) — card(s) open for {', '.join(repos)}")
    print(f"  land will require this card. Close it by landing, or ratchet reconcile if abandoned.")
    return 0

def card_close(work_id_or_wt, outcome, statuses=("open",)):
    def fn(cur):
        n = 0
        for c in cur["cards"]:
            if c["status"] in statuses and (c["work_id"] == work_id_or_wt or
                    os.path.realpath(expand(c["worktree"])) == os.path.realpath(str(work_id_or_wt))):
                c["status"] = outcome
                c["closed"] = now_iso()
                n += 1
        return n
    return state_mutate(CARDS, {"cards": []}, fn)

def reconcile(m, args):
    """Join card-world to worktree-reality. Orphan worktree (no card) / stale card (no worktree)
    are BOTH failure states after a crash. Report by default; --reap acts."""
    reap = "--reap" in args
    cards = state_load(CARDS, {"cards": []})["cards"]
    open_by_wt = {os.path.realpath(expand(c["worktree"])): c for c in cards if c["status"] in ("open", "pending", "landing")}
    problems = 0
    archive = expand(m.get("archive_dir", "~/dev/.wl-archive"))
    for name, r in m["repos"].items():
        path = expand(r["path"])
        rc, out, _ = git(path, "worktree", "list", "--porcelain")
        if rc != 0:
            continue
        live = set()
        for line in out.splitlines():
            if line.startswith("worktree "):
                wt = os.path.realpath(line.split(" ", 1)[1])
                if wt != os.path.realpath(path):
                    live.add(wt)
        root = os.path.realpath(expand(r["worktree_root"])) if os.path.exists(expand(r["worktree_root"])) else None
        for wt in sorted(live):
            if wt in open_by_wt:
                c = open_by_wt[wt]
                if c["status"] == "pending":
                    # crashed take: reserved but never finalized. The worktree EXISTS, so the
                    # reservation effectively succeeded — recovery is finalize, not delete
                    # (audit blocker: this card was unrecoverable by any verb).
                    problems += 1
                    if reap:
                        def fin(cur):
                            for cc in cur["cards"]:
                                if cc["work_id"] == c["work_id"] and cc["status"] == "pending":
                                    cc["status"] = "open"
                        state_mutate(CARDS, {"cards": []}, fin)
                        print(f"[{name}] RECOVERED stuck take {c['work_id']} ({c['slug']}) — pending card finalized to open")
                    else:
                        print(f"[{name}] STUCK  {wt} — card {c['work_id']} PENDING (crashed take? --reap finalizes to open)")
                    continue
                # liveness: last commit age in the worktree
                rc, age, _ = git(wt, "log", "-1", "--format=%ct")
                days = (time.time() - int(age)) / 86400 if rc == 0 and age else -1
                flag = f" ⚠ idle {days:.0f}d" if days > 3 else ""
                print(f"[{name}] OK    {wt} ← card {open_by_wt[wt]['work_id']} ({open_by_wt[wt]['agent']}){flag}")
            else:
                problems += 1
                if reap:
                    rc, br, _ = git(wt, "branch", "--show-current")
                    os.makedirs(archive, exist_ok=True)
                    stamp = int(time.time())
                    # DIRTY worktree = uncommitted/untracked work from a crashed lane — tar it
                    # BEFORE any removal; a bundle only saves commits (council data-loss catch).
                    rc_d, dirt, _ = git(wt, "status", "--porcelain")
                    if dirt:
                        tarball = os.path.join(archive, f"{name}-orphan-{os.path.basename(wt)}-{stamp}.tar.gz")
                        rc_t, _, terr = run(["tar", "-czf", tarball, "-C", os.path.dirname(wt),
                                             os.path.basename(wt)], timeout=300)
                        if rc_t != 0:
                            print(f"[{name}] SKIP reap of {wt}: dirty and tar-archive FAILED ({terr[:80]}) — nothing deleted")
                            continue
                        print(f"[{name}]   dirty worktree archived: {tarball}")
                    bundle = None
                    if br:
                        bundle = os.path.join(archive, f"{name}-orphan-{os.path.basename(wt)}-{stamp}.bundle")
                        rc_b, _, berr = git(path, "bundle", "create", bundle, br, timeout=120)
                        if rc_b != 0:
                            print(f"[{name}] SKIP reap of {wt}: bundle FAILED ({berr[:80]}) — nothing deleted")
                            continue
                    rc_w, _, werr = git(path, "worktree", "remove", "--force", wt)
                    if rc_w != 0:  # a swallowed failure here reported REAPED while the orphan lived on (audit catch)
                        print(f"[{name}] SKIP reap of {wt}: worktree remove FAILED ({werr[:80]}) — still live")
                        continue
                    if br:
                        git(path, "branch", "-D", br)
                    print(f"[{name}] REAPED orphan {wt} (bundle: {bundle or 'n/a — detached'})")
                else:
                    print(f"[{name}] ORPHAN {wt} — worktree with NO open card (crashed lane? --reap archives+removes)")
        for wt, c in list(open_by_wt.items()):
            if c["repo"] == name and wt not in live:
                problems += 1
                if reap:
                    card_close(c["work_id"], "abandoned", statuses=("open", "pending", "landing"))
                    print(f"[{name}] CLOSED stale card {c['work_id']} ({c['slug']}) — its worktree is gone")
                else:
                    print(f"[{name}] STALE  card {c['work_id']} ({c['slug']}) — worktree {wt} missing (--reap closes)")
    # E0: interrupted multi-step verbs — an undone journal with a DEAD pid = crash mid-window
    jr = state_load(JOURNAL, {"schema_version": 1, "runs": []})
    for rj in jr.get("runs", []):
        if rj.get("done"):
            continue
        if pid_is_claimant(rj.get("pid", 0), rj.get("pid_start", "")):
            continue  # THE claimant is alive — a run in progress, not a crash (pid-reuse-safe)
        problems += 1
        last = rj["steps"][-1]["label"] if rj["steps"] else "start"
        if reap:
            def closej(cur):
                for r2 in cur.get("runs", []):
                    if r2["run_id"] == rj["run_id"]:
                        r2["done"] = True
                        r2["outcome"] = "crashed:reaped"
            state_mutate(JOURNAL, {"schema_version": 1, "runs": []}, closej)
            print(f"[journal] CLOSED interrupted {rj['verb']} {rj['run_id']} (died after '{last}')")
        else:
            print(f"[journal] INTERRUPTED {rj['verb']} {rj['run_id']} — died after '{last}' ({rj['ref']}); "
                  f"re-run the verb to resume (--reap closes the record)")
    if problems == 0:
        print("reconcile: card-world matches worktree-reality")
    return 0 if (problems == 0 or reap) else 1

# ---------- protect: GitHub branch protection AS CODE (the un-bypassable enforcement layer) ----------

def protect_verify_one(m, name, r):
    """Compare live branch protection against the manifest. Returns (status, msg)."""
    prot = r.get("protection")
    if not prot:
        return SKIP, "no protection block in manifest"
    repo, branch = pr_repo(r), r["mainline"]
    # quote(): a slash-containing mainline (release/v1) silently broke the API path (audit catch)
    rc, out, err = run(["gh", "api", f"repos/{repo}/branches/{urllib.parse.quote(branch, safe='')}/protection"], timeout=30)
    if rc != 0:
        if "Branch not protected" in (out + err):
            return RED, f"{branch} is UNPROTECTED — anything can push straight to it (ratchet protect apply)"
        return UNKNOWN, f"cannot read protection (identity={effective_gh_login()}, repo needs {r['gh_login']}): {(err or out)[:100]}"
    try:
        live = json.loads(out)
    except json.JSONDecodeError:
        return UNKNOWN, "unparseable protection response"
    problems = []
    rsc = live.get("required_status_checks") or {}
    have = set(rsc.get("contexts") or [])
    want = set(prot["required_checks"])
    if not rsc:
        problems.append("NO required status checks")
    else:
        if want - have:
            problems.append(f"missing required checks: {sorted(want - have)}")
        if prot.get("strict", True) and not rsc.get("strict"):
            problems.append("strict (up-to-date branch) is OFF")
    if (live.get("allow_force_pushes") or {}).get("enabled"):
        problems.append("force-pushes ALLOWED")
    if (live.get("allow_deletions") or {}).get("enabled"):
        problems.append("branch deletion ALLOWED")
    if problems:
        return RED, "; ".join(problems)
    # check-name drift: every required check must still exist in recent CI reality
    ck = "checknames-" + repo.replace("/", "_")
    seen = cache_get(ck, 3600)
    if seen is None:
        rc, nums, _ = run(["gh", "pr", "list", "-R", repo, "--state", "merged", "-L", "1",
                           "--json", "number", "--jq", ".[0].number"], timeout=30)
        if rc == 0 and nums:
            rc2, names, _ = run(["gh", "pr", "view", nums, "-R", repo, "--json", "statusCheckRollup",
                                 "--jq", ".statusCheckRollup[].name"], timeout=30)
            if rc2 == 0:
                seen = names.splitlines()
                cache_put(ck, seen)
    if seen is not None:
        dead = [c for c in want if c not in seen]
        if dead:
            return WARN, f"protection matches manifest BUT check name(s) not seen in latest CI run: {dead} — renamed job would soft-disable the gate"
    return OK, f"{len(want)} required checks + strict + no force-push/deletion (live-verified)"

def protect_cmd(m, args):
    sub = next((a for a in args if not a.startswith("-")), "verify")
    targets = [a for a in args if not a.startswith("-") and a != sub]
    rc_all = 0
    for name, r in m["repos"].items():
        if targets and name not in targets:
            continue
        prot = r.get("protection")
        if not prot:
            print(f"[{name}] SKIP: no protection block in manifest"); continue
        if sub == "verify":
            st, msg = protect_verify_one(m, name, r)
            print(f"[{name}] {paint(st)} {msg}")
            rc_all = rc_all or (2 if st == RED else 0)
        elif sub == "apply":
            eff = effective_gh_login()
            if eff != r["gh_login"]:
                print(f"[{name}] REFUSE: effective identity '{eff}' ≠ '{r['gh_login']}' — gh auth switch --user {r['gh_login']} first"); rc_all = 2; continue
            repo, branch = pr_repo(r), r["mainline"]
            body = json.dumps({
                "required_status_checks": {"strict": bool(prot.get("strict", True)),
                                           "contexts": prot["required_checks"]},
                "enforce_admins": True,                # admins ARE the operators — bypass must be EXPLICIT (probe-proven 2026-07-07)
                "required_pull_request_reviews": None, # solo+agents: review = fuse + required checks
                "restrictions": None,
                "allow_force_pushes": False,
                "allow_deletions": False,
                "required_linear_history": True,
            })
            p = subprocess.run(["gh", "api", "-X", "PUT", f"repos/{repo}/branches/{urllib.parse.quote(branch, safe='')}/protection",
                                "--input", "-"], input=body, capture_output=True, text=True, timeout=45)
            if p.returncode != 0:
                print(f"[{name}] apply FAILED: {p.stderr.strip()[:200]}"); rc_all = 2; continue
            st, msg = protect_verify_one(m, name, r)
            print(f"[{name}] applied → verify: {paint(st)} {msg}")
            rc_all = rc_all or (2 if st == RED else 0)
        else:
            print(f"usage: ratchet protect [verify|apply] [repo...]"); return 1
    return rc_all

# ---------- Wave B: regression corpus — the system learns from every escaped bug ----------

CORPUS = "regression-corpus.json"

def corpus_run(repo_name, cwd):
    """Run every corpus card for this repo in the given tree. exit 0 = all pass."""
    cards = [c for c in state_load(CORPUS, {"cards": []})["cards"] if c["repo"] == repo_name]
    if not cards:
        print(f"[corpus] no regression cards for {repo_name}")
        return 0
    failed = []
    for c in cards:
        try:
            # scrubbed env (defense in depth): a corpus repro is a shell command but has no
            # business seeing GH_TOKEN / *_API_KEY / FLUX_* — strip them at the automated boundary
            rc = subprocess.call(["bash", "-lc", c["repro_cmd"]], cwd=cwd, env=clean_env(),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
        except subprocess.TimeoutExpired:
            rc = 124  # a hung repro must fail the gate, not hang the train (council catch)
        status = "pass" if rc == 0 else "FAIL"
        print(f"[corpus] {status}  {c['id']} — {c['title']}")
        if rc != 0:
            failed.append(c)
    if failed:
        for c in failed:
            print(f"[corpus]   repro: {c['repro_cmd']}")
        return 2
    print(f"[corpus] {len(cards)}/{len(cards)} regression cards green for {repo_name}")
    return 0

def bug(m, args):
    """wl bug add <repo> <title> --cmd '<repro exit-0-when-fixed>' [--source <issue/finding>]
       wl bug list [repo] · wl bug rm <id> --confirm (deletion is reviewed, not casual)"""
    sub = args[0] if args else "list"
    if sub == "add":
        if len(args) < 3 or "--cmd" not in args:
            print("usage: ratchet bug add <repo> <title> --cmd '<repro>' [--source <ref>]"); return 1
        repo_name, title = args[1], args[2]
        if repo_name not in m["repos"]:
            print(f"bug: unknown repo '{repo_name}'"); return 1
        cmd = args[args.index("--cmd") + 1]
        source = args[args.index("--source") + 1] if "--source" in args else ""
        import hashlib
        cid = hashlib.sha1(f"{repo_name}:{cmd}".encode()).hexdigest()[:8]
        # the card must PASS on the current (fixed) tree — a failing card would block every land
        try:
            rc = subprocess.call(["bash", "-lc", cmd], cwd=expand(m["repos"][repo_name]["path"]),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=600)
        except subprocess.TimeoutExpired:
            rc = 124  # a hung repro must fail ADD-time too, not hang the CLI (audit catch — corpus_run already had this)
        if rc != 0:
            print(f"bug: repro exits {rc} on the CURRENT tree — corpus cards must pass post-fix "
                  f"(exit 0 = fixed). Fix first or fix the repro."); return 1
        def add(cur):
            if any(c["id"] == cid for c in cur["cards"]):
                return "duplicate"
            cur["cards"].append({"id": cid, "repo": repo_name, "title": title, "repro_cmd": cmd,
                                 "source": source, "added": now_iso(),
                                 "agent": os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE", "unattributed")})
        if state_mutate(CORPUS, {"cards": []}, add) == "duplicate":
            print(f"bug: card {cid} already exists"); return 1
        telemetry_log({"event": "corpus_add", "repo": repo_name, "card": cid})
        print(f"bug: card {cid} added — every future land/train of {repo_name} must keep it green")
        return 0
    if sub == "list":
        want = args[1] if len(args) > 1 else None
        for c in state_load(CORPUS, {"cards": []})["cards"]:
            if want and c["repo"] != want:
                continue
            print(f"  {c['id']}  {c['repo']:8} {c['title']}  ({c['added'][:10]}{', ' + c['source'] if c['source'] else ''})")
        return 0
    if sub == "rm":
        if len(args) < 2 or "--confirm" not in args:
            print("bug rm requires the card id AND --confirm — corpus deletion is a reviewed act"); return 1
        cid = args[1]
        def rm(cur):
            before = len(cur["cards"])
            cur["cards"] = [c for c in cur["cards"] if c["id"] != cid]
            return before - len(cur["cards"])
        n = state_mutate(CORPUS, {"cards": []}, rm)
        telemetry_log({"event": "corpus_rm", "card": cid})
        print(f"bug: removed {n} card(s)"); return 0 if n else 1
    print("usage: ratchet bug add|list|rm"); return 1

def agents(m, args):
    """Per-agent scorecard from telemetry — who lands clean, who trips gates."""
    rows = {}
    try:
        for line in open(state_path("telemetry.jsonl")):
            try:
                e = json.loads(line)
            except json.JSONDecodeError:
                continue
            a = rows.setdefault(e.get("agent", "?"), {"take": 0, "landed": 0, "suite_fail": 0,
                                                      "corpus_fail": 0, "no_card": 0})
            ev = e.get("event", "")
            if ev == "take": a["take"] += 1
            elif ev == "land_gate_pass": a["landed"] += 1
            elif ev == "land_suite_fail": a["suite_fail"] += 1
            elif ev == "land_corpus_fail": a["corpus_fail"] += 1
            elif ev == "land_no_card": a["no_card"] += 1
    except OSError:
        print("agents: no telemetry yet"); return 0
    print(f"{'agent':16} {'taken':>6} {'landed':>7} {'suite✗':>7} {'corpus✗':>8} {'no-card':>8}")
    for a, s in sorted(rows.items(), key=lambda kv: -kv[1]["landed"]):
        print(f"{a:16} {s['take']:>6} {s['landed']:>7} {s['suite_fail']:>7} {s['corpus_fail']:>8} {s['no_card']:>8}")
    print("(gate-trip rates feed fuse review depth: high-trip agents earn deeper review)")
    return 0

# ---------- Wave C: wl train — the cross-repo integration gate ----------

TRAIN = "train-ledger.json"

def train(m, args):
    """Materialize ALL repos at fresh mainline refs (optionally substituting --repo/--branch for
    the change under test), run the manifest integration scenarios + regression corpus, record a
    content-addressed snapshot. Green snapshots are the only releasable unit."""
    driver = args[args.index("--repo") + 1] if "--repo" in args else None
    dbranch = args[args.index("--branch") + 1] if "--branch" in args else None
    if (driver is None) != (dbranch is None):
        print("train: --repo and --branch go together (substitute a change under test)"); return 1
    if driver is not None and driver not in m["repos"]:
        print(f"train: unknown driver repo '{driver}' — substitution would be silently skipped"); return 1
    scen = (m.get("integration") or {}).get("scenarios", [])
    if not scen:
        print("train: no integration scenarios in manifest"); return 1
    ws = tempfile.mkdtemp(prefix="wl-train-")
    refs, trees, failures = {}, {}, []
    jid = None
    try:
        for name, r in m["repos"].items():
            path = expand(r["path"])
            fetched, _, ferr = fetch_with_ttl(path, r["fetch_remote"], r["mainline"],
                                              m.get("fetch_ttl_seconds", 300))
            if not fetched:
                print(f"train: ABORT — cannot fetch {name} ({ferr}); a train on stale refs proves nothing"); return 2
            ref = dbranch if name == driver else f"{r['fetch_remote']}/{r['mainline']}"
            rc, sha, err = git(path, "rev-parse", "--verify", ref)
            if rc != 0:
                print(f"train: ABORT — ref '{ref}' not found in {name}: {err}"); return 2
            git(path, "worktree", "prune")  # clear stale mappings a killed prior train left behind (audit catch)
            wt = os.path.join(ws, name)
            rc, _, err = git(path, "worktree", "add", "--detach", wt, sha)
            if rc != 0:
                print(f"train: ABORT — cannot materialize {name}@{sha[:9]}: {err}"); return 2
            refs[name], trees[name] = sha, wt
        import hashlib
        snap_id = hashlib.sha1("|".join(f"{k}:{v}" for k, v in sorted(refs.items())).encode()).hexdigest()[:12]
        print(f"[train] snapshot {snap_id} — " + " ".join(f"{k}@{v[:9]}" for k, v in sorted(refs.items())))
        jid = journal_begin("train", snap_id)  # E0: the scenario→ledger window leaves breadcrumbs
        results = {}
        for s in scen:
            rname = s["repo"]
            if s.get("type") == "contract":
                st, msg, _ = check_contract(m, m["repos"][rname]) or (SKIP, "no contract", "")
                okv = st == OK
                results[s["name"]] = {"ok": okv, "detail": msg}
            else:
                print(f"[train] scenario {s['name']}: {s['cmd']}")
                try:
                    rc = subprocess.call(["bash", "-lc", s["cmd"]], cwd=trees[rname], timeout=900)
                    okv, detail = rc == 0, f"exit {rc}"
                except subprocess.TimeoutExpired:
                    okv, detail = False, "TIMEOUT 900s"  # a hung scenario is a red result, not a crash
                results[s["name"]] = {"ok": okv, "detail": detail}
            print(f"[train] {'PASS' if okv else 'FAIL'}  {s['name']} — {results[s['name']]['detail'][:110]}")
            if not okv:
                failures.append(s["name"])
        for name in m["repos"]:
            crc = corpus_run(name, trees[name])
            results[f"corpus-{name}"] = {"ok": crc == 0, "detail": "regression corpus"}
            if crc != 0:
                failures.append(f"corpus-{name}")
        green = not failures
        def rec(cur):
            cur["snapshots"] = [s for s in cur.get("snapshots", []) if s["id"] != snap_id]
            cur["snapshots"].append({"id": snap_id, "ts": now_iso(), "refs": refs, "green": green,
                                     "driver": f"{driver}@{dbranch}" if driver else "mainlines",
                                     "results": results})
        state_mutate(TRAIN, {"snapshots": []}, rec)
        journal_done(jid, "green" if green else "red")
        telemetry_log({"event": "train", "snapshot": snap_id, "green": green, "failures": failures})
        print(f"[train] snapshot {snap_id}: {'GREEN — releasable' if green else 'RED — ' + ', '.join(failures)}")
        return 0 if green else 2
    except BaseException:
        if jid:  # exception honesty: only a hard kill may leave done=False (audit catch)
            journal_done(jid, "exception")
        raise
    finally:
        for name, wt in trees.items():
            git(expand(m["repos"][name]["path"]), "worktree", "remove", "--force", wt)

# ---------- Wave C: release train — cut / promote / rollback on green snapshots only ----------

TRAINS = "release-trains.json"

def latest_green_snapshot(refs_now=None):
    # .get(): a snapshot from an older schema must not crash the reader (audit catch)
    snaps = [s for s in state_load(TRAIN, {"snapshots": []})["snapshots"] if s.get("green")]
    if refs_now is not None:
        snaps = [s for s in snaps if s.get("refs") == refs_now]
    return snaps[-1] if snaps else None

def cut(m, args):
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet cut <candidate-name>"); return 1
    name = pos[0]
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        print("cut: candidate name must be [A-Za-z0-9._-]+ (bundle paths are built from it)"); return 1
    refs_now = {}
    for rn, r in m["repos"].items():
        fetched, _, ferr = fetch_with_ttl(expand(r["path"]), r["fetch_remote"], r["mainline"],
                                          m.get("fetch_ttl_seconds", 300))
        if not fetched:
            print(f"cut: REFUSE — cannot fetch {rn} ({ferr}); a cut against stale refs is unvalidated"); return 2
        rc, sha, err = git(expand(r["path"]), "rev-parse", f"{r['fetch_remote']}/{r['mainline']}")
        if rc != 0 or not sha:
            print(f"cut: REFUSE — cannot resolve {rn} mainline ref: {err}"); return 2
        refs_now[rn] = sha
    snap = latest_green_snapshot(refs_now)
    if snap is None:
        print("cut: REFUSE — no GREEN train snapshot matches the CURRENT mainline refs.\n"
              "     Run wl train first; only validated states get cut."); return 2
    # dup pre-check BEFORE bundle writes — two same-name cuts overwrote each other's bundles
    # before the locked check ran (audit catch). The locked check in rec() stays authoritative.
    if any(t["name"] == name for t in state_load(TRAINS, {"trains": []}).get("trains", [])):
        print(f"cut: candidate '{name}' already exists"); return 1
    archive = expand(m.get("archive_dir", "~/dev/.wl-archive"))
    os.makedirs(archive, exist_ok=True)
    jid = journal_begin("cut", name)  # E0: bundle-writes→ledger window
    try:
        return _cut_window(m, name, refs_now, snap, archive, jid)
    except BaseException:
        journal_done(jid, "exception")  # exception honesty (audit catch)
        raise

def _cut_window(m, name, refs_now, snap, archive, jid):
    kit = {}
    for rn, r in m["repos"].items():
        bundle = os.path.join(archive, f"cut-{name}-{rn}.bundle")
        rc, _, err = git(expand(r["path"]), "bundle", "create", bundle,
                         f"{r['fetch_remote']}/{r['mainline']}", timeout=300)
        if rc != 0:
            journal_done(jid, "aborted:bundle")
            print(f"cut: revert-kit bundle failed for {rn}: {err}"); return 2
        rc, sha2, _ = git(expand(r["path"]), "rev-parse", f"{r['fetch_remote']}/{r['mainline']}")
        if sha2 != refs_now[rn]:  # ref moved mid-cut → bundle holds unvalidated commits (council race)
            os.remove(bundle)
            journal_done(jid, "aborted:ref-moved")
            print(f"cut: REFUSE — {rn} mainline moved during cut ({refs_now[rn][:9]}→{sha2[:9]}); re-run"); return 2
        kit[rn] = bundle
        journal_step(jid, f"bundle:{rn}")
    def rec(cur):
        if any(t["name"] == name for t in cur.get("trains", [])):
            return "dup"
        cur.setdefault("trains", []).append({"name": name, "ts": now_iso(), "status": "cut",
                                             "snapshot": snap["id"], "refs": refs_now, "revert_kit": kit})
    if state_mutate(TRAINS, {"trains": []}, rec) == "dup":
        journal_done(jid, "aborted:dup")
        print(f"cut: candidate '{name}' already exists"); return 1
    journal_done(jid)
    telemetry_log({"event": "cut", "name": name, "snapshot": snap["id"]})
    print(f"cut: candidate '{name}' on GREEN snapshot {snap['id']}")
    for rn, sha in refs_now.items():
        print(f"  {rn:8} {sha[:9]}  revert-kit: {kit[rn]}")
    print(f"  next: ratchet promote {name} (records GO; actual tagging stays with the release process)")
    return 0

def promote_rollback(m, args, action):
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print(f"usage: ratchet {action} <candidate-name>"); return 1
    name = pos[0]
    LEGAL = {"promote": ("cut",), "rollback": ("cut", "promoted")}
    def upd(cur):
        for t in cur.get("trains", []):
            if t["name"] == name:
                if t["status"] not in LEGAL[action]:
                    done = "promoted" if action == "promote" else "rolled-back"
                    if t["status"] == done:  # crash-rerun of a completed action is success, not an error (audit catch)
                        return {"__already__": done}
                    return {"__illegal__": t["status"]}
                t["status"] = "promoted" if action == "promote" else "rolled-back"
                t[action + "_ts"] = now_iso()
                return t
        return None
    t = state_mutate(TRAINS, {"trains": []}, upd)
    if t is None:
        print(f"{action}: no candidate '{name}' (ratchet cut first)"); return 1
    if "__already__" in t:
        print(f"{action}: '{name}' already {t['__already__']} — idempotent re-run, nothing to do"); return 0
    if "__illegal__" in t:
        print(f"{action}: REFUSE — '{name}' is '{t['__illegal__']}'; legal: cut→promoted, cut/promoted→rolled-back "
              f"(a rolled-back candidate is DEAD — cut a new one)"); return 2
    telemetry_log({"event": action, "name": name})
    if action == "promote":
        print(f"promote: '{name}' GO — refs recorded; tag via the normal release process:")
        for rn, sha in t["refs"].items():
            print(f"  {rn:8} {sha[:9]}")
    else:
        print(f"rollback: '{name}' — restore paths (bundles are full history):")
        for rn, sha in t["refs"].items():
            print(f"  {rn:8} known-good {sha[:9]} · bundle {t['revert_kit'][rn]}")
        print("  revert = land a revert PR onto mainline (protection blocks force-push by design)")
    return 0

# ---------- Wave D: wl audit — dependency / supply-chain gate (OSV) ----------

def parse_deps(path, lang):
    """Extract {(ecosystem, name, version)} from lock/manifest CONTENT for a tree."""
    deps = set()
    def rd(rel):
        try:
            return open(os.path.join(path, rel)).read()
        except OSError:
            return None
    if lang == "rust":
        t = rd("Cargo.lock")
        if t:
            for mt in re.finditer(r'name = "([^"]+)"\nversion = "([^"]+)"', t):
                deps.add(("crates.io", mt.group(1), mt.group(2)))
    elif lang == "ts":
        t = rd("package-lock.json")
        if t:
            try:
                for k, v in (json.loads(t).get("packages") or {}).items():
                    if k.startswith("node_modules/") and v.get("version"):
                        deps.add(("npm", k.split("node_modules/")[-1], v["version"]))
            except json.JSONDecodeError:
                pass
        else:
            t = rd("package.json")  # bun.lock is not parseable here — DIRECT deps only, said out loud
            if t:
                try:
                    p = json.loads(t)
                    for sec in ("dependencies", "devDependencies"):
                        for n, ver in (p.get(sec) or {}).items():
                            deps.add(("npm", n, ver.lstrip("^~>=<")))
                except json.JSONDecodeError:
                    pass
    elif lang == "python":
        for f in ("requirements.txt", "requirements-dev.txt"):
            t = rd(f)
            if t:
                for line in t.splitlines():
                    mt = re.match(r"^([A-Za-z0-9_.-]+)==([A-Za-z0-9_.-]+)", line.strip())
                    if mt:
                        deps.add(("PyPI", mt.group(1), mt.group(2)))
    return deps

def osv_query(eco, name, ver):
    """OSV.dev vulnerability lookup — returns list of vuln ids (empty = clean)."""
    body = json.dumps({"package": {"name": name, "ecosystem": eco}, "version": ver}).encode()
    req = urllib.request.Request("https://api.osv.dev/v1/query", data=body,
                                 headers={"Content-Type": "application/json"})
    try:
        data = json.load(urllib.request.urlopen(req, timeout=15))
        return [v.get("id", "?") for v in data.get("vulns", [])]
    except Exception:
        return None  # network fail = UNKNOWN, caller decides

def audit(m, args):
    """wl audit [worktree|repo] — diff dependency surface vs mainline, OSV-check what CHANGED.
    New/changed dep with a known vuln = block (exit 2). Network-fail = loud UNKNOWN (exit 3)."""
    pos = [a for a in args if not a.startswith("-")]
    target = pos[0] if pos else os.getcwd()
    if target in m["repos"]:
        name, r = target, m["repos"][target]
        wt = expand(r["path"])
    else:
        wt = os.path.realpath(expand(target))
        name, r = repo_for_dir(m, wt)
        if not name:
            print(f"audit: '{target}' is not a repo name or a tree inside one"); return 1
    base_ref = f"{r['fetch_remote']}/{r['mainline']}"
    # materialize the BASE dependency surface from the mainline ref
    base = set()
    with tempfile.TemporaryDirectory(prefix="wl-audit-") as tmp:
        rc, _, err = git(expand(r["path"]), "worktree", "add", "--detach", os.path.join(tmp, "base"), base_ref)
        if rc == 0:
            base = parse_deps(os.path.join(tmp, "base"), r["lang"])
            git(expand(r["path"]), "worktree", "remove", "--force", os.path.join(tmp, "base"))
        else:
            print(f"audit: cannot materialize {base_ref} ({err}) — treating ALL deps as changed")
        git(expand(r["path"]), "worktree", "prune")  # never leave a dangling registry entry
    cur = parse_deps(wt, r["lang"])
    changed = sorted(cur - base)
    if not cur and r["lang"] in ("rust", "ts", "python"):
        # an empty surface for a dep-bearing language means the PARSER failed, not that deps
        # vanished — silent pass here waves vulnerable deps through (3-auditor convergence)
        print(f"audit: UNKNOWN — no parseable dependency surface for {name} ({r['lang']}); "
              f"lockfile missing/renamed/unsupported. NOT a pass."); return 3
    if not changed:
        print(f"audit: {name} dependency surface unchanged vs {base_ref} ({len(cur)} deps)"); return 0
    print(f"audit: {len(changed)} new/changed dep(s) vs {base_ref} — OSV-checking each")
    vulns, unknowns = [], []
    for eco, n, v in changed:
        if not v:  # "latest"/"*" stripped to empty — unverifiable, never counts as clean
            unknowns.append(f"{n}@(unpinned)")
            print(f"  ?      {eco:10} {n} — UNPINNED version, cannot OSV-verify")
            continue
        ids = osv_query(eco, n, v)
        if ids is None:
            unknowns.append(f"{n}@{v}")
            print(f"  ?      {eco:10} {n}@{v} — OSV unreachable")
        elif ids:
            vulns.append((n, v, ids))
            print(f"  VULN   {eco:10} {n}@{v} — {', '.join(ids[:4])}")
        else:
            print(f"  clean  {eco:10} {n}@{v}")
    if vulns:
        print(f"audit: BLOCK — {len(vulns)} vulnerable dep(s) introduced"); return 2
    if unknowns:
        print(f"audit: UNKNOWN — {len(unknowns)} dep(s) unverifiable (network); not a pass"); return 3
    print("audit: all changed deps clean")
    return 0

# ---------- Wave D: wl adopt — one-command repo onboarding ----------

def adopt(m, args):
    """wl adopt <path|github-url> [--name <n>] — infer everything, write the manifest entry,
    install hooks, report next steps. The 'any repo in a minute' verb."""
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet adopt <path|https://github.com/org/repo> [--name <n>]"); return 1
    src = pos[0]
    if src.startswith("https://github.com/"):
        rname = args[args.index("--name") + 1] if "--name" in args else src.rstrip("/").split("/")[-1].removesuffix(".git")
        dest = expand(f"~/dev/{rname}")
        if not os.path.exists(dest):
            print(f"adopt: cloning {src} → {dest}")
            # clone to a pid-scoped temp then rename: an interrupted clone must never leave a
            # corrupt dest that permanently blocks re-adoption (audit catch)
            tmp_clone = f"{dest}.cloning-{os.getpid()}"
            rc, _, err = run(["git", "clone", src, tmp_clone], timeout=600)
            if rc != 0:
                shutil.rmtree(tmp_clone, ignore_errors=True)
                print(f"adopt: clone failed: {err}"); return 1
            os.rename(tmp_clone, dest)
        else:
            rc, have_url, _ = git(dest, "remote", "get-url", "origin")
            want = src.removesuffix(".git")
            if rc != 0 or have_url.removesuffix(".git") != want:
                print(f"adopt: REFUSE — {dest} exists but origin is '{have_url or 'not a repo'}', "
                      f"not {src}; will not register an unrelated tree"); return 2
        path = dest
        origin_url = src if src.endswith(".git") else src + ".git"
    else:
        path = os.path.realpath(expand(src))
        rname = args[args.index("--name") + 1] if "--name" in args else os.path.basename(path)
        rc, origin_url, _ = git(path, "remote", "get-url", "origin")
        if rc != 0:
            print("adopt: repo has no 'origin' remote — add one first (the plane enforces remote truth)"); return 1
    if rname in m["repos"]:
        print(f"adopt: '{rname}' already in the manifest"); return 1
    # detect language + suite
    def has(f): return os.path.exists(os.path.join(path, f))
    if has("Cargo.toml"):
        lang, suite = "rust", "cargo test --workspace --quiet"
    elif has("package.json"):
        lang = "ts"
        try:
            scripts = json.load(open(os.path.join(path, "package.json"))).get("scripts", {})
        except (OSError, json.JSONDecodeError):
            scripts = {}
        suite = "bun run test" if "test" in scripts and has("bun.lock") else ("npm test" if "test" in scripts else "")
    elif has("pyproject.toml") or has("requirements.txt"):
        lang, suite = "python", "python3 -m pytest -q"
    else:
        lang, suite = "unknown", ""
    rc, head, _ = git(path, "symbolic-ref", "refs/remotes/origin/HEAD")
    # removeprefix, NOT split('/')[-1]: a release/v1 mainline was silently truncated to v1
    # (audit catch — same bug class the gc branch parser had)
    mainline = head.removeprefix("refs/remotes/origin/") if rc == 0 else (git(path, "branch", "--show-current")[1] or "main")
    eff = effective_gh_login() or "UNKNOWN"
    entry = {"path": src if src.startswith("~") else path.replace(os.path.expanduser("~"), "~", 1),
             "mainline": mainline, "fetch_remote": "origin", "push_remote": "origin",
             "gh_login": eff, "forbidden_push": [],
             "remotes": {"origin": origin_url},
             "worktree_root": f"~/dev/{rname}-worktrees", "lang": lang}
    if suite:
        entry["suite_cmd"] = suite
    # discover the repo's real CI check names and pre-fill a protection block, so the very next
    # command (`ratchet protect apply`) actually enforces them — no manual manifest editing,
    # no "go find your check names" homework (don't-make-me-think)
    checks = []
    rc_ck, nums, _ = run(["gh", "pr", "list", "-R", pr_repo(entry), "--state", "merged", "-L", "1",
                          "--json", "number", "--jq", ".[0].number"], timeout=20)
    if rc_ck == 0 and nums.strip():
        rc_n, names, _ = run(["gh", "pr", "view", nums.strip(), "-R", pr_repo(entry),
                              "--json", "statusCheckRollup", "--jq", ".statusCheckRollup[].name"], timeout=20)
        if rc_n == 0:
            checks = sorted(set(n for n in names.splitlines() if n.strip()))
    if checks:
        entry["protection"] = {"required_checks": checks, "strict": True}
    def add(cur):
        cur["repos"][rname] = entry
    # validate the entry through the same gate everything else passes
    probe = json.loads(json.dumps(m))
    probe["repos"][rname] = entry
    probe_name = f".adopt-probe-{os.getpid()}.json"  # pid-unique: parallel adopts must not clobber
    tmpf = state_path(probe_name)
    state_save(probe_name, probe)
    try:
        rc = subprocess.run([sys.executable, os.path.abspath(__file__), "doctor", rname, "--offline"],
                            env=dict(os.environ, WL_MANIFEST=tmpf), capture_output=True, text=True).returncode
    finally:
        os.remove(tmpf)
    if rc not in (0, 3):  # offline doctor: 3 (UNKNOWN sync) is expected, RED is not
        print(f"adopt: candidate entry fails doctor (rc {rc}) — not writing a broken manifest"); return 2
    # write to MANIFEST_PATH (which may be WL_MANIFEST-overridden), locked + atomic
    import fcntl
    with open(MANIFEST_PATH + ".lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        cur = json.load(open(MANIFEST_PATH))
        if rname in cur["repos"]:  # re-check INSIDE the lock — the early check read pre-lock state (audit race catch)
            print(f"adopt: '{rname}' was registered by a concurrent adopt — not overwriting"); return 1
        cur["repos"][rname] = entry
        tmpw = f"{MANIFEST_PATH}.{os.getpid()}.tmp"
        with open(tmpw, "w") as fh:
            json.dump(cur, fh, indent=2)
        os.replace(tmpw, MANIFEST_PATH)
    okv, detail = install_hooks(cur, rname, entry, expand(entry["path"]))
    telemetry_log({"event": "adopt", "repo": rname, "lang": lang})
    print(f"adopt: '{rname}' is under the gate — {lang}, mainline {mainline}, identity {eff}")
    print(f"  hooks {'installed' if okv else 'FAILED: ' + str(detail)} · suite: {suite or 'none detected (set suite_cmd)'}")
    if checks:
        print(f"  found {len(checks)} CI check(s) and wired them in: {', '.join(checks[:6])}")
        print(f"\n  one command locks the branch to them:\n    ratchet protect apply {rname}")
    else:
        print(f"\n  next:  ratchet doctor {rname}   (then `ratchet protect apply {rname}` once it has CI)")
    # governance audit (read-only): onboarding SURFACES the gaps; scaffolding is one explicit command.
    gaps = _governance_gaps(expand(entry["path"]))
    if gaps:
        print(f"  governance: missing {', '.join(gaps)} — scaffold with `ratchet govern {rname} --scaffold`")
    else:
        print("  governance: complete (security, codeowners, PR template, contributing all present)")
    return 0


# ---------- govern — governance scaffolding (guided, approval-gated) ----------
# Onboarding a repo should not just ENFORCE rules, it should SET THEM UP. `adopt` audits the governance
# set read-only and reports gaps; `ratchet govern <repo> --scaffold` writes the MISSING files onto a
# fresh branch for the human to review and PR. It never writes to the mainline and never pushes:
# governance is the human's to ratify — the plane just removes the blank-page work.

def _governance_gaps(path):
    """The governance files that are MISSING. Each may live at repo root or under .github/ (GitHub honors
    both), so a repo that already has one anywhere is not re-scaffolded."""
    def has(*rels):
        return any(os.path.exists(os.path.join(path, r)) for r in rels)
    present = {
        "SECURITY.md": has("SECURITY.md", ".github/SECURITY.md", "docs/SECURITY.md"),
        "CODEOWNERS": has("CODEOWNERS", ".github/CODEOWNERS", "docs/CODEOWNERS"),
        ".github/PULL_REQUEST_TEMPLATE.md": has(".github/PULL_REQUEST_TEMPLATE.md", "PULL_REQUEST_TEMPLATE.md",
                                                "docs/PULL_REQUEST_TEMPLATE.md"),
        "CONTRIBUTING.md": has("CONTRIBUTING.md", ".github/CONTRIBUTING.md", "docs/CONTRIBUTING.md"),
    }
    return [f for f, ok in present.items() if not ok]


def _govern_template(relfile, owner, rname):
    """Starter content for a missing governance file, grounded in the repo's owner + name. CONTRIBUTING
    carries the SCOPE policy (the in-scope / declined boundary) with TODOs for the maintainer to fill."""
    if relfile == "SECURITY.md":
        return (f"# Security Policy\n\n## Reporting a vulnerability\n\n"
                f"Report security issues **privately**: use GitHub's private vulnerability reporting (the "
                f"repo Security tab, \"Report a vulnerability\"), or contact the {owner} maintainers "
                f"directly. Do not open a public issue for a vulnerability.\n\n"
                f"We aim to acknowledge a report within 3 business days and to ship a fix or mitigation "
                f"before any public disclosure.\n\n## Supported versions\n\n"
                f"Security fixes target the latest released version of `{rname}`.\n")
    if relfile == "CODEOWNERS":
        return (f"# Default reviewers for everything in {rname}.\n"
                f"# Refine to teams/paths as the project grows, e.g. `/src/ @{owner}/core`.\n"
                f"* @{owner}\n")
    if relfile == ".github/PULL_REQUEST_TEMPLATE.md":
        return ("## What and why\n\n<!-- one line: what this changes and why -->\n\n## Scope\n\n"
                "- [ ] In scope per CONTRIBUTING.md (out-of-scope requests are declined, not merged)\n\n"
                "## Checks\n\n"
                "- [ ] The gate is green (tests/build pass)\n"
                "- [ ] No secrets, keys, or credentials committed\n"
                "- [ ] No AI-generated signatures in commits or the PR body\n")
    if relfile == "CONTRIBUTING.md":
        return (f"# Contributing to {rname}\n\n## In scope\n\n"
                f"<!-- What this project IS. Contributions that serve this are welcome. -->\n"
                f"- TODO: state the project's core purpose.\n\n## Out of scope (declined)\n\n"
                f"Requests outside the core purpose are declined with a pointer to this policy, not left "
                f"open, so the roadmap stays focused. Examples:\n"
                f"- TODO: list the kinds of asks that are out of scope.\n\n## How we work\n\n"
                f"- Every change passes the gate (tests must pass) before merge.\n"
                f"- Keep changes surgical, scoped to one concern.\n")
    return ""


def govern(m, args):
    """ratchet govern <repo> [--scaffold] — audit the repo's governance set; with --scaffold, write the
    MISSING files onto a fresh review branch (never mainline, never pushed)."""
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet govern <repo> [--scaffold]"); return 1
    rname = pos[0]
    r = m["repos"].get(rname)
    if not r:
        print(f"govern: unknown repo '{rname}' (have: {', '.join(m['repos']) or 'none'})"); return 1
    path = expand(r["path"])
    gaps = _governance_gaps(path)
    if not gaps:
        print(f"govern: '{rname}' has the full governance set (SECURITY, CODEOWNERS, PR template, CONTRIBUTING)")
        return 0
    print(f"govern: '{rname}' is missing {len(gaps)} governance file(s):")
    for g in gaps:
        print(f"  - {g}")
    if "--scaffold" not in args:
        print(f"\n  scaffold them onto a review branch:\n    ratchet govern {rname} --scaffold")
        return 0
    owner = r.get("gh_login") or effective_gh_login() or "OWNER"
    mainline = r["mainline"]
    branch = f"govern/scaffold-{os.getpid()}"
    wt = expand(os.path.join(r.get("worktree_root", f"~/dev/{rname}-worktrees"), f"govern-{os.getpid()}"))
    # scaffold in a THROWAWAY worktree branched off mainline: never disturbs the user's working tree,
    # never touches mainline, never pushes.
    rc, _, err = git(path, "worktree", "add", "-b", branch, wt, f"{r['fetch_remote']}/{mainline}")
    if rc != 0:
        rc, _, err = git(path, "worktree", "add", "-b", branch, wt, mainline)   # fallback to local mainline
    if rc != 0:
        print(f"govern: could not create a scaffold worktree: {err}"); return 2
    committed = False
    try:
        written = []
        for g in gaps:
            dest = os.path.join(wt, g)
            if os.path.dirname(g):
                os.makedirs(os.path.dirname(dest), exist_ok=True)
            with open(dest, "w", encoding="utf-8") as fh:      # explicit utf-8: never crash under LANG=C
                fh.write(_govern_template(g, owner, rname))
            written.append(g)
        git(wt, "add", *written)
        rc, _, err = git(wt, "commit", "-m", "chore: scaffold governance starter files")
        committed = rc == 0
        if not committed:
            print(f"govern: commit failed: {err}")
    except OSError as e:
        print(f"govern: scaffold write failed: {e}")
    finally:
        rc_rm, _, rm_err = git(path, "worktree", "remove", "--force", wt)
        if rc_rm != 0:
            print(f"govern: warning — could not remove scaffold worktree {wt}: {rm_err[:80]}")
        if not committed:
            git(path, "branch", "-D", branch)                 # no dangling empty scaffold branch on failure
    if not committed:
        return 2
    print(f"\ngovern: wrote {len(written)} file(s) onto branch '{branch}' (mainline untouched, nothing pushed).")
    print(f"  review:  git -C {r['path']} show {branch}")
    print(f"  ship:    git -C {r['path']} push {r['push_remote']} {branch}  then open a PR")
    print("  These are STARTERS with TODOs (especially the CONTRIBUTING scope policy) — edit before merging.")
    return 0


# ---------- E3: the glass — watch (terminal + GET-only server) · log · replay ----------
# §9 CONTRACT, enforced not promised: the server implements GET ONLY (no do_POST/do_PUT/
# do_DELETE exists in this file — selftest asserts it); no forms, no cookies, no identity;
# binds 127.0.0.1 by default. Every element renders a kernel artifact. It never mutates.

def _cards_ro():
    """The card list, shape-safe: workcards.json is agent-writable, so a list/keyless/wrong-typed
    file must degrade to an empty list — never a subscript crash that darks watch/inbox/glass
    (a §9 read surface must survive one poisoned card)."""
    sl = state_load(CARDS, {"cards": []})
    cards = sl.get("cards") if isinstance(sl, dict) else None
    return [c for c in cards if isinstance(c, dict)] if isinstance(cards, list) else []

def _lanes(m):
    """Live-lane rows derived from cards + recordings + journals — no second state."""
    rows = []
    cards = [c for c in _cards_ro() if c.get("status") in ("open", "landing", "pending")]
    for c in cards:
        wid = safe_ref(str(c.get("work_id") or ""))  # a poisoned work_id must not reach the fs
        rec = os.path.join(WL_HOME, "state", "recordings", wid, "events.jsonl") if wid else None
        beat = int(time.time() - os.path.getmtime(rec)) if rec and os.path.exists(rec) else None
        rows.append({"work_id": c.get("work_id"), "slug": c.get("slug"), "repo": c.get("repo"),
                     "status": c.get("status"), "risk": c.get("risk"), "agent": c.get("agent"),
                     "age_h": None, "beat_s": beat, "created": c.get("created")})
    return rows

def _needs_you(m):
    """The needs-you strip, DERIVED (§9): each item names the resolving verb. No stored inbox
    state to drift out of sync — cards/journals/recordings/ledgers stay the single truth."""
    items = []
    jl = state_load(JOURNAL, {"schema_version": 1, "runs": []})
    jruns = jl.get("runs") if isinstance(jl, dict) else None
    for rj in (jruns if isinstance(jruns, list) else []):
        if not isinstance(rj, dict):
            continue
        if not rj.get("done") and not pid_is_claimant(rj.get("pid", 0), rj.get("pid_start", "")):
            items.append({"kind": "interrupted",
                          "msg": f"{rj.get('verb', 'run')} died mid-window ({rj.get('ref', '?')})",
                          "verb": f"re-run the {rj.get('verb', 'run')}, or: ratchet reconcile --reap",
                          "ts": rj.get("started", "")})
    for c in _cards_ro():
        if c.get("status") not in ("open", "landing"):
            continue
        wid = safe_ref(str(c.get("work_id") or ""))
        if wid is None:
            continue  # a poisoned work_id can't index the recordings tree
        rdir = os.path.join(WL_HOME, "state", "recordings", wid)
        # latest delivery by MTIME, never lexical sort — an older clean verdict lexically
        # outsorting a newer failure was a gate bypass (final-audit MAJOR, 3 auditors)
        deliv = sorted((f for f in os.listdir(rdir) if f.startswith("delivery")),
                       key=lambda f: os.path.getmtime(os.path.join(rdir, f))) if os.path.isdir(rdir) else []
        if deliv:
            try:
                dj = json.load(open(os.path.join(rdir, deliv[-1])))
            except (OSError, json.JSONDecodeError):
                continue
            if dj.get("verdict") == "clean":
                items.append({"kind": "ready-to-land", "msg": f"card {c.get('work_id')} ({c.get('slug')}) passed exec checks",
                              "verb": f"ratchet land {c.get('worktree')}", "ts": dj.get("ts", c.get("created", ""))})
        try:  # a single malformed timestamp must never take down watch/inbox/glass (final-audit)
            idle_d = (time.time() - time.mktime(time.strptime(str(c.get("created")), "%Y-%m-%dT%H:%M:%S"))) / 86400
        except (ValueError, TypeError, OverflowError):
            idle_d = 0.0
        if idle_d > 3 and not deliv:
            items.append({"kind": "stale-card", "msg": f"card {c.get('work_id')} ({c.get('slug')}) open {idle_d:.0f}d with no delivery",
                          "verb": f"ratchet reconcile · or ratchet-exec run {c.get('work_id')}", "ts": c.get("created", "")})
    snaps = state_load(TRAIN, {"snapshots": []}).get("snapshots", [])
    trains = state_load(TRAINS, {"trains": []}).get("trains", [])
    cut_snaps = {t.get("snapshot") for t in trains}
    for s in snaps[-3:]:
        if s.get("green") and s["id"] not in cut_snaps:
            items.append({"kind": "green-uncut", "msg": f"GREEN snapshot {s['id']} not yet cut",
                          "verb": f"ratchet cut <name>", "ts": s.get("ts", "")})
    for t in trains:
        if t.get("status") == "cut":
            items.append({"kind": "promote-decision", "msg": f"candidate '{t['name']}' is cut, awaiting GO",
                          "verb": f"ratchet promote {t['name']} · or ratchet rollback {t['name']}", "ts": t.get("ts", "")})
        elif t.get("status") == "promoted" and not t.get("closeout"):
            items.append({"kind": "closeout-due", "msg": f"'{t['name']}' promoted without a ship-audit",
                          "verb": f"ratchet closeout {t['name']}", "ts": t.get("promote_ts", t.get("ts", ""))})
    return sorted(items, key=lambda i: str(i["ts"]))

def watch(m, args):
    if "--serve" in args:
        return glass_serve(m, args)
    print(f"ratchet watch · {now_iso()}")
    ny = _needs_you(m)
    print(f"\nNEEDS YOU ({len(ny)}):" if ny else "\nNEEDS YOU: nothing — the swarm is unblocked")
    for i in ny[:10]:
        print(f"  [{i['kind']:16}] {i['msg']}\n  {'':18}→ {i['verb']}")
    lanes = _lanes(m)
    print(f"\nLANES ({len(lanes)}):" if lanes else "\nLANES: none open")
    for l in lanes:
        beat = f"beat {l['beat_s']}s ago" if l["beat_s"] is not None else "no recording yet"
        print(f"  {l['work_id']}  {l['slug']:24} {l['repo']:8} {l['status']:8} {l['risk']:6} {beat}")
    try:
        spend = spend_today()  # cursor-cached: reads only the bytes appended since last render
    except OSError:
        spend = 0.0
    print(f"\nledger: ${spend:.4f} recorded today · chain: ratchet chain · glass: ratchet watch --serve")
    return 0

def log_cmd(m, args):
    """ratchet log <card> — the postmortem: every recorded event + artifact, chronological."""
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet log <work-id>"); return 1
    wid = safe_ref(pos[0])
    if wid is None:
        print("log: refs are [A-Za-z0-9._-], no traversal"); return 1
    rdir = os.path.join(WL_HOME, "state", "recordings", wid)
    if not os.path.isdir(rdir):
        print(f"log: no recording for '{wid}'"); return 1
    ev = os.path.join(rdir, "events.jsonl")
    if os.path.exists(ev):
        for ln in open(ev):
            try:
                e = json.loads(ln)
            except json.JSONDecodeError:
                continue
            rest = {k: v for k, v in e.items() if k not in ("ts", "agent", "event")}
            print(f"  {e.get('ts')}  {e.get('event', '?'):14} {e.get('agent', ''):14} {json.dumps(rest)[:120]}")
    arts = sorted(f for f in os.listdir(rdir) if f != "events.jsonl")
    if arts:
        print("  artifacts:")
        for a in arts:
            print(f"    {os.path.join(rdir, a)}")
    return 0

def replay(m, args):
    """ratchet replay <card> — re-derive council verdicts from their RECORDED inputs. A stored
    verdict that can't be re-derived is flagged DIVERGENT: stochastic output wrapped as a
    testable artifact (the differentiation ledger's exact claim)."""
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet replay <work-id|ref>"); return 1
    if safe_ref(pos[0]) is None:
        print("replay: refs are [A-Za-z0-9._-], no traversal"); return 1
    rdir = os.path.join(WL_HOME, "state", "recordings", pos[0])
    thinks = sorted(f for f in os.listdir(rdir) if f.startswith("think-")) if os.path.isdir(rdir) else []
    if not thinks:
        print(f"replay: no council artifacts recorded for '{pos[0]}'"); return 1
    bad = 0
    for f in thinks:
        try:
            art = json.load(open(os.path.join(rdir, f)))
        except (OSError, json.JSONDecodeError):
            print(f"  UNREADABLE {f}"); bad += 1; continue
        res = art.get("result") or {}
        stored = res.get("verdict")
        if stored is None:
            print(f"  SKIP       {f} (mode '{res.get('mode')}' carries no verdict)"); continue
        members = res.get("members") or {}
        judged = [n for n in members if n.startswith("judge:")]
        if judged:
            rederived = canonicalize_verdict(members[judged[0]])["verdict"]
        else:
            vs = [canonicalize_verdict(o)["verdict"] for o in members.values()]
            rederived = max(set(vs), key=vs.count) if vs else None
        okv = rederived == stored
        print(f"  {'REPLAYED  ' if okv else 'DIVERGENT '} {f}: stored={stored} re-derived={rederived}")
        bad += 0 if okv else 1
    if bad:
        print(f"replay: {bad} artifact(s) DIVERGE — the recorded verdict does not follow from its recorded inputs")
        return 2
    print(f"replay: {len(thinks)} council artifact(s) re-derived exactly")
    return 0

# ---------- E2b: the DECIDE/DIRECT verbs — inbox · approve/reject · answer · fleet control ----------

def _item_id(i):
    import hashlib
    return hashlib.sha1(f"{i['kind']}:{i['msg']}".encode()).hexdigest()[:8]

def inbox(m, args):
    """ratchet inbox — what needs YOU, worst first, opening with the one thing to do now.
    Items are DERIVED (§9); snooze/delegate are stored overrides keyed by stable item id."""
    show_all = "--all" in args
    cfg, _, _ = config_load()
    stale_s = float(cfg.get("inbox", {}).get("stale_hours", 24)) * 3600
    ov = state_load("inbox-overrides.json", {"schema_version": 1, "items": {}}).get("items", {})
    items = []
    for i in _needs_you(m):
        iid = _item_id(i)
        o = ov.get(iid, {})
        if o.get("snooze_until") and o["snooze_until"] > now_iso():
            continue
        age_s = 0.0
        try:
            age_s = time.time() - time.mktime(time.strptime(str(i["ts"]), "%Y-%m-%dT%H:%M:%S"))
        except (ValueError, TypeError):
            pass
        items.append({**i, "id": iid, "stale": age_s > stale_s,
                      "delegate": o.get("delegate_to"), "age_h": age_s / 3600})
    items.sort(key=lambda x: (not x["stale"], -x["age_h"]))
    if not items:
        # an empty queue is a GOOD state — say so, and point forward, never leave a dead end
        one = list(m["repos"])[0] if len(m.get("repos", {})) == 1 else "<repo>"
        print("inbox clear — nothing is waiting on you. The swarm is unblocked.")
        print(f"  start something:  ratchet take <slug> --repo {one}")
        return 0
    top = items[0]
    print(f"do this now: {top['verb']}")
    print(f"  ({top['kind']}: {top['msg']}{' · STALE past SLA' if top['stale'] else ''})\n")
    for i in items[: None if show_all else 10]:
        extra = (" STALE" if i["stale"] else "") + (f" →{i['delegate']}" if i["delegate"] else "")
        print(f"  {i['id']}  [{i['kind']:16}]{extra} {i['msg']}")
        print(f"  {'':10} verb: {i['verb']}")
    if not show_all and len(items) > 10:
        print(f"  … {len(items) - 10} more (--all)")
    print("\ntriage: ratchet snooze <id> --until <ISO> · ratchet delegate <id> --to <role>")
    return 0

def inbox_override(m, args, field):
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print(f"usage: ratchet {'snooze <id> --until <ISO-ts>' if field == 'snooze_until' else 'delegate <id> --to <role>'}"); return 1
    iid = pos[0]
    val = (args[args.index("--until") + 1] if "--until" in args else None) if field == "snooze_until" \
        else (args[args.index("--to") + 1] if "--to" in args else None)
    if not val:
        print(f"{field}: missing {'--until' if field == 'snooze_until' else '--to'}"); return 1
    agent = os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE", "unattributed")
    def fn(cur):
        cur.setdefault("items", {}).setdefault(iid, {})[field] = val
        cur["items"][iid]["by"] = agent
        cur["items"][iid]["ts"] = now_iso()
    state_mutate("inbox-overrides.json", {"schema_version": 1, "items": {}}, fn)
    telemetry_log({"event": field, "item": iid, "value": val})  # delegation/snooze is a ledgered act
    print(f"{'snoozed' if field == 'snooze_until' else 'delegated'}: item {iid} → {val}")
    return 0

def approve(m, args):
    """ratchet approve <plan-artifact.json> — sign off a council plan: hash it, ledger the
    approval, emit its cards via take --bulk. The id IS the content hash — approving a file
    that changed since you read it fails closed (COCKPIT v2.1)."""
    import hashlib
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet approve <plan.json> [--hash <sha12>] · ratchet reject <ref> --why '<r>'"); return 1
    path = expand(pos[0])
    try:
        raw = open(path, "rb").read()
    except OSError as e:
        print(f"approve: unreadable ({e})"); return 1
    digest = hashlib.sha256(raw).hexdigest()[:12]
    want = args[args.index("--hash") + 1] if "--hash" in args else None
    if want and want != digest:
        print(f"approve: REFUSE — artifact hash {digest} ≠ expected {want}; it CHANGED since you read it"); return 2
    art = json.loads(raw)
    plan = art.get("result", art)  # accept a raw plan or a full think artifact
    tmpp = state_path(f".approve-{os.getpid()}.json")
    json.dump({"schema_version": 1, "cards": plan.get("cards", [])}, open(tmpp, "w"))
    try:
        rc = take_bulk(m, [tmpp])
    finally:
        os.remove(tmpp)
    if rc != 0:
        print("approve: plan REFUSED by take --bulk — nothing approved"); return rc
    agent = os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE", "unattributed")
    def fn(cur):
        cur.setdefault("approvals", []).append({"hash": digest, "path": path, "by": agent,
                                                "ts": now_iso(), "cards": len(plan.get("cards", []))})
    state_mutate("approvals.json", {"schema_version": 1, "approvals": []}, fn)
    telemetry_log({"event": "approve", "hash": digest, "cards": len(plan.get("cards", []))})
    print(f"approve: plan {digest} — {len(plan.get('cards', []))} card(s) opened; approval ledgered")
    return 0

def reject(m, args):
    pos = [a for a in args if not a.startswith("-")]
    why = args[args.index("--why") + 1] if "--why" in args else ""
    if not pos or not why:
        print("usage: ratchet reject <ref> --why '<reason>' (rejections are on the record too)"); return 1
    telemetry_log({"event": "reject", "ref": pos[0], "why": why})
    print(f"reject: '{pos[0]}' — ledgered with reason")
    return 0

def answer(m, args):
    """ratchet answer <question-slug> --text '<decision>' — a council question resolved into a
    LOCKED DECISION on the record; briefs cite these so agents stop re-asking."""
    pos = [a for a in args if not a.startswith("-")]
    text = args[args.index("--text") + 1] if "--text" in args else ""
    if not pos or not text:
        print("usage: ratchet answer <question-slug> --text '<the decision>'"); return 1
    agent = os.environ.get("RATCHET_AGENT") or os.environ.get("WL_INSTANCE", "unattributed")
    def fn(cur):
        cur.setdefault("decisions", []).append({"q": pos[0], "answer": text, "by": agent, "ts": now_iso()})
    state_mutate("decisions.json", {"schema_version": 1, "decisions": []}, fn)
    telemetry_log({"event": "answer", "q": pos[0]})
    print(f"answer: '{pos[0]}' locked — decisions are cited by every future brief")
    return 0

def _lane_pid(work_id):
    """Latest exec lane identity from the flight recording (ground truth, pid-reuse-safe)."""
    ev = os.path.join(WL_HOME, "state", "recordings", work_id, "events.jsonl")
    pid, start = None, ""
    try:
        for ln in open(ev):
            try:
                e = json.loads(ln)
            except json.JSONDecodeError:
                continue
            if e.get("event") == "exec_spawn" and e.get("pid"):
                pid, start = e["pid"], e.get("pid_start", "")
            elif e.get("event") == "exec_exit":
                pid = None
    except OSError:
        pass
    return pid, start

def lane_signal(m, args, action):
    """ratchet kill|pause|resume <work-id> — fleet control as VERBS (§9): signal the recorded
    lane process group. Refuses when the recorded pid isn't the claimant (pid-reuse-safe)."""
    import signal as _sig
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print(f"usage: ratchet {action} <work-id>"); return 1
    wid = safe_ref(pos[0])
    if wid is None:  # a crafted/typo'd id must never traverse into a forged events.jsonl → arbitrary signal
        print(f"{action}: '{pos[0]}' is not a valid card id"); return 1
    pid, start = _lane_pid(wid)
    if pid is None:
        print(f"{action}: no LIVE exec lane recorded for card {wid}"); return 1
    if not pid_is_claimant(pid, start):
        print(f"{action}: recorded lane pid {pid} is no longer that process — nothing signaled"); return 1
    sig = {"kill": _sig.SIGTERM, "pause": _sig.SIGSTOP, "resume": _sig.SIGCONT}[action]
    try:
        os.killpg(pid, sig)
    except OSError:
        try:
            os.kill(pid, sig)
        except OSError as e:
            print(f"{action}: signal failed ({e})"); return 1
    telemetry_log({"event": f"lane_{action}", "work_id": wid, "pid": pid})
    print(f"{action}: lane {wid} (pid {pid}) signaled — ledgered")
    return 0

def closeout(m, args):
    """ratchet closeout <candidate> — the ship-audit: spend + egress + gate summary for a
    PROMOTED release, written as an artifact. The next promote warns if this is missing."""
    pos = [a for a in args if not a.startswith("-")]
    if not pos:
        print("usage: ratchet closeout <promoted-candidate>"); return 1
    name = pos[0]
    t = next((t for t in state_load(TRAINS, {"trains": []}).get("trains", []) if t["name"] == name), None)
    if t is None:
        print(f"closeout: no candidate '{name}'"); return 1
    if t["status"] != "promoted":
        print(f"closeout: '{name}' is '{t['status']}' — closeout follows promote"); return 2
    spend, events = 0.0, 0
    try:
        for ln in open(state_path("telemetry.jsonl")):
            try:
                e = json.loads(ln)
            except json.JSONDecodeError:
                continue
            events += 1
            spend += float(e.get("cost_usd") or 0)
    except OSError:
        pass
    art = {"schema_version": 1, "candidate": name, "refs": t.get("refs", {}), "snapshot": t.get("snapshot"),
           "ledger_events": events, "spend_usd_recorded": round(spend, 4),
           "cost_basis": "oracle-when-present, ADVISORY otherwise", "ts": now_iso()}
    d = os.path.join(WL_HOME, "state", "recordings", f"release-{name}")
    os.makedirs(d, exist_ok=True)
    apath = os.path.join(d, "closeout.json")
    json.dump(art, open(apath, "w"), indent=1)
    def fn(cur):
        for tt in cur.get("trains", []):
            if tt["name"] == name:
                tt["closeout"] = apath
    state_mutate(TRAINS, {"trains": []}, fn)
    telemetry_log({"event": "closeout", "name": name})
    print(f"closeout: '{name}' — {events} ledger events, ${spend:.4f} recorded · {apath}")
    return 0

def glass_serve(m, args):
    """glass v4 (systems audit R2-11): the glass lives in the ratchet-glass COMPANION — first-
    party code in the same trust domain, loading this kernel read-only the way ratchet-kanban
    does. The kernel keeps `watch --serve` as this thin delegate so the operator verb (and the
    selftest's GET-only / POST-501 / bind-refuse proofs, which spawn it) keep holding against
    the real server. exec, not subprocess: the companion IS the serving process — its output,
    exit code, and ^C reach the operator unwrapped, and no zombie wrapper lingers."""
    comp = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ratchet-glass")
    if not os.path.exists(comp):
        print(f"glass: companion missing ({comp}) — bin/ratchet-glass ships beside the kernel; reinstall")
        return 1
    os.execv(sys.executable, [sys.executable, comp, "serve", *[a for a in args if a != "--serve"]])

# ---------- selftest (the plane proves its own checks catch their targets) ----------

def selftest(m, args):
    """Sandbox-reproduce every git-level failure mode; assert each check FIRES."""
    results = []
    def expect(label, got, want):
        okv = got[0] == want
        results.append((label, okv, f"want {want}, got {got[0]}: {got[1]}"))

    with tempfile.TemporaryDirectory(prefix="wl-selftest-") as tmp:
        # build an upstream 'remote' with 3 commits
        upstream = os.path.join(tmp, "upstream.git")
        seed = os.path.join(tmp, "seed")
        run(["git", "init", "-q", "--bare", upstream])
        run(["git", "init", "-q", "-b", "main", seed])
        run(["git", "-C", seed, "config", "user.email", "t@t"]); run(["git", "-C", seed, "config", "user.name", "t"])
        for i in range(3):
            open(os.path.join(seed, f"f{i}.txt"), "w").write(str(i))
            run(["git", "-C", seed, "add", "."]); run(["git", "-C", seed, "commit", "-qm", f"c{i}"])
        run(["git", "-C", seed, "remote", "add", "origin", upstream])
        run(["git", "-C", seed, "push", "-q", "origin", "main"])

        clone = os.path.join(tmp, "clone")
        run(["git", "clone", "-q", upstream, clone])
        run(["git", "-C", clone, "config", "user.email", "t@t"]); run(["git", "-C", clone, "config", "user.name", "t"])

        # 1. healthy baseline
        expect("STANDALONE healthy", check_standalone(clone), OK)
        expect("MAINLINE healthy", check_mainline(clone, "main"), OK)
        expect("REMOTES healthy", check_remotes(clone, {"origin": upstream}), OK)
        f_ok, age, ferr = fetch_with_ttl(clone, "origin", "main", 300, fresh=True)
        expect("SYNC healthy", check_sync(clone, "origin", "main", 1, 50, f_ok, age, ferr), OK)
        expect("CLEAN healthy", check_clean(clone, ["AGENTS.md"]), OK)
        expect("WORKTREES healthy", check_worktrees(clone, os.path.join(tmp, "wt-root")), OK)

        # 2. behind (the 752 class): push 2 more upstream, don't pull
        for i in (3, 4):
            open(os.path.join(seed, f"f{i}.txt"), "w").write(str(i))
            run(["git", "-C", seed, "add", "."]); run(["git", "-C", seed, "commit", "-qm", f"c{i}"])
        run(["git", "-C", seed, "push", "-q", "origin", "main"])
        f_ok, age, ferr = fetch_with_ttl(clone, "origin", "main", 300, fresh=True)
        expect("SYNC behind→WARN", check_sync(clone, "origin", "main", 1, 50, f_ok, age, ferr), WARN)
        expect("SYNC big-behind→RED", check_sync(clone, "origin", "main", 1, 2, f_ok, age, ferr), RED)

        # 3. fetch FAILURE = UNKNOWN, never a stale number (v1.3 — live-reproduced today)
        run(["git", "-C", clone, "remote", "set-url", "origin", os.path.join(tmp, "nonexistent.git")])
        f_ok, age, ferr = fetch_with_ttl(clone, "origin", "main", 300, fresh=True)
        expect("SYNC fetch-fail→UNKNOWN", check_sync(clone, "origin", "main", 1, 50, f_ok, age, ferr), UNKNOWN)
        expect("REMOTES wrong-url→RED", check_remotes(clone, {"origin": upstream}), RED)
        run(["git", "-C", clone, "remote", "set-url", "origin", upstream])

        # 4. unpushed local commit on canonical mainline → WARN
        run(["git", "-C", clone, "pull", "-q", "--ff-only", "origin", "main"])
        open(os.path.join(clone, "local.txt"), "w").write("x")
        run(["git", "-C", clone, "add", "."]); run(["git", "-C", clone, "commit", "-qm", "local-only"])
        f_ok, age, ferr = fetch_with_ttl(clone, "origin", "main", 300, fresh=True)
        expect("SYNC unpushed→WARN", check_sync(clone, "origin", "main", 1, 50, f_ok, age, ferr), WARN)
        run(["git", "-C", clone, "reset", "-q", "--hard", "origin/main"])

        # 5. wrong branch → RED
        run(["git", "-C", clone, "checkout", "-qb", "feature"])
        expect("MAINLINE wrong-branch→RED", check_mainline(clone, "main"), RED)
        run(["git", "-C", clone, "checkout", "-q", "main"])

        # 6. worktree-pointer .git (the engine-tangle) → RED
        wt_in = os.path.join(tmp, "wt-root", "wt-good")
        wt_out = os.path.join(tmp, "stray", "wt-bad")
        run(["git", "-C", clone, "worktree", "add", "-q", wt_in, "-b", "wt1"])
        expect("STANDALONE pointer→RED", check_standalone(wt_in), RED)

        # 7. stray worktree outside root → WARN
        run(["git", "-C", clone, "worktree", "add", "-q", wt_out, "-b", "wt2"])
        expect("WORKTREES stray→WARN", check_worktrees(clone, os.path.join(tmp, "wt-root")), WARN)

        # 7b. wrong lineage (the 2026-07-06 canonical-desktop discovery) → RED
        alien = os.path.join(tmp, "alien")
        run(["git", "init", "-q", "-b", "main", alien])
        run(["git", "-C", alien, "config", "user.email", "t@t"]); run(["git", "-C", alien, "config", "user.name", "t"])
        open(os.path.join(alien, "other.txt"), "w").write("x")
        run(["git", "-C", alien, "add", "."]); run(["git", "-C", alien, "commit", "-qm", "alien-root"])
        run(["git", "-C", alien, "remote", "add", "origin", upstream])
        run(["git", "-C", alien, "fetch", "-q", "origin", "main"])
        f_ok2, age2, ferr2 = fetch_with_ttl(alien, "origin", "main", 300, fresh=True)
        expect("SYNC wrong-lineage→RED", check_sync(alien, "origin", "main", 1, 50, f_ok2, age2, ferr2), RED)

        # 8. dirty vs noise-only
        open(os.path.join(clone, "real-change.py"), "w").write("x")
        expect("CLEAN real-dirt→WARN", check_clean(clone, ["AGENTS.md"]), WARN)
        os.remove(os.path.join(clone, "real-change.py"))
        open(os.path.join(clone, "AGENTS.md"), "w").write("noise")
        expect("CLEAN noise-only→OK", check_clean(clone, ["AGENTS.md"]), OK)

        # 9. hooks: install into sandbox repo, prove each hard-block FIRES
        sb_repo = {"path": clone, "mainline": "main", "fetch_remote": "origin", "push_remote": "origin",
                   "gh_login": "t", "remotes": {"origin": upstream, "evil": os.path.join(tmp, "evil.git")},
                   "forbidden_push": ["evil"], "worktree_root": os.path.join(tmp, "wt-root")}
        run(["git", "init", "-q", "--bare", os.path.join(tmp, "evil.git")])
        run(["git", "-C", clone, "remote", "add", "evil", os.path.join(tmp, "evil.git")])
        okv, hooks_dir = install_hooks({"repos": {}}, "sandbox", sb_repo, clone)
        results.append(("HOOKS install", okv, str(hooks_dir)))
        # secret in staged diff → pre-commit BLOCKS
        open(os.path.join(clone, "leak.txt"), "w").write("api_key = 'sk-" + "a" * 24 + "'\n")
        run(["git", "-C", clone, "add", "leak.txt"])
        rc, _, err = git(clone, "commit", "-m", "add config")
        results.append(("HOOK pre-commit blocks secret", rc != 0, err[:80]))
        run(["git", "-C", clone, "reset", "-q", "HEAD", "leak.txt"]); os.remove(os.path.join(clone, "leak.txt"))
        # redaction-parity (audit): token classes the OLD hook regex MISSED must now block —
        # gho_ (GitHub OAuth), glpat- (GitLab), JWT. These reached the remote before the fix.
        for tok, lbl in (("gho_" + "a" * 36, "gho_ token"),
                         ("glpat-" + "b" * 22, "gitlab pat"),
                         ("eyJ" + "a" * 20 + "." + "b" * 20 + "." + "c" * 20, "jwt")):
            lk = os.path.join(clone, "leak2.txt")
            open(lk, "w").write("secret = '" + tok + "'\n")
            run(["git", "-C", clone, "add", "leak2.txt"])
            rc_p, _, _ = git(clone, "commit", "-m", "cfg")
            run(["git", "-C", clone, "reset", "-q", "HEAD", "leak2.txt"])
            try:
                os.remove(lk)
            except OSError:
                pass
            results.append((f"HOOK pre-commit blocks {lbl} (redaction-parity)", rc_p != 0, lbl))
        # AI attribution in message → commit-msg BLOCKS
        open(os.path.join(clone, "ok.txt"), "w").write("fine\n")
        run(["git", "-C", clone, "add", "ok.txt"])
        rc, _, err = git(clone, "commit", "-m", "good change\n\nCo-Authored-By: Claude <noreply@anthropic.com>")
        results.append(("HOOK commit-msg blocks AI sig", rc != 0, err[:80]))
        # >72-char subject → BLOCKS
        rc, _, err = git(clone, "commit", "-m", "x" * 80)
        results.append(("HOOK commit-msg blocks 80-char subject", rc != 0, err[:80]))
        # secret in the commit MESSAGE (live-fire 2026-07-06 found this gap) → commit-msg BLOCKS
        rc, _, err = git(clone, "commit", "-m", "innocent subject\n\nkey is sk-" + "c" * 24)
        results.append(("HOOK commit-msg blocks message-body secret", rc != 0 and "MESSAGE" in err, err[:80]))
        # clean commit → PASSES
        rc, _, err = git(clone, "commit", "-m", "legit: add ok.txt for hook selftest")
        results.append(("HOOK clean commit passes", rc == 0, err[:80]))
        # push to forbidden remote → pre-push BLOCKS; allowed remote → PASSES
        rc, _, err = git(clone, "push", "-q", "evil", "main")
        results.append(("HOOK pre-push blocks forbidden remote", rc != 0, err[:80]))
        run(["git", "-C", clone, "checkout", "-qb", "feat/allowed"])
        rc, _, err = git(clone, "push", "-q", "origin", "feat/allowed")
        results.append(("HOOK pre-push allows push_remote (feature branch)", rc == 0, err[:80]))
        rc, _, err = git(clone, "push", "-q", "origin", "HEAD:main")
        results.append(("HOOK pre-push blocks DIRECT mainline push", rc != 0 and "DIRECT push" in err, err[:90]))
        # secret buried in PUSHED HISTORY (bypassed pre-commit via --no-verify) → pre-push range scan BLOCKS
        open(os.path.join(clone, "sneaky.txt"), "w").write("token = 'ghp_" + "b" * 24 + "'\n")
        run(["git", "-C", clone, "add", "sneaky.txt"])
        run(["git", "-C", clone, "commit", "-q", "--no-verify", "-m", "innocent-looking change"])
        rc, _, err = git(clone, "push", "-q", "origin", "feat/allowed")
        # must fail BECAUSE OF THE HOOK — a remote-side rejection passing this test would be false-green
        results.append(("HOOK pre-push catches history secret (post --no-verify)",
                        rc != 0 and "SECRET-LIKE" in err, err[:100]))
        run(["git", "-C", clone, "reset", "-q", "--hard", "HEAD~1"])
        run(["git", "-C", clone, "checkout", "-q", "main"])

        # 9b. GOVERN: audit detects the gaps; --scaffold writes the missing files onto a review BRANCH,
        #     never mainline, never pushed.
        gbare = os.path.join(tmp, "govbare"); os.makedirs(gbare, exist_ok=True)
        results.append(("GOVERN audit flags every gap on a bare repo",
                        set(_governance_gaps(gbare)) == {"SECURITY.md", "CODEOWNERS",
                        ".github/PULL_REQUEST_TEMPLATE.md", "CONTRIBUTING.md"}, str(_governance_gaps(gbare))))
        os.makedirs(os.path.join(gbare, ".github"), exist_ok=True)
        open(os.path.join(gbare, ".github", "CODEOWNERS"), "w").write("* @x")
        results.append(("GOVERN audit clears a file that exists (root OR .github)",
                        "CODEOWNERS" not in _governance_gaps(gbare), str(_governance_gaps(gbare))))
        os.makedirs(os.path.join(gbare, "docs"), exist_ok=True)
        open(os.path.join(gbare, "docs", "CONTRIBUTING.md"), "w").write("x")
        results.append(("GOVERN audit honors docs/ location (no false re-scaffold)",
                        "CONTRIBUTING.md" not in _governance_gaps(gbare), str(_governance_gaps(gbare))))
        prt = _govern_template(".github/PULL_REQUEST_TEMPLATE.md", "FerroxLabs", "demo")
        results.append(("GOVERN PR template forbids AI signatures", "AI-generated signatures" in prt, ""))
        results.append(("GOVERN codeowners names the owner",
                        "@FerroxLabs" in _govern_template("CODEOWNERS", "FerroxLabs", "demo"), ""))
        main_sha0 = git(clone, "rev-parse", "main")[1].strip()
        gm = {"schema_version": 1, "repos": {"gsb": {"path": clone, "mainline": "main",
              "fetch_remote": "origin", "push_remote": "origin", "gh_login": "FerroxLabs",
              "worktree_root": os.path.join(tmp, "gov-wt")}}}
        rc_g = govern(gm, ["gsb", "--scaffold"])
        _rcb, branches, _ = git(clone, "for-each-ref", "--format=%(refname:short)", "refs/heads/govern/")
        made = [b for b in branches.splitlines() if b.startswith("govern/scaffold-")]
        scaffolded = False
        if made:
            _rcf, names, _ = git(clone, "show", "--pretty=", "--name-only", made[0])
            scaffolded = ("SECURITY.md" in names and "CONTRIBUTING.md" in names
                          and "PULL_REQUEST_TEMPLATE.md" in names)
        results.append(("GOVERN --scaffold writes the files onto a review branch",
                        rc_g == 0 and bool(made) and scaffolded, str(made[:1])))
        results.append(("GOVERN --scaffold leaves mainline untouched (approval-gated)",
                        git(clone, "rev-parse", "main")[1].strip() == main_sha0, "mainline moved!"))

        # 10. work + gc integration via a synthetic manifest (subprocess, WL_MANIFEST injection)
        sb_manifest = {"schema_version": 1, "min_wl_plane": "0.9.0",
                       "repos": {"sb": {**sb_repo, "suite_cmd": "true"}},
                       "noise_paths": [], "archive_dir": os.path.join(tmp, "archive"),
                       "fetch_ttl_seconds": 300, "sync_warn_behind": 1, "sync_red_behind": 50}
        mpath = os.path.join(tmp, "manifest.json")
        json.dump(sb_manifest, open(mpath, "w"))
        env = dict(os.environ, WL_MANIFEST=mpath)
        me = os.path.abspath(__file__)
        r1 = subprocess.run([sys.executable, me, "work", "sb", "itest-slug"], env=env, capture_output=True, text=True, timeout=60)
        wt_path = os.path.join(tmp, "wt-root", "wt-itest-slug")
        results.append(("WORK creates worktree off fresh origin", r1.returncode == 0 and os.path.isdir(wt_path), r1.stdout[-120:] + r1.stderr[-120:]))
        r1b = subprocess.run([sys.executable, me, "work", "sb", "itest-slug"], env=env, capture_output=True, text=True, timeout=60)
        results.append(("WORK slug collision refused (atomic)", r1b.returncode != 0, r1b.stdout[-80:]))

        # 11. Waves A-D: cards, gates, corpus, reconcile, audit parser, train, adopt — all sandboxed
        wl_home = os.path.join(tmp, "wlhome")
        os.makedirs(os.path.join(wl_home, "state"), exist_ok=True)
        env = dict(os.environ, WL_HOME=wl_home, WL_MANIFEST=mpath, WL_INSTANCE="selftest-agent")
        env.pop("WL_BREAK_GLASS", None)
        me = os.path.abspath(__file__)
        def plane(*a, **kw):
            return subprocess.run([sys.executable, me, *a], env={**env, **kw.get("extra", {})},
                                  capture_output=True, text=True, timeout=120)
        # take → card + worktree
        r_t = plane("take", "card-proof", "--repo", "sb", "--title", "card proof")
        wt_card = os.path.join(tmp, "wt-root", "wt-card-proof")
        cards = json.load(open(os.path.join(wl_home, "state", "workcards.json")))["cards"] if os.path.exists(os.path.join(wl_home, "state", "workcards.json")) else []
        results.append(("TAKE creates card + worktree", r_t.returncode == 0 and os.path.isdir(wt_card)
                        and any(c["slug"] == "card-proof" and c["status"] == "open" for c in cards),
                        r_t.stdout[-120:] + r_t.stderr[-80:]))
        # land refuses a worktree with NO card (use the earlier un-carded itest worktree)
        run(["git", "-C", wt_path, "commit", "-q", "--allow-empty", "-m", "feat: something to land"])
        r_l = plane("land", wt_path, "--no-fuse")
        results.append(("LAND card-gate refuses cardless worktree", r_l.returncode == 2 and "no open work card" in r_l.stdout, r_l.stdout[-140:]))
        # reconcile: cardless worktree = ORPHAN; carded one = OK
        r_r = plane("reconcile")
        results.append(("RECONCILE flags orphan + honors card",
                        r_r.returncode == 1 and "ORPHAN" in r_r.stdout and "card-proof" in r_r.stdout, r_r.stdout[-160:]))
        # corpus: failing card blocks, passing card passes, rm needs --confirm
        r_b1 = plane("bug", "add", "sb", "always-green", "--cmd", "true")
        r_b2 = plane("bug", "add", "sb", "would-block", "--cmd", "false")
        r_c = plane("bug", "list", "sb")
        results.append(("BUG add validates repro passes now",
                        r_b1.returncode == 0 and r_b2.returncode != 0 and "always-green" in r_c.stdout,
                        r_b1.stdout[-60:] + " | " + r_b2.stdout[-90:]))
        # train on the sandbox manifest: green with 'true' scenario, red with 'false'
        sb_manifest2 = json.loads(json.dumps(sb_manifest))
        sb_manifest2["integration"] = {"scenarios": [{"name": "smoke", "repo": "sb", "cmd": "true"}]}
        m2path = os.path.join(tmp, "manifest2.json")
        json.dump(sb_manifest2, open(m2path, "w"))
        r_tr = plane("train", extra={"WL_MANIFEST": m2path})
        sb_manifest2["integration"]["scenarios"][0]["cmd"] = "false"
        json.dump(sb_manifest2, open(m2path, "w"))
        r_tr2 = plane("train", extra={"WL_MANIFEST": m2path})
        ledger = json.load(open(os.path.join(wl_home, "state", "train-ledger.json"))) if os.path.exists(os.path.join(wl_home, "state", "train-ledger.json")) else {"snapshots": []}
        results.append(("TRAIN green + red snapshots recorded",
                        r_tr.returncode == 0 and r_tr2.returncode == 2 and len(ledger["snapshots"]) >= 1,
                        f"g={r_tr.returncode} r={r_tr2.returncode} snaps={len(ledger['snapshots'])}"))
        # cut refuses without a green snapshot matching current refs; then succeeds after green train
        sb_manifest2["integration"]["scenarios"][0]["cmd"] = "true"
        json.dump(sb_manifest2, open(m2path, "w"))
        plane("train", extra={"WL_MANIFEST": m2path})
        r_cut = plane("cut", "rc-selftest", extra={"WL_MANIFEST": m2path})
        results.append(("CUT works only on green snapshot", r_cut.returncode == 0 and "GREEN snapshot" in r_cut.stdout, r_cut.stdout[-120:]))
        # council-fix proofs: fuse gate blocks by default · cut traversal name · illegal promote
        run(["git", "-C", wt_card, "commit", "-q", "--allow-empty", "-m", "feat: carded change"])
        r_lf2 = plane("land", wt_card)  # carded worktree, NO review ack → must abort at the fuse gate
        results.append(("LAND fuse-gate blocks unreviewed by default",
                        r_lf2.returncode == 2 and "review is REQUIRED" in r_lf2.stdout, r_lf2.stdout[-140:]))
        # clean-tree gate (audit MED-HIGH): an UNTRACKED file (invisible to rebase, readable by the
        # suite, never pushed) must abort the land — not sail through as a false-green merge.
        _junk = os.path.join(wt_card, "untracked_junk.txt")
        open(_junk, "w").write("x")
        r_lct = plane("land", wt_card)
        os.remove(_junk)
        results.append(("LAND refuses an unclean worktree (untracked file → no false-green)",
                        r_lct.returncode == 2 and "not clean" in r_lct.stdout, r_lct.stdout[-140:]))
        # FRICTION #3: a repo with NO suite_cmd must NOT sail through green. The sb sandbox has no
        # package.json/Cargo/check-all → detect_repo_check finds nothing → land must REFUSE unless
        # --no-suite is on the record. (Old behavior: printed "SKIP" and continued — a false gate.)
        nosuite = json.loads(json.dumps(sb_manifest)); nosuite["repos"]["sb"].pop("suite_cmd", None)
        nspath = os.path.join(tmp, "manifest-nosuite.json"); json.dump(nosuite, open(nspath, "w"))
        r_ns = plane("land", wt_card, extra={"WL_MANIFEST": nspath})
        results.append(("LAND refuses when no suite_cmd and no repo check detectable (no silent skip)",
                        r_ns.returncode == 2 and "no repo check auto-detected" in r_ns.stdout, r_ns.stdout[-160:]))
        r_nsk = plane("land", wt_card, "--no-suite", extra={"WL_MANIFEST": nspath})
        results.append(("LAND --no-suite is an explicit logged skip (passes the suite step)",
                        "SKIPPED by --no-suite" in r_nsk.stdout, r_nsk.stdout[-160:]))
        # detect_repo_check unit matrix (pure function, no subprocess): empty→refuse, else the check
        dchk = os.path.join(tmp, "dchk"); os.makedirs(dchk, exist_ok=True)
        results.append(("DETECT empty repo → nothing (caller then refuses)", detect_repo_check(dchk) == ("", ""), str(detect_repo_check(dchk))))
        open(os.path.join(dchk, "package.json"), "w").write('{"scripts":{"test":"echo t"}}')
        results.append(("DETECT package.json test script → npm test", detect_repo_check(dchk)[0] == "npm test", str(detect_repo_check(dchk))))
        open(os.path.join(dchk, "check-all.sh"), "w").write("#!/bin/sh\nexit 0\n")
        results.append(("DETECT own check-all.sh wins over language runner", detect_repo_check(dchk) == ("bash check-all.sh", "check-all.sh"), str(detect_repo_check(dchk))))
        # remote gate routing (_gate_exec_plan) — decides WHERE the suite runs, never WHAT.
        fake_h = os.path.join(tmp, "fake-harness.sh"); open(fake_h, "w").write("#!/bin/bash\necho ran\n")
        HZ = {"gate": {"runner": "hetzner", "kind": "cargo", "harness": fake_h, "slot": "s",
                       "command": "nextest run --workspace", "ssh": "root@127.0.0.1", "port": "1"}}
        results.append(("GATE no config → local (unchanged)", _gate_exec_plan({}, "/wt", "cargo test", False) == (["bash", "-lc", "cargo test"], "local", None), str(_gate_exec_plan({}, "/wt", "cargo test", False))))
        results.append(("GATE --local-gate overrides a hetzner block → local", _gate_exec_plan(HZ, "/wt", "cargo test", True)[1] == "local", str(_gate_exec_plan(HZ, "/wt", "cargo test", True))))
        gcmd = _gate_exec_plan(HZ, "/wt", "cargo test", False)
        results.append(("GATE hetzner/cargo builds the harness invocation (slot, wt, cargo args)",
                        gcmd[0] == ["bash", fake_h, "s", "/wt", "nextest", "run", "--workspace"] and gcmd[2] is None, str(gcmd)))
        results.append(("GATE unknown runner → config error (abort, not local)", _gate_exec_plan({"gate": {"runner": "aws"}}, "/wt", "x", False)[2] is not None, ""))
        # TS path: kind=vitest routes to the vitest harness with the SAME suite command the local gate
        # would have run — the only thing that changes is WHERE. (Was "not supported yet" pre-slice-3.)
        VT = {"gate": {"runner": "hetzner", "kind": "vitest", "harness": fake_h, "slot": "app-gate",
                       "command": "bun run test", "ssh": "root@127.0.0.1", "port": "1"}}
        vcmd = _gate_exec_plan(VT, "/wt", "bun run test", False)
        results.append(("GATE hetzner/vitest builds the harness invocation (slot, wt, suite cmd)",
                        vcmd[0] == ["bash", fake_h, "app-gate", "/wt", "bun", "run", "test"] and vcmd[2] is None, str(vcmd)))
        results.append(("GATE --local-gate overrides a vitest block → local (unchanged suite_cmd)",
                        _gate_exec_plan(VT, "/wt", "bun run test", True) == (["bash", "-lc", "bun run test"], "local", None), ""))
        results.append(("GATE unsupported kind (pytest) → config error (abort, not local)",
                        "not supported" in (_gate_exec_plan({"gate": {"runner": "hetzner", "kind": "pytest"}}, "/wt", "x", False)[2] or ""), ""))
        # review HIGH: the remote path runs gate.command, NOT suite_cmd — they legitimately differ
        # (wcore: `cargo test` local vs `nextest run` remote). Pin WHICH one reaches argv with a suite
        # that differs from the command, so this can never silently become "runs suite_cmd" again. (The
        # first version of this test used suite == command and so proved nothing.)
        dcmd = _gate_exec_plan(VT, "/wt", "bun run test && bun run lint && tsc --noEmit", False)
        results.append(("GATE remote executes gate.command, not a differing suite_cmd",
                        dcmd[0] == ["bash", fake_h, "app-gate", "/wt", "bun", "run", "test"], str(dcmd[0])))
        # review MED: slot is interpolated into a root shell on the box. Reject, never sanitize —
        # a silently-rewritten slot would point the gate at a DIFFERENT slot than the operator wrote.
        inj = _gate_exec_plan({"gate": {"runner": "hetzner", "kind": "vitest", "harness": fake_h,
                                        "slot": "a b; rm -rf /", "command": "bun run test", "ssh": "root@h"}},
                              "/wt", "x", False)
        results.append(("GATE slot with shell metacharacters → config error (no root-shell injection)",
                        inj[0] is None and "slot" in (inj[2] or ""), str(inj[2])))
        # The shipped vitest harness must exist and be syntactically valid bash — a broken harness would
        # only surface INSIDE someone's land gate, the worst possible place to find out. Asserted only
        # when running from a SOURCE CHECKOUT (the installed ~/.ratchet/bin copy ships no harness/ dir,
        # and the manifest names the harness by absolute path anyway): in a checkout a missing/broken
        # harness is RED, never a hollow green; from an install it's simply not part of the artifact.
        _root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        if os.path.exists(os.path.join(_root, ".git")):   # worktrees have a .git FILE, repos a dir
            vh = os.path.join(_root, "harness", "remote-vitest.sh")
            vh_rc = subprocess.run(["bash", "-n", vh], capture_output=True).returncode if os.path.exists(vh) else 1
            results.append(("GATE shipped harness/remote-vitest.sh exists and parses as bash", vh_rc == 0, vh))
            # and it must honor the harness interface contract: refuse a call with no command rather than
            # silently ssh'ing a bare `cd` (which would exit 0 = a FALSE GREEN gate with ZERO tests run).
            # Assert the SPECIFIC refusal, not merely rc!=0 — an unrelated `set -u` fault at line 1 also
            # exits non-zero and would green a bare rc!=0 check (review nit: a tautological guard).
            vh_noc = subprocess.run(["bash", vh, "slot", "/wt"], capture_output=True)
            results.append(("GATE vitest harness with no command → refuses (rc=2, names the reason)",
                            vh_noc.returncode == 2 and b"no suite command" in vh_noc.stderr,
                            f"rc={vh_noc.returncode} {vh_noc.stderr[:60]!r}"))
            # a slot name that could escape into the box's root shell must be refused by the harness too
            # (the harness is also invoked by hand, not only via _gate_exec_plan's validation).
            vh_inj = subprocess.run(["bash", vh, "a b; rm -rf /", "/wt", "bun", "run", "test"], capture_output=True)
            results.append(("GATE vitest harness rejects a metacharacter slot before any ssh",
                            vh_inj.returncode == 2 and b"slot" in vh_inj.stderr, f"rc={vh_inj.returncode}"))
            # review BLOCK A: git archive honors export-ignore from the PR's OWN .gitattributes, so a PR
            # could delete its failing tests from the gate. Both harnesses must (1) REFUSE such a tree and
            # (2) ship via a mechanism that is immune anyway. Build a repo with `tests/ export-ignore` and
            # assert BOTH properties against a real git tree (no ssh — the harness exits before that).
            import tempfile as _tf, subprocess as _sp
            def _git(d, *a): return _sp.run(["git", "-C", d, *a], capture_output=True, text=True)
            gi = _tf.mkdtemp()
            _git(gi, "init", "-q"); _git(gi, "config", "user.email", "s@t"); _git(gi, "config", "user.name", "s")
            open(os.path.join(gi, ".gitattributes"), "w").write("tests/ export-ignore\n")
            os.makedirs(os.path.join(gi, "tests"))
            open(os.path.join(gi, "tests", "critical.test.ts"), "w").write("// must reach the gate\n")
            open(os.path.join(gi, "app.ts"), "w").write("export const x = 1\n")
            _git(gi, "add", "-A"); _git(gi, "commit", "-qm", "seed")
            # (1) the harness refuses the export-ignore tree, before ssh (unreachable box coords prove no net)
            eiar = _sp.run(["bash", vh, "app-gate", gi, "bun", "run", "test"], capture_output=True,
                           env={**os.environ, "RATCHET_GATE_SSH": "root@127.0.0.1", "RATCHET_GATE_PORT": "1"})
            results.append(("GATE harness REFUSES a HEAD .gitattributes export-ignore (PR can't hide tests)",
                            eiar.returncode == 2 and b"export-ignore" in eiar.stderr, eiar.stderr[-80:].decode(errors="replace")))
            # (2) the shipped mechanism (checkout-index) keeps the export-ignored file that git archive drops
            arch = _sp.run(["bash", "-lc", f"git -C {gi} archive HEAD | tar -t"], capture_output=True, text=True).stdout
            cidir = _tf.mkdtemp()
            _sp.run(["git", "-C", gi, "checkout-index", "-a", "-f", "--prefix", cidir + "/"], capture_output=True)
            ci_has = os.path.exists(os.path.join(cidir, "tests", "critical.test.ts"))
            results.append(("GATE checkout-index keeps a file that git archive's export-ignore DROPS",
                            ("tests/critical.test.ts" not in arch) and ci_has,
                            f"archive_dropped={'tests/critical.test.ts' not in arch} checkout_index_kept={ci_has}"))
            # review MED: remote-cargo.sh is the OTHER shipped harness and had ZERO coverage — a broken
            # cargo harness would only surface inside a live wcore land. Same interface contract as vitest:
            # exists+parses, refuses no-command (rc=2, names it), rejects a metachar slot, and refuses an
            # export-ignore tree — all BEFORE any ssh (proven by unreachable box coords + no hang).
            ch = os.path.join(_root, "harness", "remote-cargo.sh")
            ch_rc = subprocess.run(["bash", "-n", ch], capture_output=True).returncode if os.path.exists(ch) else 1
            results.append(("GATE shipped harness/remote-cargo.sh exists and parses as bash", ch_rc == 0, ch))
            ch_noc = subprocess.run(["bash", ch, "slot", "/wt"], capture_output=True)
            results.append(("GATE cargo harness with no command → refuses (rc=2, names the reason)",
                            ch_noc.returncode == 2 and b"no cargo command" in ch_noc.stderr,
                            f"rc={ch_noc.returncode} {ch_noc.stderr[:60]!r}"))
            ch_inj = subprocess.run(["bash", ch, "a b; rm -rf /", "/wt", "nextest", "run"], capture_output=True)
            results.append(("GATE cargo harness rejects a metacharacter slot before any ssh",
                            ch_inj.returncode == 2 and b"slot" in ch_inj.stderr, f"rc={ch_inj.returncode}"))
            ch_ei = subprocess.run(["bash", ch, "wcore-gate", gi, "nextest", "run"], capture_output=True,
                                   env={**os.environ, "RATCHET_GATE_SSH": "root@127.0.0.1", "RATCHET_GATE_PORT": "1"})
            results.append(("GATE cargo harness REFUSES a HEAD .gitattributes export-ignore",
                            ch_ei.returncode == 2 and b"export-ignore" in ch_ei.stderr, ch_ei.stderr[-80:].decode(errors="replace")))
        results.append(("GATE missing required field → error", _gate_exec_plan({"gate": {"runner": "hetzner", "kind": "cargo", "harness": fake_h, "slot": "s"}}, "/wt", "x", False)[2] is not None, ""))
        results.append(("GATE harness path not found → error", _gate_exec_plan({"gate": {"runner": "hetzner", "kind": "cargo", "harness": "/nope/x.sh", "slot": "s", "command": "c", "ssh": "root@h"}}, "/wt", "x", False)[2] is not None, ""))
        # FAIL CLOSED integration: a hetzner gate whose box is unreachable must ABORT the land (never
        # silently run local). Land wt_card under a manifest with sb.gate → unreachable ssh → abort.
        gate_m = json.loads(json.dumps(sb_manifest)); gate_m["repos"]["sb"]["gate"] = HZ["gate"]
        gmpath = os.path.join(tmp, "manifest-gate.json"); json.dump(gate_m, open(gmpath, "w"))
        r_gate = plane("land", wt_card, "--fuse-done", extra={"WL_MANIFEST": gmpath})
        results.append(("GATE remote unreachable → land ABORTS fail-closed (no silent local fallback)",
                        r_gate.returncode == 2 and "UNREACHABLE" in r_gate.stdout, r_gate.stdout[-160:]))
        # review BLOCK fix: the remote slot is a shared box dir — concurrent lands on the SAME slot must
        # NOT race (Frankenstein tree → possible false green). _gate_slot_lock serializes them.
        L1 = _gate_slot_lock("selftest-slotA")
        L2 = _gate_slot_lock("selftest-slotA")   # same slot, held → must refuse
        L3 = _gate_slot_lock("selftest-slotB")   # different slot → independent, granted
        results.append(("GATE slot lock: same slot held → second acquire refused (no concurrent share)",
                        L1 is not None and L2 is None and L3 is not None, f"L1={bool(L1)} L2={bool(L2)} L3={bool(L3)}"))
        if L1: L1.close()
        L4 = _gate_slot_lock("selftest-slotA")   # released → re-acquirable
        results.append(("GATE slot lock: releases on close (next land can acquire)", L4 is not None, str(bool(L4))))
        for _h in (L3, L4):
            if _h: _h.close()
        # review nit #3: a command token with embedded whitespace would be re-split by the harness →
        # reject at plan time rather than run a silently-wrong command.
        ws = _gate_exec_plan({"gate": {"runner": "hetzner", "kind": "cargo", "harness": fake_h, "slot": "s",
                                       "command": 'nextest run --message-format "human readable"', "ssh": "root@h"}}, "/wt", "x", False)
        results.append(("GATE whitespace-in-token command → error (harness re-splits remotely)",
                        ws[0] is None and "whitespace" in (ws[2] or ""), str(ws[2])))
        # Makefile tier: a real `test:` target is found, but `.PHONY: test` / `test-unit:` must NOT
        # misfire the ^-anchored regex (the one heuristic path in detect_repo_check).
        dmk = os.path.join(tmp, "dmk"); os.makedirs(dmk, exist_ok=True)
        open(os.path.join(dmk, "Makefile"), "w").write(".PHONY: test\ntest:\n\techo running\n")
        results.append(("DETECT Makefile test target → make test", detect_repo_check(dmk) == ("make test", "Makefile test target"), str(detect_repo_check(dmk))))
        dmk2 = os.path.join(tmp, "dmk2"); os.makedirs(dmk2, exist_ok=True)
        open(os.path.join(dmk2, "Makefile"), "w").write(".PHONY: test\ntest-unit:\n\techo x\n")
        results.append(("DETECT Makefile with only test-unit → nothing (no ^test:/^check: misfire)", detect_repo_check(dmk2) == ("", ""), str(detect_repo_check(dmk2))))
        r_ct = plane("cut", "../evil", extra={"WL_MANIFEST": m2path})
        results.append(("CUT refuses path-traversal name", r_ct.returncode == 1 and "must be" in r_ct.stdout, r_ct.stdout[-80:]))
        plane("rollback", "rc-selftest", extra={"WL_MANIFEST": m2path})
        r_pr = plane("promote", "rc-selftest", extra={"WL_MANIFEST": m2path})
        results.append(("PROMOTE refused after rollback", r_pr.returncode == 2 and "REFUSE" in r_pr.stdout, r_pr.stdout[-100:]))
        # audit parser: pure-function fixture (no network)
        d1, d2 = os.path.join(tmp, "dep-a"), os.path.join(tmp, "dep-b")
        os.makedirs(d1); os.makedirs(d2)
        open(os.path.join(d1, "Cargo.lock"), "w").write('[[package]]\nname = "serde"\nversion = "1.0.0"\n')
        open(os.path.join(d2, "Cargo.lock"), "w").write('[[package]]\nname = "serde"\nversion = "1.0.0"\n\n[[package]]\nname = "sneaky"\nversion = "0.1.0"\n')
        delta = parse_deps(d2, "rust") - parse_deps(d1, "rust")
        results.append(("AUDIT parser isolates the delta", delta == {("crates.io", "sneaky", "0.1.0")}, str(delta)))
        # adopt: local sandbox repo → manifest entry + hooks (isolated manifest copy)
        m3path = os.path.join(tmp, "manifest3.json")
        json.dump(sb_manifest, open(m3path, "w"))
        adoptee = os.path.join(tmp, "adoptee")
        run(["git", "clone", "-q", upstream, adoptee])
        open(os.path.join(adoptee, "requirements.txt"), "w").write("requests==2.31.0\n")
        r_ad = plane("adopt", adoptee, "--name", "adoptee", extra={"WL_MANIFEST": m3path})
        m3 = json.load(open(m3path))
        results.append(("ADOPT registers repo + installs hooks",
                        r_ad.returncode == 0 and "adoptee" in m3["repos"] and m3["repos"]["adoptee"]["lang"] == "python"
                        and os.path.exists(os.path.join(adoptee, ".git", "hooks", "pre-push")),
                        r_ad.stdout[-140:] + r_ad.stderr[-60:]))

        # 11c. resilience proofs (v0.10.2 — final-audit code findings)
        # crashed take: a PENDING card whose worktree exists was unrecoverable by ANY verb.
        # reconcile must flag it (STUCK) and --reap must finalize it to open.
        cards_p = os.path.join(wl_home, "state", "workcards.json")
        cj = json.load(open(cards_p))
        for c in cj["cards"]:
            if c["slug"] == "card-proof":
                c["status"] = "pending"
        json.dump(cj, open(cards_p, "w"))
        r_rec1 = plane("reconcile")
        r_rec2 = plane("reconcile", "--reap")
        cj2 = json.load(open(cards_p))
        results.append(("RECONCILE recovers crashed take (pending→open)",
                        "STUCK" in r_rec1.stdout and "RECOVERED" in r_rec2.stdout
                        and any(c["slug"] == "card-proof" and c["status"] == "open" for c in cj2["cards"]),
                        r_rec1.stdout[-90:] + " | " + r_rec2.stdout[-90:]))
        # concurrent land: a 'landing' card with a LIVE claimant pid must refuse a second land
        cj3 = json.load(open(cards_p))
        for c in cj3["cards"]:
            if c["slug"] == "card-proof":
                # self-consistent claim: pid AND its start-time (the pid-reuse binding rightly
                # rejects a pid paired with someone else's start-time — proven when a stale
                # land_pid_start from an earlier gate test made this exact test re-claim)
                c["status"] = "landing"; c["land_pid"] = os.getpid()
                c["land_pid_start"] = pid_start(os.getpid())
        json.dump(cj3, open(cards_p, "w"))
        r_l2 = plane("land", wt_card, "--no-fuse")
        results.append(("LAND refuses concurrent land (live claimant)",
                        r_l2.returncode == 2 and "in progress" in r_l2.stdout, r_l2.stdout[-120:]))
        # crash re-run: a DEAD claimant's card must be re-claimed and the gate re-entered
        cj4 = json.load(open(cards_p))
        for c in cj4["cards"]:
            if c["slug"] == "card-proof":
                c["land_pid"] = 2 ** 22 + 7919  # far past pid space on macOS, prime offset dodges reuse
        json.dump(cj4, open(cards_p, "w"))
        r_l3 = plane("land", wt_card, "--no-fuse")
        results.append(("LAND re-claims a dead claimant's card",
                        "in progress" not in r_l3.stdout and "pushed" in r_l3.stdout, r_l3.stdout[-140:]))
        # the gate journals ALL FOUR steps (the glass stepper's source), and diff facts land in
        # the recording AT LAND TIME — worktrees get GC'd; nothing ever re-runs git on page view.
        # Honesty: this land skipped the fuse (--no-fuse), so the stepper must say review:skipped
        # — a skip recorded as "review" is a stepper that lies about a station that never ran.
        jd_l = json.load(open(os.path.join(wl_home, "state", "journals.json")))
        step_sets = [{s["label"] for s in r2.get("steps", [])}
                     for r2 in jd_l.get("runs", []) if r2["verb"] == "land"]
        wid_cp = next(c["work_id"] for c in json.load(open(cards_p))["cards"] if c["slug"] == "card-proof")
        ev_cp = open(os.path.join(wl_home, "state", "recordings", wid_cp, "events.jsonl")).read()
        results.append(("LAND journals all 4 gate steps (skips marked honest) + diff facts at land time",
                        any({"rebase", "suite", "review:skipped", "pushed"} <= s and "review" not in s
                            for s in step_sets)
                        and '"diff_facts"' in ev_cp and '"subjects"' in ev_cp,
                        f"steps={[sorted(s) for s in step_sets][-1:]}"))
        # a suite FAILURE leaves its output tail in the recording dir — the glass shows the
        # failing step's last lines without re-running anything — and the abort names its station
        sb_fail = json.loads(json.dumps(sb_manifest))
        sb_fail["repos"]["sb"]["suite_cmd"] = "echo tail-marker-xyz; false"
        mfail = os.path.join(tmp, "manifest-fail.json")
        json.dump(sb_fail, open(mfail, "w"))
        plane("take", "tail-proof", "--repo", "sb", "--title", "tail proof", extra={"WL_MANIFEST": mfail})
        wt_tail = os.path.join(tmp, "wt-root", "wt-tail-proof")
        run(["git", "-C", wt_tail, "commit", "-q", "--allow-empty", "-m", "feat: tail proof"])
        r_lt = plane("land", wt_tail, "--no-fuse", extra={"WL_MANIFEST": mfail})
        wid_tail = next(c["work_id"] for c in json.load(open(cards_p))["cards"] if c["slug"] == "tail-proof")
        tailp = os.path.join(wl_home, "state", "recordings", wid_tail, "suite-tail.txt")
        jd_t = json.load(open(os.path.join(wl_home, "state", "journals.json")))
        t_runs = [r2 for r2 in jd_t.get("runs", []) if r2["verb"] == "land" and r2.get("outcome") == "aborted:suite"]
        results.append(("LAND suite failure captures the output tail + journals the abort station",
                        r_lt.returncode == 2 and os.path.exists(tailp)
                        and "tail-marker-xyz" in open(tailp).read()
                        and t_runs and "rebase" in {s["label"] for s in t_runs[-1]["steps"]},
                        r_lt.stdout[-100:]))

        # 11d. E0 foundations: config · redaction · journals · schema migration · write discipline
        # config: pure defaults; unknown key REFUSES; newer schema REFUSES (isolated home per case)
        cfg_home = os.path.join(tmp, "cfghome")
        os.makedirs(os.path.join(cfg_home, "state"), exist_ok=True)
        r_c0 = plane("config", extra={"WL_HOME": cfg_home})
        okc0 = r_c0.returncode == 0 and "pure defaults" in r_c0.stdout and "premium_policy" in r_c0.stdout
        json.dump({"schema_version": 1, "premium_polcy": "never"}, open(os.path.join(cfg_home, "state", "config.json"), "w"))
        r_c1 = plane("config", extra={"WL_HOME": cfg_home})
        okc1 = r_c1.returncode != 0 and "UNKNOWN" in (r_c1.stdout + r_c1.stderr)
        json.dump({"schema_version": 99}, open(os.path.join(cfg_home, "state", "config.json"), "w"))
        r_c2 = plane("config", extra={"WL_HOME": cfg_home})
        okc2 = r_c2.returncode != 0 and "NEWER" in (r_c2.stdout + r_c2.stderr)
        json.dump({"schema_version": 1, "premium_policy": "allowed"}, open(os.path.join(cfg_home, "state", "config.json"), "w"))
        r_c3 = plane("config", extra={"WL_HOME": cfg_home})
        okc3 = r_c3.returncode == 0 and '[file   ] "allowed"' in r_c3.stdout
        results.append(("CONFIG defaults + unknown-key refuse + newer-schema refuse + file override",
                        okc0 and okc1 and okc2 and okc3,
                        f"d={r_c0.returncode} unk={r_c1.returncode} new={r_c2.returncode} ovr={r_c3.returncode}"))
        # redaction: pure function — a secret in any string never survives to the captured form
        leak = redact({"stream": "auth ok api_key = 'sk-" + "a" * 24 + "' done", "n": 3})
        results.append(("REDACT scrubs secrets before capture",
                        "sk-" not in json.dumps(leak) and "[REDACTED" in leak["stream"] and leak["n"] == 3,
                        json.dumps(leak)[:100]))
        # flight recorder: the dead-claimant land above pushed through the gate → events on disk,
        # and a recorder write with a live secret lands redacted
        rec_dir = os.path.join(wl_home, "state", "recordings")
        recs = os.listdir(rec_dir) if os.path.isdir(rec_dir) else []
        rec_ok = False
        if recs:
            body = open(os.path.join(rec_dir, recs[0], "events.jsonl")).read()
            rec_ok = "land_gate" in body and "sk-" not in body
        results.append(("RECORDER writes per-card flight events", rec_ok, f"cards recorded: {recs}"))
        # journals: the sandbox train (green) completed its run; a fabricated dead-pid run is
        # reported INTERRUPTED by reconcile and closed by --reap
        jpath = os.path.join(wl_home, "state", "journals.json")
        jd = json.load(open(jpath)) if os.path.exists(jpath) else {"runs": []}
        train_done = any(r["verb"] == "train" and r.get("done") for r in jd.get("runs", []))
        jd.setdefault("runs", []).append({"run_id": "deadbeef00", "verb": "land", "ref": "/x",
                                          "pid": 2 ** 22 + 7919, "started": now_iso(),
                                          "steps": [{"label": "pushed", "ts": now_iso()}], "done": False})
        json.dump(jd, open(jpath, "w"))
        r_j1 = plane("reconcile")
        r_j2 = plane("reconcile", "--reap")
        jd2 = json.load(open(jpath))
        j_closed = all(r.get("done") for r in jd2.get("runs", []) if r["run_id"] == "deadbeef00")
        results.append(("JOURNAL records runs + reconcile flags/reaps interrupted ones",
                        train_done and "INTERRUPTED land" in r_j1.stdout and j_closed,
                        f"train_done={train_done} | {r_j1.stdout[-90:]}"))
        # schema migration: an unversioned state file gains schema_version on next write, ledgered
        cpath = os.path.join(wl_home, "state", "workcards.json")
        cjm = json.load(open(cpath))
        cjm.pop("schema_version", None)
        json.dump(cjm, open(cpath, "w"))
        plane("take", "mig-proof", "--repo", "sb", "--title", "migration proof")
        cjm2 = json.load(open(cpath))
        tel = open(os.path.join(wl_home, "state", "telemetry.jsonl")).read()
        results.append(("STATE forward-migration stamps + ledgers",
                        cjm2.get("schema_version") == 1 and "state_migrated" in tel,
                        f"ver={cjm2.get('schema_version')}"))
        # newer state refuses loudly
        cjm2["schema_version"] = 99
        json.dump(cjm2, open(cpath, "w"))
        r_new = plane("take", "too-new", "--repo", "sb")
        cjm2["schema_version"] = 1
        json.dump(cjm2, open(cpath, "w"))
        results.append(("STATE newer-than-kernel refuses",
                        r_new.returncode != 0 and "NEWER" in (r_new.stdout + r_new.stderr), r_new.stderr[-90:]))
        # write-path discipline: state_save is called ONLY by state_mutate (§10 invariant);
        # adopt's pid-unique PROBE manifest is the single sanctioned exception
        import ast as _ast
        offenders = set()
        for node in _ast.walk(_ast.parse(open(me).read())):
            if isinstance(node, _ast.FunctionDef):
                for sub in _ast.walk(node):
                    if (isinstance(sub, _ast.Call) and getattr(sub.func, "id", "") == "state_save"
                            and node.name != "state_mutate"):
                        offenders.add(node.name)
        results.append(("STATE write-path discipline (state_save only via state_mutate)",
                        offenders <= {"adopt"}, f"offenders: {sorted(offenders)}"))

        # 11e. E2: canonicalizer + structural disagreement + bulk plan import
        va = canonicalize_verdict({"verdict": "fix_first", "findings": [
            {"severity": "blocker", "file": "B.py", "claim": "  Race   in take "},
            {"severity": "MAJOR", "file": "a.py", "claim": "x"}]})
        vb = canonicalize_verdict({"verdict": "FIX-FIRST", "findings": [
            {"severity": "BLOCKER", "file": "b.py", "claim": "race in TAKE"}]})
        vc = canonicalize_verdict({"verdict": "GO", "findings": []})
        results.append(("CANONICALIZE normalizes; disagreement is structural not textual",
                        not verdicts_disagree(va, vb) and verdicts_disagree(va, vc)
                        and va["claims"][0]["severity"] == "BLOCKER",
                        json.dumps(va)[:90]))
        # bulk import: valid plan → N cards; invalid plan → refused whole, ZERO cards
        planp = os.path.join(tmp, "plan.json")
        json.dump({"schema_version": 1, "cards": [
            {"slug": "bulk-a", "repo": "sb", "title": "bulk card A"},
            {"slug": "bulk-b", "repo": "sb", "title": "bulk card B"}]}, open(planp, "w"))
        r_bk = plane("take", "--bulk", planp)
        cards_now = json.load(open(os.path.join(wl_home, "state", "workcards.json")))["cards"]
        n_bulk = sum(1 for c in cards_now if c["slug"].startswith("bulk-") and c["status"] == "open")
        json.dump({"schema_version": 1, "cards": [
            {"slug": "bulk-c", "repo": "sb", "title": "ok"},
            {"slug": "bulk-d", "repo": "NOPE", "title": "bad repo"}]}, open(planp, "w"))
        r_bk2 = plane("take", "--bulk", planp)
        cards_now2 = json.load(open(os.path.join(wl_home, "state", "workcards.json")))["cards"]
        results.append(("TAKE --bulk imports valid plans; refuses invalid WHOLE",
                        r_bk.returncode == 0 and n_bulk == 2 and r_bk2.returncode != 0
                        and not any(c["slug"] in ("bulk-c", "bulk-d") for c in cards_now2),
                        f"n={n_bulk} r2={r_bk2.returncode}"))

        # 11f. E0 audit fixes (fix-forward round): redaction depth, pid-reuse, migration chain
        deep = redact({"sk-" + "q" * 20: ["nested", ("tuple", "glpat-" + "r" * 20)],
                       "jwt": "eyJ" + "a" * 10 + ".eyJ" + "b" * 10 + "." + "c" * 12,
                       "url": "https://x.y/cb?token=supersecret123&x=1"})
        flat = json.dumps(deep)
        results.append(("REDACT covers keys, tuples, jwt, urls, vendor families",
                        all(s not in flat for s in ("sk-qqqq", "glpat-rrrr", "eyJaaaa", "supersecret123")),
                        flat[:110]))
        results.append(("PID-REUSE binding: same pid, different start-time = NOT the claimant",
                        pid_is_claimant(os.getpid(), pid_start(os.getpid()))
                        and not pid_is_claimant(os.getpid(), "Thu Jan  1 00:00:00 1970"),
                        pid_start(os.getpid())[:30]))
        # migration chain: a version bump without its step must refuse, never blind-stamp
        r_mig = subprocess.run([sys.executable, "-c",
            "import importlib.machinery, importlib.util, sys\n"
            f"L=importlib.machinery.SourceFileLoader('k','{me}')\n"
