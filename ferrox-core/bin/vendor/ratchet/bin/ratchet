        results.append(("INIT wizard renders lanes + default dispatch + suggestions (no silent install)",
                        r_wiz.returncode == 0 and "agent lanes discovered" in r_wiz.stdout
                        and "you're set" in r_wiz.stdout,
                        r_wiz.stdout[:60]))

        # 11j. security hardening (security-council fold)
        results.append(("SAFE_REF rejects traversal, slashes, leading dots; accepts ids",
                        safe_ref("85af6d552e") == "85af6d552e" and safe_ref("rc-godmode-1") == "rc-godmode-1"
                        and safe_ref("..") is None and safe_ref("../x") is None
                        and safe_ref("a/b") is None and safe_ref(".hidden") is None and safe_ref("") is None,
                        "ref guard"))
        # clean_env allowlists: a secret in the parent env never reaches the child map
        os.environ["GH_TOKEN"] = "ghp_" + "z" * 30
        os.environ["OPENAI_API_KEY"] = "sk-" + "z" * 30
        ce = clean_env({"RATCHET_CARD": "x"})
        del os.environ["GH_TOKEN"]; del os.environ["OPENAI_API_KEY"]
        results.append(("CLEAN_ENV allowlist strips GH_TOKEN / *_API_KEY, keeps PATH + RATCHET_*",
                        "GH_TOKEN" not in ce and "OPENAI_API_KEY" not in ce and "PATH" in ce
                        and ce.get("RATCHET_CARD") == "x", f"keys={sorted(ce)[:5]}"))
        # the agent must not be handed a signpost to kernel state (no RATCHET_HOME/MANIFEST/WL_*)
        os.environ["RATCHET_HOME"] = "/some/state"; os.environ["WL_MANIFEST"] = "/m.json"
        ce2 = clean_env({"RATCHET_CARD": "y"})
        del os.environ["RATCHET_HOME"]; del os.environ["WL_MANIFEST"]
        results.append(("CLEAN_ENV does not signpost state (no RATCHET_HOME/MANIFEST/WL_*)",
                        "RATCHET_HOME" not in ce2 and "RATCHET_MANIFEST" not in ce2 and "WL_MANIFEST" not in ce2,
                        f"leaked={[k for k in ce2 if 'HOME' in k or 'MANIFEST' in k]}"))
        # kill/pause/resume refuse a traversal id instead of reading a forged events.jsonl
        r_kt = plane("kill", "../../../etc/passwd")
        results.append(("KILL refuses a path-traversal card id",
                        r_kt.returncode == 1 and "not a valid card id" in r_kt.stdout, r_kt.stdout[-70:]))
        # glass --bind-all refuses without the explicit exposure ack
        r_ba = plane("watch", "--serve", "--bind-all", "--port", "0")
        results.append(("GLASS --bind-all refuses without RATCHET_GLASS_EXPOSE=1",
                        r_ba.returncode == 2 and "REFUSE" in r_ba.stdout, r_ba.stdout[-70:]))
        # contract callback: a poisoned endpoint host, and a host-credential key_env, both refuse
        # BEFORE any secret is attached (no token ever leaves for the attacker's server)
        st_evil = check_contract({"fetch_ttl_seconds": 300},
                                 {"gh_login": "x", "contract": {"endpoint": "https://attacker.com/steal",
                                  "key_env": ["FLUX_DEV_KEY"], "required_aliases": ["a"]}})
        st_badkey = check_contract({"fetch_ttl_seconds": 300},
                                   {"gh_login": "x", "contract": {"endpoint": "https://api.fluxrouter.ai/v1/models",
                                    "key_env": ["GH_TOKEN"], "required_aliases": ["a"]}})
        results.append(("CONTRACT refuses attacker host + host-credential key_env before sending",
                        st_evil[0] == RED and "allowlist" in st_evil[1]
                        and st_badkey[0] == RED and "host credential" in st_badkey[1],
                        f"{st_evil[0]}/{st_badkey[0]}"))

        # 11b. pure functions: pin extraction + version compare
        fx = "const DEFAULT_WCORE_VERSION = 'v0.12.24';"
        mt = re.search(r"DEFAULT_WCORE_VERSION = '(v[0-9][0-9.]*)'", fx)
        results.append(("PIN regex extracts", bool(mt and mt.group(1) == "v0.12.24"), f"got {mt.group(1) if mt else None}"))
        results.append(("vtuple orders correctly",
                        vtuple("v0.9.4") < vtuple("v0.12.24") < vtuple("v0.12.24-wayland-3.1"),
                        "v0.9.4 < v0.12.24 <= suffixed"))
        results.append(("BRANCH_FOR maps slugs consistently (work create == take rollback)",
                        branch_for("add-thing") == "feat/add-thing"
                        and branch_for("fix-thing") == "fix/thing"
                        and branch_for("chore-bump") == "chore/bump", ""))

        # 12. overwatch verb family — the never-idle team loop as a tested feature (FRICTION #1+#2).
        # Overwatch's build order: prove the answer-already-there race (#2) FIRST (red), then the
        # flag-time baseline fix (green). Same pre-arm-answer scenario, two baseline strategies.
        ow_home = os.path.join(tmp, "owhome")
        ow_env = dict(os.environ, RATCHET_HOME=ow_home); ow_env.pop("WL_HOME", None); ow_env.pop("WL_MANIFEST", None)
        def ow(*a):
            return subprocess.run([sys.executable, me, "overwatch", *a], env=ow_env, capture_output=True, text=True, timeout=30)
        # RED — reproduce the race: NO flag on record → await baselines at ARM time. An answer that
        # arrived before await is armed is invisible (current == arm-time baseline) → await MISSES it.
        ow("register", "t1"); ow("respond", "t1", "--text", "answer-A")
        r_arm = ow("await", "t1", "--once")
        results.append(("OVERWATCH arm-time baseline MISSES a pre-arm answer (race #2, reproduced red)",
                        r_arm.returncode == 3 and "no flag on record" in r_arm.stdout, r_arm.stdout[-120:]))
        # GREEN — the fix: flag FIRST (freezes sha(BRIEF) at flag time), THEN the answer lands in the
        # gap before await is armed. await compares live-vs-frozen → fires immediately.
        ow("register", "t2"); ow("flag", "t2", "--text", "decide X")
        r_sweep_open = ow("sweep", "--json")
        ow("respond", "t2", "--text", "answer-B")
        r_fix = ow("await", "t2", "--once")
        results.append(("OVERWATCH flag-time baseline CATCHES the pre-arm answer (race #2 fixed green)",
                        r_fix.returncode == 0 and "advanced past the baseline" in r_fix.stdout, r_fix.stdout[-120:]))
        # sweep derives open/answered from the SAME sha the waker uses — never out of sync
        def _openct(js, team):
            d = json.loads(js); return next(((1 if t["flag_state"] == "open" else 0) for t in d["teams"] if t["team"] == team), None)
        r_sweep_after = ow("sweep", "--json")
        results.append(("OVERWATCH sweep: flag OPEN before the answer, CLEAR after (derived from sha)",
                        _openct(r_sweep_open.stdout, "t2") == 1 and _openct(r_sweep_after.stdout, "t2") == 0,
                        f"{_openct(r_sweep_open.stdout,'t2')}→{_openct(r_sweep_after.stdout,'t2')}"))
        # regression (adversarial review): once await fired for t2 it CONSUMED the flag, so a later
        # bare await must NOT re-fire on a stale flag — it falls back to arm-time (rc 3), not a false
        # "responded". This is the multi-cycle hole the pile-of-flags model had.
        r_cycle2 = ow("await", "t2", "--once")
        results.append(("OVERWATCH await after pickup does NOT false-fire on a stale flag (rc 3)",
                        r_cycle2.returncode == 3 and "no flag on record" in r_cycle2.stdout, r_cycle2.stdout[-120:]))
        # re-flag re-baselines at the CURRENT brief, so a fresh ask doesn't inherit the old answer
        ow("flag", "t2", "--text", "decide Y")
        r_reflag = ow("await", "t2", "--once")
        results.append(("OVERWATCH re-flag re-baselines at current brief (waits, rc 3, no stale fire)",
                        r_reflag.returncode == 3, r_reflag.stdout[-120:]))
        # singular flag: a second flag before any answer REPLACES the first — never two open flags
        # sharing a baseline that one respond would ambiguously close.
        ow("register", "t4"); ow("flag", "t4", "--text", "ask A"); ow("flag", "t4", "--text", "ask B")
        results.append(("OVERWATCH at most one live flag per team (2nd flag replaces, no pile)",
                        _openct(ow("sweep", "--json").stdout, "t4") == 1, "expected exactly 1 open flag"))
        # regression (re-review): consume-on-fire is COMPARE-and-delete. A background await that
        # baselined against flag A must NOT eat flag B if the team re-flagged during its sleep. Tested
        # in-process against the same sandbox home (deterministic — no timing window).
        _saved = os.environ.get("RATCHET_HOME")
        os.environ["RATCHET_HOME"] = ow_home
        try:
            ow("register", "tcd"); ow("flag", "tcd", "--text", "A")
            fa = (_ow_load_flag("tcd") or {}).get("flag_id")
            ow("respond", "tcd", "--text", "answer-A")           # brief moves; A is now answerable
            ow("flag", "tcd", "--text", "B")                     # team re-flags B before the awaiter wakes
            fb = (_ow_load_flag("tcd") or {}).get("flag_id")
            _ow_clear_flag("tcd", fa)                            # the stale awaiter (baselined on A) fires
            kept = _ow_load_flag("tcd")
            results.append(("OVERWATCH consume-on-fire won't eat a newer flag (compare-and-delete)",
                            kept is not None and kept.get("flag_id") == fb and fa != fb, str(kept)))
            _ow_clear_flag("tcd", fb)                            # matching id → really consumes
            results.append(("OVERWATCH consume-on-fire deletes when the flag_id matches",
                            _ow_load_flag("tcd") is None, "flag should be gone"))
        finally:
            if _saved is None:
                os.environ.pop("RATCHET_HOME", None)
            else:
                os.environ["RATCHET_HOME"] = _saved
        # timeout path: flagged, unanswered, tiny timeout → exit 2 with re-flag guidance
        ow("register", "t3"); ow("flag", "t3", "--text", "q")
        r_to = ow("await", "t3", "--timeout", "1", "--interval", "1")
        results.append(("OVERWATCH await times out (exit 2) with re-flag guidance when unanswered",
                        r_to.returncode == 2 and "re-flag" in r_to.stdout, r_to.stdout[-120:]))
        # register is idempotent: a second register must NOT clobber an edited brief
        briefp = os.path.join(ow_home, "overwatch", "t1", "BRIEF.md")
        open(briefp, "a").write("EDITED-MARKER\n"); ow("register", "t1")
        results.append(("OVERWATCH register is idempotent (won't clobber an existing brief)",
                        "EDITED-MARKER" in open(briefp).read(), "brief clobbered!"))

        # 13. overwatch LIVENESS (item-1 amendment) — heartbeat + dead-waker detection. Isolated home so
        # counts are deterministic. Failure-first per Overwatch: seed a stale-heartbeat working team and
        # assert sweep flags it SILENT (the exact wayland-core incident).
        lhome = os.path.join(tmp, "owhome-live")
        lenv = dict(os.environ, RATCHET_HOME=lhome); lenv.pop("WL_HOME", None); lenv.pop("WL_MANIFEST", None)
        def owl(*a):
            return subprocess.run([sys.executable, me, "overwatch", *a], env=lenv, capture_output=True, text=True, timeout=30)
        def seed(team, hb=None, awaiting=None):
            d = os.path.join(lhome, "overwatch", team, ".waker"); os.makedirs(d, exist_ok=True)
            if hb is not None: json.dump(hb, open(os.path.join(d, "heartbeat.json"), "w"))
            if awaiting is not None: json.dump(awaiting, open(os.path.join(d, "awaiting.json"), "w"))
        def livemap(js):
            return {t["team"]: t["state"] for t in json.loads(js)["teams"]}
        # a definitely-dead pid: spawn a trivial child and reap it
        _d = subprocess.Popen([sys.executable, "-c", "pass"]); _d.wait(); dead_pid = _d.pid
        owl("register", "lv_silent"); seed("lv_silent", hb={"team": "lv_silent", "ts": time.time() - 9999, "state": "working"})
        owl("register", "lv_ok"); owl("beat", "lv_ok", "--state", "working")
        owl("register", "lv_idle"); owl("beat", "lv_idle", "--state", "idle-empty")
        owl("register", "lv_dead"); owl("flag", "lv_dead", "--text", "need a call")
        seed("lv_dead", hb={"team": "lv_dead", "ts": time.time() - 30, "state": "blocked"},
             awaiting={"team": "lv_dead", "pid": dead_pid, "since_ts": time.time() - 60, "flag_id": "z"})
        owl("register", "lv_live"); owl("flag", "lv_live", "--text", "need a call")
        seed("lv_live", awaiting={"team": "lv_live", "pid": os.getpid(), "since_ts": time.time() - 60, "flag_id": "z"})
        # anti-PID-REUSE: a LIVE pid whose recorded start-time doesn't match (the marker's pid was
        # recycled by an unrelated process) must read as a DEAD waker → SILENT, not a live one.
        owl("register", "lv_reuse"); owl("flag", "lv_reuse", "--text", "need a call")
        seed("lv_reuse", awaiting={"team": "lv_reuse", "pid": os.getpid(),
                                   "pid_start": "Thu Jan  1 00:00:00 1999", "since_ts": time.time() - 60, "flag_id": "z"})
        owl("register", "lv_fresh")  # registered, never beat, no flag → unknown, NOT an alarm
        # review regression: a stale heartbeat in state=blocked/idle-empty WITH NO live marker must be
        # SILENT — the original bug read these as 'ok' because staleness only checked working/None.
        owl("register", "lv_blk_stale"); seed("lv_blk_stale", hb={"team": "lv_blk_stale", "ts": time.time() - 9999, "state": "blocked"})
        owl("register", "lv_idle_stale"); seed("lv_idle_stale", hb={"team": "lv_idle_stale", "ts": time.time() - 9999, "state": "idle-empty"})
        lm = livemap(owl("sweep", "--json").stdout)
        results.append(("OVERWATCH LIVENESS stale working heartbeat → SILENT (the incident)", lm.get("lv_silent") == "SILENT", str(lm)))
        results.append(("OVERWATCH LIVENESS fresh beat → live/ok", lm.get("lv_ok") == "ok", str(lm)))
        results.append(("OVERWATCH LIVENESS idle-empty fresh → not alarmed", lm.get("lv_idle") == "idle-empty", str(lm)))
        results.append(("OVERWATCH LIVENESS blocked + dead waker pid → SILENT (overnight incident)", lm.get("lv_dead") == "SILENT", str(lm)))
        results.append(("OVERWATCH LIVENESS blocked + live waker pid → blocked, not alarmed", lm.get("lv_live") == "blocked", str(lm)))
        results.append(("OVERWATCH LIVENESS live pid but mismatched start-time → SILENT (anti-PID-reuse)", lm.get("lv_reuse") == "SILENT", str(lm)))
        results.append(("OVERWATCH LIVENESS registered-but-never-beat → unknown, not a false SILENT", lm.get("lv_fresh") == "unknown", str(lm)))
        results.append(("OVERWATCH LIVENESS stale blocked heartbeat, no live marker → SILENT (review regression)", lm.get("lv_blk_stale") == "SILENT", str(lm)))
        results.append(("OVERWATCH LIVENESS stale idle-empty heartbeat → SILENT (review regression)", lm.get("lv_idle_stale") == "SILENT", str(lm)))
        r_sw = owl("sweep")
        results.append(("OVERWATCH sweep exits 2 when any team is SILENT", r_sw.returncode == 2 and "SILENT" in r_sw.stdout, r_sw.stdout[-100:]))
        r_wt = owl("watch", "--once")
        alarm_p = os.path.join(lhome, "overwatch", "lv_silent", ".waker", "ALARM.json")
        results.append(("OVERWATCH watch --once alarms SILENT teams (exit 2 + ALARM.json)",
                        r_wt.returncode == 2 and os.path.exists(alarm_p), r_wt.stdout[-100:]))
        no_alarm = os.path.join(lhome, "overwatch", "lv_ok", ".waker", "ALARM.json")
        results.append(("OVERWATCH watch does NOT alarm a live team", not os.path.exists(no_alarm), "false alarm on lv_ok"))
        adir = os.path.join(tmp, "agents")
        r_ins = owl("watch", "--install", "--agents-dir", adir, "--interval", "300", "--ratchet-bin", "/usr/bin/ratchet")
        plist = os.path.join(adir, "ai.ferrox.ratchet-overwatch.plist")
        pl = open(plist).read() if os.path.exists(plist) else ""
        results.append(("OVERWATCH watch --install writes a valid LaunchAgent plist",
                        r_ins.returncode == 0 and "ai.ferrox.ratchet-overwatch" in pl and "<integer>300</integer>" in pl and "watch" in pl,
                        pl[:80]))
        # review regression: the plist MUST pin RATCHET_HOME (launchd's minimal env won't inherit it) so
        # the durable agent monitors OUR home, not a default empty one (silent false-clear otherwise).
        results.append(("OVERWATCH plist pins RATCHET_HOME to the install-time home (no silent false-clear)",
                        "EnvironmentVariables" in pl and "RATCHET_HOME" in pl and lhome in pl, pl[:120]))

        # 13b. FROZEN sweep --json DATA CONTRACT (Glass binds to this) — schema_version + exact fields,
        # current_card round-trip from beat --card, open_ask surfaced only when a flag is open.
        owl("register", "lv_card"); owl("beat", "lv_card", "--state", "working", "--card", "abc123")
        owl("register", "lv_ask"); owl("flag", "lv_ask", "--text", "decide the thing")
        doc = json.loads(owl("sweep", "--json").stdout)
        results.append(("OVERWATCH contract: sweep --json carries schema_version", doc.get("schema_version") == 1, str(doc.get("schema_version"))))
        CONTRACT = {"team", "state", "last_beat_ts", "last_beat_iso", "heartbeat_age", "current_card", "open_ask", "flag_state", "why", "latest_status"}
        byteam = {t["team"]: t for t in doc["teams"]}
        results.append(("OVERWATCH contract: every team object has exactly the frozen fields",
                        all(set(t.keys()) == CONTRACT for t in doc["teams"]),
                        str(sorted(set(byteam["lv_card"].keys()) ^ CONTRACT))))
        results.append(("OVERWATCH contract: state is the liveness enum (ok/blocked/idle-empty/SILENT/unknown)",
                        all(t["state"] in ("ok", "blocked", "idle-empty", "SILENT", "unknown") for t in doc["teams"]),
                        str({t["team"]: t["state"] for t in doc["teams"]})))
        results.append(("OVERWATCH contract: current_card round-trips from beat --card",
                        byteam["lv_card"]["current_card"] == "abc123" and byteam["lv_card"]["last_beat_ts"] is not None,
                        str(byteam["lv_card"])))
        # review regression: a PLAIN liveness beat (no --card/--state) must NOT wipe current_card/state —
        # merge-forward, so a dashboard's current_card doesn't flicker to null on routine heartbeats.
        owl("beat", "lv_card")  # plain tick, omits --card and --state
        bt2 = {t["team"]: t for t in json.loads(owl("sweep", "--json").stdout)["teams"]}["lv_card"]
        results.append(("OVERWATCH contract: plain beat preserves current_card + state (merge, not clobber)",
                        bt2["current_card"] == "abc123" and bt2["state"] == "ok", str(bt2)))
        results.append(("OVERWATCH contract: open_ask carries the question only when flag is open",
                        byteam["lv_ask"]["open_ask"] == "decide the thing" and byteam["lv_ask"]["flag_state"] == "open"
                        and byteam["lv_card"]["open_ask"] is None,
                        str(byteam["lv_ask"])))

        # 14. overwatch ASK QUEUE (FRICTION #6) — escalations as first-class, queryable objects.
        # The incident: team→Overwatch asks were free-text NEEDS-OVERWATCH prose in append-only logs,
        # so an open money-decision (flux #737) sat unseen — it was never on a queryable list. Fresh
        # isolated home so the ask enumeration is deterministic (independent of the flag tests above).
        ahome = os.path.join(tmp, "owhome-asks")
        aenv = dict(os.environ, RATCHET_HOME=ahome); aenv.pop("WL_HOME", None); aenv.pop("WL_MANIFEST", None)
        def owa(*a):
            return subprocess.run([sys.executable, me, "overwatch", *a], env=aenv, capture_output=True, text=True, timeout=30)
        def asks_json(*a):
            return json.loads(owa("asks", *a).stdout)
        def ask_by_id(js, aid):
            return next((x for x in js["asks"] if x["id"] == aid), None)
        # 14.1 LIFECYCLE: create(open) → ack(acked) → answer(answered), each state persisted+reloadable.
        owa("register", "aq_life")
        r_new = owa("ask", "--team", "aq_life", "--subject", "release the thing?", "--option", "yes", "--option", "no")
        import re as _re
        m_id = _re.search(r"ask ([0-9a-f]{12}) opened", r_new.stdout)
        life_id = m_id.group(1) if m_id else ""
        a_open = ask_by_id(asks_json(), life_id)
        results.append(("ASK lifecycle: created ask persists as state=open with its options",
                        bool(a_open) and a_open["state"] == "open" and a_open["options"] == ["yes", "no"], str(a_open)))
        owa("answer", life_id, "--ack")
        a_ack = ask_by_id(asks_json(), life_id)
        results.append(("ASK lifecycle: --ack flips state=acked and stamps acked_at (reloaded from disk)",
                        bool(a_ack) and a_ack["state"] == "acked" and a_ack["acked_at"], str(a_ack)))
        owa("answer", life_id, "--ref", "BRIEF#decision-1", "--by", "sean")
        a_ans = ask_by_id(asks_json(), life_id)
        results.append(("ASK lifecycle: answer flips state=answered, records answer_ref + answered_by",
                        bool(a_ans) and a_ans["state"] == "answered" and a_ans["answer_ref"] == "BRIEF#decision-1"
                        and a_ans["answered_by"] == "sean" and a_ans["answered_at"], str(a_ans)))
        # 14.2 MULTI-TEAM ENUMERATION + the #737 REGRESSION: asks --open scans EVERY team dir. A team
        # added AFTER the code shipped must appear with ZERO code change — that dir-derived coverage is
        # the exact thing whose absence (a hardcoded team subset) hid flux #737.
        owa("register", "aq_a"); owa("ask", "--team", "aq_a", "--subject", "A needs a call")
        owa("register", "aq_b"); owa("ask", "--team", "aq_b", "--subject", "B needs a call")
        open_teams = {x["team"] for x in asks_json("--open")["asks"]}
        results.append(("ASK asks --open enumerates open asks across MULTIPLE teams from the dir",
                        {"aq_a", "aq_b"} <= open_teams, str(open_teams)))
        # the regression proper: a brand-new team dir (mkdir + register, no code touched) with an open
        # ask IS included. This is flux-excluded-#737 — coverage derived from the dir, never a list.
        owa("register", "flux_new_737")
        owa("ask", "--team", "flux_new_737", "--subject", "money decision on #737")
        open_now = asks_json("--open")
        results.append(("ASK newly-added team dir with an open ask is included WITHOUT code change (#737 regression)",
                        any(x["team"] == "flux_new_737" for x in open_now["asks"]), str([x["team"] for x in open_now["asks"]])))
        # 14.3 REVERSE WAKER: `ask` marks the Overwatch inbox AND await-ask fires on a genuinely new ask.
        inbox = json.load(open(os.path.join(ahome, "overwatch", ".inbox.json")))
        results.append(("ASK reverse waker: `ask` bumps the Overwatch inbox marker (seq advances)",
                        int(inbox.get("seq", 0)) >= 1 and inbox.get("last_team"), str(inbox)))
        r_fire = owa("await-ask", "--once")   # cursor absent → all current open asks are 'new' → fires
        results.append(("ASK reverse waker: await-ask --once FIRES (rc 0) when open asks are pending",
                        r_fire.returncode == 0 and "new open ask" in r_fire.stdout, r_fire.stdout[-120:]))
        r_none = owa("await-ask", "--once")   # cursor now consumed → nothing new → rc 3, no false fire
        results.append(("ASK reverse waker: await-ask --once does NOT false-fire once consumed (rc 3)",
                        r_none.returncode == 3, r_none.stdout[-120:]))
        owa("register", "aq_late"); owa("ask", "--team", "aq_late", "--subject", "a later ask")
        r_refire = owa("await-ask", "--once")  # a genuinely new ask after the watermark → fires again
        results.append(("ASK reverse waker: await-ask re-fires (rc 0) on a genuinely NEW ask after consume",
                        r_refire.returncode == 0 and "aq_late" in r_refire.stdout, r_refire.stdout[-120:]))
        # 14.4 answering removes an ask from asks --open (the queue drains as decisions land).
        aq_a_id = next(x["id"] for x in asks_json("--open")["asks"] if x["team"] == "aq_a")
        owa("answer", aq_a_id, "--team", "aq_a", "--ref", "done")
        still_open_a = [x for x in asks_json("--open")["asks"] if x["team"] == "aq_a"]
        results.append(("ASK answering an ask removes it from asks --open (queue drains)",
                        still_open_a == [], str(still_open_a)))
        # 14.5 BACK-COMPAT FOLD: a pre-ask single-flag NEEDS-OVERWATCH surfaces as a synthetic open ask
        # so nothing open under the old mechanism is dropped; a matching .ow-ack watermark subsumes it
        # as state=acked (the interim watermark folded in, not discarded).
        owa("register", "aq_legacy"); owa("flag", "aq_legacy", "--text", "legacy money call")
        leg_open = [x for x in asks_json("--open")["asks"] if x["team"] == "aq_legacy"]
        results.append(("ASK back-compat: an open legacy NEEDS-OVERWATCH flag surfaces as a synthetic open ask",
                        len(leg_open) == 1 and leg_open[0]["id"].startswith("legacy-"), str(leg_open)))
        import hashlib as _hl
        open(os.path.join(ahome, "overwatch", "aq_legacy", ".ow-ack"), "w").write(
            _hl.md5("legacy money call".encode()).hexdigest())
        leg_after = [x for x in asks_json("--open")["asks"] if x["team"] == "aq_legacy"]
        results.append(("ASK back-compat: a matching .ow-ack watermark folds the legacy flag to acked (not open)",
                        leg_after == [], str(leg_after)))
        # 14.6 REVIEW REGRESSION (finding 1): a genuinely-new open legacy flag must NOT be masked just
        # because its text equals an unrelated, already-ANSWERED native ask. Text is not identity;
        # masking an open ask by subject collision is the exact #737 failure mode. Over-surface instead.
        owa("register", "aq_dup")
        r_dup = owa("ask", "--team", "aq_dup", "--subject", "identical text")
        dup_id = _re.search(r"ask ([0-9a-f]{12}) opened", r_dup.stdout).group(1)
        owa("answer", dup_id, "--team", "aq_dup", "--ref", "closed")          # native ask now answered
        owa("flag", "aq_dup", "--text", "identical text")                     # NEW open legacy flag, same text
        dup_open = [x for x in asks_json("--open")["asks"] if x["team"] == "aq_dup"]
        results.append(("ASK a new open legacy flag is NOT masked by an identical-subject answered ask (finding 1)",
                        len(dup_open) == 1 and dup_open[0]["id"].startswith("legacy-"), str(dup_open)))
        # 14.7 REVIEW REGRESSION (finding 2): a corrupt/unreadable ask file must be LOUD (a warning), not
        # silently swallowed into "no open asks" — a broken store must never look identical to an empty one.
        owa("register", "aq_bad")
        os.makedirs(os.path.join(ahome, "overwatch", "aq_bad", "asks"), exist_ok=True)
        open(os.path.join(ahome, "overwatch", "aq_bad", "asks", "broken.json"), "w").write("{ not valid json")
        r_warn = owa("asks")
        warn_js = json.loads(r_warn.stdout)
        results.append(("ASK a corrupt ask file surfaces a LOUD warning + non-zero rc (not a silent empty)",
                        r_warn.returncode == 2 and any("aq_bad" in w for w in warn_js.get("warnings", [])),
                        str(warn_js.get("warnings"))))

    # companions prove themselves too — one suite, everywhere (CI, land gate, train)
    import signal
    for comp in ("ratchet-exec", "ratchet-think", "ratchet-index", "ratchet-agents", "ratchet-budget", "ratchet-delint", "ratchet-preview", "ratchet-ci", "ratchet-mcp", "ratchet-kanban", "ratchet-maintain", "ratchet-glass"):
        cpath = os.path.join(os.path.dirname(os.path.abspath(__file__)), comp)
        if not os.path.exists(cpath):
            continue
        # ratchet-exec is the PROCESS SANDBOX: its selftest is almost entirely spawn-and-reap proofs
        # (guarded_suite, mock lanes, bg/detached children). That reaping is not portable to headless
        # shared CI runners — it intermittently stalls the runner at step-end (a flaky ~15-min hang that
        # is unreproducible locally). Under RATCHET_SELFTEST_NO_EXEC=1 (set only in CI) we SKIP it here,
        # VISIBLY, so CI is deterministic. It runs in full locally (`ratchet-exec selftest`, 33/33) and
        # will get real CI coverage once the containerized runner makes the sandbox CI-portable.
        if comp == "ratchet-exec" and os.environ.get("RATCHET_SELFTEST_NO_EXEC") == "1":
            results.append((f"{comp} selftest (SKIPPED in CI — process-sandbox is local-only; run it directly)", True, ""))
            continue
        # Capture to a FILE in a NEW SESSION, and wait on the DIRECT child only. A companion selftest
        # exercising the sandbox can leak a background/detached child that inherits the output stream;
        # with capture_output=True (a pipe) communicate() then blocks on the held write-end forever,
        # even past the timeout — a nondeterministic CI deadlock. A file has no write-end to hold, and
        # p.wait() returns the moment the companion itself exits; we then killpg the group to reap any
        # leftover child so it can't accumulate. Deterministic regardless of what a companion leaks.
        with tempfile.TemporaryFile(mode="w+") as tf:
            p = subprocess.Popen([sys.executable, cpath, "selftest"], stdout=tf, stderr=subprocess.STDOUT,
                                 stdin=subprocess.DEVNULL, start_new_session=True)
            try:
                rc = p.wait(timeout=600)
            except subprocess.TimeoutExpired:
                rc = 124
            finally:
                try:
                    os.killpg(os.getpgid(p.pid), signal.SIGKILL)   # reap the whole group (leaked children too)
                except (ProcessLookupError, PermissionError, OSError):
                    pass
                try:
                    p.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    pass
            tf.seek(0)
            out = tf.read()
        tail = [l for l in out.splitlines() if l.strip()][-1] if out.strip() else "no output"
        results.append((f"{comp} selftest ({tail.strip()})", rc == 0, out[-200:]))

    passed = sum(1 for _, okv, _ in results if okv)
    for label, okv, detail in results:
        print(f"  {paint(OK if okv else RED)} {label}" + ("" if okv else f" — {detail}"))
    print(f"\n  selftest: {passed}/{len(results)} checks proved against reproduced failures")
    return 0 if passed == len(results) else 2


# ---------- capability detection (shared by init wizard AND the exec dispatch layer) ----------
# One registry of the tools Ratchet knows about: how to detect each, why it matters, and the
# per-platform install command. The setup wizard renders it; the dispatcher reads which agents
# are present to pick a lane. `agent: True` marks a spawnable building agent.

def _os_key():
    return "darwin" if sys.platform == "darwin" else ("windows" if os.name == "nt" else "linux")

TOOLS = {
    "git":      {"why": "the ground everything stands on", "required": True, "check": ["git", "--version"],
                 "install": {"darwin": "xcode-select --install", "linux": "sudo apt install -y git", "windows": "winget install Git.Git"}},
    "gh":       {"why": "PRs, branch protection, GitHub-truth cleanup", "required": True, "check": ["gh", "--version"],
                 "install": {"darwin": "brew install gh", "linux": "sudo apt install -y gh", "windows": "winget install GitHub.cli"}},
    "rg":       {"why": "fast code search (feeds the repo index)", "required": False, "check": ["rg", "--version"],
                 "install": {"darwin": "brew install ripgrep", "linux": "sudo apt install -y ripgrep", "windows": "winget install BurntSushi.ripgrep.MSVC"}},
    "ctags":    {"why": "symbol map for the repo index (wave 2)", "required": False, "check": ["ctags", "--version"],
                 "install": {"darwin": "brew install universal-ctags", "linux": "sudo apt install -y universal-ctags", "windows": "choco install universal-ctags"}},
    "gitleaks": {"why": "deeper secret scanning (builtin grep always runs)", "required": False, "check": ["gitleaks", "version"],
                 "install": {"darwin": "brew install gitleaks", "linux": "sudo apt install -y gitleaks", "windows": "winget install gitleaks.gitleaks"}},
    "claude":   {"why": "Anthropic agent — flat-rate if you have a subscription", "required": False, "agent": True, "check": ["claude", "--version"],
                 "install": {"darwin": "npm i -g @anthropic-ai/claude-code", "linux": "npm i -g @anthropic-ai/claude-code", "windows": "npm i -g @anthropic-ai/claude-code"}},
    "codex":    {"why": "OpenAI agent — flat-rate if you have a ChatGPT sub", "required": False, "agent": True, "check": ["codex", "--version"],
                 "install": {"darwin": "npm i -g @openai/codex", "linux": "npm i -g @openai/codex", "windows": "npm i -g @openai/codex"}},
    "gemini":   {"why": "Google agent — flat-rate if you're locked in", "required": False, "agent": True, "check": ["gemini", "--version"],
                 "install": {"darwin": "npm i -g @google/gemini-cli", "linux": "npm i -g @google/gemini-cli", "windows": "npm i -g @google/gemini-cli"}},
    "wayland-core": {"why": "universal Flux-routed agent — always available, metered, beyond-frontier for pennies",
                 "required": False, "agent": True, "check": ["wayland-core", "--version"],
                 "install": {"darwin": "npm i -g @ferroxlabs/wayland-core", "linux": "npm i -g @ferroxlabs/wayland-core", "windows": "npm i -g @ferroxlabs/wayland-core"}},
}

def detect_tools():
    """Probe every known tool once. Returns {name: present_bool}. Reused by the dispatcher."""
    out = {}
    for name, spec in TOOLS.items():
        out[name] = run(spec["check"], timeout=10)[0] == 0
    return out

def default_dispatch(present=None):
    """The lane the exec dispatcher would pick, per the v2 preference hierarchy:
    a chosen installed sub-CLI (flat-rate) → else Wayland Core via Flux (metered) → else none."""
    present = present if present is not None else detect_tools()
    for cli in ("claude", "codex", "gemini"):  # sub-CLIs first (flat-rate, the user's own sub)
        if present.get(cli):
            return (cli, "flat-rate subscription CLI, sandbox+time-governed")
    has_key = any(os.environ.get(k) for k in ("FLUX_DEV_KEY", "FLUX_TEST_KEY"))
    if present.get("wayland-core") and has_key:
        return ("wayland-core", "Flux-routed, metered, beyond-frontier — the universal fallback")
    if present.get("wayland-core"):
        return ("wayland-core", "installed but needs FLUX_DEV_KEY to route")
    return (None, "no agent installed — add a sub-CLI, or wayland-core + FLUX_DEV_KEY")

def init_cmd(args):
    """ratchet init [--install [--yes]] — first-run: state home, starter manifest, setup wizard.
    --install offers to run the install command for each missing tool (consent required; never
    silent). --yes actually runs them, else prints the copy-paste commands."""
    os.makedirs(os.path.join(WL_HOME, "state"), exist_ok=True)
    if not os.path.exists(MANIFEST_PATH):
        state_save_path = MANIFEST_PATH
        with open(state_save_path, "w") as fh:
            json.dump({"schema_version": 1, "min_wl_plane": VERSION, "repos": {},
                       "noise_paths": ["AGENTS.md", "CLAUDE.md", "GEMINI.md"],
                       "backup_ref_ns": "wip/ratchet-safety/",
                       "archive_dir": "~/.ratchet/archive",
                       "fetch_ttl_seconds": 300, "sync_warn_behind": 1, "sync_red_behind": 50}, fh, indent=2)
        print(f"init: starter manifest → {MANIFEST_PATH}")
    else:
        print(f"init: manifest already at {MANIFEST_PATH}")
    do_install = "--install" in args
    do_yes = "--yes" in args
    osk = _os_key()
    present = detect_tools()

    print("\nchecking your machine —")
    for name in ("git", "gh"):
        ok = present[name]
        print(f"  {'✓' if ok else '✗ MISSING':10} {name:12} {TOOLS[name]['why']}")
    rc, who, _ = run(["gh", "api", "user", "--jq", ".login"], timeout=15)
    print(f"  {'✓' if rc == 0 else '✗':10} {'gh auth':12} {'signed in as ' + who if rc == 0 else 'run: gh auth login'}")

    # agent lanes — count and CELEBRATE (Sutherland: the number is the pitch)
    agent_names = [n for n, s in TOOLS.items() if s.get("agent")]
    have_agents = [n for n in agent_names if present[n]]
    print(f"\nagent lanes discovered: {len(have_agents)}" + (f" — {', '.join(have_agents)}" if have_agents else ""))
    lane, lane_why = default_dispatch(present)
    if lane:
        print(f"  default dispatch: {lane} ({lane_why})")
    else:
        print("  → no building agent yet — install one below, or add wayland-core + FLUX_DEV_KEY.")
    if len([n for n in have_agents if n in ("claude", "codex", "gemini")]) >= 2:
        print("  cross-vendor swarm available: providers audit each other, cheap-first.")

    # the council key, framed as an unlock you CHOOSE
    key = any(os.environ.get(k) for k in ("FLUX_DEV_KEY", "FLUX_TEST_KEY"))
    print("\nreview council: " + ("ON — multi-model plan/review/judge unlocked." if key
          else "standing by — set FLUX_DEV_KEY (fluxrouter.ai) to unlock the AI council + Wayland Core dispatch."))

    # suggestions — what's missing, why, and the EXACT command (never a vague "install X")
    missing = [n for n, ok in present.items() if not ok]
    suggest = [n for n in missing if TOOLS[n]["install"].get(osk)]
    if suggest:
        print("\nsuggested to complete your setup:")
        for n in suggest:
            tag = "REQUIRED" if TOOLS[n].get("required") else ("agent" if TOOLS[n].get("agent") else "optional")
            print(f"  [{tag:8}] {n:12} {TOOLS[n]['why']}\n  {'':22}{TOOLS[n]['install'][osk]}")
        if do_install:
            print("\ninstalling (with your consent) —" if do_yes else "\n--install: the commands above will run with --yes. Nothing run yet.")
            if do_yes:
                for n in suggest:
                    cmd = TOOLS[n]["install"][osk]
                    print(f"  $ {cmd}")
                    rc_i = subprocess.call(["bash", "-lc", cmd])
                    present[n] = run(TOOLS[n]["check"], timeout=10)[0] == 0
                    print(f"    → {n}: {'installed' if present[n] else 'FAILED (rc ' + str(rc_i) + ') — install by hand'}")
        else:
            print("\n  → run `ratchet init --install --yes` to install these, or copy the commands above.")
    else:
        print("\neverything's here. Nothing to install.")

    print("\nyou're set. one command from here:\n\n    ratchet adopt <path-or-github-url>\n")
    return 0

# ---------- main ----------

def plain_fetch_err(ferr):
    """One calm line from git's multi-line fetch stderr. The common brand-new-repo case reads
    as a benign fact, not a red 'fatal:' that makes a new user think something broke."""
    first = (ferr or "").strip().splitlines()[0] if (ferr or "").strip() else "unreachable"
    low = first.lower()
    if "not found" in low or "repository not found" in low:
        return "remote not reachable yet — normal for a brand-new repo (push it, or ignore)"
    if "could not resolve host" in low or "connection" in low or "timed out" in low:
        return "offline — can't reach the remote right now"
    if "permission denied" in low or "authentication" in low or "403" in low:
        return "no access to the remote — check gh auth / the remote URL"
    return first[:80]

def next_move(m, args):
    """ratchet next — the guide. Reads where you are on the spine and names the ONE thing to do
    now. This is the whole tool's don't-make-me-think front door: you never memorize the
    lifecycle (install→govern→work→see→ship): ratchet holds it for you and hands you one verb.
    Bare `ratchet` runs this; `ratchet help` is the full reference."""
    # station 0 — nothing governed yet: point at the single onboarding verb
    if not m.get("repos"):
        print("Welcome to Ratchet — the enforcement layer for AI-built software.\n")
        print("Nothing is under the gate yet. One command changes that:\n")
        print("    ratchet adopt <path-or-github-url>\n")
        print("It reads the language, tests, and CI, installs the hooks, and puts the repo")
        print("under branch protection — your first governed PR in under ten minutes.")
        return 0
    # station 1 — something needs YOU: hand over the top inbox item verbatim (it already
    # leads with 'do this now' and the exact verb). The human is the scarce resource.
    if _needs_you(m):
        return inbox(m, [])
    # station 2 — idle: is the ground solid? surface a fast local dirty/worktree nudge, then
    # invite the next piece of work, inferring the repo when there's only one.
    dirty_repos = []
    for name, r in m["repos"].items():
        _, d, _ = git(expand(r["path"]), "status", "--porcelain")
        if d and d.strip():
            dirty_repos.append(name)
    print("All clear — nothing needs you right now.\n")
    if dirty_repos:
        print(f"uncommitted changes in: {', '.join(dirty_repos)} (commit them inside a `take` worktree)\n")
    repos = list(m["repos"])
    hint = repos[0] if len(repos) == 1 else "<repo>"
    print("Start something — every piece of work enters through one door:\n")
    print(f"    ratchet take <slug> --repo {hint}\n")
    print("or look under the hood without touching anything:  ratchet watch --serve")
    return 0

# ---------- overwatch: the never-idle team-coordination loop, as a first-class verb ----------
# FRICTION #1+#2: the multi-team wait-loop (register → flag NEEDS-OVERWATCH → await a response →
# sweep) used to live as copy-pasted shell (await-overwatch.sh) + prose in RULES-COMMON. Here it is
# a tested Ratchet verb family. The one hard bug it kills is the "answer-already-there race" (#2):
# a team that armed its waker AFTER Overwatch already answered baselined against a brief that already
# held the answer → waited forever. The fix is structural: `flag` freezes sha(BRIEF) AT FLAG TIME,
# and `await` compares the LIVE brief against that frozen baseline — so if the answer landed in the
# gap between flag and await, await returns immediately. The race is impossible by construction.
# State is loose dirs under WL_HOME/overwatch/<team>/ (Overwatch-approved: a team exists iff its dir
# does — the same truth the live teams already run on). Waker state is additive under .waker/.

def _ow_home():
    # resolve at call time (not import) so a selftest sandbox that sets RATCHET_HOME/WL_HOME in the
    # child env is honored, exactly like the module-level WL_HOME does for the real run.
    home = os.environ.get("RATCHET_HOME") or os.environ.get("WL_HOME") or os.path.expanduser("~/.ratchet")
    return os.path.join(home, "overwatch")

def _ow_team_dir(team):
    return os.path.join(_ow_home(), team)

def _ow_sha(path):
    import hashlib
    try:
        return hashlib.sha256(open(path, "rb").read()).hexdigest()
    except OSError:
        return ""  # a missing/unreadable brief hashes to "" — a first real write is then a change

def _ow_flag_path(team):
    return os.path.join(_ow_team_dir(team), ".waker", "flag.json")

def _ow_load_flag(team):
    # AT MOST ONE live flag per team, by design. A team blocks on one ask at a time (batch several
    # questions into one --text, as the real flags do). Singular kills three bugs a pile invited:
    # no 'newest of N' to mis-pick (same-second tie-break), no second flag sharing a baseline that
    # one respond would ambiguously close, and — because `await` CONSUMES the flag on fire — no stale
    # flag left behind to false-fire a later bare `await`. Returns the flag dict, or None.
    try:
        return json.load(open(_ow_flag_path(team)))
    except (OSError, json.JSONDecodeError):
        return None  # absent or corrupt → treated as no live flag (never crashes sweep/await)

def _ow_clear_flag(team, expect_flag_id):
    # COMPARE-and-delete: only consume the flag this awaiter actually baselined against. A long-lived
    # background `await` (the tool's own "arm the waker &" pattern) loads its baseline once; by the
    # time it fires for question A, the team may have already re-flagged question B. An unconditional
    # remove would eat B's live, unanswered flag and silently drop the team back into the race. So we
    # delete only if the on-disk flag_id still matches — and never when we armed with no flag (None).
    if expect_flag_id is None:
        return
    cur = _ow_load_flag(team)
    if cur is None or cur.get("flag_id") != expect_flag_id:
        return  # someone re-flagged (or already consumed) since we loaded — leave their ask intact
    try:
        os.remove(_ow_flag_path(team))
    except OSError:
        pass

def _ow_arg(rest, name, default=None):
    if name in rest:
        i = rest.index(name)
        if i + 1 < len(rest):
            return rest[i + 1]
    return default

# ---------- liveness: heartbeat + dead-waker detection (item-1 amendment) ----------
# The incident this closes: on a push-only voluntary substrate, "working silently", "parked idle after
# finishing", and "process dead" are indistinguishable — wayland-core landed 3 cards then went silent for
# 3h, and overnight blocked teams' wakers died and never resumed. Heartbeat + an awaiting-pid marker make
# both observable: a stale heartbeat on a working team, or a blocked team whose waker pid is gone, is the
# alarm. All additive under .waker/; sweep/watch read it, nothing else changes.
_OW_HB_STATES = ("working", "blocked", "idle-empty")

def _ow_hb_path(team):
    return os.path.join(_ow_team_dir(team), ".waker", "heartbeat.json")

def _ow_awaiting_path(team):
    return os.path.join(_ow_team_dir(team), ".waker", "awaiting.json")

def _ow_alarm_path(team):
    return os.path.join(_ow_team_dir(team), ".waker", "ALARM.json")

def _ow_load_json(path):
    try:
        return json.load(open(path))
    except (OSError, json.JSONDecodeError):
        return None

def _ow_atomic_write(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"  # pid-unique temp so concurrent writers don't share a path
    json.dump(obj, open(tmp, "w"))
    os.replace(tmp, path)

def _ow_write_hb(team, state=None, note=None, card=None):
    # MERGE, don't clobber: carry forward the last-known state + card when this beat omits them, so a
    # plain liveness beat (the natural "I'm still alive, same context" tick) doesn't wipe current_card
    # or flip the displayed state to null. Only an explicit --state/--card overrides. `note` is a
    # per-beat annotation (what I'm doing NOW), so it is NOT carried forward.
    prev = _ow_load_json(_ow_hb_path(team)) or {}
    state = state or prev.get("state")
    card = card or prev.get("card")
    hb = {"team": team, "ts": time.time(), "iso": now_iso(), "pid": os.getpid()}
    if state:
        hb["state"] = state
    if note:
        hb["note"] = note
    if card:
        hb["card"] = card  # the work-card this team is on — surfaced as current_card in the contract
    _ow_atomic_write(_ow_hb_path(team), hb)
    return hb

def _ow_beat(args):
    if not args or args[0].startswith("-"):
        print("usage: ratchet overwatch beat <team> [--state working|blocked|idle-empty] [--card <id>] [--note '<n>']"); return 1
    team = args[0]
    if not os.path.isdir(_ow_team_dir(team)):
        print(f"overwatch beat: team '{team}' is not registered"); return 1
    state = _ow_arg(args, "--state")
    if state and state not in _OW_HB_STATES:
        print(f"overwatch beat: --state must be one of {_OW_HB_STATES}"); return 1
    note = _ow_arg(args, "--note")
    card = _ow_arg(args, "--card")
    hb = _ow_write_hb(team, state, note, card)
    print(f"[overwatch] {team} heartbeat @ {hb['iso']}"
          + (f" · {state}" if state else "") + (f" · card {card}" if card else "") + (f" · {note}" if note else ""))
    return 0

def _ow_liveness(team, stale_after):
    """Classify ONE team's liveness. Returns a dict with liveness ∈
    {ok, blocked, idle-empty, SILENT} and a human 'why'. SILENT is the alarm state:
      · a stale heartbeat on a working/unknown team (the live-but-silent case), OR
      · an open ask whose awaiting-waker pid is dead (the overnight dead-waker case)."""
    now = time.time()
    hb = _ow_load_json(_ow_hb_path(team))
    age = (now - hb.get("ts", 0)) if hb else None
    hb_state = hb.get("state") if hb else None
    flag = _ow_load_flag(team)
    cur = _ow_sha(os.path.join(_ow_team_dir(team), "BRIEF.md"))
    open_ask = bool(flag) and flag.get("brief_sha") == cur  # unanswered NEEDS-OVERWATCH
    awaiting = _ow_load_json(_ow_awaiting_path(team))
    # anti-PID-REUSE (audit-established elsewhere in this file): a bare os.kill(pid,0) says "a process
    # exists", not "THE waker exists" — a recycled pid would make a dead waker read alive and silently
    # reproduce the overnight incident. Bind to the recorded start time via pid_is_claimant.
    waker_alive = bool(awaiting) and pid_is_claimant(awaiting.get("pid"), awaiting.get("pid_start", ""))
    stale = (age is not None) and (age > stale_after)  # never-beat is 'unknown', not 'stale'
    def _v(liveness, why):  # every return carries the frozen data-contract fields (see _ow_sweep doc)
        return {"team": team, "liveness": liveness, "why": why, "age": age, "state": hb_state,
                "last_beat_ts": (hb.get("ts") if hb else None),
                "last_beat_iso": (hb.get("iso") if hb else None),
                "current_card": (hb.get("card") if hb else None)}
    # dead-waker class: a team blocked on an OPEN ask whose waker process is gone will never resume.
    if open_ask and awaiting and not waker_alive:
        return _v("SILENT", "blocked on an open ask but its waker pid is dead — will never resume")
    if open_ask and waker_alive:
        return _v("blocked", "waiting on Overwatch (waker alive)")
    if hb is None:
        # never emitted a heartbeat and not blocked → not-started / pre-heartbeat CLI. Deliberately NOT
        # an alarm: flagging every freshly-registered team SILENT would cry wolf. The alarm is reserved
        # for a team that WAS alive (beat at least once) and went quiet, or a blocked team with a dead waker.
        return _v("unknown", "no heartbeat yet (not started, or a pre-heartbeat CLI)")
    if hb_state == "idle-empty" and not stale:
        return _v("idle-empty", "queue drained, waker armed")
    if stale:
        # A stale heartbeat in ANY state is the alarm — the team stopped beating, i.e. stopped looping.
        # A legitimately-quiet team (blocked with a LIVE waker) is caught above and never reaches here,
        # AND its waker beats each tick so it isn't stale anyway. Restricting this to working/None (the
        # original bug) let a stale 'blocked'/'idle-empty' heartbeat with no live marker read as 'ok'.
        return _v("SILENT", f"no heartbeat for {int(age)}s (state={hb_state or 'unknown'})")
    return _v("ok", f"heartbeat {int(age)}s ago")

def _ow_teams():
    home = _ow_home()
    try:
        return sorted(d for d in os.listdir(home) if os.path.isdir(os.path.join(home, d)))
    except OSError:
        return []

def _ow_notify(msg):
    # best-effort macOS desktop notification; never fatal off-mac or if osascript is absent.
    # AppleScript string literals do NOT honor backslash escapes (json.dumps escaping is unsafe and
    # a team name — an unvalidated path component — could carry a quote and inject AppleScript). So
    # strip the only chars that can break/inject an AppleScript string literal, then embed plainly.
    if sys.platform != "darwin":
        return
    safe = re.sub(r'["\\\r\n]', " ", str(msg))
    try:
        subprocess.run(["osascript", "-e", f'display notification "{safe}" with title "Ratchet Overwatch"'],
                       capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass

def _ow_watch(args):
    if "--install" in args:
        return _ow_watch_install(args)
    if "--uninstall" in args:
        return _ow_watch_uninstall(args)
    try:
        stale_after = int(_ow_arg(args, "--stale-after", "900"))
    except ValueError:
        print("overwatch watch: --stale-after must be an integer (seconds)"); return 1
    notify = "--notify" in args
    silent = [_ow_liveness(t, stale_after) for t in _ow_teams()]
    silent = [s for s in silent if s["liveness"] == "SILENT"]
    for s in silent:
        _ow_atomic_write(_ow_alarm_path(s["team"]),
                         {"team": s["team"], "why": s["why"], "ts": time.time(), "iso": now_iso()})
        if notify:
            _ow_notify(f"{s['team']} is SILENT — {s['why']}")
    if silent:
        print(f"[overwatch] watch: {len(silent)} SILENT team(s): " + ", ".join(s["team"] for s in silent))
        for s in silent:
            print(f"    {s['team']}: {s['why']}")
        return 2
    print("[overwatch] watch: all teams live.")
    return 0

_OW_PLIST_LABEL = "ai.ferrox.ratchet-overwatch"

def _ow_home_root():
    # the dir that _ow_home() hangs 'overwatch/' off — the value we must pin into the LaunchAgent so
    # the agent monitors the SAME home the operator installed from, not launchd's default ~/.ratchet.
    return os.environ.get("RATCHET_HOME") or os.environ.get("WL_HOME") or os.path.expanduser("~/.ratchet")

def _ow_plist(ratchet_bin, interval, home_root):
    def esc(s):  # plist values are XML text nodes — escape the three that would break the document
        return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{_OW_PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array><string>{esc(ratchet_bin)}</string><string>overwatch</string><string>watch</string><string>--once</string><string>--notify</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>RATCHET_HOME</key><string>{esc(home_root)}</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>{interval}</integer>
</dict></plist>
"""

def _ow_watch_install(args):
    # SUBSTRATE-TOUCHING: writes a LaunchAgent and (with --load) hands it to launchd. Gated on the
    # Overwatch NEEDS-OVERWATCH verdict for the durable-waker mechanism — do not --load onto the real
    # machine until approved. --agents-dir lets selftest write to a sandbox instead of ~/Library.
    agents_dir = _ow_arg(args, "--agents-dir", os.path.expanduser("~/Library/LaunchAgents"))
    try:
        interval = int(_ow_arg(args, "--interval", "300"))
    except ValueError:
        print("overwatch watch --install: --interval must be an integer (seconds)"); return 1
    ratchet_bin = _ow_arg(args, "--ratchet-bin", os.path.abspath(sys.argv[0]))
    home_root = _ow_arg(args, "--home", _ow_home_root())  # baked into the agent so it monitors OUR home
    os.makedirs(agents_dir, exist_ok=True)
    plist_path = os.path.join(agents_dir, f"{_OW_PLIST_LABEL}.plist")
    with open(plist_path, "w") as f:
        f.write(_ow_plist(ratchet_bin, interval, home_root))
    print(f"[overwatch] wrote LaunchAgent {plist_path} (runs `overwatch watch --once --notify` every {interval}s)")
    if "--load" in args:
        rc, _, err = run(["launchctl", "load", plist_path], timeout=15)
        print(f"[overwatch] launchctl load {'OK' if rc == 0 else 'FAILED: ' + err}")
        return 0 if rc == 0 else 2
    print(f"  load it with:  launchctl load {plist_path}")
    return 0

def _ow_watch_uninstall(args):
    agents_dir = _ow_arg(args, "--agents-dir", os.path.expanduser("~/Library/LaunchAgents"))
    plist_path = os.path.join(agents_dir, f"{_OW_PLIST_LABEL}.plist")
    run(["launchctl", "unload", plist_path], timeout=15)
    try:
        os.remove(plist_path)
        print(f"[overwatch] removed LaunchAgent {plist_path}")
    except OSError:
        print(f"[overwatch] no LaunchAgent at {plist_path}")
    return 0

# ---------- ask queue: escalations as first-class, queryable objects (FRICTION #6) ----------
# THE INCIDENT: team→Overwatch escalations were free-text "NEEDS-OVERWATCH" prose buried in
# append-only STATUS.md logs, and the only "queue" was whatever team list a human happened to
# eyeball. An OPEN money-decision (flux #737) sat unseen because it was never on a queryable list.
# The fix gives every escalation an INDEPENDENT json object at <team>/asks/<id>.json — one file
# per ask (no cross-team write race, trivial enumeration), a real lifecycle (open→acked→answered),
# and — critically — an `asks --open` view that enumerates FROM THE DIRECTORY (via _ow_teams), so a
# newly-added team is covered with ZERO code change. A hardcoded team subset is the exact omission
# that hid #737; deriving the sweep from the dir makes that class of miss impossible by construction.
_OW_ASK_STATES = ("open", "acked", "answered")

def _ow_asks_dir(team):
    return os.path.join(_ow_team_dir(team), "asks")

def _ow_ask_path(team, ask_id):
    return os.path.join(_ow_asks_dir(team), f"{ask_id}.json")

def _ow_valid_id(s):
    # ask ids are our own sha slugs, but `answer <id>` / `--team` take operator input — a traversal
    # component ('..', a slash, a leading dot) must never resolve a path outside the asks tree.
    return bool(s) and "/" not in s and "\\" not in s and ".." not in s and not s.startswith(".")

def _ow_inbox_path():
    # the Overwatch-side inbox marker — the reverse (team→Overwatch) waker's push signal. `ask`
    # bumps a monotonic seq here; it is the mirror of the BRIEF the forward waker (`await`) watches.
    return os.path.join(_ow_home(), ".inbox.json")

def _ow_cursor_path():
    # await-ask's consumed-watermark: the set of open-ask keys Overwatch has already been woken for.
    # Persisting it is what makes the reverse waker deterministic (a fresh `await-ask --once` fires on
    # a genuinely NEW ask, not on one already surfaced) — the same discipline as flag's frozen sha.
    return os.path.join(_ow_home(), ".inbox-cursor.json")

def _ow_mark_inbox(ask):
    prev = _ow_load_json(_ow_inbox_path()) or {}
    seq = int(prev.get("seq", 0)) + 1
    _ow_atomic_write(_ow_inbox_path(), {"seq": seq, "last_ask_id": ask["id"], "last_team": ask["team"],
                                        "last_subject": ask.get("subject", ""), "iso": now_iso(), "ts": time.time()})
    return seq

def _ow_iter_team_asks(team, warn=None):
    d = _ow_asks_dir(team)
    try:
        names = sorted(os.listdir(d))
    except FileNotFoundError:
        return  # no asks/ dir yet is the normal empty case — silent by design
    except OSError as e:
        # an UNREADABLE asks/ dir (perm / broken mount / I/O) must be LOUD: for a visibility feature a
        # store that FAILED to read is not the same as "no open asks". Surface it; never read as empty-fine.
        if warn is not None:
            warn.append(f"{team}: asks/ dir unreadable ({e.__class__.__name__}) — open asks may be hidden")
        return
    for n in names:
        if not n.endswith(".json"):
            continue
        a = _ow_load_json(os.path.join(d, n))
        if isinstance(a, dict) and a.get("id"):
            a.setdefault("team", team)
            yield a
        elif warn is not None:
            # a corrupt / half-written / bad hand-written ask file dropped in silence is exactly how an
            # open money-decision goes unseen — flag it loudly instead of skipping quietly.
            warn.append(f"{team}: unreadable ask file {n} — skipped (an open ask may be hidden)")

def _ow_ack_watermark(team):
    # interim substrate: .ow-ack holds an md5 of the newest NEEDS-OVERWATCH the operator answered.
    try:
        return open(os.path.join(_ow_team_dir(team), ".ow-ack")).read().strip()
    except OSError:
        return None

def _ow_legacy_ask(team):
    """Fold the pre-ask single-flag + .ow-ack watermark INTO the ask model so nothing open under the
    old mechanism is dropped during the transition. Returns a synthetic ask for a still-open legacy
    NEEDS-OVERWATCH flag (brief unmoved since its baseline), or None. If the .ow-ack watermark matches
    the flag, the interim 'seen' is subsumed as state=acked — not surfaced as a fresh open ask."""
    flag = _ow_load_flag(team)
    if not flag:
        return None
    cur = _ow_sha(os.path.join(_ow_team_dir(team), "BRIEF.md"))
    if flag.get("brief_sha") != cur:
        return None  # brief advanced past the frozen baseline → answered under the old model, not open
    import hashlib
    q = flag.get("question", "") or ""
    fid = flag.get("flag_id", "") or ""
    wm = _ow_ack_watermark(team)
    acked = bool(wm) and wm in {hashlib.md5(q.encode()).hexdigest(), hashlib.md5(fid.encode()).hexdigest()}
    return {"id": f"legacy-{fid}", "team": team, "subject": q, "options": [],
            "state": "acked" if acked else "open", "created": flag.get("created"),
            "answered_by": None, "answer_ref": None, "acked_at": None, "answered_at": None, "legacy": True}

def _ow_collect_asks(open_only=False, warn=None):
    # THE ANTI-#737 INVARIANT: coverage is enumerated from _ow_teams() (the directory), never a
    # hand-maintained list. A team dir that exists is in scope, full stop.
    out = []
    for team in _ow_teams():
        for a in _ow_iter_team_asks(team, warn):
            out.append(a)
        leg = _ow_legacy_ask(team)
        if leg:
            # OVER-surface the synthetic legacy ask; NEVER mask it. An earlier revision deduped it by
            # subject-text equality against native asks — but text is not identity: a genuinely new open
            # legacy flag whose text matched an unrelated (even already-answered) ask would vanish. That
            # IS the #737 failure mode. A harmless duplicate is the safe direction; a hidden ask is not.
            out.append(leg)
    if open_only:
        out = [a for a in out if a.get("state") == "open"]
    out.sort(key=lambda a: (a.get("team", ""), a.get("id", "")))
    return out

def _ow_open_ask_keys():
    return {f"{a['team']}:{a['id']}" for a in _ow_collect_asks(open_only=True)}

def _ow_ask(args):
    team = _ow_arg(args, "--team")
    subject = _ow_arg(args, "--subject")
    if not team or not subject:
        print("usage: ratchet overwatch ask --team <t> --subject '<s>' [--option '<o>' ...]"); return 1
    if not _ow_valid_id(team) or not os.path.isdir(_ow_team_dir(team)):
        print(f"overwatch ask: team '{team}' is not registered — run `ratchet overwatch register {team}` first"); return 1
    # collect EVERY --option occurrence (real asks are multi-choice — flux #737 offered 3 options)
    options = [args[i + 1] for i, a in enumerate(args) if a == "--option" and i + 1 < len(args)]
    import hashlib
    ask_id = hashlib.sha1(f"{team}:{time.time()}:{subject}".encode()).hexdigest()[:12]
    ask = {"id": ask_id, "team": team, "subject": subject, "options": options,
           "state": "open", "created": now_iso(),
           "answered_by": None, "answer_ref": None, "acked_at": None, "answered_at": None}
    _ow_atomic_write(_ow_ask_path(team, ask_id), ask)  # independent file → no cross-team write race
    seq = _ow_mark_inbox(ask)                           # reverse waker: push, so await-ask can fire
    # keep writing the legacy STATUS.md line too, so sweep's latest_status + any human tail still see
    # the escalation during the transition (back-compat: old readers keep working, unchanged).
    try:
        with open(os.path.join(_ow_team_dir(team), "STATUS.md"), "a") as f:
            f.write(f"\n## {now_iso()} — NEEDS-OVERWATCH [ask {ask_id}]\n{subject}\n")
            for o in options:
                f.write(f"- option: {o}\n")
    except OSError:
        pass
    telemetry_log({"event": "overwatch_ask", "team": team, "ask_id": ask_id})
    _ow_notify(f"{team} asks: {subject}")
    print(f"[overwatch] ask {ask_id} opened for '{team}' (inbox seq {seq}).")
    print(f"  subject: {subject}")
    for o in options:
        print(f"    · option: {o}")
    print(f"  Overwatch sees it via:  ratchet overwatch asks --open")
    return 0

def _ow_asks(args):
    open_only = "--open" in args
    warns = []
    asks = _ow_collect_asks(open_only=open_only, warn=warns)
    # ALWAYS machine-readable JSON — the whole point is a queryable object model Glass + the monitor
    # consume, not prose to grep. This is a NEW command with its OWN schema_version; it does not touch
    # `sweep --json` (Glass's FROZEN schema_version 1 — the asks→sweep surfacing is a later follow-up).
    # `warnings` carries any store-read failure so a broken ask store is LOUD, never silently "empty".
    print(json.dumps({"schema_version": 1, "open_only": open_only, "count": len(asks),
                      "warnings": warns, "asks": asks}, indent=2))
    for w in warns:  # loud on stderr too, so a human tail / a monitor's log can't miss it
        print(f"[overwatch] asks WARNING — {w}", file=sys.stderr)
    return 2 if warns else 0  # non-zero when the store didn't fully read — a monitor can act on it

def _ow_answer(args):
    if not args or args[0].startswith("-"):
        print("usage: ratchet overwatch answer <ask_id> [--team <t>] [--ref <anchor/url>] [--by <who>] [--ack]"); return 1
    ask_id = args[0]
    if not _ow_valid_id(ask_id):
        print(f"overwatch answer: invalid ask id '{ask_id}'"); return 1
    team = _ow_arg(args, "--team")
    if team and not _ow_valid_id(team):
        print(f"overwatch answer: invalid team '{team}'"); return 1
    ref = _ow_arg(args, "--ref")
    by = _ow_arg(args, "--by")
    ack_only = "--ack" in args
    # locate the ask by scanning teams FROM THE DIR (never a hardcoded list); --team just scopes it
    teams = [team] if team else _ow_teams()
    found = found_team = None
    for t in teams:
        a = _ow_load_json(_ow_ask_path(t, ask_id))
        if a:
            found, found_team = a, t; break
    if not found:
        where = f" for team '{team}'" if team else " in any team"
        print(f"overwatch answer: no ask '{ask_id}' found{where} "
              f"(legacy NEEDS-OVERWATCH flags are answered with `overwatch respond`)"); return 1
    if ack_only:
        found["state"] = "acked"; found["acked_at"] = now_iso()
    else:
        found["state"] = "answered"; found["answered_at"] = now_iso()
        found["answer_ref"] = ref
        found["answered_by"] = by or os.environ.get("RATCHET_AGENT") or "overwatch"
    _ow_atomic_write(_ow_ask_path(found_team, ask_id), found)
    telemetry_log({"event": "overwatch_answer", "team": found_team, "ask_id": ask_id, "state": found["state"]})
    print(f"[overwatch] ask {ask_id} ({found_team}) → {found['state']}"
          + (f" · ref {ref}" if ref and not ack_only else ""))
    return 0

def _ow_report_new_asks(keys):
    byk = {f"{a['team']}:{a['id']}": a for a in _ow_collect_asks(open_only=True)}
    print(f"[overwatch] {len(keys)} new open ask(s) — answer with `ratchet overwatch answer <id> --ref <anchor>`:")
    for k in sorted(keys):
        a = byk.get(k)
        if a:
            print(f"    {a['team']:16} {a['id']}  {a.get('subject', '')}")

def _ow_await_ask(args):
    """The REVERSE waker (team→Overwatch push). The forward waker (`await`) watches a team's BRIEF;
    this watches the Overwatch inbox — the set of OPEN asks derived from the dir — and fires when a
    NEW one appears, so the Overwatch session can be re-invoked. Consumed-watermark is dir-derived
    (not the inbox seq alone), so a hand-written ask file can't slip past the wake."""
    once = "--once" in args
    try:
        timeout = int(_ow_arg(args, "--timeout", "14400"))   # ~4h, matches the forward waker
        interval = int(_ow_arg(args, "--interval", "60"))
    except ValueError:
        print("overwatch await-ask: --timeout/--interval must be integers (seconds)"); return 1
    cursor = _ow_load_json(_ow_cursor_path()) or {}
    prev_keys = set(cursor.get("keys", []))
    def _consume(keys):
        _ow_atomic_write(_ow_cursor_path(), {"keys": sorted(keys), "iso": now_iso(), "ts": time.time()})
    def _check():
        keys = _ow_open_ask_keys()
        return keys, (keys - prev_keys)   # genuinely-new open asks since Overwatch was last woken
    keys, new = _check()
    if new:
        _ow_report_new_asks(new); _consume(keys); return 0
    if once:
        _consume(keys)  # prune answered asks out of the watermark even when nothing new
        print("[overwatch] await-ask: no new asks since baseline."); return 3
    waited = 0
    while waited < timeout:
        time.sleep(interval); waited += interval
        keys, new = _check()
        if new:
            print(f"[overwatch] await-ask: new ask(s) after ~{waited}s")
            _ow_report_new_asks(new); _consume(keys); return 0
    _consume(_ow_open_ask_keys())
    print(f"[overwatch] await-ask: {timeout}s elapsed, no new asks."); return 2

def overwatch(rest):
    """ratchet overwatch <register|flag|await|ask|asks|answer|await-ask|sweep|respond> — the team
    wait-loop as a verb. Baselines the waker AT FLAG TIME so the answer-already-there race can't
    strand a team; escalations are first-class ask objects an `asks --open` query enumerates."""
    sub = rest[0] if rest else "sweep"
    args = rest[1:]
    if sub in ("-h", "--help", "help"):
        print(overwatch.__doc__)
        print("\n  register <team>                 create/attach a team dir (BRIEF.md + STATUS.md); idempotent")
        print("  flag <team> --text '<q>'        record the team's one live NEEDS-OVERWATCH ask; freezes sha(BRIEF) now")
        print("  await <team> [--timeout <s>] [--interval <s>] [--once]")
        print("                                  block until BRIEF advances past the flag-time baseline; consumes on fire")
        print("  ask --team <t> --subject '<s>' [--option '<o>' ...]   open a first-class escalation ask; fires the reverse waker")
        print("  asks [--open]                   JSON of asks across ALL teams (enumerated from the dir); --open filters to open")
        print("  answer <ask_id> [--team <t>] [--ref <anchor/url>] [--by <who>] [--ack]   answer (or --ack) an ask")
        print("  await-ask [--timeout <s>] [--interval <s>] [--once]   reverse waker: block until a NEW ask is posted")
        print("  beat <team> [--state working|blocked|idle-empty] [--card <id>] [--note '<n>']   emit a liveness heartbeat")
        print("  sweep [--json] [--stale-after <s>]   every team: flags + liveness (ok/blocked/idle-empty/SILENT)")
        print("  watch [--once] [--notify] [--stale-after <s>]   alarm on SILENT teams (durable via --install)")
        print("  watch --install [--interval <s>] [--load] | --uninstall   the durable launchd waker")
        print("  respond <team> --text '<ans>'   Overwatch-side: append the answer to the team's BRIEF (fires their waker)")
        return 0
    if sub == "register":
        return _ow_register(args)
    if sub == "flag":
        return _ow_flag(args)
    if sub == "await":
        return _ow_await(args)
    if sub == "ask":
        return _ow_ask(args)
    if sub == "asks":
        return _ow_asks(args)
    if sub == "answer":
        return _ow_answer(args)
    if sub == "await-ask":
        return _ow_await_ask(args)
    if sub == "beat":
        return _ow_beat(args)
    if sub == "sweep":
        return _ow_sweep(args)
    if sub == "watch":
        return _ow_watch(args)
    if sub == "respond":
        return _ow_respond(args)
    print(f"ratchet overwatch: unknown subcommand '{sub}' "
          f"(register|flag|await|ask|asks|answer|await-ask|beat|sweep|watch|respond)", file=sys.stderr)
    return 1

def _ow_register(args):
    if not args or args[0].startswith("-"):
        print("usage: ratchet overwatch register <team>"); return 1
    team = args[0]
    tdir = _ow_team_dir(team)
    os.makedirs(os.path.join(tdir, ".waker"), exist_ok=True)  # team dir + its waker state dir
    brief = os.path.join(tdir, "BRIEF.md")
    status = os.path.join(tdir, "STATUS.md")
    created = []
    if not os.path.exists(brief):
        open(brief, "w").write(f"# Overwatch Brief — {team}\n\n(Overwatch writes here; the team reads. "
                               f"Responses to a NEEDS-OVERWATCH flag land at the bottom.)\n")
        created.append("BRIEF.md")
    if not os.path.exists(status):
        open(status, "w").write(f"# STATUS — {team} → Overwatch\n\nAppend newest at top.\n")
        created.append("STATUS.md")
    print(f"[overwatch] team '{team}' registered at {tdir}"
          + (f" (created {', '.join(created)})" if created else " (already present — left intact)"))
    return 0

def _ow_flag(args):
    if not args or args[0].startswith("-"):
        print("usage: ratchet overwatch flag <team> --text '<question>'"); return 1
    team = args[0]
    text = _ow_arg(args, "--text")
    if not text:
        print("overwatch flag: --text '<question>' is required"); return 1
    tdir = _ow_team_dir(team)
    brief = os.path.join(tdir, "BRIEF.md")
    if not os.path.isdir(tdir):
        print(f"overwatch flag: team '{team}' is not registered — run `ratchet overwatch register {team}` first"); return 1
    import hashlib
    cur = _ow_sha(brief)
    existing = _ow_load_flag(team)
    if existing and existing.get("brief_sha") == cur:
        print(f"[overwatch] note: replacing '{team}' still-unanswered flag {existing.get('flag_id')} "
              f"— batch questions into one flag when you can (one live ask per team).")
    flag_id = hashlib.sha1(f"{team}:{time.time()}:{text}".encode()).hexdigest()[:10]
    # THE RACE FIX: freeze the brief hash NOW, at flag time — not when await is armed later. Re-flagging
    # simply re-freezes at the CURRENT sha, so a new ask never inherits a superseded baseline.
    rec = {"flag_id": flag_id, "team": team, "created": now_iso(),
           "brief_sha": cur, "question": text}
    # atomic write (temp + replace): two near-simultaneous flags on one team can't leave a torn,
    # unparseable flag.json that _ow_load_flag would silently read as "no flag" (lost ask).
    fp = _ow_flag_path(team)
    os.makedirs(os.path.dirname(fp), exist_ok=True)
    tmp_fp = f"{fp}.{os.getpid()}.tmp"  # pid-unique so two concurrent flags don't share a temp path
    json.dump(rec, open(tmp_fp, "w"))
    os.replace(tmp_fp, fp)  # singular: overwrites any prior live flag, atomically
    status = os.path.join(tdir, "STATUS.md")
    with open(status, "a") as f:
        f.write(f"\n## {now_iso()} — NEEDS-OVERWATCH [{flag_id}]\n{text}\n")
    telemetry_log({"event": "overwatch_flag", "team": team, "flag_id": flag_id})
    print(f"[overwatch] flagged NEEDS-OVERWATCH for '{team}' (flag {flag_id}); brief baseline frozen.")
    print(f"  never idle — arm the waker now:  ratchet overwatch await {team} &")
    return 0

def _ow_await(args):
    if not args or args[0].startswith("-"):
        print("usage: ratchet overwatch await <team> [--timeout <s>] [--interval <s>] [--once]"); return 1
    team = args[0]
    brief = os.path.join(_ow_team_dir(team), "BRIEF.md")
    if not os.path.isdir(_ow_team_dir(team)):
        print(f"overwatch await: team '{team}' is not registered"); return 1
    once = "--once" in args
    try:
        timeout = int(_ow_arg(args, "--timeout", "14400"))   # ~4h, matches await-overwatch.sh
        interval = int(_ow_arg(args, "--interval", "150"))   # under the 5-min cache window
    except ValueError:
        print("overwatch await: --timeout/--interval must be integers (seconds)"); return 1
    flag = _ow_load_flag(team)
    if flag:
        # baseline = the sha frozen when THIS ask was flagged. Comparing the live brief against it is
        # the whole race fix: an answer that landed between flag-time and now still trips await. Capture
        # the flag_id too, so consume-on-fire only deletes THIS ask — not a newer one flagged since.
        baseline = flag.get("brief_sha")
        expect_id = flag.get("flag_id")
    else:
        # no live flag (never flagged, or already consumed by a prior await) → fall back to an
        # arm-time baseline and SAY SO. This is exactly the window the race lives in; a flag would
        # have frozen the baseline earlier. Crucially: without a flag we do NOT resurrect a stale one.
        baseline = _ow_sha(brief)
        expect_id = None
        print(f"[overwatch] await '{team}': no flag on record — baselining at ARM time "
              f"(flag first to close the answer-already-there race).")
    def _fired(after=""):
        if _ow_sha(brief) == baseline:
            return False
        print(f"[overwatch] '{team}': Overwatch responded{after}. Re-read the tail:")
        _ow_print_tail(brief)
        _ow_clear_flag(team, expect_id)  # consume only OUR ask — never a newer flag raised since
        return True
    if _fired(" — BRIEF advanced past the baseline"):
        return 0
    if once:
        print(f"[overwatch] '{team}': no response yet (brief unchanged since baseline).")
        return 3  # distinct from timeout(2): "checked once, nothing yet" — for scripting/selftest
    # durable-waker liveness: record THIS awaiter's pid so sweep/watch can tell a live blocking waker
    # from a dead one (the overnight incident where wakers died and teams never resumed), and beat
    # state=blocked each tick so a blocked team's heartbeat stays fresh. The marker is removed on any
    # exit — so a marker whose pid is gone is proof the waker died mid-wait.
    _ow_atomic_write(_ow_awaiting_path(team),
                     {"team": team, "pid": os.getpid(), "pid_start": pid_start(os.getpid()),
                      "since": now_iso(), "since_ts": time.time(), "flag_id": expect_id})
    _ow_write_hb(team, "blocked", "awaiting Overwatch")
    try:
        waited = 0
        while waited < timeout:
            time.sleep(interval)
            waited += interval
            if _fired(f" after ~{waited}s"):
                return 0
            _ow_write_hb(team, "blocked", f"awaiting Overwatch ~{waited}s")
        print(f"[overwatch] await '{team}': {timeout}s elapsed with no response — re-flag NEEDS-OVERWATCH and re-arm.")
        return 2
    finally:
        try:
            os.remove(_ow_awaiting_path(team))  # gone ⇒ waker exited; a lingering marker w/ dead pid = crash
        except OSError:
            pass

def _ow_print_tail(path, n=30):
    try:
        lines = open(path).read().splitlines()
    except OSError:
        return
    for ln in lines[-n:]:
        print("  | " + ln)

def _ow_sweep(args):
    as_json = "--json" in args
    try:
        stale_after = int(_ow_arg(args, "--stale-after", "900"))
    except ValueError:
        print("overwatch sweep: --stale-after must be an integer (seconds)"); return 1
    home = _ow_home()
    teams = []
    for team in _ow_teams():
        flag = _ow_load_flag(team)
        cur = _ow_sha(os.path.join(_ow_team_dir(team), "BRIEF.md"))
        # three derived states from the ONE live flag: none · open (brief unmoved since the flag froze
        # its baseline → truly awaiting) · answered (brief moved past it → reply landed, await not yet
        # picked it up). All read from the same sha the waker uses, so flag and answer never disagree.
        if flag is None:
            flag_state, question, created = "clear", None, None
        elif flag.get("brief_sha") == cur:
            flag_state, question, created = "open", flag.get("question"), flag.get("created")
        else:
            flag_state, question, created = "answered", flag.get("question"), flag.get("created")
        status = os.path.join(_ow_team_dir(team), "STATUS.md")
        latest = ""
        try:
            for ln in open(status).read().splitlines():
                if ln.startswith("## "):
                    latest = ln[3:].strip()  # STATUS is newest-at-top, so first '## ' is latest
                    break
        except OSError:
            pass
        live = _ow_liveness(team, stale_after)  # ok / blocked / idle-empty / SILENT / unknown
        # FROZEN DATA CONTRACT (schema_version 1) — Glass and any dashboard bind to THESE fields.
        # Canonical doc: ~/.ratchet/overwatch/RULES-COMMON.md (Overwatch substrate) + selftest 13b.
        # Additive fields may be appended; existing names/meanings are stable.
        teams.append({
            "team": team,
            "state": live["liveness"],          # PRIMARY signal: ok|blocked|idle-empty|SILENT|unknown
            "last_beat_ts": live["last_beat_ts"],    # epoch seconds of last heartbeat, or null
            "last_beat_iso": live["last_beat_iso"],  # ISO-8601 of last heartbeat, or null
            "heartbeat_age": (int(live["age"]) if live["age"] is not None else None),  # seconds, or null
            "current_card": live["current_card"],    # work-card id the team last beat with, or null
            "open_ask": (question if flag_state == "open" else None),  # open NEEDS-OVERWATCH text, or null
            "flag_state": flag_state,           # NEEDS-OVERWATCH lifecycle: clear|open|answered
            "why": live["why"],                 # human-readable explanation of state
            "latest_status": latest[:200],      # first heading line of STATUS.md (capped — display summary)
        })
    if as_json:
        print(json.dumps({"schema_version": 1, "teams": teams}, indent=2)); return 0
    if not teams:
        print(f"[overwatch] no teams registered under {home}"); return 0
    silent = sum(1 for t in teams if t["state"] == "SILENT")
    print(f"[overwatch] sweep — {len(teams)} team(s) under {home}"
          + (f"  ·  ⚠ {silent} SILENT" if silent else "") + "\n")
    for t in teams:
        mark = {"open": f"⚑ OPEN NEEDS-OVERWATCH ({t['open_ask'][:50] if t['open_ask'] else ''})",
                "answered": "✓ answered — awaiting team pickup",
                "clear": "· clear"}[t["flag_state"]]
        badge = {"SILENT": "🔴 SILENT", "blocked": "⏳ blocked", "idle-empty": "💤 idle-empty",
                 "ok": "🟢 live", "unknown": "· unknown"}[t["state"]]
        card = f" · card {t['current_card']}" if t["current_card"] else ""
        print(f"  {t['team']:16} {badge:12} {mark}{card}")
        if t["state"] == "SILENT":
            print(f"  {'':16}   ⚠ {t['why']}")
        if t["latest_status"]:
            print(f"  {'':16}   latest: {t['latest_status']}")
    return 2 if silent else 0  # non-zero exit when any team is SILENT — a monitor can act on it

def _ow_respond(args):
    if not args or args[0].startswith("-"):
        print("usage: ratchet overwatch respond <team> --text '<answer>'"); return 1
    team = args[0]
    text = _ow_arg(args, "--text")
    if not text:
        print("overwatch respond: --text '<answer>' is required"); return 1
    tdir = _ow_team_dir(team)
    brief = os.path.join(tdir, "BRIEF.md")
    if not os.path.isdir(tdir):
        print(f"overwatch respond: team '{team}' is not registered"); return 1
    # Appending to BRIEF is exactly the event `await` watches for — it moves sha(BRIEF) past the live
    # flag's frozen baseline, which is how the ask becomes "answered". respond does NOT touch the flag
    # file (that would re-open the very race this fixes); the team's own `await` consumes it on pickup.
    with open(brief, "a") as f:
        f.write(f"\n## Overwatch response — {now_iso()}\n{text}\n")
    telemetry_log({"event": "overwatch_respond", "team": team})
    print(f"[overwatch] responded to '{team}' (BRIEF appended). Their waker fires within one poll; "
          f"the live flag is now answered (brief advanced past its baseline).")
    return 0

def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__); return 0
    # bare `ratchet` is the GUIDE, not a wall of 25 verbs (Krug: don't make me think).
    # No manifest yet → the warm welcome that points at init. `ratchet help` = the reference.
    if not args or args[0] == "next":
        try:
            m = load_manifest()
        except SystemExit:
            print("Welcome to Ratchet. Set up this machine with one command:\n\n    ratchet init\n")
            print("Then adopt your first repo. `ratchet help` shows every verb.")
            return 0
        config_load()
        return next_move(m, args[1:] if args else [])
    verb, rest = args[0], args[1:]
    if verb == "init":
        return init_cmd(rest)
    if verb == "selftest":
        return selftest(None, rest)  # selftest builds its own sandbox; manifest not required
    if verb == "overwatch":
        return overwatch(rest)  # team-coordination substrate; independent of repo topology
    m = load_manifest()
    config_load()  # E0: config enters memory ONCE, read-only; bad config = loud refusal for every verb
    if verb == "config":
        return config_cmd(m, rest)
    if verb == "watch":
        return watch(m, rest)
    if verb == "log":
        return log_cmd(m, rest)
    if verb == "replay":
        return replay(m, rest)
    if verb == "chain":
        return chain_verify()
    if verb == "inbox":
        return inbox(m, rest)
    if verb == "snooze":
        return inbox_override(m, rest, "snooze_until")
    if verb == "delegate":
        return inbox_override(m, rest, "delegate_to")
    if verb == "approve":
        return approve(m, rest)
    if verb == "reject":
        return reject(m, rest)
    if verb == "answer":
        return answer(m, rest)
    if verb in ("kill", "pause", "resume"):
        return lane_signal(m, rest, verb)
    if verb == "closeout":
        return closeout(m, rest)
    if verb == "doctor":
        return doctor(m, rest)
    if verb == "sync":
        return sync(m, rest)
    if verb == "status":
        return status(m, rest)
    if verb == "hooks":
        return hooks_cmd(m, rest)
    if verb == "work":
        return work(m, rest)
    if verb == "land":
        return land(m, rest)
    if verb == "gc":
        return gc(m, rest)
    if verb == "protect":
        return protect_cmd(m, rest)
    if verb == "take":
        return take(m, rest)
    if verb == "reconcile":
        return reconcile(m, rest)
    if verb == "bug":
        return bug(m, rest)
    if verb == "agents":
        return agents(m, rest)
    if verb == "train":
        return train(m, rest)
    if verb == "cut":
        return cut(m, rest)
    if verb in ("promote", "rollback"):
        return promote_rollback(m, rest, verb)
    if verb == "audit":
        return audit(m, rest)
    if verb == "adopt":
        return adopt(m, rest)
    if verb == "govern":
        return govern(m, rest)
    print(f"ratchet: unknown verb '{verb}' (doctor|sync|status|selftest|hooks|work|land|gc|protect|adopt|govern|overwatch)", file=sys.stderr)
    return 1

if __name__ == "__main__":
    sys.exit(main())
