document.addEventListener("keydown",e=>{
 if((e.metaKey||e.ctrlKey)&&e.key==="k"){e.preventDefault();palIsOpen()?palClose():palOpen()}
 else if(palIsOpen()){
  if(e.key==="Escape"){e.preventDefault();palClose()}
  else if(e.key==="Tab"){e.preventDefault();pin.focus()}  // focus trap: keep the modal contained
  else if(e.key==="ArrowDown"){e.preventDefault();sel=Math.min(sel+1,hits.length-1);palPaint()}
  else if(e.key==="ArrowUp"){e.preventDefault();sel=Math.max(sel-1,0);palPaint()}
  else if(e.key==="Enter"){e.preventDefault();palGo(sel)}}});
pal.addEventListener("click",e=>{if(e.target===pal)palClose()});
"""


def render_shell(data):
    """The single served document: shell + server-computed DATA + client hash router.
    The JSON payload is armored for <script> embedding: every '<' is emitted as \\u003c
    (kills </script> breakout and <!-- ambiguity in one move) and ensure_ascii keeps
    U+2028/U+2029 as escapes. Client renderers still E() every field before innerHTML."""
    payload = json.dumps(data).replace("<", "\\u003c")
    return ("<!doctype html><html><head><meta charset='utf-8'>"
            "<meta name='viewport' content='width=device-width,initial-scale=1'>"
            "<title>RATCHET GLASS — mission control</title>"
            f"<style>{GLASS_CSS}</style></head><body>"
            "<button class='skip' id='skip'>skip to content</button>"
            "<header class='bridge'>"
            "<div class='mark'><svg width='20' height='20' viewBox='0 0 24 24' fill='none' aria-hidden='true'>"
            "<circle cx='12' cy='12' r='8.5' stroke='#ff7a29' stroke-width='2.4' stroke-dasharray='4.1 2.2'/>"
            "<circle cx='12' cy='12' r='3.2' fill='#ff7a29'/></svg>"
            "RATCHET <span class='g'>// GLASS</span></div>"
            "<div id='bstats' style='display:flex;gap:1.1rem;align-items:center'></div>"
            "<div class='spacer'></div>"
            "<div class='bstat' id='bspend'></div>"
            "<button class='kbtn' id='kbtn' aria-haspopup='dialog' aria-controls='pal'>⌘K jump</button>"
            "<div class='clock' id='clock' aria-hidden='true'>--:--:--</div>"
            "</header>"
            "<nav class='side' id='side' aria-label='Primary'></nav>"
            "<main class='main' id='main' tabindex='-1'></main>"
            "<div class='pal' id='pal' role='dialog' aria-modal='true' aria-label='Command palette' hidden><div class='palbox'>"
            "<input id='palin' placeholder='jump to a card, repo, page, or verb…' autocomplete='off'"
            " role='combobox' aria-expanded='false' aria-controls='palres' aria-label='Jump to a card, repo, page, or verb'>"
            "<div class='res' id='palres' role='listbox' aria-label='Results'></div></div></div>"
            "<span style='display:none'>every action is a CLI verb; this page renders state and will never mutate it (§9)</span>"
            f"<script>const DATA = {payload};{GLASS_JS}</script>"
            "</body></html>")


# ---------- the server (GET only, exact 404s, threaded, 10s handler timeout) ----------

def serve(argv):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    try:
        port = int(argv[argv.index("--port") + 1]) if "--port" in argv else 8721
        if not 0 <= port <= 65535:
            raise ValueError(port)
    except (IndexError, ValueError):
        sys.stderr.write("glass: --port needs a number in 0..65535\n")
        return 2
    bind = "127.0.0.1"
    if "--bind-all" in argv:
        # everything the kernel knows becomes network-readable. Demand a deliberate ack so a
        # copy-pasted --bind-all can't quietly expose the workspace (kernel council HIGH).
        if os.environ.get("RATCHET_GLASS_EXPOSE") != "1":
            print("glass: REFUSE — --bind-all exposes all workspace state to your whole network.\n"
                  "  If you truly mean it: RATCHET_GLASS_EXPOSE=1 ratchet-glass serve --bind-all", flush=True)
            return 2
        bind = "0.0.0.0"
        print("glass: WARNING — serving beyond localhost; everything on it is readable on your network", flush=True)

    K.GLASS_RO = True  # kernel loaders now RAISE on corrupt state instead of quarantining (§9)
    global GLASS_EXPOSED
    GLASS_EXPOSED = bind != "127.0.0.1"  # keys page refuses even presence when network-exposed

    import html as _html

    def esc(x):
        return _html.escape(str(x))

    class Glass(BaseHTTPRequestHandler):
        # NO do_POST / do_PUT / do_DELETE / do_PATCH exists here — BaseHTTPRequestHandler
        # answers 501 for any method without a handler; the selftest proves it at runtime
        # and scans this source to prove it stays true by construction.
        timeout = 10  # a stalled client (slow-loris) holds ONE thread ≤10s, never the server

        def log_message(self, *a):
            pass

        def _send(self, body, code=200):
            data = body.encode()
            self.send_response(code)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            # no external loads ever; inline style+script are the whole app (systems audit §9-7)
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            try:
                pth = self.path.split("?")[0]
                if pth == "/":
                    self._send(render_shell(build_data()))
                    return
                if pth == "/favicon.ico":
                    self._send("", 404)  # browsers ask; it isn't state — quietly no
                    return
                # EXACT matches only: every page is a hash route under /; any other server
                # path is a 404, never a silent home render (kernel audit: typos looked real)
                self._send("<!doctype html><html><head><meta charset='utf-8'>"
                           "<title>404</title></head><body style='background:#0a0c0e;color:#7f8d99;"
                           "font-family:monospace;padding:2rem'>404 — the glass serves one document at "
                           "<a style='color:#ff7a29' href='/'>/</a>; pages are hash routes (#/board, #/card/&lt;id&gt;)"
                           "</body></html>", 404)
            except BaseException as e:
                # BaseException: a sys.exit deep in a loader raises SystemExit, which a handler
                # thread would swallow SILENTLY. Render the failure; a 500 is honest (kernel catch).
                try:
                    self._send("<!doctype html><html><head><meta charset='utf-8'><title>error</title>"
                               "</head><body style='background:#0a0c0e;color:#ff5d5d;font-family:monospace;"
                               f"padding:2rem'>render error — {esc(type(e).__name__)}: {esc(e)}"
                               "<p style='color:#7f8d99'>page views mutate nothing (§9) — fix the file "
                               "with a terminal verb and reload</p></body></html>", 500)
                except OSError:
                    pass  # client already gone

    srv = ThreadingHTTPServer((bind, port), Glass)
    srv.daemon_threads = True  # ^C wins even with a connection mid-stall
    print(f"glass: http://{bind}:{srv.server_port}/ — read-only; ^C stops it", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nglass: stopped")
    return 0


# ---------- selftest (prove the fences catch their targets, hermetically) ----------

def selftest(argv):
    import hashlib as _hl, shutil as _sh, socket as _sock, subprocess as _sp, tempfile as _tf
    import re as _re_mod
    import urllib.error, urllib.request
    results = []

    def check(label, okv, detail=""):
        results.append((label, bool(okv), str(detail)[:200]))

    def _dirhash(d):
        h = _hl.sha1()
        for root, _, files in os.walk(d):
            for fn in sorted(files):
                p = os.path.join(root, fn)
                h.update(os.path.relpath(p, d).encode())
                with open(p, "rb") as f:
                    h.update(f.read())
        return h.hexdigest()

    def _env(home, extra_env=None):
        env = dict(os.environ, RATCHET_HOME=home)
        for k in ("WL_HOME", "RATCHET_MANIFEST", "WL_MANIFEST", "RATCHET_GLASS_EXPOSE"):
            env.pop(k, None)
        if extra_env:
            env.update(extra_env)
        return env

    def _spawn(home, extra=(), extra_env=None):
        p = _sp.Popen([sys.executable, os.path.abspath(__file__), "serve", "--port", "0", *extra],
                      env=_env(home, extra_env), stdout=_sp.PIPE, stderr=_sp.STDOUT, text=True)
        for _ in range(5):  # --bind-all prints a WARNING line before the http announce
            line = p.stdout.readline()
            if "http://" in line:
                try:
                    return p, int(line.rsplit(":", 1)[1].split("/")[0])
                except (IndexError, ValueError):
                    break
            if not line:
                break
        p.terminate()
        raise RuntimeError("serve did not announce a port: %r" % line)

    def _get(port, path, timeout=5):
        try:
            r = urllib.request.urlopen("http://127.0.0.1:%d%s" % (port, path), timeout=timeout)
            return r.getcode(), r.read().decode(errors="replace"), dict(r.headers)
        except urllib.error.HTTPError as e:
            return e.code, e.read().decode(errors="replace"), dict(e.headers)

    def _stop(p):
        p.terminate()
        try:
            p.wait(timeout=10)
        except _sp.TimeoutExpired:
            p.kill()
            p.wait(timeout=5)

    now = time.strftime("%Y-%m-%dT%H:%M:%S")
    old = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(time.time() - 6 * 86400))
    old40 = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(time.time() - 40 * 86400))

    # 1. GET-only by construction: this source defines no mutating handler
    src = open(os.path.abspath(__file__)).read()
    check("GET-only by construction (no mutating handlers in source)",
          all(("def do_%s" % v) not in src for v in ("POST", "PUT", "DELETE", "PATCH")), "source scan")

    # 2-4. empty home: shell 200 + markers, POST 501, unknown routes 404, NOTHING written
    tmp = _tf.mkdtemp(prefix="glass-st-")
    try:
        p, port = _spawn(tmp)
        try:
            code, body, hdrs = _get(port, "/")
            check("shell 200 on empty home with §9 markers",
                  code == 200 and "RATCHET" in body and "never mutate" in body, "code=%s" % code)
            check("shell carries the 9-page sidebar (hash router)",
                  all(('["%s",' % s) in body and ("%s()" % s) in body
                      for s in ("overview", "board", "agents", "overwatch", "github", "repos",
                                "budget", "history", "config")),
                  body[:80])
            check("shell teaches verbs in empty states (take hint in payload)",
                  "ratchet take" in body, "")
            # a11y contract (WCAG): landmarks + skip link + focusable main + visible focus
            check("a11y: header/nav/main landmarks + labeled nav + skip link + focusable main",
                  "<header class='bridge'>" in body and "aria-label='Primary'" in body
                  and "id='main' tabindex='-1'" in body and "class='skip'" in body, "")
            check("a11y: a global :focus-visible outline exists (keyboard focus is visible)",
                  ":focus-visible{outline" in body, "")
            check("a11y: ⌘K palette is a proper dialog (role=dialog, aria-modal, combobox input)",
                  "role='dialog' aria-modal='true'" in body and "role='combobox'" in body
                  and "role='listbox'" in body, "")
            check("a11y: palette keyboard model present (focus trap, restore, +N more, aria state)",
                  'e.key==="Tab"' in body and "palPrev" in body and "aria-activedescendant" in body
                  and "refine your search" in body and 'setAttribute("aria-expanded"' in body, "")
            check("a11y: nav rows carry a REAL inner <a> link (native keyboard, table role=row kept)",
                  'href="#/repo/${E(r.name)}"' in body and 'target="_blank" rel="noopener"' in body
                  and 'role="link"' not in body and 'e.target.closest("a")' in body, "")
            check("a11y: --faint text color meets WCAG AA on the dark theme (bumped from #54626e)",
                  "--faint:#7a8792" in body and "--faint:#54626e" not in body, "")
            check("a11y: decorative SVG icons are aria-hidden (shell + client-rendered sidebar)",
                  "aria-hidden='true'" in body and 'aria-hidden="true"' in body, "")
            check("CSP forbids external loads",
                  "default-src 'none'" in hdrs.get("Content-Security-Policy", ""),
                  hdrs.get("Content-Security-Policy", "MISSING"))
            # liveness motion (card glass-liveness-motion): tasteful, state-conveying animation that
            # is ALWAYS opt-out under prefers-reduced-motion and never a network poll (§9 read-only).
            check("motion: avatars convey liveness (breathe=alive, alarm=needs-you) via keyframes",
                  "@keyframes breathe" in body and "@keyframes alarm" in body
                  and ".ava.beat{" in body and ".ava.alarm{" in body, "")
            check("motion: an in-progress gate station shimmers + the header carries a heartbeat",
                  "@keyframes shimmer" in body and 'class="hbeat"' in body and "@keyframes hb{" in body
                  # the gradient + animation must be COLOCATED on the winning .step.running rule, and
                  # the old solid-bg rule (which silently clobbered the shimmer via the background
                  # shorthand) must be GONE — a substring check that catches the cascade-dead defect.
                  and ".step.running{background:linear-gradient" in body
                  and "animation:shimmer 1.6s" in body
                  and ".step.running{background:rgba(240,184,62,.1)}" not in body, "")
            check("motion: counts ease up at render-time only (data-count + rAF), never a poll",
                  "data-count=" in body and "requestAnimationFrame(step)" in body
                  and "fetch(" not in body and "XMLHttpRequest" not in body, "")
            check("motion: EVERY animation respects prefers-reduced-motion (CSS guard + JS check)",
                  ".ava.beat,.ava.alarm,.step.running,.hbeat,.panel{animation:none}" in body
                  and 'matchMedia("(prefers-reduced-motion:reduce)")' in body, "")
            check("motion is state-bound: SILENT alarms / live breathes / stuck lane alarms",
                  't.liveness==="SILENT"?"alarm":t.liveness==="ok"?"beat"' in body
                  and 'b.stuck?"alarm":b.quiet?"":"beat"' in body, "")
            post_code = 0
            try:
                urllib.request.urlopen(urllib.request.Request(
                    "http://127.0.0.1:%d/" % port, data=b"x=1", method="POST"), timeout=5)
            except urllib.error.HTTPError as e:
                post_code = e.code
            check("POST refused with 501", post_code == 501, "post=%s" % post_code)
            n1, _, _ = _get(port, "/no-such-route")
            n2, _, _ = _get(port, "/card/abc123")          # old server route — pages are hash routes now
            n3, _, _ = _get(port, "/trainsgarbage")
            fav, _, _ = _get(port, "/favicon.ico")
            check("unknown server routes 404 (exact match, home only)",
                  n1 == 404 and n2 == 404 and n3 == 404 and fav == 404,
                  "codes=%s/%s/%s/fav=%s" % (n1, n2, n3, fav))
            check("empty home: GitHub + Repos render empty, not crashed",
                  '"github": []' in body and '"repos": []' in body, "")
            wrote = os.listdir(tmp)
            check("empty home: page views created NOTHING", not wrote, "wrote=%s" % wrote)
        finally:
            _stop(p)
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 4b. estate pages: a SEEDED manifest + doctor-report + maintain snapshots + checknames +
    # governance files render real rows (BRIEF: assert rendered rows against a seeded fixture),
    # and seeding them writes NOTHING on a page view
    tmp = _tf.mkdtemp(prefix="glass-est-")
    try:
