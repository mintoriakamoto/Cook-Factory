# Client renderers: everything that touches DATA goes through E() before innerHTML — DATA is
# state agents wrote (card slugs, telemetry fields) and is treated as hostile at render time,
# on top of the server-side \\u003c JSON armoring.
GLASS_JS = """
const E=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const pill=(k,t)=>`<span class="pill ${E(k)}">${E(t)}</span>`;
const verb=(v,d)=>v?`<button class="verb${d?' danger':''}" data-v="${E(v)}">${E(v)}</button>`:"";
const shq=s=>/^[A-Za-z0-9._\\/~-]+$/.test(s)?s:"'"+String(s).replace(/'/g,"'\\''")+"'";
const asof=()=>`<span class="asof"><span class="hbeat" aria-hidden="true"></span>as of ${E(DATA.asof)} \\u00b7 sources: local state files (reload to recompute)</span>`;
const NAV=[["overview","Overview","M3 12l9-9 9 9M5 10v10h14V10"],["board","Board","M3 4h18M3 12h18M3 20h18"],
