  navigator.clipboard&&navigator.clipboard.writeText(v.getAttribute("data-v")||v.textContent);
  v.classList.add("copied");setTimeout(()=>v.classList.remove("copied"),1200)}));
 // row navigation via data-* read with getAttribute — NOT an inline handler: the value is a
 // string assigned to location.hash (always #-prefixed) or passed to window.open (always an
 // https://github.com/… URL), never compiled as JS, so an attacker-controlled repo name or
 // remote slug containing a quote cannot execute (review CRITICAL — E() alone is unsafe inside
 // an inline onclick because the browser HTML-decodes &#39; back to ' before running it).
 // The keyboard/AT nav path is a REAL <a> inside each row's first cell (native link semantics,
 // table role=row preserved). The row click is a mouse-only convenience over the whole row; it
 // skips clicks that already hit the inner link so an external row never opens twice.
 const rowClick=fn=>e=>{if(!e.target.closest("a"))fn()};
 document.querySelectorAll("[data-nav]").forEach(el=>el.addEventListener("click",rowClick(()=>{location.hash=el.getAttribute("data-nav")})));
 document.querySelectorAll("[data-ext]").forEach(el=>el.addEventListener("click",rowClick(()=>{const u=el.getAttribute("data-ext");if(u&&u.indexOf("https://")===0)window.open(u,"_blank","noopener")})));
 // count-up: numbers ease from 0 to their value AT RENDER (a "live counts" cue — render-time only,
 // never a network poll; the DATA is unchanged). Skipped whole under prefers-reduced-motion, where
 // the server-rendered final number simply stays put.
 if(!(window.matchMedia&&matchMedia("(prefers-reduced-motion:reduce)").matches)){
  document.querySelectorAll("[data-count]").forEach(el=>{
   const end=parseInt(el.getAttribute("data-count"),10);if(!(end>0)){return}
   let t0=null;el.textContent="0";
   const step=ts=>{if(!el.isConnected){el.textContent=String(end);return}
    if(t0===null){t0=ts}const p=Math.min(1,(ts-t0)/520);
    el.textContent=String(Math.round(end*(1-Math.pow(1-p,3))));
    if(p<1){requestAnimationFrame(step)}else{el.textContent=String(end)}};
   requestAnimationFrame(step);
  });
 }
 window.scrollTo(0,0);
 // move focus to the <main> container on a route CHANGE (not first paint) so keyboard/AT users
 // aren't dropped to <body> when the old focused element is destroyed (a11y focus management).
 if(window.__navd){const m=document.getElementById("main");if(m)m.focus({preventScroll:true})}
 window.__navd=true;
}
window.addEventListener("hashchange",render);
bridge();render();
setInterval(()=>{document.getElementById("clock").textContent=new Date().toTimeString().slice(0,8)},1000);

/* \\u2318K command palette. The index is built from cards/repos/pages/verbs ONLY \\u2014 KEY rows
   are deliberately EXCLUDED (systems R2-8: a searchable key-name set is a leak of its own), and no
   config value or secret ever enters it. Every entry is an E()-escaped label; navigation reuses
   the safe location.hash assignment (never eval). */
function buildIndex(){
 const ix=NAV.map(([id,label])=>["page",label.replace("&amp;","&"),"#/"+id]);
 (DATA.board||[]).forEach(b=>ix.push(["card",b.slug+" \\u2014 "+(b.title||""),"#/card/"+b.wid]));
 ((DATA.repos_est||{}).repos||[]).forEach(r=>ix.push(["repo",r.name,"#/repo/"+r.name]));
 [["verb","ratchet doctor",null],["verb","ratchet chain",null],["verb","ratchet-maintain snapshot --all",null],
  ["verb","ratchet-budget report --period day",null],["verb","~/.ratchet/bin/ratchet-daily.sh",null]]
  .forEach(v=>ix.push(v));
 return ix;
}
const pal=document.getElementById("pal"),pin=document.getElementById("palin"),pres=document.getElementById("palres");
