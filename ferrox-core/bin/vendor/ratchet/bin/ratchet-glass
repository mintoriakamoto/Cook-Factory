        before = _dirhash(tmp)
        p, port = _spawn(tmp)
        try:
            code, body, _ = _get(port, "/")
            _get(port, "/")
            import re as _re2
            D = json.loads(_re2.search(r"const DATA = (.*?);\n", body).group(1))
            gh = {g["repo"]: g for g in D.get("github", [])}
            check("GitHub board renders the snapshot (total + counts + delta vs .prev)",
                  gh.get("demo", {}).get("issues", {}).get("total") == 12
                  and gh["demo"]["issues"]["counts"]["triage"] == 5
                  and gh["demo"]["issues"]["delta"] == 2, str(gh.get("demo", {}).get("issues")))
            check("GitHub snapshot never triggers a live gh call (renders cache only)",
                  gh.get("demo", {}).get("age") is not None, "")
            check("hostile issue title from the snapshot cannot break out",
                  "</script><script>x" not in body and hostile_iss.replace("<", "\\u003c") in body, "")
            # the real fence: row navigation must NOT be an inline onclick — E() decodes &#39;
            # back to ' before an inline handler runs, so a quote in a repo name/remote would
            # execute. After the fix there are zero inline handlers; nav rides a data-* attr.
            check("no inline onclick handlers exist (E-inside-JS XSS class eliminated)",
                  "onclick=" not in body, "")
            # nav rides an E()-escaped data-* ATTRIBUTE (safe: read via getAttribute, assigned to
            # location.hash / passed to window.open — never compiled as JS). The shipped client
            # source proves the safe pattern; the hostile repo name flows only as inert data.
            check("row nav uses an E-escaped data-attribute, not a JS-context interpolation",
                  'data-nav="#/repo/${E(r.name)}"' in body and 'data-ext="${E(u)}"' in body, "")
            check("hostile repo name flows only as inert data in the payload",
                  "\"x'y\"" in body, "")
            check("governance for an absent working tree reads UNKNOWN, not all-missing",
                  {r["name"]: r for r in D["repos_est"]["repos"]}.get("x'y", {}).get("gov_known") is False, "")
            re_ = {r["name"]: r for r in D.get("repos_est", {}).get("repos", [])}
            check("Repos health = worst doctor check (OK+WARN -> WARN)",
                  re_.get("demo", {}).get("health") == "WARN"
                  and D["repos_est"]["doctor_run"] is True, str(re_.get("demo", {}).get("health")))
            check("Repos protection from checknames cache (no gh call)",
                  re_.get("demo", {}).get("protect") == ["selftest", "build"], str(re_.get("demo", {}).get("protect")))
            check("Repos governance presence is a local stat (all 4 present -> none missing)",
                  re_.get("demo", {}).get("gov_missing") == [], str(re_.get("demo", {}).get("gov_missing")))
        finally:
