  +(total>hits.length?`<div class="empty" style="padding:.5rem 1rem;font-size:.7rem">+ ${total-hits.length} more \\u2014 refine your search</div>`:"")
  ||`<div class="empty" style="padding:.8rem 1rem">no matches</div>`;
