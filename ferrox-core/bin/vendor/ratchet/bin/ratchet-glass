#!/usr/bin/env python3
"""ratchet-glass — mission control for the ratchet control plane (glass v4).

The glass RENDERS state and NEVER mutates it (§9): GET only, localhost only,
no fetches on page view, no cache writes from a page view, no os.replace /
sys.exit in any read path. Every "action" on a page is a copyable CLI verb —
the write happens in your terminal, where the gate applies.

This is a companion in the ratchet-kanban mold: it loads the kernel read-only
(SourceFileLoader) for its state paths and derivations, and holds no verb that
mutates anything. The read-only guarantee is proved, not promised: the selftest
renders against a populated home and asserts it stays byte-identical.

Stage 1 (glass-serve-shell): the SPA shell — bridge, sidebar, hash router,
Overview (needs-you · tiles · today feed) from kernel state files. Pages that
ship in later cards render an honest "not built yet" state that teaches the
CLI verb answering the same question today.

Verbs:
  serve [--port N] [--bind-all]   serve the glass (default 127.0.0.1:8721)
  selftest                        hermetic proofs: GET-only, POST 501, exact
                                  404s, read-only-ness, corrupt-state 500,
                                  hostile-title escaping, slow-loris survival
"""
import importlib.machinery, importlib.util
import json, os, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))


def _kernel():
    spec = importlib.util.spec_from_loader(
        "ratchet_kernel",
        importlib.machinery.SourceFileLoader("ratchet_kernel", os.path.join(HERE, "ratchet")))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


K = _kernel()

DAY_S = 86400.0
GLASS_EXPOSED = False  # set True by serve() when bind != 127.0.0.1: the keys page then refuses
# even presence booleans over the network (systems R2-8 — a name-set can hint at what to attack)
STALE_S = 24 * 3600  # bridge badges: a green older than this renders amber (stale-green is amber)


# ---------- read-only loaders (§9: a page view writes NOTHING, not even a cursor) ----------

def _age_str(secs):
    if secs is None:
        return ""
    secs = max(0, int(secs))
    if secs < 3600:
        return "%dm" % (secs // 60)
    if secs < DAY_S:
        return "%dh" % (secs // 3600)
    return "%dd" % (secs // DAY_S)


def _ts_age_s(ts):
    try:
        return time.time() - time.mktime(time.strptime(str(ts)[:19], "%Y-%m-%dT%H:%M:%S"))
    except (ValueError, TypeError, OverflowError):
        return None


def spend_today_ro():
    """Today's metered spend WITHOUT advancing the kernel's spend cursor: read the cursor
    cache, scan only the bytes appended since, sum in memory, persist nothing. The kernel's
    spend_today() writes the cursor back — that is a CLI-side optimization; a page view gets
    the same number by leaving the tail bytes for the CLI to absorb later."""
    p = K.state_path("telemetry.jsonl")
    today = K.now_iso()[:10]
    offset, day_sum = 0, 0.0
    saved, _age = K.cache_get_stale("spend-cursor")
    if isinstance(saved, dict) and isinstance(saved.get("offset"), int) and saved["offset"] >= 0:
        offset = saved["offset"]
        if saved.get("day") == today:
            try:
                day_sum = float(saved.get("day_sum") or 0.0)
            except (TypeError, ValueError):
                day_sum = 0.0
    try:
        size = os.path.getsize(p)
    except OSError:
        return 0.0  # no telemetry yet — nothing spent
    if offset > size:  # cursor past EOF: file truncated/rotated — the cursor is a lie, rescan
        offset, day_sum = 0, 0.0
    import math
    with open(p, "rb") as fh:
        fh.seek(offset)
        for ln in fh:
            if not ln.endswith(b"\n"):
                break  # torn tail line — the CLI's next pass counts it; never half-count here
            try:
                e = json.loads(ln)
            except (json.JSONDecodeError, ValueError):
                continue
            if not isinstance(e, dict) or not str(e.get("ts", "")).startswith(today):
                continue
            try:
                v = float(e.get("cost_usd") or 0)
            except (TypeError, ValueError):
                continue
            if math.isfinite(v) and v >= 0:  # a nan/inf/negative cost is NO price, never summed
                day_sum += v
    return day_sum


# telemetry events the Overview feed shows (R2-10: telemetry is the feed's source of truth,
# whitelisted — journals only contribute interrupted-run items, which needs-you already carries).
FEED_EVENTS = {
    "take": "ember", "take_bulk": "ember", "land_gate_pass": "ok", "land_suite_fail": "red",
    "land_fuse_claimed": "unk", "land_no_card": "warn", "cut": "blue", "train": "blue",
    "promote": "blue", "rollback": "red", "adopt": "unk", "approve": "ok", "reject": "red",
    "closeout": "blue",
}
_FEED_DETAIL_KEYS = ("slug", "work_id", "name", "repos", "repo", "ref", "snapshot", "green")


def feed_tail(limit=8, tail_bytes=131072):
    """Newest whitelisted telemetry events — reads only the file TAIL (the ledger is multi-MB
    and grows daily; a page view never scans it from byte 0)."""
    p = K.state_path("telemetry.jsonl")
    try:
        size = os.path.getsize(p)
        with open(p, "rb") as fh:
            if size > tail_bytes:
                fh.seek(size - tail_bytes)
                fh.readline()  # drop the partial first line
            raw = fh.read()
    except OSError:
        return []
    rows = []
    for ln in raw.splitlines():
        try:
            e = json.loads(ln)
        except (json.JSONDecodeError, ValueError):
            continue
        if not isinstance(e, dict):  # a non-dict telemetry line must not reach a .get()
            continue
        ev = e.get("event")
        if ev not in FEED_EVENTS:
            continue
        bits = []
        for k in _FEED_DETAIL_KEYS:
            v = e.get(k)
            if v not in (None, "", []):
                bits.append("%s %s" % (k, ",".join(v) if isinstance(v, list) else v))
        ts = str(e.get("ts", ""))
        rows.append({"ts": ts[11:16] if len(ts) >= 16 else ts, "ev": str(ev),
                     "pill": FEED_EVENTS[ev], "msg": " · ".join(bits) or str(ev),
                     "age": _age_str(_ts_age_s(ts))})
    rows.reverse()
    return rows[:limit]


STATIONS = ("rebase", "suite", "review", "push")
_ABORT_STATION = {"fetch": "rebase", "rebase": "rebase", "suite": "suite", "corpus": "suite",
                  "review": "review", "push": "push", "pr-create": "push"}


def _gate_from_run(run):
    """Stepper states derived from a land journal run. Honest by construction: a station
    renders 'done' only if its step was journaled; a skip renders as a skip (never 'done');
    a completed run from before step-journaling renders 'unrecorded', never a claimed pass;
    an aborted run marks the station it died at with the recorded reason."""
    steps = run.get("steps")
    labels = [str(st.get("label", "")) for st in steps
              if isinstance(st, dict)] if isinstance(steps, list) else []
    outcome = str(run.get("outcome") or "")
    ok = bool(run.get("done")) and outcome == "ok"
    aborted = bool(run.get("done")) and not ok
    why = outcome[len("aborted:"):] if outcome.startswith("aborted:") else (outcome or None)
    fail_at = _ABORT_STATION.get(why) if aborted else None
    if run.get("done"):
        interrupted = False
    else:
        # journals are agent-writable: a garbage pid must degrade to "claimant unverifiable"
        # (= interrupted), never crash the whole dashboard
        try:
            claimant = K.pid_is_claimant(int(run.get("pid") or 0), str(run.get("pid_start") or ""))
        except (TypeError, ValueError, OverflowError):
            claimant = False
        interrupted = not claimant
    running = (not run.get("done")) and not interrupted
    gate, live_marked = [], False
    for st in STATIONS:
        if ("pushed" if st == "push" else st) in labels:
            state = "done"
        elif (st + ":skipped") in labels:
            state = "skipped"
        elif ok:
            state = "unrecorded"  # pre-journaling kernel: the run passed, the step wasn't recorded
        elif not aborted and not live_marked:
            state = "stalled" if interrupted else "running"
            live_marked = True
        else:
            state = "pending"
        gate.append({"st": st, "state": state})
    if aborted:
        # mark the recorded station if it is still unclaimed; else the first pending one — a
        # corpus abort happens AFTER suite passed, and "no red anywhere" would evaporate the
        # failure (review catch: the reason text alone must never carry a gate abort)
        idx = next((i for i, g in enumerate(gate)
                    if g["st"] == fail_at and g["state"] == "pending"), None)
        if idx is None:
            idx = next((i for i, g in enumerate(gate) if g["state"] == "pending"), None)
        if idx is not None:
            gate[idx]["state"] = "failed"
    step = sum(1 for g in gate if g["state"] in ("done", "skipped", "unrecorded"))
    return {"gate": gate, "step": step, "ok": ok, "aborted": aborted, "why": why,
            "interrupted": interrupted, "running": running}


def _read_recording(wid, max_events=40):
    """Timeline + derived facts from state/recordings/<wid>/ — read-only, capped, tolerant.
    wid comes from agent-writable workcards.json: safe_ref() confines it to the recordings
    tree (a work_id of "../../<x>" or "/etc/<x>" must never read outside it — review catch)."""
    if K.safe_ref(str(wid)) is None:
        return {"tl": [], "n_events": 0, "diff": None, "result": None,
                "result_ts": None, "last_ts": None, "suite_tail": None}
    rdir = os.path.join(K.WL_HOME, "state", "recordings", str(wid))
    tl, diff, result, result_ts, last_ts = [], None, None, None, None
    try:
        lines = open(os.path.join(rdir, "events.jsonl"), "rb").read().splitlines()
    except OSError:
        lines = []
    for ln in lines:
        try:
            e = json.loads(ln)
        except (json.JSONDecodeError, ValueError):
            continue
        rest = {k: v for k, v in e.items() if k not in ("ts", "agent", "event")}
        ts = str(e.get("ts", ""))
        last_ts = ts or last_ts
        tl.append([ts, str(e.get("event", "?")), str(e.get("agent", "")),
                   json.dumps(rest, default=str)[:160]])
        if e.get("event") == "diff_facts":
            if "error" in e:
                diff = {"error": str(e["error"])[:200]}
            else:
                diff = {"n_files": e.get("n_files"), "plus": e.get("plus"), "minus": e.get("minus"),
                        "files": [str(f) for f in (e.get("files") or [])[:30]],
                        "subjects": [str(x)[:100] for x in (e.get("subjects") or [])[:10]]}
        elif e.get("event") == "land_pass":
            result = "landed %s -> %s" % (e.get("branch", ""), e.get("repo", ""))
            result_ts = ts
    tail = None
    try:
        tail = open(os.path.join(rdir, "suite-tail.txt"), errors="replace").read()[-4096:]
    except OSError:
        pass
    return {"tl": tl[-max_events:], "n_events": len(tl), "diff": diff, "result": result,
            "result_ts": result_ts, "last_ts": last_ts, "suite_tail": tail}


def build_cards():
    """Board rows + per-card detail from workcards + land journals + flight recordings."""
    sl = K.state_load(K.CARDS, {"cards": []})
    raw = sl.get("cards") if isinstance(sl, dict) else None
    if not isinstance(raw, list):
        raw = []  # a list/keyless workcards.json degrades to an empty board, never a 500
    jl = K.state_load("journals.json", {"schema_version": 1, "runs": []})
    jruns = jl.get("runs") if isinstance(jl, dict) else None
    runs = [r for r in (jruns if isinstance(jruns, list) else [])
            if isinstance(r, dict) and r.get("verb") == "land"]
    run_by_ref = {}
    for r in runs:
        run_by_ref[str(r.get("ref"))] = r  # append-ordered: last one per worktree wins
    today = K.now_iso()[:10]
    board, details, agents = [], {}, {}
    abandoned = 0
    # bound the per-view work: recordings are opened only for ACTIVE cards and the most
    # recent landed ones (7 days, max 30) — landed cards accumulate forever and an
    # every-card read would grow the page and the IO without bound (review catch).
    # Older landed cards stay on the board and get a light "archived" detail.
    week_ago = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(time.time() - 7 * 86400))
    cands = [c for c in raw if isinstance(c, dict)]
    recent_landed = sorted((c for c in cands if c.get("status") == "landed"),
                           key=lambda c: str(c.get("land_ts") or c.get("created") or ""),
                           reverse=True)
    covered = {id(c) for c in cands if c.get("status") in ("pending", "open", "landing")}
    n_rec = 0
    for c in recent_landed:
        if n_rec >= 30 or str(c.get("land_ts") or c.get("created") or "") < week_ago:
            break
        covered.add(id(c))
        n_rec += 1
    empty_rec = {"tl": [], "n_events": 0, "diff": None, "result": None,
                 "result_ts": None, "last_ts": None, "suite_tail": None}
    for c in cands:
        status = c.get("status")
        if status == "abandoned":
            abandoned += 1
            continue
        if status not in ("pending", "open", "landing", "landed"):
            continue
        wid = str(c.get("work_id") or "?")
        wt = K.expand(str(c.get("worktree") or ""))
        run = run_by_ref.get(os.path.realpath(wt) if wt else "")
        g = _gate_from_run(run) if run else None
        archived = id(c) not in covered
        rec = empty_rec if archived else _read_recording(wid)
        wt_gone = bool(wt) and status in ("open", "landing") and not os.path.exists(wt)
        stuck_why = ("worktree gone" if wt_gone
                     else "land interrupted" if (g and g["interrupted"] and status == "landing")
                     else "gate failed: %s" % g["why"] if (g and g["aborted"] and status in ("open", "landing"))
                     else None)
        land_ts = None
        if status == "landed":
            for ts_c in (rec["result_ts"], c.get("land_ts"), c.get("created")):
                if ts_c:
                    land_ts = str(ts_c)
                    break
        step = 4 if status == "landed" and g is None else (g["step"] if g else 0)
        ag = str(c.get("agent") or "").strip() or "unattributed"
        last_ev_s = _ts_age_s(rec["last_ts"]) if rec["last_ts"] else None
        active = status in ("open", "landing")
        lane_quiet = bool(active and last_ev_s is not None and last_ev_s > 90 * 60 and not stuck_why)
        board.append({
            "wid": wid, "slug": str(c.get("slug") or wid), "title": str(c.get("title") or ""),
            "repo": str(c.get("repo") or ""), "status": status, "risk": str(c.get("risk") or ""),
            "agent": ag, "age": _age_str(_ts_age_s(c.get("created"))), "step": step,
            "stuck": bool(stuck_why), "stuck_why": stuck_why, "quiet": lane_quiet,
            "last_ev_age": _age_str(last_ev_s) if last_ev_s is not None else None,
            "landed_day": (land_ts or "")[:10] if status == "landed" else None,
            "issue": str(c.get("issue") or "")})
        # per-agent aggregate (Agents page). Counts are per LANE (multi-repo work is one card per
        # repo, sharing a work_id — two real lanes, counted as two, by design). model/CLI and
        # reliable per-lane spend are NOT in kernel state (friction #11); the page says so.
        a = agents.setdefault(ag, {"agent": ag, "lands": 0, "active": 0, "stuck": 0,
                                   "active_ev_s": None, "unattributed": ag == "unattributed"})
        if status == "landed":
            a["lands"] += 1
        elif active:
            a["active"] += 1
            # liveness is measured over ACTIVE lanes ONLY — a card that landed minutes ago must
            # never mask an open lane that has been silent for hours (review MAJOR)
            if last_ev_s is not None and (a["active_ev_s"] is None or last_ev_s < a["active_ev_s"]):
                a["active_ev_s"] = last_ev_s
        if stuck_why:
            a["stuck"] += 1
        if wid not in details:
            details[wid] = {
                "archived": archived,
                "slug": str(c.get("slug") or wid), "title": str(c.get("title") or ""),
                "repo": str(c.get("repo") or ""), "branch": K.branch_for(str(c.get("slug") or wid)),
                "issue": str(c.get("issue") or ""), "status": status,
                "agent": str(c.get("agent") or ""), "age": _age_str(_ts_age_s(c.get("created"))),
                "worktree": str(c.get("worktree") or ""), "wt_gone": wt_gone,
                "gate": g["gate"] if g else None, "gate_why": g["why"] if (g and g["aborted"]) else None,
                "interrupted": bool(g and g["interrupted"]), "stuck_why": stuck_why,
                "tl": rec["tl"], "n_events": rec["n_events"], "diff": rec["diff"],
                "result": rec["result"], "suite_tail": rec["suite_tail"]}
    trains = [{"name": str(t.get("name") or ""), "status": str(t.get("status") or ""),
               "snapshot": str(t.get("snapshot") or "")[:10], "ts": str(t.get("ts") or "")[:10]}
              for t in (lambda x: x.get("trains") if isinstance(x, dict) and
                        isinstance(x.get("trains"), list) else [])(
                            K.state_load(K.TRAINS, {"trains": []}))
              if isinstance(t, dict)]
    LIVENESS_QUIET_S = 90 * 60  # an active lane silent this long is "quiet" before it's called dead
    agents_list = []
    for a in agents.values():
        active = a["active"]
        quiet = active > 0 and a["active_ev_s"] is not None and a["active_ev_s"] > LIVENESS_QUIET_S
        state = ("stuck" if a["stuck"] else "quiet" if quiet
                 else "on-shift" if active else "idle")
        agents_list.append({
            "agent": a["agent"], "lands": a["lands"], "active": active, "stuck": a["stuck"],
            "unattributed": a["unattributed"], "state": state,
            "last_ev_age": _age_str(a["active_ev_s"]) if a["active_ev_s"] is not None else None})
    # sort: on-shift/stuck first (most active), then most lands — the working agents on top
    order = {"stuck": 0, "quiet": 1, "on-shift": 2, "idle": 3}
    agents_list.sort(key=lambda x: (order.get(x["state"], 9), -x["active"], -x["lands"]))
    return {"board": board, "cards": details, "trains": trains, "abandoned": abandoned,
            "agents": agents_list, "today": today}


GOV_ALTS = {
    "SECURITY.md": ("SECURITY.md", ".github/SECURITY.md", "docs/SECURITY.md"),
    "CODEOWNERS": ("CODEOWNERS", ".github/CODEOWNERS", "docs/CODEOWNERS"),
    "PULL_REQUEST_TEMPLATE.md": (".github/PULL_REQUEST_TEMPLATE.md", "PULL_REQUEST_TEMPLATE.md",
                                 "docs/PULL_REQUEST_TEMPLATE.md"),
    "CONTRIBUTING.md": ("CONTRIBUTING.md", ".github/CONTRIBUTING.md", "docs/CONTRIBUTING.md"),
}
ISSUE_COLS = ["triage", "active", "blocked", "stale"]
PR_COLS = ["review", "ready", "checks-fail", "draft", "stale"]


def _manifest_ro():
    """The manifest, read-only + defensive — never K.load_manifest() (it sys.exits on any hiccup,
    which under the threaded server dies silently). A page view degrades to an empty estate."""
    try:
        m = json.load(open(K.MANIFEST_PATH))
    except (OSError, ValueError):
        return {}
    repos = m.get("repos") if isinstance(m, dict) else None
    return repos if isinstance(repos, dict) else {}


def _slug_from_remote(r):
    """owner/repo for external GitHub links, parsed from the manifest remote — never a network call."""
    remotes = r.get("remotes") if isinstance(r, dict) else None
    url = ""
    if isinstance(remotes, dict) and remotes:
        url = str(remotes.get(r.get("push_remote") or "origin") or next(iter(remotes.values()), ""))
    return url.split("github.com/")[-1].removesuffix(".git") if "github.com/" in url else ""


# Config & Keys: a FIXED integration allowlist — env is NEVER enumerated (R1-5). Presence is a
# BOOLEAN computed server-side; a value/last-4 is NEVER rendered or indexed (R2-8). WORKS is a
# last-success signal from telemetry, not a live probe.
KEYS_ALLOWLIST = [
    {"name": "Flux Router (FLUX_TEST_KEY)", "kind": "env", "env": ["FLUX_TEST_KEY"],
     "breaks": "council metering + wl-fuse", "works": "flux",
     "add": "security add-generic-password -s FLUX_TEST_KEY -a ratchet -w"},
    {"name": "Flux Router (FLUX_DEV_KEY)", "kind": "env", "env": ["FLUX_DEV_KEY"],
     "breaks": "dev-lane routing", "works": "flux",
     "add": "security add-generic-password -s FLUX_DEV_KEY -a ratchet -w"},
    {"name": "Anthropic (council direct)", "kind": "env", "env": ["ANTHROPIC_API_KEY"],
     "breaks": "direct-Anthropic council lane", "add": "export ANTHROPIC_API_KEY=<key>"},
    {"name": "GitHub (gh keychain)", "kind": "gh", "env": ["GH_TOKEN", "GITHUB_TOKEN"],
     "breaks": "land / push / PR", "works": "github", "add": "gh auth login"},
    {"name": "codex CLI (judge roster)", "kind": "cli", "bin": "codex", "breaks": "judge roster"},
    {"name": "gemini CLI (council)", "kind": "cli", "bin": "gemini", "breaks": "gemini council lane"},
    {"name": "claude CLI (flat lanes)", "kind": "cli", "bin": "claude", "breaks": "flat sub-CLI lanes"},
]


def build_keys(ctx=None):
    """Presence-only capability matrix. When the glass is network-exposed, refuse to render even
    the NAME set (a would-be attacker learns nothing from the page). Never touches a value."""
    if GLASS_EXPOSED:
        return {"exposed": True, "keys": []}
    import shutil
    evs, _ = (ctx or _read_ctx())["tev"]
    worked = set()
    for e in evs:
        ev = e.get("event")
        if ev in ("land_gate_pass", "adopt", "land_pr_fail"):
            worked.add("github")
        if _classify(e) == "metered":
            worked.add("flux")
    rows = []
    for k in KEYS_ALLOWLIST:
        if k["kind"] == "cli":
            present = shutil.which(k["bin"]) is not None  # PATH stat — pure, no value
        else:
            present = any(bool(os.environ.get(e)) for e in k.get("env", []))
        sig = k.get("works")
        if present and sig and sig in worked:
            state, note = "works", "last successful use seen in telemetry"
        elif k["kind"] == "gh" and not present:
            state, note = "unknown", "managed by the gh keychain (not an env var) — verify below"
        elif present:
            state, note = "present", "present — not yet verified this session"
        else:
            state, note = "missing", "without it: " + k["breaks"]
        rows.append({"name": k["name"], "state": state, "note": note,
                     "add": k["add"] if (state == "missing" and k.get("add")) else
                            ("gh auth status" if k["kind"] == "gh" and state == "unknown" else None)})
    return {"exposed": False, "keys": rows}


def build_config(ctx=None):
    """Effective config + where each value came from (default/file). Policy values only — no
    secrets live here; the SECRET_RE selftest scans the whole payload to keep it that way."""
    cfg, src, digest = (ctx or _read_ctx())["cfg"]  # GLASS_RO: no witnessing write
    rows = []
    for k in sorted(cfg):
        if k == "schema_version":
            continue
        rows.append({"key": k, "value": K.redact(json.dumps(cfg[k]))[:90], "source": str(src.get(k, "default")),
                     "verb": ("ratchet config set %s <value>" % k) if not isinstance(cfg[k], (dict, list)) else None})
    return {"rows": rows, "digest": (digest or "")[:12], "sourced": bool(digest)}


def what_is_working(ctx=None):
    """The machine's green systems — DERIVED and honest (never the mock's hardcoded '107/107').
    Only rows we can actually stand up from persisted state; the rest are simply omitted."""
    ctx = ctx or _read_ctx()
    rows = []
    cv, cv_age = ctx["chain"]
    if isinstance(cv, dict) and "ok" in cv:
        rows.append({"name": "telemetry chain", "ok": bool(cv["ok"]),
                     "note": ("intact" if cv["ok"] else "BROKEN") + (" \u00b7 %s ago" % _age_str(cv_age) if cv_age is not None else "")})
    dr = ctx["doctor"]
    if isinstance(dr, dict) and dr.get("repos"):
        sm = dr.get("summary", {}) if isinstance(dr.get("summary"), dict) else {}
        def _n(key):  # a poisoned (non-int) summary count must degrade, never 500 the dashboard
            v = sm.get(key, 0)
            return v if isinstance(v, int) else 0
        rows.append({"name": "topology (doctor)", "ok": not _n(K.RED),
                     "note": "%d OK \u00b7 %d warn \u00b7 %d red" % (_n(K.OK), _n(K.WARN), _n(K.RED))})
    try:
        reps = sorted(f for f in os.listdir(os.path.join(K.WL_HOME, "reports")) if f.endswith(".md"))
    except OSError:
        reps = []
    if reps:
        rows.append({"name": "daily sweep", "ok": True, "note": "last report %s" % (reps[-1][:-3])})
    prot = sum(1 for f in ctx["cache_ls"] if f.startswith("checknames-"))
    if prot:
        rows.append({"name": "branch protection", "ok": True, "note": "%d repo(s) with cached required-checks" % prot})
    return rows


_CALL_KEYS = ("model", "tokens", "usage", "prompt_tokens", "completion_tokens")


def _tail_events(tail_bytes=524288):
    """Parsed telemetry events from the last tail_bytes ONLY — the ledger is multi-MB and grows
    daily; a page view never scans it from byte 0 (systems R2-4). Returns (events, scanned_all)."""
    pth = K.state_path("telemetry.jsonl")
    try:
        size = os.path.getsize(pth)
        with open(pth, "rb") as fh:
            scanned_all = size <= tail_bytes
            if not scanned_all:
                fh.seek(size - tail_bytes)
                fh.readline()  # drop the partial first line
            raw = fh.read()
    except OSError:
        return [], True
    evs = []
    for ln in raw.splitlines():
        try:
            e = json.loads(ln)
        except (json.JSONDecodeError, ValueError):
            continue
        if isinstance(e, dict):  # a non-dict line (null/5/"x"/[..]) must not reach a later .get()
            evs.append(e)
    return evs, scanned_all


def _cost_val(e):
    """Mirror of ratchet-budget._cost_val — a finite, non-negative price or None (never $0 for a
    missing/nan/negative value, so it can't silently escape the meter). Kept in sync deliberately;
    the budget oracle owns the canonical version."""
    import math
    if not isinstance(e, dict):
        return None
    for src in (e, e.get("usage") if isinstance(e.get("usage"), dict) else {}):
        if isinstance(src, dict) and "cost_usd" in src:
            try:
                v = float(src["cost_usd"])
            except (TypeError, ValueError):
                return None
            return v if (math.isfinite(v) and v >= 0) else None
    return None


def _classify(e):
    """Mirror of ratchet-budget.classify: metered | unpriced | flat. unpriced = a model call with
    no resolvable price (the fail-closed surface); flat = a sub-CLI lane or bookkeeping event."""
    if not isinstance(e, dict):
        return "flat"
    if _cost_val(e) is not None:
        return "metered"
    is_call = any(k in e for k in _CALL_KEYS) or e.get("cost_basis") == "oracle"
    flat_cli = e.get("cli") in ("claude", "codex", "gemini")
    return "unpriced" if (is_call and not flat_cli) else "flat"


def build_budget(ctx=None):
    """Metered spend TODAY is exact (the kernel's byte-offset cursor, read-only). The
    metered/unpriced/flat breakdown + per-card split come from a BOUNDED ledger tail — honestly
    scoped, never a full re-scan; the authoritative figure is `ratchet-budget report`."""
    ctx = ctx or _read_ctx()
    cfg, _src, _dig = ctx["cfg"]  # GLASS_RO: witnessing is skipped, so this stays read-only
    b = cfg.get("budgets", {}) if isinstance(cfg.get("budgets"), dict) else {}
    cap = float(b.get("per_day_usd", 5.0) or 0.0)
    metered_today = ctx["spend"]
    evs, scanned_all = ctx["tev"]
    today = K.now_iso()[:10]
    n_m = n_u = n_f = 0
    by_card = {}
    for e in evs:
        ts = str(e.get("ts", ""))
        if ts and not ts.startswith(today):
            continue  # a dated event from another day is out; a NO-ts event stays (oracle parity)
        kind = _classify(e)
        if kind == "metered":
            n_m += 1
            wid = str(e.get("work_id") or e.get("card") or "\u2014")
            by_card[wid] = by_card.get(wid, 0.0) + (_cost_val(e) or 0.0)
        elif kind == "unpriced":
            n_u += 1
        else:
            n_f += 1
    cv, _age = ctx["chain"]
    chain_ok = bool(cv.get("ok")) if isinstance(cv, dict) else None
    cards = sorted(by_card.items(), key=lambda kv: -kv[1])[:12]
    return {"metered_today": "%.4f" % metered_today, "cap": "%.2f" % cap,
            "pct": min(100, round(metered_today / cap * 100)) if cap > 0 else 100,
            "per_card": "%.2f" % float(b.get("per_card_reserve_usd", 0.5) or 0),
            "per_lane": "%.2f" % float(b.get("per_lane_ceiling_usd", 2.0) or 0),
            "premium": str(cfg.get("premium_policy", "never")),
            "chain_ok": chain_ok,
            "tail": {"n_metered": n_m, "n_unpriced": n_u, "n_flat": n_f, "scanned_all": scanned_all,
                     "by_card": [{"card": c, "usd": "%.4f" % u} for c, u in cards]}}


_HIST_EVENTS = {
    "take": "ember", "take_bulk": "ember", "land_gate_pass": "ok", "land_suite_fail": "red",
    "land_corpus_fail": "red", "land_fuse_claimed": "unk", "land_pr_fail": "red",
    "land_no_card": "warn", "cut": "blue", "train": "blue", "promote": "blue", "rollback": "red",
    "adopt": "unk", "approve": "ok", "reject": "red", "closeout": "blue", "state_migrated": "warn",
}
_HIST_DETAIL = ("name", "slug", "work_id", "repos", "repo", "branch", "snapshot", "ref", "green")


def build_history(limit=30, ctx=None):
    """The ledger stream (bounded tail, whitelisted events, newest first) + regression corpus.
    Chain verdict + release trains ride the shared payload blocks the client already has."""
    evs, scanned_all = (ctx or _read_ctx())["tev"]
    rows = []
    for e in evs:
        ev = e.get("event")
        if ev not in _HIST_EVENTS:
            continue
        bits = []
        for k in _HIST_DETAIL:
            v = e.get(k)
            if v not in (None, "", []):
                bits.append("%s %s" % (k, ",".join(str(x) for x in v) if isinstance(v, list) else v))
        ts = str(e.get("ts", ""))
        rows.append({"ts": ts[5:16].replace("T", " ") if len(ts) >= 16 else ts, "ev": str(ev),
                     "pill": _HIST_EVENTS[ev], "msg": " \u00b7 ".join(bits) or str(ev)})
    rows.reverse()
    corpus = K.state_load(K.CORPUS, {"cards": []})
    ccards = corpus.get("cards") if isinstance(corpus, dict) and isinstance(corpus.get("cards"), list) else []
    return {"stream": rows[:limit], "scanned_all": scanned_all,
            "corpus_n": len(ccards),
            "corpus": [{"id": str(c.get("id") or ""), "repo": str(c.get("repo") or ""),
                        "title": str(c.get("title") or "")} for c in ccards[:12] if isinstance(c, dict)]}


def build_github(ctx=None):
    """GitHub boards from the maintain snapshots (state/.cache/triage-<repo>.json) + the .prev
    rotation for deltas. NEVER a live gh call on a page view (slow + rate-limited = disqualified)."""
    ctx = ctx or _read_ctx()
    names = sorted({f[len("triage-"):-len(".json")] for f in ctx["cache_ls"]
                    if f.startswith("triage-") and f.endswith(".json") and ".prev." not in f})
    man = ctx["manifest"]
    out = []
    for name in names:
        snap, age = K.cache_get_stale("triage-" + name)
        if not isinstance(snap, dict):
            continue
        prev, _ = K.cache_get_stale("triage-" + name + ".prev")
        prev = prev if isinstance(prev, dict) else {}

        def board(key, cols):
            b = snap.get(key) if isinstance(snap.get(key), dict) else {}
            pb = prev.get(key) if isinstance(prev.get(key), dict) else {}
            counts = b.get("counts") if isinstance(b.get("counts"), dict) else {}
            top = b.get("top") if isinstance(b.get("top"), dict) else {}
            rows = []
            for col in cols:
                for it in (top.get(col) or []):
                    if isinstance(it, dict):
                        rows.append({"col": col, "number": it.get("number"),
                                     "title": str(it.get("title") or ""), "age_days": it.get("age_days")})
            total, ptotal = b.get("total"), pb.get("total")
            delta = (total - ptotal) if isinstance(total, int) and isinstance(ptotal, int) else None
            return {"total": total, "counts": {c: counts.get(c, 0) for c in cols},
                    "delta": delta, "top": rows[:8]}

        out.append({"repo": name, "gh": _slug_from_remote(man.get(name, {})),
                    "age": _age_str(age) if age is not None else None,
                    "issues": board("issues", ISSUE_COLS), "prs": board("prs", PR_COLS)})
    return out


def build_repos(ctx=None):
    """Repos topology from the manifest + doctor-report.json (persisted health, never live git)
    + checknames cache (required checks, never a gh call) + governance file presence (local stat)."""
    ctx = ctx or _read_ctx()
    man = ctx["manifest"]
    dr = ctx["doctor"]
    dr_repos = dr.get("repos", {}) if isinstance(dr, dict) else {}
    dr_ts = dr.get("ts") if isinstance(dr, dict) else None
    WORST = {"RED": 0, "UNKNOWN": 1, "WARN": 2, "SKIP": 3, "OK": 4}
    rows = []
    for name, r in man.items():
        if not isinstance(r, dict):
            continue
        craw = dr_repos.get(name) if isinstance(dr_repos.get(name), dict) else {}
        checks = [{"name": k, "status": str(v.get("status") or "UNKNOWN"), "msg": str(v.get("msg") or "")}
                  for k, v in craw.items() if isinstance(v, dict)]
        health = min((c["status"] for c in checks), key=lambda x: WORST.get(x, -1)) if checks else "unrun"
        slug = _slug_from_remote(r)
        prot = []
        if slug:
            pc, _ = K.cache_get_stale("checknames-" + slug.replace("/", "_"))
            if isinstance(pc, list):
                prot = [str(x) for x in pc][:40]
        path = K.expand(str(r.get("path") or "")) if r.get("path") else ""
        gov_missing, gov_known = [], bool(path) and os.path.isdir(path)
        if gov_known:  # only stat a tree that is actually checked out — a missing tree is
            for f, alts in GOV_ALTS.items():  # "unknown", not "all four missing" (review MINOR)
                if not any(os.path.exists(os.path.join(path, a)) for a in alts):
                    gov_missing.append(f)
        rows.append({"name": name, "gh": slug, "branch": str(r.get("mainline") or ""),
                     "remote": str((r.get("remotes") or {}).get(r.get("push_remote") or "origin", "")),
                     "health": health, "checks": checks, "protect": prot,
                     "gov_missing": gov_missing, "gov_total": len(GOV_ALTS), "gov_known": gov_known})
    return {"repos": rows, "doctor_age": _age_str(_ts_age_s(dr_ts)) if dr_ts else None,
            "doctor_run": bool(dr_repos)}


_NEEDS_SEV = {"interrupted": "red", "ready-to-land": "ember", "stale-card": "warn",
              "green-uncut": "warn", "promote-decision": "ember", "closeout-due": "warn"}

# attention-first ordering for the fleet board (intelligence lens: what NEEDS you, first). SILENT
# and an open NEEDS-OVERWATCH ask are handled by explicit branches in the sort key below (rank 0/1);
# a 'blocked' team is BY DEFINITION an open ask (its liveness requires open_ask), so it also takes
# the open-ask branch. This map therefore only ranks the remaining, non-attention states.
_OW_LIVE_RANK = {"unknown": 4, "idle-empty": 5, "ok": 6}
_OW_STALE_AFTER = 900  # mirror the kernel sweep default; a heartbeat older than this is SILENT


def build_overwatch():
    """The Overwatch fleet board — per-team liveness bound to the SAME read-only contract the
    kernel's `overwatch sweep` computes. §9: we CALL the kernel's own read-only classifiers
    (K._ow_liveness / _ow_teams / _ow_load_flag / _ow_sha) in-process — no writes (the only
    subprocess any of them can reach is the kernel's read-only `ps` pid-liveness check, and only
    when an awaiting.pid is a live process), single source of truth (zero drift). Honest by
    construction: a team that never emitted a
    heartbeat is 'unknown', never faked 'live'; one poisoned .waker degrades its row, never 500s
    the board. Reads <home>/overwatch/<team>/{BRIEF.md,STATUS.md,.waker/*} only."""
    teams = []
    try:
        names = K._ow_teams()
    except (OSError, AttributeError):
        names = []
    for team in names:
        try:
            flag = K._ow_load_flag(team)
            cur = K._ow_sha(os.path.join(K._ow_team_dir(team), "BRIEF.md"))
            if not flag:
                fstate, ask, created = "clear", None, None
            elif flag.get("brief_sha") == cur:
                fstate, ask, created = "open", flag.get("question"), flag.get("created")
            else:
                fstate, ask, created = "answered", flag.get("question"), flag.get("created")
            latest = ""
            try:
                for ln in open(os.path.join(K._ow_team_dir(team), "STATUS.md")).read().splitlines():
                    if ln.startswith("## "):
                        latest = ln[3:].strip()  # STATUS is newest-at-top: first '## ' is the latest
                        break
            except OSError:
                pass
            live = K._ow_liveness(team, _OW_STALE_AFTER)
            age = live.get("age")
            teams.append({
                "team": str(team), "flag_state": fstate,
                "ask": (str(ask)[:280] if ask else None),
                "ask_age": _age_str(_ts_age_s(created)) if created else None,
                "latest": str(latest)[:200],
                "liveness": str(live.get("liveness") or "unknown"),
                "why": str(live.get("why") or ""),
                "beat_age": (_age_str(int(age)) if isinstance(age, (int, float)) else None)})
        except (OSError, ValueError, TypeError, KeyError, AttributeError):
            # a single team's hostile/unreadable .waker must never take down the board
            teams.append({"team": str(team), "flag_state": "clear", "ask": None, "ask_age": None,
                          "latest": "", "liveness": "unknown", "why": "team state unreadable",
                          "beat_age": None})
    teams.sort(key=lambda t: (0 if t["liveness"] == "SILENT" else 1 if t["flag_state"] == "open"
                              else _OW_LIVE_RANK.get(t["liveness"], 7), t["team"]))
    summary = {
        "total": len(teams),
        "live": sum(1 for t in teams if t["liveness"] == "ok"),
        "silent": sum(1 for t in teams if t["liveness"] == "SILENT"),
        "needs": sum(1 for t in teams if t["flag_state"] == "open"),
        "blocked": sum(1 for t in teams if t["liveness"] == "blocked")}
    return {"teams": teams, "summary": summary, "stale_after": _OW_STALE_AFTER}


def _read_ctx():
    """Read each SHARED source exactly ONCE per page view so the sub-builders don't each re-open
    the multi-MB telemetry ledger / re-load config / re-stat the cache dir (perf card
    glass-perf-readonce). Output-identical by construction: every value here is the SAME one each
    consumer would have read for itself — computed once and injected. build_data is the only
    production caller and always passes ctx; a builder invoked standalone (ctx=None) falls back to
    this full read (over-reads sources it may not use, but yields identical output on valid state —
    keeps each builder self-contained for tests/reuse). Before this,
    per page view: _tail_events 3×, config_load 3×, spend_today_ro 2×, chain-verdict 3×,
    _manifest_ro 2×, doctor-report 3×, listdir(CACHE_DIR) 3×. The telemetry tail is shared at the
    DEFAULT bound (every consumer called _tail_events() with no arg), so one scan serves all."""
    try:
        cache_ls = sorted(os.listdir(K.CACHE_DIR))
    except OSError:
        cache_ls = []
    return {
        "cfg": K.config_load(),                       # (cfg, src, digest)
        "tev": _tail_events(),                        # (events, scanned_all) — default 512K tail
        "spend": spend_today_ro(),
        "chain": K.cache_get_stale("chain-verdict"),  # (val, age)
        "manifest": _manifest_ro(),
        "doctor": K.state_load("doctor-report.json", {}),
        "cache_ls": cache_ls,
    }


def build_data():
    """Assemble the page payload from kernel state files. Read-only by construction: every
    source is a state_load (GLASS_RO raises on corrupt — the handler renders a 500), a stale
    cache read, or a tail scan. Nothing here writes, fetches, or exits."""
    ctx = _read_ctx()  # every shared source read ONCE here; injected into the sub-builders below
    # bridge: ground (doctor's last persisted run), chain (last recorded verdict), landing, spend
    dr = ctx["doctor"]
    if dr.get("repos"):
        s = dr.get("summary", {})
        age = _ts_age_s(dr.get("ts"))
        if s.get(K.RED):
            ground = {"state": "red", "label": "ground RED", "detail": "%d red check(s)" % s[K.RED]}
        elif s.get(K.WARN) or s.get(K.UNKNOWN):
            ground = {"state": "warn", "label": "ground amber",
                      "detail": "%d warn · %d unknown" % (s.get(K.WARN, 0), s.get(K.UNKNOWN, 0))}
        else:
            ground = {"state": "ok", "label": "ground green", "detail": "all checks OK"}
        if age is not None and age > STALE_S and ground["state"] == "ok":
            ground = {"state": "warn", "label": "ground green (stale)",
                      "detail": "last doctor run %s ago" % _age_str(age)}
        ground["age"] = _age_str(age)
    else:
        ground = {"state": "unknown", "label": "ground unknown", "detail": "doctor has never run",
                  "age": "", "verb": "ratchet doctor"}
    cv, cv_age = ctx["chain"]
    if isinstance(cv, dict) and "ok" in cv:
        if not cv["ok"]:
            chain = {"state": "red", "label": "chain " + str(cv.get("verdict", "BROKEN"))}
        elif cv_age is not None and cv_age > STALE_S:
            chain = {"state": "warn", "label": "chain ok (stale)"}
        else:
            chain = {"state": "ok", "label": "chain intact"}
        chain["detail"] = str(cv.get("detail", ""))[:120]
        chain["age"] = _age_str(cv_age)
    else:
        chain = {"state": "unknown", "label": "chain unverified", "detail": "no recorded verdict",
                 "age": "", "verb": "ratchet chain"}
    lanes = K._lanes(None)  # kernel derivation reads cards+recordings only; no manifest needed
    landing = sum(1 for l in lanes if l["status"] == "landing")
    cfg, _src, _digest = ctx["cfg"]
    cap = float(cfg.get("budgets", {}).get("per_day_usd", 5.0))
    spend = ctx["spend"]

    needs = []
    for i in K._needs_you(None):
        needs.append({"kind": i["kind"], "sev": _NEEDS_SEV.get(i["kind"], "unk"),
                      "msg": i["msg"], "verb": i["verb"], "age": _age_str(_ts_age_s(i["ts"]))})

    issues_total, issues_bits, snap_age = None, [], None
    snaps = sorted(f for f in ctx["cache_ls"]
                   if f.startswith("triage-") and f.endswith(".json") and ".prev." not in f)
    for f in snaps:
        snap, s_age = K.cache_get_stale(f[:-len(".json")])
        if not isinstance(snap, dict):
            continue
        total = snap.get("issues", {}).get("total")
        if isinstance(total, int):
            issues_total = (issues_total or 0) + total
            issues_bits.append("%s %d" % (f[len("triage-"):-len(".json")], total))
            snap_age = s_age if snap_age is None else max(snap_age, s_age)

    cardsblock = build_cards()
    return {
        "asof": time.strftime("%H:%M:%S"),
        "board": cardsblock["board"], "cards": cardsblock["cards"],
        "trains": cardsblock["trains"], "abandoned": cardsblock["abandoned"],
        "agents": cardsblock["agents"], "today": cardsblock["today"],
        "github": build_github(ctx), "repos_est": build_repos(ctx),
        "budget": build_budget(ctx), "history": build_history(ctx=ctx),
        "config": build_config(ctx), "keys": build_keys(ctx), "working": what_is_working(ctx),
        "overwatch": build_overwatch(),
        "ground": ground, "chain": chain, "landing": landing,
        "spend": {"day": "%.4f" % spend, "cap": "%.2f" % cap},
        "lanes": {"open": sum(1 for l in lanes if l["status"] in ("open", "pending")),
                  "landing": landing},
        "needs": needs,
        "feed": feed_tail(),
        "issues": {"total": issues_total, "sub": " · ".join(issues_bits) or "no snapshot yet",
                   "age": _age_str(snap_age) if snap_age is not None else None},
    }


# ---------- the shell (design carried from the approved v3.2 mock) ----------

