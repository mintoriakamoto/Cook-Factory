 ["repos","Repos","M4 4h16v6H4zM4 14h16v6H4z"],["budget","Budget","M12 2v20M17 6H9.5a2.5 2.5 0 000 5h5a2.5 2.5 0 010 5H6"],
 ["history","History","M12 8v4l3 3M21 12a9 9 0 11-9-9"],["config","Config &amp; Keys","M12 15a3 3 0 100-6 3 3 0 000 6zM19 12a7 7 0 01-.1 1.2l2 1.6-2 3.4-2.4-1a7 7 0 01-2 1.2L14 21h-4l-.4-2.6a7 7 0 01-2-1.2l-2.5 1-2-3.4 2-1.6A7 7 0 015 12"]];
function sidebar(cur){
 document.getElementById('side').innerHTML = NAV.map(([id,label,path])=>
  `<a class="nav${cur===id?' on':''}" href="#/${id}" aria-label="${E(String(label).replace("&amp;","and"))}"${cur===id?' aria-current="page"':''}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="${path}"/></svg><span>${label}</span></a>`).join("")
  +`<div class="foot">\\u00a79 \\u2014 renders state, never mutates it.<br>Every action is a verb.<br><br>glass v4 \\u00b7 stage 1</div>`;
}
function head(t,sub,crumb){return `${crumb?`<div class="crumb">${crumb}</div>`:""}<div class="pagehead"><h1>${t}</h1><span class="sub">${sub||""}</span>${asof()}</div>`}
function unbuilt(title,sub,card,verbs,q){return head(E(title),E(sub))+
 `<div class="panel"><h2>not built yet ${pill("unk","ships with card "+card)}</h2>
 <p class="empty">${E(q)} \\u2014 until this page ships, the terminal answers it:</p>
 <div style="display:flex;flex-direction:column;gap:.5rem;align-items:flex-start;margin-top:.4rem">${verbs.map(v=>verb(v)).join("")}</div></div>`}
