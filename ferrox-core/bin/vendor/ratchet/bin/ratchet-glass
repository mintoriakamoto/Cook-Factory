        with open(os.path.join(rf, "events.jsonl"), "w") as fh:
            for i in range(47):
                fh.write(json.dumps({"ts": now, "agent": "x", "event": "progress", "i": i}) + "\n")
            fh.write(json.dumps({"ts": now, "agent": "x", "event": "land_gate",
                                 "repo": "ratchet", "branch": "feat/shipped"}) + "\n")
            fh.write(json.dumps({"ts": now, "agent": "x", "event": "diff_facts", "files": ["a.py"],
                                 "n_files": 3, "plus": 119, "minus": 4,
                                 "subjects": ["feat: thing", hostile]}) + "\n")
            fh.write(json.dumps({"ts": now, "agent": "x", "event": "land_pass",
                                 "repo": "ratchet", "branch": "feat/shipped"}) + "\n")
        # a file OUTSIDE the recordings tree that a traversal work_id would reach
        sk = os.path.join(st, "seekrit")
        os.makedirs(sk)
        open(os.path.join(sk, "suite-tail.txt"), "w").write("TOP SECRET DATA")
        open(os.path.join(sk, "events.jsonl"), "w").write(
            json.dumps({"ts": now, "event": "leak", "secret": "TOP SECRET DATA"}) + "\n")
        # an OLD landed card's recording: must NOT be loaded (archived bound)
        rh = os.path.join(st, "recordings", "hhhh777777")
        os.makedirs(rh)
        open(os.path.join(rh, "events.jsonl"), "w").write(
            json.dumps({"ts": old40, "event": "take", "note": "ARCHIVED-EVENT-MARKER"}) + "\n")
        rk = os.path.join(st, "recordings", "kkkk101010")  # stalebob active lane — STALE
        os.makedirs(rk)
        open(os.path.join(rk, "events.jsonl"), "w").write(
            json.dumps({"ts": old40, "agent": "stalebob", "event": "progress"}) + "\n")
        rm = os.path.join(st, "recordings", "mmmm121212")  # stalebob landed lane — FRESH
        os.makedirs(rm)
        open(os.path.join(rm, "events.jsonl"), "w").write(
            json.dumps({"ts": now, "agent": "stalebob", "event": "land_pass",
                        "repo": "ratchet", "branch": "feat/bobship"}) + "\n")
        json.dump({"trains": [{"name": "rc-1", "ts": now, "status": "cut",
                               "snapshot": "abc123def456", "refs": {}}]},
                  open(os.path.join(st, "release-trains.json"), "w"))
        json.dump({"cards": [{"id": "corp1", "repo": "ratchet", "title": "a bug that escaped once"}]},
                  open(os.path.join(st, "regression-corpus.json"), "w"))
        ev1 = json.dumps({"ts": now, "event": "take", "work_id": "aaaa111111", "cost_usd": 1.0}) + "\n"
        ev2 = json.dumps({"ts": now, "event": "land_gate_pass", "work_id": hostile, "cost_usd": 0.25}) + "\n"
        ev3 = json.dumps({"ts": now, "event": "think", "model": "glm"}) + "\n"  # usage, no price -> UNPRICED
        ev4 = json.dumps({"ts": now, "event": "exec", "cli": "claude"}) + "\n"  # sub-CLI lane -> FLAT
        open(os.path.join(st, "telemetry.jsonl"), "w").write(ev1 + ev2 + ev3 + ev4)
        # cursor covers only ev1: the page must ADD ev2's 0.25 in memory and NOT move the cursor
        json.dump({"offset": len(ev1.encode()), "day": now[:10], "day_sum": 1.0},
                  open(os.path.join(cache, "spend-cursor.json"), "w"))
        json.dump({"ok": True, "verdict": "ok", "detail": "n entries", "ts": now, "lines": 2},
                  open(os.path.join(cache, "chain-verdict.json"), "w"))
        json.dump({"repos": {"ratchet": {"SYNC": {"status": "OK", "msg": "", "ts": now}}},
                   "ts": now, "summary": {"RED": 0, "UNKNOWN": 0, "WARN": 0, "OK": 1, "SKIP": 0}},
                  open(os.path.join(st, "doctor-report.json"), "w"))
        json.dump({"ts": now, "issues": {"total": 7}, "prs": {"total": 2}},
                  open(os.path.join(cache, "triage-demo.json"), "w"))
        # config.json PRESENT and UNWITNESSED: this reproduced the review CRITICAL — the
        # kernel's config_load used to witness it on first load (state write + ledger append)
        # from a page view. The byte-identical check below is the fence.
        json.dump({"schema_version": 1, "budgets": {"per_day_usd": 7.5}},
                  open(os.path.join(st, "config.json"), "w"))
        # Overwatch fleet board: seed teams across every liveness class the sweep contract defines,
        # under RATCHET_HOME/overwatch (the spawn sets RATCHET_HOME=tmp). build_overwatch CALLS the
        # kernel's own read-only classifiers (K._ow_liveness/_teams/_load_flag), so this proves the
        # glass reads the REAL contract — not a reimplementation that could drift. A live-waker
        # 'blocked' needs a real claimant pid, so that state is covered by the kernel's own selftest.
        import hashlib as _hl
        owh = os.path.join(tmp, "overwatch")
        nowe = time.time()

        def _seedteam(name, hb=None, flag=None, awaiting=None, brief="brief\n",
                      status="## latest line\nbody\n"):
            td = os.path.join(owh, name)
            wk = os.path.join(td, ".waker")
            os.makedirs(wk)
            open(os.path.join(td, "BRIEF.md"), "w").write(brief)
            open(os.path.join(td, "STATUS.md"), "w").write(status)
            if hb is not None:
                json.dump(hb, open(os.path.join(wk, "heartbeat.json"), "w"))
            if flag is not None:
                json.dump(flag, open(os.path.join(wk, "flag.json"), "w"))
            if awaiting is not None:
                json.dump(awaiting, open(os.path.join(wk, "awaiting.json"), "w"))
        _seedteam("aa-ok", hb={"ts": nowe, "state": "working"})
        _seedteam("bb-silent", hb={"ts": nowe - 2000, "state": "working"})  # stale >900s -> SILENT
        _seedteam("cc-idle", hb={"ts": nowe, "state": "idle-empty"})
        _seedteam("dd-unknown")  # never emitted a heartbeat -> unknown, NEVER faked live
        eeb = "the ee brief body\n"  # OPEN ask (flag baseline == current sha) + DEAD waker -> SILENT
        _seedteam("ee-open", brief=eeb,
                  flag={"flag_id": "f1", "brief_sha": _hl.sha256(eeb.encode()).hexdigest(),
                        "question": hostile, "created": now},
                  awaiting={"pid": 999999999, "pid_start": "nope"})
        _seedteam("ff-answered", hb={"ts": nowe, "state": "working"},  # brief moved past flag -> answered
                  flag={"flag_id": "f2", "brief_sha": "stale-sha", "question": "old q", "created": now})
        # gg-blocked: OPEN ask with a LIVE waker (this very process is the claimant) -> 'blocked',
        # not SILENT. Deterministic via the kernel's own pid-claimant binding (os.getpid + its ps
        # start), the same way the kernel selftest seeds a live waker.
        ggb = "the gg brief body\n"
        _seedteam("gg-blocked", brief=ggb,
                  flag={"flag_id": "f3", "brief_sha": _hl.sha256(ggb.encode()).hexdigest(),
                        "question": "waiting on a decision", "created": now},
                  awaiting={"pid": os.getpid(), "pid_start": K.pid_start(os.getpid())})
        before = _dirhash(tmp)
        p, port = _spawn(tmp)
        try:
            code, body, _ = _get(port, "/")
            _get(port, "/")  # render twice — a second view must also write nothing
            check("populated home renders 200", code == 200, "code=%s" % code)
            check("stale open card surfaces in needs-you payload",
                  "live-card" in body and "stale-card" in body, "")
            check("landing lanes counted in bridge payload", '"landing": 5' in body, "")
            check("chain verdict rendered from cache (never re-verified on view)",
                  "chain intact" in body, "")
            check("doctor report drives the ground badge", "ground green" in body, "")
            check("issues tile sums the maintain snapshot", '"total": 7' in body, "")
            check("spend = cursor sum + appended tail (1.0 + 0.25)", "1.2500" in body, "")
            check("config.json read (cap 7.50 rendered) without being witnessed",
                  '"cap": "7.50"' in body, "")
            check("hostile title cannot break out of the payload",
                  "</script><script>" not in body and "<!--" not in body
                  and "\u2028" not in body and "alert(1)" in body,  # present, but only armored
                  "")
            import re as _re
            m = _re.search(r"const DATA = (.*?);\n", body)
            D = json.loads(m.group(1)) if m else {}
            cards = D.get("cards", {})
            g_skip = {g["st"]: g["state"] for g in (cards.get("cccc333333", {}).get("gate") or [])}
            check("stepper honesty: suite:skipped renders SKIPPED, never a pass",
                  g_skip.get("suite") == "skipped" and g_skip.get("rebase") == "done"
                  and g_skip.get("push") == "done", str(g_skip))
            g_fail = {g["st"]: g["state"] for g in (cards.get("dddd444444", {}).get("gate") or [])}
            check("stepper marks the aborted station FAILED with its recorded reason",
                  g_fail.get("suite") == "failed" and g_fail.get("rebase") == "done"
                  and g_fail.get("push") == "pending"
                  and cards.get("dddd444444", {}).get("gate_why") == "suite", str(g_fail))
            check("failing suite tail reaches the card (armored, not raw)",
                  "FAIL test_x" in (cards.get("dddd444444", {}).get("suite_tail") or ""), "")
            g_int = {g["st"]: g["state"] for g in (cards.get("eeee555555", {}).get("gate") or [])}
            check("dead-pid land run renders STALLED at the next station",
                  g_int.get("review") == "stalled" and g_int.get("suite") == "done"
                  and cards.get("eeee555555", {}).get("interrupted") is True, str(g_int))
            bd = {b["wid"]: b for b in D.get("board", [])}
            check("gone worktree flags the board chip stuck",
                  bd.get("bbbb222222", {}).get("stuck") is True
                  and bd.get("bbbb222222", {}).get("stuck_why") == "worktree gone", "")
            check("landed card carries diff facts + result + today grouping",
                  cards.get("ffff666666", {}).get("diff", {}).get("plus") == 119
                  and "landed" in (cards.get("ffff666666", {}).get("result") or "")
                  and bd.get("ffff666666", {}).get("landed_day") == D.get("today"), "")
            check("timeline capped at 40 of 50 events (count honest)",
                  cards.get("ffff666666", {}).get("n_events") == 50
                  and len(cards.get("ffff666666", {}).get("tl") or []) == 40, "")
            check("abandoned cards collapse to a count, off the board",
                  D.get("abandoned") == 1 and "9999000000" not in bd, "")
            check("cut release train reaches the CUT column data",
                  D.get("trains") and D["trains"][0]["name"] == "rc-1"
                  and D["trains"][0]["status"] == "cut", "")
            g_corp = {g["st"]: g["state"] for g in (cards.get("iiii888888", {}).get("gate") or [])}
            check("corpus abort cannot evaporate: a station renders FAILED with the reason",
                  g_corp.get("suite") == "done" and g_corp.get("review") == "failed"
                  and cards.get("iiii888888", {}).get("gate_why") == "corpus", str(g_corp))
            g_bad = {g["st"]: g["state"] for g in (cards.get("jjjj999999", {}).get("gate") or [])}
            check("hostile journal types (steps null, pid str) degrade, never 500",
                  code == 200 and g_bad.get("rebase") == "stalled"
                  and cards.get("jjjj999999", {}).get("interrupted") is True, str(g_bad))
            check("traversal work_id cannot read outside the recordings tree",
                  "TOP SECRET" not in body
                  and any(b["slug"] == "traverse" for b in D.get("board", [])), "")
            check("old landed card is ARCHIVED: on the board, recording not read",
                  cards.get("hhhh777777", {}).get("archived") is True
                  and cards.get("hhhh777777", {}).get("tl") == []
                  and "ARCHIVED-EVENT-MARKER" not in body
                  and any(b["wid"] == "hhhh777777" for b in D.get("board", [])), "")
            check("copy verbs shell-quote agent-written values (shq present)",
                  "shq(" in body and "shq(id)" in body, "")
            byag = {a["agent"]: a for a in D.get("agents", [])}
            check("agent 'x' aggregates lands + stuck lanes across the card set",
                  byag.get("x", {}).get("lands") == 2 and byag.get("x", {}).get("stuck", 0) >= 3
                  and byag["x"]["state"] == "stuck", str(byag.get("x")))
            check("empty agent field renders as UNATTRIBUTED (never blank/faked)",
                  byag.get("unattributed", {}).get("unattributed") is True
                  and byag["unattributed"]["active"] >= 1, str(byag.get("unattributed")))
            check("a stuck agent sorts to the top of the track record",
                  D.get("agents") and D["agents"][0]["agent"] == "x", "")
            check("distinct agents are kept separate (alice on shift, not merged into x)",
                  "alice" in byag and byag["alice"]["active"] >= 1
                  and byag["alice"]["state"] in ("on-shift", "quiet"), str(byag.get("alice")))
            check("Agents payload invents no model/spend/cost fields (honest gaps only)",
                  all(all(k not in a for k in ("model", "cli", "spend", "cost", "price"))
                      for a in D.get("agents", [])) and len(D.get("agents", [])) > 0, "")
            # Live Agents Dashboard (mandate card 1): the on-shift panel is lane-centric — each
            # active worktree is an agent-at-work carrying the human title, inline gate progress,
            # tenure + honest last-activity. All derived from state the page already ships; the
            # missing true-liveness datum is named, not faked.
            check("live dashboard: lane card surfaces the human title (escaped), slug fallback",
                  'class="lane"' in body and "E(b.title||b.slug)" in body, "")
            check("live dashboard: inline gate progress reuses the card's own honest gate array",
                  "DATA.cards[b.wid]" in body and 'class="steps mini"' in body, "")
            # aaaa111111 is a real open/no-run lane, so an on-shift row DOES reach miniGate's
            # empty-gate branch — which routes to the 'working' span, never a faked stepper. The
            # harness can't run the client JS, so we assert the branch is wired AND the fixture
            # exercises it (honest about what this proves), not a bare always-true constant.
            check("live dashboard: an open no-run lane exists and routes to 'working', not a stepper",
                  bd.get("aaaa111111", {}).get("status") == "open"
                  and not cards.get("aaaa111111", {}).get("gate")
                  and "!g||!g.length" in body and "pre-land" in body,
                  str(bd.get("aaaa111111", {}).get("status")))
            check("live dashboard: tenure + last-activity shown, labeled honestly (no 'last seen alive')",
                  "b.age" in body and "last activity" in body and "not a heartbeat" in body
                  and "last event" not in body, "")
            check("live dashboard: the missing heartbeat is a named honest gap (FRICTION #12)",
                  "true liveness / heartbeat" in body and "FRICTION #12" in body, "")
            # Overwatch fleet board (bound to the real `overwatch sweep` contract, in-process).
            ow = D.get("overwatch", {})
            owt = {t["team"]: t for t in ow.get("teams", [])}
            check("overwatch: reads the REAL sweep contract via the kernel's read-only classifiers",
                  ow.get("summary", {}).get("total") == 7
                  and owt.get("aa-ok", {}).get("liveness") == "ok"
                  and owt.get("cc-idle", {}).get("liveness") == "idle-empty", str(ow.get("summary")))
            check("overwatch: a stale heartbeat is SILENT (the alarm), never silently 'ok'",
                  owt.get("bb-silent", {}).get("liveness") == "SILENT"
                  and ow.get("summary", {}).get("silent") == 2, str(owt.get("bb-silent")))
            check("overwatch: an open ask with a DEAD waker is SILENT + counted as needs-you",
                  owt.get("ee-open", {}).get("liveness") == "SILENT"
                  and owt.get("ee-open", {}).get("flag_state") == "open"
                  and ow.get("summary", {}).get("needs") == 2, str(owt.get("ee-open")))
            check("overwatch: an open ask with a LIVE waker is 'blocked' (waiting), not SILENT",
                  owt.get("gg-blocked", {}).get("liveness") == "blocked"
                  and owt.get("gg-blocked", {}).get("flag_state") == "open"
                  and ow.get("summary", {}).get("blocked") == 1, str(owt.get("gg-blocked")))
            check("overwatch: a never-beat team is 'unknown', NEVER faked live",
                  owt.get("dd-unknown", {}).get("liveness") == "unknown"
                  and "no heartbeat" in owt.get("dd-unknown", {}).get("why", ""),
                  str(owt.get("dd-unknown")))
            check("overwatch: an answered flag reads 'answered', not a standing alarm",
                  owt.get("ff-answered", {}).get("flag_state") == "answered"
                  and owt.get("ff-answered", {}).get("liveness") == "ok", str(owt.get("ff-answered")))
            check("overwatch: attention-first order floats a SILENT team to the top",
                  bool(ow.get("teams")) and ow["teams"][0]["liveness"] == "SILENT", "")
            check("overwatch: a hostile ask question is armored + shows a copyable respond verb",
                  "</script><script>" not in body and "alert(1)" in body
                  and "ratchet overwatch respond" in body, "")
            check("overwatch: page binds to the sweep contract + carries the honest 'unknown' gap",
                  "ratchet overwatch sweep" in body and "never faked live" in body, "")
            bud = D.get("budget", {})
            check("Budget: metered today is the exact cursor sum (1.25), cap from config (7.50)",
                  bud.get("metered_today") == "1.2500" and bud.get("cap") == "7.50", str(bud.get("metered_today")))
            check("Budget: tail classifies metered / UNPRICED / flat (2 / 1 / 1)",
                  bud.get("tail", {}).get("n_metered") == 2 and bud["tail"]["n_unpriced"] == 1
                  and bud["tail"]["n_flat"] == 1, str(bud.get("tail")))
            check("Budget: UNPRICED>0 surfaces as the fail-closed signal",
                  bud["tail"]["n_unpriced"] == 1 and bud.get("chain_ok") is True, "")
            check("Budget: per-card metered split from the tail (aaaa111111 -> $1.00)",
                  any(r["card"] == "aaaa111111" and r["usd"] == "1.0000"
                      for r in bud.get("tail", {}).get("by_card", [])), str(bud.get("tail", {}).get("by_card")))
            hist = D.get("history", {})
            check("History: whitelisted telemetry stream, newest first",
                  any(r["ev"] == "land_gate_pass" for r in hist.get("stream", []))
                  and hist["stream"][0]["ev"] in ("exec", "think", "land_gate_pass", "take")
                  and all(r["ev"] != "exec" for r in hist.get("stream", [])), str(len(hist.get("stream", []))))
            check("History: regression corpus rendered (1 card)",
                  hist.get("corpus_n") == 1 and hist.get("corpus", [{}])[0].get("id") == "corp1", str(hist.get("corpus_n")))
            check("active-lane liveness ignores fresh landed cards (no masking)",
                  byag.get("stalebob", {}).get("state") == "quiet", str(byag.get("stalebob")))
            check("an agent with only landed cards is idle, not on-shift",
                  byag.get("carol", {}).get("state") == "idle"
                  and byag.get("carol", {}).get("lands", 0) >= 1, str(byag.get("carol")))
        finally:
            _stop(p)
        after = _dirhash(tmp)
        check("populated home stays BYTE-IDENTICAL after views (cursor not advanced)",
              before == after, "before=%s after=%s" % (before[:8], after[:8]))
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 9. corrupt state on a page view: 500 naming the file, file NOT quarantine-renamed
    tmp = _tf.mkdtemp(prefix="glass-st3-")
    try:
        st = os.path.join(tmp, "state")
        os.makedirs(st)
        cj = os.path.join(st, "workcards.json")
        open(cj, "w").write("{ not json")
        p, port = _spawn(tmp)
        try:
            code, body, _ = _get(port, "/")
        finally:
            _stop(p)
        renamed = [f for f in os.listdir(st) if f.startswith("workcards.json.corrupt")]
        check("corrupt state renders 500 naming the file", code == 500 and "CORRUPT" in body,
              "code=%s" % code)
        check("corrupt file NOT renamed by a page view (§9)",
              os.path.exists(cj) and not renamed, "renamed=%s" % renamed)
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 9a2. workcards.json with a VALID-JSON wrong shape (list / keyless) degrades to an
    # empty board — one bad file must never dark the whole control plane with a 500
    for shape in ("[]", '{"schema_version": 1}'):
        tmp = _tf.mkdtemp(prefix="glass-st3a-")
        try:
            os.makedirs(os.path.join(tmp, "state"))
            open(os.path.join(tmp, "state", "workcards.json"), "w").write(shape)
            p, port = _spawn(tmp)
            try:
                code, body, _ = _get(port, "/")
            finally:
                _stop(p)
            check("wrong-shaped workcards.json (%s) renders 200, empty board" % shape[:12],
                  code == 200 and '"board": []' in body, "code=%s" % code)
        finally:
            _sh.rmtree(tmp, ignore_errors=True)

    # 9b. INVALID config.json on a page view: an honest 500 (not a silently-dead thread — the
    # kernel used to sys.exit here, which a handler thread swallows), and NO witness write
    tmp = _tf.mkdtemp(prefix="glass-st3b-")
    try:
        st = os.path.join(tmp, "state")
        os.makedirs(st)
        open(os.path.join(st, "config.json"), "w").write("{ not json")
        p, port = _spawn(tmp)
        try:
            code, body, _ = _get(port, "/")
        finally:
            _stop(p)
        check("invalid config.json renders 500 (never a silent empty reply)",
              code == 500 and "INVALID JSON" in body, "code=%s" % code)
        check("invalid config not witnessed by a page view",
              not os.path.exists(os.path.join(st, "config-witness.json")), "")
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 10. slow-loris: an idle connection must not serialize the glass (threaded + timeout)
    tmp = _tf.mkdtemp(prefix="glass-st4-")
    try:
        p, port = _spawn(tmp)
        try:
            lor = _sock.socket()
            lor.connect(("127.0.0.1", port))
            try:
                code2, body2, _ = _get(port, "/")
            finally:
                lor.close()
            check("slow-loris: second request unblocked", code2 == 200 and "RATCHET" in body2,
                  "code=%s" % code2)
        finally:
            _stop(p)
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 11. --bind-all refuses without the explicit exposure ack
    tmp = _tf.mkdtemp(prefix="glass-st5-")
    try:
        r = _sp.run([sys.executable, os.path.abspath(__file__), "serve", "--bind-all", "--port", "0"],
                    env=_env(tmp), capture_output=True, text=True, timeout=30)
        check("--bind-all refuses without RATCHET_GLASS_EXPOSE=1",
              r.returncode == 2 and "REFUSE" in r.stdout, "rc=%s" % r.returncode)
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 12. unknown verb → usage, nonzero; malformed --port → graceful refusal, not a traceback
    r = _sp.run([sys.executable, os.path.abspath(__file__), "bogus"],
                capture_output=True, text=True, timeout=30)
    check("unknown verb exits nonzero with usage", r.returncode != 0 and "usage" in r.stderr,
          "rc=%s" % r.returncode)
    for bad in (["--port"], ["--port", "abc"], ["--port", "99999999"]):
        r = _sp.run([sys.executable, os.path.abspath(__file__), "serve", *bad],
                    capture_output=True, text=True, timeout=30)
        if not (r.returncode == 2 and "--port" in r.stderr):
            break
    check("malformed --port refused gracefully (missing / non-numeric / out of range)",
          r.returncode == 2 and "--port" in r.stderr, "rc=%s err=%s" % (r.returncode, r.stderr[:60]))

    # ---- perf card glass-perf-readonce: PROVE read-once (fewer reads, IDENTICAL output) ----
    # The sub-builders used to each re-open the multi-MB ledger / re-load config / re-stat the
    # cache dir. build_data now reads every SHARED source ONCE (_read_ctx) and injects it. This
    # proves BOTH halves of the contract in-process on a seeded home: (a) each shared reader fires
    # EXACTLY ONCE per page view (was 2-3x each), and (b) the injected sub-builders are byte-
    # identical to the self-reading (ctx=None) path — same rendered output, fewer reads.
    tmp = _tf.mkdtemp(prefix="glass-readonce-")
    _save = (K.WL_HOME, K.CACHE_DIR, K.MANIFEST_PATH, K.GLASS_RO)
    _o = {"tev": _tail_events, "spend": spend_today_ro, "man": _manifest_ro,
          "cfg": K.config_load, "cache": K.cache_get_stale, "sload": K.state_load, "ls": os.listdir}
    g = sys.modules[__name__]
    try:
        st = os.path.join(tmp, "state"); cache = os.path.join(st, ".cache"); os.makedirs(cache)
        open(os.path.join(st, "telemetry.jsonl"), "w").write(
            json.dumps({"ts": now, "event": "land_gate_pass", "repo": "demo", "cost_usd": 0.12}) + "\n"
            + json.dumps({"ts": now, "event": "take", "slug": "x", "cost_usd": 0.03}) + "\n")
        json.dump({"ok": True, "verdict": "ok", "detail": "intact", "ts": now, "lines": 2},
                  open(os.path.join(cache, "chain-verdict.json"), "w"))
        json.dump({"ts": now, "issues": {"total": 4, "counts": {}, "top": {}},
                   "prs": {"total": 0, "counts": {}, "top": {}}},
                  open(os.path.join(cache, "triage-demo.json"), "w"))
        json.dump(["selftest"], open(os.path.join(cache, "checknames-acme_demo.json"), "w"))
        json.dump({"repos": {"demo": {"OK": {"status": "OK", "msg": "", "ts": now}}}, "ts": now,
                   "summary": {"OK": 1, "RED": 0, "WARN": 0, "UNKNOWN": 0, "SKIP": 0}},
                  open(os.path.join(st, "doctor-report.json"), "w"))
        json.dump({"repos": {"demo": {"path": tmp, "mainline": "main", "push_remote": "origin",
                   "remotes": {"origin": "https://github.com/acme/demo.git"}}}},
                  open(os.path.join(st, "workspace.json"), "w"))
        K.WL_HOME, K.CACHE_DIR, K.MANIFEST_PATH = tmp, cache, os.path.join(st, "workspace.json")
        K.GLASS_RO = True  # page-view semantics: loaders don't witness-write (would perturb the ledger)

        counts = {"tev": 0, "spend": 0, "man": 0, "cfg": 0, "chain": 0, "doctor": 0, "cachels": 0}
        def _c(key, fn):
            def w(*a, **k):
                counts[key] += 1; return fn(*a, **k)
            return w
        g._tail_events, g.spend_today_ro, g._manifest_ro = _c("tev", _o["tev"]), _c("spend", _o["spend"]), _c("man", _o["man"])
        K.config_load = _c("cfg", _o["cfg"])
        def _cache_w(key, *a, **k):
            if key == "chain-verdict":
                counts["chain"] += 1
            return _o["cache"](key, *a, **k)
        def _sload_w(name, *a, **k):
            if name == "doctor-report.json":
                counts["doctor"] += 1
            return _o["sload"](name, *a, **k)
        _cabs = os.path.abspath(cache)
        def _ls_w(p, *a, **k):
            if os.path.abspath(p) == _cabs:
                counts["cachels"] += 1
            return _o["ls"](p, *a, **k)
        K.cache_get_stale, K.state_load, os.listdir = _cache_w, _sload_w, _ls_w

        D = build_data()
        reads = dict(counts)  # FREEZE before the identity self-reads below re-invoke the readers
        check("perf: every shared source read EXACTLY ONCE per page view (was 2-3x each)",
              all(v == 1 for v in reads.values()), "counts=%s (want all 1)" % reads)
        # output-identical: injected blocks == self-reading (ctx=None) builders. These four carry
        # no _age_str, so static-state re-reads compare EXACTLY (github/repos/working age fields are
        # covered by the fixture selftests above + the count proof).
        check("perf: injected sub-builders byte-identical to self-read (ctx=None) path",
              D["budget"] == build_budget() and D["history"] == build_history()
              and D["config"] == build_config() and D["keys"] == build_keys(),
              "budget/history/config/keys identical under injection")
    finally:
        g._tail_events, g.spend_today_ro, g._manifest_ro = _o["tev"], _o["spend"], _o["man"]
        K.config_load, K.cache_get_stale, K.state_load, os.listdir = _o["cfg"], _o["cache"], _o["sload"], _o["ls"]
        K.WL_HOME, K.CACHE_DIR, K.MANIFEST_PATH, K.GLASS_RO = _save
        _sh.rmtree(tmp, ignore_errors=True)

    passed = sum(1 for _, okv, _ in results if okv)
    for label, okv, detail in results:
        sys.stdout.write(("  OK    " if okv else "  FAIL  ") + label
                         + ("" if okv else "  -- " + detail) + "\n")
    sys.stdout.write("\n  ratchet-glass selftest: %d/%d\n" % (passed, len(results)))
    return 0 if passed == len(results) else 2


_USAGE = ("usage:\n"
          "  ratchet-glass serve [--port N] [--bind-all]\n"
          "  ratchet-glass selftest\n")


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv:
        sys.stdout.write(_USAGE)
        return 0
    verb, rest = argv[0], argv[1:]
    if verb == "serve":
        return serve(rest)
    if verb == "selftest":
        return selftest(rest)
    if verb in ("-h", "--help"):
        sys.stdout.write(_USAGE)
        return 0
    sys.stderr.write("ratchet-glass: unknown verb %r\n%s" % (verb, _USAGE))
    return 2


if __name__ == "__main__":
    sys.exit(main())
