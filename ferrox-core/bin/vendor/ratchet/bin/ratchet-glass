                                      "CLEAN": {"status": "WARN", "msg": "3 dirty", "ts": now}}},
                   "ts": now, "summary": {"RED": 0, "UNKNOWN": 0, "WARN": 1, "OK": 1, "SKIP": 0}},
                  open(os.path.join(st, "doctor-report.json"), "w"))
        hostile_iss = "</script><script>x</script>"
        json.dump({"ts": now, "issues": {"total": 12,
                    "counts": {"triage": 5, "active": 4, "blocked": 2, "stale": 1},
                    "top": {"triage": [{"number": 101, "title": hostile_iss, "age_days": 3}]}},
                   "prs": {"total": 3, "counts": {"review": 1, "ready": 1, "checks-fail": 1,
                           "draft": 0, "stale": 0}, "top": {}}},
                  open(os.path.join(cache, "triage-demo.json"), "w"))
