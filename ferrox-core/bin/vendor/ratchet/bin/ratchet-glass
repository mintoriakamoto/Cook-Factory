    # 4c. Budget robustness + fail-closed HONESTY on a big/hostile ledger (review MAJORs):
    # a non-dict line and a NaN cost must NOT 500; a ledger past the tail bound must render
    # scanned_all=False AND suppress the green "nothing escaped" all-clear; a no-ts unpriced
    # call is COUNTED toward the fail-closed surface (oracle parity), never silently dropped.
    tmp = _tf.mkdtemp(prefix="glass-bud-")
    try:
        st = os.path.join(tmp, "state")
        os.makedirs(st)
        pad = json.dumps({"ts": now, "event": "exec", "cli": "claude", "p": "x" * 70}) + "\n"
        lines = [pad * 7000]                                    # > 512KB → tail-bounded
        lines.append("null\n")                                  # non-dict line → must not 500
        lines.append('{"ts": "%s", "cost_usd": NaN}\n' % now)   # NaN cost → must not 500 (round pct)
        lines.append(json.dumps({"ts": now, "event": "think", "model": "glm"}) + "\n")   # UNPRICED, dated
        lines.append(json.dumps({"event": "think", "model": "kimi"}) + "\n")             # UNPRICED, NO ts
        open(os.path.join(st, "telemetry.jsonl"), "w").write("".join(lines))
        p, port = _spawn(tmp)
        try:
            code, body, _ = _get(port, "/")
        finally:
            _stop(p)
        check("big/hostile ledger (non-dict + NaN) renders 200, never 500", code == 200, "code=%s" % code)
        import re as _re3
        m = _re3.search(r"const DATA = (.*?);\n", body)
        Db = json.loads(m.group(1)) if m else {}
        tb = Db.get("budget", {}).get("tail", {})
        check("ledger past the tail bound reports scanned_all=False",
              tb.get("scanned_all") is False, str(tb.get("scanned_all")))
        check("no-ts UNPRICED call is counted toward the fail-closed surface (oracle parity)",
              tb.get("n_unpriced", 0) >= 2, str(tb.get("n_unpriced")))
        check("NaN cost never poisons the exact metered headline (finite, no 500)",
              "nan" not in Db.get("budget", {}).get("metered_today", "").lower(), "")
        check("client suppresses the green UNPRICED all-clear when the tail is truncated",
              "t.scanned_all?pill(" in body, "")
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

    # 4d. Config & Keys (stage 5): config renders from config.json with source; keys are
    # PRESENCE-ONLY over a fixed allowlist; a planted secret VALUE must never appear anywhere in
    # the served document or the ⌘K index; the palette index EXCLUDES key rows.
    _SECRET_RE = _re_mod.compile(
        r"sk-[A-Za-z0-9_-]{16,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}"
        r"|xox[abprs]-[0-9A-Za-z-]{10,}|AKIA[0-9A-Z]{16}")
    fake_gh = "ghp_" + "A" * 36
    fake_flux = "sk-flux-" + "B" * 32
    tmp = _tf.mkdtemp(prefix="glass-key-")
    try:
        st = os.path.join(tmp, "state")
        cache = os.path.join(st, ".cache")
        os.makedirs(cache)
        cfg_secret = "ghp_" + "C" * 36  # a token a user might paste into a policy field by mistake
        json.dump({"schema_version": 1, "premium_policy": "ask",
                   "budgets": {"per_day_usd": 9.0}, "contract_hosts": ["https://x/" + cfg_secret]},
                  open(os.path.join(st, "config.json"), "w"))
        json.dump({"ok": True, "verdict": "ok", "detail": "n", "ts": now, "lines": 3},
                  open(os.path.join(cache, "chain-verdict.json"), "w"))
        planted = {"GH_TOKEN": fake_gh, "FLUX_TEST_KEY": fake_flux}
        p, port = _spawn(tmp, extra_env=planted)
        try:
            code, body, _ = _get(port, "/")
        finally:
            _stop(p)
        import re as _re4
        D = json.loads(_re4.search(r"const DATA = (.*?);\n", body).group(1))
        cfg = D.get("config", {})
        check("config renders from config.json with source=file + a change verb",
              cfg.get("sourced") is True
              and any(r["key"] == "premium_policy" and r["source"] == "file" and r["verb"]
                      for r in cfg.get("rows", [])), "")
        krows = D.get("keys", {}).get("keys", [])
        gh_row = next((k for k in krows if "gh keychain" in k["name"]), {})
        flux_row = next((k for k in krows if "FLUX_TEST_KEY" in k["name"]), {})
        check("keys are presence-only: planted GH + FLUX read PRESENT/WORKS, never a value",
              gh_row.get("state") in ("present", "works")
              and flux_row.get("state") in ("present", "works"),
              str({k["name"]: k["state"] for k in krows}))
        check("NO secret-shaped string appears anywhere in the served document",
              not _SECRET_RE.search(body) and fake_gh not in body and fake_flux not in body
              and cfg_secret not in body, "")
        check("a secret in a config VALUE is redacted, never rendered verbatim",
              any(r["key"] == "contract_hosts" for r in cfg.get("rows", []))
              and cfg_secret not in json.dumps(cfg.get("rows", [])), "")
        bi0 = body.find("function buildIndex(){")
        bi1 = body.find("function palOpen", bi0) if bi0 >= 0 else -1
        bidx = body[bi0:bi1] if bi0 >= 0 and bi1 > bi0 else ""
        check("the command palette index is built from cards/repos/pages/verbs only, never keys",
              bool(bidx) and "DATA.board" in bidx and "repos_est" in bidx
              and "keys" not in bidx.lower(), "")
        check("what-is-working is derived (chain row present from the seeded verdict)",
              any(w["name"] == "telemetry chain" for w in D.get("working", [])), "")
    finally:
        _sh.rmtree(tmp, ignore_errors=True)

